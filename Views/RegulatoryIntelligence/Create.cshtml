@model OpenQMS.Models.RI.RegulatoryApplication
@using OpenQMS.Models.RI
@{
    ViewData["Title"] = L["New Regulatory Application"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-plus-circle me-2 text-primary"></i>@L["New Regulatory Application"]</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>@L["Back to Register"]
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" id="saveErrorBanner">
        <h6 class="fw-bold mb-2"><i class="fas fa-exclamation-triangle me-1"></i>@L["The application was not created"]</h6>
        <p class="mb-2 small">@L["Please correct the following and submit again. Fields needing attention may be on other tabs."]</p>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<form asp-action="Create" method="post" id="createRIForm" novalidate>
    @Html.AntiForgeryToken()

    <!-- 7-Tab Navigation -->
    <ul class="nav nav-tabs mb-3" id="applicationTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1" type="button">
                <i class="fas fa-file-alt me-1"></i>@L["Application Info"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab2-tab" data-bs-toggle="tab" data-bs-target="#tab2" type="button">
                <i class="fas fa-pills me-1"></i>@L["Product"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab3-tab" data-bs-toggle="tab" data-bs-target="#tab3" type="button">
                <i class="fas fa-calendar-alt me-1"></i>@L["Key Dates"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab4-tab" data-bs-toggle="tab" data-bs-target="#tab4" type="button">
                <i class="fas fa-dollar-sign me-1"></i>@L["Fees"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab5-tab" data-bs-toggle="tab" data-bs-target="#tab5" type="button">
                <i class="fas fa-users me-1"></i>@L["Contacts"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab6-tab" data-bs-toggle="tab" data-bs-target="#tab6" type="button">
                <i class="fas fa-clipboard-check me-1"></i>@L["Notes"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab7-tab" data-bs-toggle="tab" data-bs-target="#tab7" type="button">
                <i class="fas fa-paperclip me-1"></i>@L["Documents"]
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-4 mb-3">

        <!-- Tab 1: Application Info -->
        <div class="tab-pane fade show active" id="tab1" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">@L["RI Number"]</label>
                    <input type="text" class="form-control" value="Auto-generated on save" disabled />
                    <input type="hidden" asp-for="RINumber" value="PENDING" />
                </div>
                <div class="col-md-4">
                    <label asp-for="SubmissionMethod" class="form-label fw-bold">@L["Submission Method"]
                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="submissionmethod" aria-label="@L["Submission Method guidance"]">?</button>
                    </label>
                    <select asp-for="SubmissionMethod" class="form-select">
                        <option value="">@L["— Select —"]</option>
                        <option value="eCTD">@L["eCTD"]</option>
                        <option value="PRISM Portal">@L["PRISM Portal"]</option>
                        <option value="Online Portal">@L["Online Portal"]</option>
                        <option value="Paper / Email">@L["Paper / Email"]</option>
                        <option value="Other">@L["Other"]</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AuthorityReferenceNumber" class="form-label fw-bold">@L["Authority Reference No."]
                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="authorityref" aria-label="@L["Authority Reference guidance"]">?</button>
                    </label>
                    <input asp-for="AuthorityReferenceNumber" class="form-control" placeholder="@L["e.g. ARTG#, NDA#, EMA/H/..."]" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">@L["Jurisdiction"] <span class="text-danger">*</span></label>
                    <select id="JurisdictionId" asp-for="JurisdictionId" class="form-select">
                        <option value="">@L["— Select Jurisdiction —"]</option>
                        @foreach (var item in ViewData["Jurisdictions"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(new List<object>()))
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                    <div class="invalid-feedback" id="JurisdictionId-error">@L["Please select a jurisdiction."]</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">@L["Application Type"] <span class="text-danger">*</span></label>
                    <select id="ApplicationTypeId" asp-for="ApplicationTypeId" class="form-select">
                        <option value="">@L["— Select Jurisdiction first —"]</option>
                    </select>
                    <div class="invalid-feedback" id="ApplicationTypeId-error">@L["Please select an application type."]</div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">@L["Priority / Expedited Designations"]
                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="designations" aria-label="@L["Expedited Designations guidance"]">?</button>
                    </label>
                    <div class="d-flex flex-wrap gap-3">
                        <div class="form-check">
                            <input asp-for="IsOrphanDesignation" class="form-check-input" type="checkbox" />
                            <label asp-for="IsOrphanDesignation" class="form-check-label">@L["Orphan Designation"]</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsPriorityReview" class="form-check-input" type="checkbox" />
                            <label asp-for="IsPriorityReview" class="form-check-label">@L["Priority Review"]</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsBreakthroughTherapy" class="form-check-input" type="checkbox" />
                            <label asp-for="IsBreakthroughTherapy" class="form-check-label">@L["Breakthrough Therapy"]</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsPRIME" class="form-check-input" type="checkbox" />
                            <label asp-for="IsPRIME" class="form-check-label">@L["PRIME"]</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="IsConditionalApproval" class="form-check-input" type="checkbox" />
                            <label asp-for="IsConditionalApproval" class="form-check-label">@L["Conditional Approval"]</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: Product & Indication -->
        <div class="tab-pane fade" id="tab2" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">@L["Product"] <span class="text-danger">*</span></label>
                    <select id="ProductId" asp-for="ProductId" asp-items='@(ViewData["Products"] as SelectList)' class="form-select">
                        <option value="">@L["— Select Product —"]</option>
                    </select>
                    <div class="invalid-feedback" id="ProductId-error">@L["Please select a product."]</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProductName" class="form-label fw-bold">@L["Product Name (snapshot)"] <span class="text-danger">*</span>
                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="productsnapshot" aria-label="@L["Product Name snapshot guidance"]">?</button>
                    </label>
                    <input asp-for="ProductName" id="ProductName" class="form-control"
                           placeholder="@L["Auto-filled from product selection, or enter manually"]" />
                    <div class="form-text">@L["Denormalised name stored at time of creation."]</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="ActiveSubstance" class="form-label fw-bold">@L["Active Substance / INN"]</label>
                    <input asp-for="ActiveSubstance" class="form-control" placeholder="@L["e.g. Imatinib"]" />
                </div>
                <div class="col-md-8">
                    <label asp-for="Indication" class="form-label fw-bold">@L["Indication"]</label>
                    <input asp-for="Indication" class="form-control" placeholder="@L["e.g. Chronic Myeloid Leukaemia (CML)"]" />
                </div>
                <div class="col-md-4">
                    <label asp-for="DosageForm" class="form-label fw-bold">@L["Dosage Form"]</label>
                    <input asp-for="DosageForm" class="form-control" placeholder="@L["e.g. Film-coated tablets"]" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Strength" class="form-label fw-bold">@L["Strength"]</label>
                    <input asp-for="Strength" class="form-control" placeholder="@L["e.g. 100 mg, 400 mg"]" />
                </div>
            </div>
        </div>

        <!-- Tab 3: Key Dates -->
        <div class="tab-pane fade" id="tab3" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="StrategyStartDate" class="form-label fw-bold">@L["Strategy Start"]</label>
                    <input asp-for="StrategyStartDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="PreSubMeetingDate" class="form-label fw-bold">@L["Pre-Submission Meeting"]</label>
                    <input asp-for="PreSubMeetingDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="DossierLockDate" class="form-label fw-bold">@L["Dossier Lock Date"]</label>
                    <input asp-for="DossierLockDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="SubmissionDate" class="form-label fw-bold">@L["Submission Date"]</label>
                    <input asp-for="SubmissionDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="AcknowledgementDate" class="form-label fw-bold">@L["Acknowledgement Date"]</label>
                    <input asp-for="AcknowledgementDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Day0Date" class="form-label fw-bold">@L["Day 0 (Clock Start)"]
                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="day0" aria-label="@L["Day 0 guidance"]">?</button>
                    </label>
                    <input asp-for="Day0Date" id="Day0Date" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="TargetDecisionDate" class="form-label fw-bold">@L["Target Decision Date"]</label>
                    <input asp-for="TargetDecisionDate" id="TargetDecisionDate" type="date" class="form-control" />
                    <div class="form-text">@L["Auto-calculated from Day 0 + clock days."]</div>
                </div>
                <div class="col-md-3">
                    <label asp-for="ActualDecisionDate" class="form-label fw-bold">@L["Actual Decision Date"]</label>
                    <input asp-for="ActualDecisionDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ApprovalDate" class="form-label fw-bold">@L["Approval Date"]</label>
                    <input asp-for="ApprovalDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ExpiryDate" class="form-label fw-bold">@L["Expiry / Renewal Date"]</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="NextRenewalDue" class="form-label fw-bold">@L["Next Renewal Due"]</label>
                    <input asp-for="NextRenewalDue" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="AppealDeadline" class="form-label fw-bold">@L["Appeal Deadline"]</label>
                    <input asp-for="AppealDeadline" type="date" class="form-control" />
                </div>
            </div>
        </div>

        <!-- Tab 4: Fees -->
        <div class="tab-pane fade" id="tab4" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="ApplicationFee" class="form-label fw-bold">@L["Application Fee"]</label>
                    <input asp-for="ApplicationFee" type="number" step="0.01" class="form-control" placeholder="@L["0.00"]" />
                </div>
                <div class="col-md-2">
                    <label asp-for="FeeCurrency" class="form-label fw-bold">@L["Currency"]</label>
                    <select asp-for="FeeCurrency" class="form-select">
                        <option value="">—</option>
                        <option value="AUD">@L["AUD"]</option><option value="NZD">@L["NZD"]</option><option value="EUR">@L["EUR"]</option>
                        <option value="USD">@L["USD"]</option><option value="CAD">@L["CAD"]</option><option value="SGD">@L["SGD"]</option>
                        <option value="MYR">@L["MYR"]</option><option value="BRL">@L["BRL"]</option><option value="MXN">@L["MXN"]</option>
                        <option value="COP">@L["COP"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="FeePaidDate" class="form-label fw-bold">@L["Fee Paid Date"]</label>
                    <input asp-for="FeePaidDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <div class="form-check mt-4 pt-2">
                        <input asp-for="FeeWaiverApplied" class="form-check-input" type="checkbox" />
                        <label asp-for="FeeWaiverApplied" class="form-check-label fw-bold">@L["Fee Waiver Applied"]</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <label asp-for="FeeWaiverReason" class="form-label fw-bold">@L["Fee Waiver Reason"]</label>
                    <input asp-for="FeeWaiverReason" class="form-control"
                           placeholder="@L["e.g. Orphan drug fee waiver, rare disease designation"]" />
                </div>
            </div>
        </div>

        <!-- Tab 5: Contacts & Strategy -->
        <div class="tab-pane fade" id="tab5" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="InternalRALead" class="form-label fw-bold">@L["Internal RA Lead"]</label>
                    <select id="InternalRALead" asp-for="InternalRALead" asp-items='@(ViewBag.UsersList as SelectList)' class="form-select">
                        <option value=""></option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ExternalConsultant" class="form-label fw-bold">@L["External RA Consultant"]</label>
                    <input asp-for="ExternalConsultant" class="form-control" placeholder="@L["Consulting firm or individual"]" />
                </div>
                <div class="col-md-6">
                    <label asp-for="AuthorityRapporteur" class="form-label fw-bold">@L["Authority Rapporteur / Project Manager"]</label>
                    <input asp-for="AuthorityRapporteur" class="form-control" placeholder="@L["Name of authority contact"]" />
                </div>
                <div class="col-md-6">
                    <label asp-for="AuthorityContactEmail" class="form-label fw-bold">@L["Authority Contact Email"]</label>
                    <input asp-for="AuthorityContactEmail" type="email" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ManufacturingSupplierId" class="form-label fw-bold">@L["Manufacturing Supplier (CMO/CDMO)"]</label>
                    <select asp-for="ManufacturingSupplierId"
                            asp-items='@(ViewData["Suppliers"] as SelectList)'
                            class="form-select">
                        <option value="">@L["— None / Not applicable —"]</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="StrategyNotes" class="form-label fw-bold">@L["Strategy Notes"]</label>
                    <textarea asp-for="StrategyNotes" class="form-control" rows="5"
                              placeholder="@L["Regulatory strategy rationale, pre-submission meeting outcomes, key decisions..."]"></textarea>
                </div>
            </div>
        </div>

        <!-- Tab 6: Notes -->
        <div class="tab-pane fade" id="tab6" role="tabpanel">
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                @L["Conditions of Approval and Rejection / Withdrawal reasons can be managed after the application is created."]
            </div>
        </div>

        <!-- Tab 7: Documents -->
        <div class="tab-pane fade" id="tab7" role="tabpanel">
            <div class="alert alert-info">
                <i class="fas fa-paperclip me-2"></i>
                @L["Documents can be uploaded after the application is saved."]
            </div>
        </div>

    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-1"></i>@L["Create Application"]
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">@L["Cancel"]</a>
    </div>
</form>

<!-- Field-help popover content (hidden, read by field-help.js) -->
<div class="d-none">
    <div id="help-submissionmethod">
        <p class="mb-1"><strong>@L["How the dossier is filed with the authority"]</strong></p>
        <ul class="mb-0 ps-3">
            <li>@H["<strong>eCTD</strong> — electronic Common Technical Document; the standard structured electronic submission (TGA, FDA, EMA)."]</li>
            <li><strong>@L["PRISM"]</strong> @L["— Singapore HSA's online submission portal."]</li>
            <li><strong>@L["Portal"]</strong> @L["— an authority web portal that isn't eCTD (e.g. country-specific upload systems)."]</li>
            <li><strong>@L["Paper"]</strong> @L["— a physical/PDF submission where electronic filing isn't available."]</li>
        </ul>
    </div>
    <div id="help-authorityref">
        <p class="mb-0">@H["The authority's own identifier for this application or product, used in all correspondence. Examples: <strong>ARTG</strong> number (TGA), <strong>NDA/BLA</strong> number (FDA), <strong>EMA/H/C/…</strong> (EMA), <strong>HSA</strong> registration number. Leave blank until the authority assigns one."]</p>
    </div>
    <div id="help-designations">
        <p class="mb-1"><strong>@L["Expedited / priority pathways"]</strong> @L["— tick any the authority has granted. They shorten timelines or relax requirements:"]</p>
        <ul class="mb-0 ps-3">
            <li>@H["<strong>Orphan Designation</strong> — for rare-disease products; brings fee relief and market exclusivity."]</li>
            <li><strong>@L["Priority Review"]</strong> @L["— shorter assessment clock for products of major therapeutic value."]</li>
            <li><strong>@L["Breakthrough Therapy"]</strong> @L["— FDA designation for therapies showing substantial improvement over existing options."]</li>
            <li><strong>@L["PRIME"]</strong> @L["— EMA's PRIority MEdicines scheme: enhanced support for unmet medical need."]</li>
            <li><strong>@L["Conditional Approval"]</strong> @L["— early authorisation on less complete data, subject to post-approval conditions."]</li>
        </ul>
    </div>
    <div id="help-productsnapshot">
        <p class="mb-0">@H["A frozen copy of the product name <em>as filed in this application</em>. The linked <strong>Product</strong> above stays live and may change over time; this snapshot preserves exactly what was submitted to the authority, so the regulatory record stays accurate even if the product is later renamed or superseded."]</p>
    </div>
    <div id="help-day0">
        <p class="mb-0">@H["<strong>Day 0</strong> is the official start of the authority's review clock — the date validation completes and assessment formally begins (not the date you submitted). The <strong>Target Decision Date</strong> is calculated from Day 0 plus the jurisdiction's statutory review period. Clock-stops (e.g. responding to questions) pause this clock."]</p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/tab-form-validation.js" asp-append-version="true"></script>
    <script src="~/js/field-help.js" asp-append-version="true"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            // Select2 on jurisdiction and product
            $('#JurisdictionId').select2({ placeholder: @Json.Serialize(L["— Select Jurisdiction —"].Value), allowClear: true, width: '100%' });
            $('#ApplicationTypeId').select2({ placeholder: @Json.Serialize(L["— Select Jurisdiction first —"].Value), allowClear: true, width: '100%' });
            $('#ProductId').select2({ placeholder: @Json.Serialize(L["— Select Product —"].Value), allowClear: true, width: '100%' });
            $('#InternalRALead').select2({ placeholder: @Json.Serialize(L["— Select RA Lead —"].Value), allowClear: true, width: '100%' });

            // Jurisdiction → ApplicationType cascade
            $('#JurisdictionId').on('change', function () {
                var jId = $(this).val();
                var $appType = $('#ApplicationTypeId');
                $appType.empty().append('<option value="">— Loading... —</option>');

                if (!jId) {
                    $appType.empty().append('<option value="">' + @Json.Serialize(L["— Select Jurisdiction first —"].Value) + '</option>');
                    $appType.trigger('change.select2');
                    return;
                }

                $.getJSON('@Url.Action("GetApplicationTypes", "RegulatoryIntelligence")', { jurisdictionId: jId }, function (data) {
                    $appType.empty().append('<option value="">— Select Application Type —</option>');
                    $.each(data, function (_, item) {
                        $appType.append(new Option(item.code + ' — ' + item.name, item.id));
                    });
                    $appType.trigger('change.select2');
                });
            });

            // Day0Date → auto-calculate TargetDecisionDate
            $('#Day0Date').on('change', function () {
                var day0   = $(this).val();
                var typeId = $('#ApplicationTypeId').val();
                if (!day0 || !typeId) return;

                $.getJSON('@Url.Action("CalculateTargetDate", "RegulatoryIntelligence")',
                    { day0: day0, appTypeId: typeId }, function (r) {
                        if (r.targetDate) $('#TargetDecisionDate').val(r.targetDate);
                    });
            });

            // Auto-fill product fields from product selection
            $('#ProductId').on('change', function () {
                var id = $(this).val();
                if (!id) return;

                $.getJSON('@Url.Action("GetProductDetails", "RegulatoryIntelligence")', { productId: id }, function (data) {
                    if (!data) return;
                    // Product Name — use brand name if available, else system name
                    $('#ProductName').val(data.brandName || data.name || '');
                    // Auto-fill regulatory fields from product record
                    if (data.innName)    $('#ActiveSubstance').val(data.innName);
                    if (data.dosageForm) $('#DosageForm').val(data.dosageForm);
                    if (data.strengths)  $('#Strength').val(data.strengths);
                });
            });

            // Clear validation error when user makes a selection
            $('#JurisdictionId, #ApplicationTypeId, #ProductId').on('change', function () {
                var id = $(this).attr('id');
                $(this).next('.select2-container').removeClass('is-invalid');
                $(this).removeClass('is-invalid');
                $('#' + id + '-error').hide();
            });
            $('#ProductName').on('input', function () {
                $(this).removeClass('is-invalid');
            });

            // Custom pre-submit validation for Select2 required fields
            $('#createRIForm').on('submit', function (e) {
                var valid = true;

                var required = [
                    { id: 'JurisdictionId',    label: @Json.Serialize(L["Jurisdiction"].Value) },
                    { id: 'ApplicationTypeId', label: @Json.Serialize(L["Application Type"].Value) },
                    { id: 'ProductId',         label: @Json.Serialize(L["Product"].Value) }
                ];

                required.forEach(function (field) {
                    var val = $('#' + field.id).val();
                    var $container = $('#' + field.id).next('.select2-container');
                    if (!val) {
                        $container.addClass('is-invalid');
                        $('#' + field.id + '-error').show();
                        valid = false;
                    } else {
                        $container.removeClass('is-invalid');
                        $('#' + field.id + '-error').hide();
                    }
                });

                var productName = $('#ProductName').val().trim();
                if (!productName) {
                    $('#ProductName').addClass('is-invalid');
                    valid = false;
                } else {
                    $('#ProductName').removeClass('is-invalid');
                }

                if (!valid) {
                    e.preventDefault();
                    var missing = [];
                    required.forEach(function (field) {
                        if (!$('#' + field.id).val()) missing.push(field.label);
                    });
                    if (!$('#ProductName').val().trim()) missing.push(@Json.Serialize(L["Product Name (snapshot)"].Value));

                    var $banner = $('#riValidationBanner');
                    if ($banner.length === 0) {
                        $banner = $('<div id="riValidationBanner" class="alert alert-danger alert-dismissible mb-3"><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                        $('#createRIForm').prepend($banner);
                    }
                    $banner.html('<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                        '<strong>' + @Json.Serialize(L["Please complete all required fields:"].Value) + '</strong>' +
                        '<ul class="mb-0 mt-1">' + missing.map(function(m){ return '<li>' + m + '</li>'; }).join('') + '</ul>');

                    $('html, body').animate({ scrollTop: 0 }, 200);
                    $('#tab1-tab').tab('show');
                }
            });
        });
    </script>
    <style>
        .select2-container.is-invalid .select2-selection {
            border-color: #dc3545;
        }
        .select2-container.is-invalid + .invalid-feedback {
            display: block;
        }
    </style>
}
