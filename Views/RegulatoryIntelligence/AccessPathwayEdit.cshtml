@model OpenQMS.Models.RI.RIAccessPathwayRecord
@using OpenQMS.Models.RI
@{
    ViewData["Title"] = $"Edit {Model.AccessNumber}";
    int applicationId = (int)ViewData["ApplicationId"]!;
    string riNumber   = (string)(ViewData["RINumber"] ?? "");
    string authority  = (string)(ViewData["Authority"] ?? "Authority");
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="AccessPathwayDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back to @Model.AccessNumber
    </a>
    <h4 class="mb-0"><i class="fas fa-edit me-2 text-primary"></i>Edit Access Pathway</h4>
</div>

<form asp-action="EditAccessPathway" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RegulatoryApplicationId" />
    <input type="hidden" asp-for="CreatedBy" />
    <input type="hidden" asp-for="CreatedAt" />

    <div class="card mb-3">
        <div class="card-header fw-semibold">Pathway Information</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="AccessNumber" class="form-label">AP Number</label>
                    <input asp-for="AccessNumber" class="form-control" />
                    <span asp-validation-for="AccessNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PathwayType" class="form-label">Pathway Type <span class="text-danger">*</span></label>
                    <select asp-for="PathwayType" class="form-select"
                            asp-items="Html.GetEnumSelectList<RIAccessPathwayType>()"></select>
                    <span asp-validation-for="PathwayType" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select"
                            asp-items="Html.GetEnumSelectList<RIAccessPathwayStatus>()"></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label d-block">&nbsp;</label>
                    <div class="form-check mt-2">
                        <input asp-for="AEReportingRequired" class="form-check-input" type="checkbox" />
                        <label asp-for="AEReportingRequired" class="form-check-label">AE Reporting Required</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">Patient &amp; Prescriber</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="PatientIdentifier" class="form-label">Patient Identifier <span class="text-muted small">(pseudonymised)</span></label>
                    <input asp-for="PatientIdentifier" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PrescriberName" class="form-label">Prescriber Name</label>
                    <input asp-for="PrescriberName" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PrescriberId" class="form-label">Prescriber ID</label>
                    <input asp-for="PrescriberId" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">@authority Approval</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TGAApprovalLetterNumber" class="form-label">Approval Letter / Reference Number</label>
                    <input asp-for="TGAApprovalLetterNumber" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ApprovalDate" class="form-label">Approval Date</label>
                    <input asp-for="ApprovalDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ExpiryDate" class="form-label">Expiry Date</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="NextSixMonthlyReportDue" class="form-label">Next Six-Monthly Report Due</label>
                    <input asp-for="NextSixMonthlyReportDue" type="date" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">Clinical Justification</div>
        <div class="card-body">
            <textarea asp-for="ClinicalJustification" class="form-control" rows="4"></textarea>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-1"></i>Save Changes
        </button>
        <a asp-action="AccessPathwayDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
