@model IEnumerable<OpenQMS.Models.RI.RegulatoryApplication>
@using OpenQMS.Models.RI
@{
    ViewData["Title"] = "Regulatory Intelligence";
    var jurisdictions  = ViewData["Jurisdictions"] as List<RIJurisdiction> ?? new();
    var currentJuris   = ViewData["CurrentJurisdiction"] as string;
    var currentStatus  = ViewData["CurrentStatus"] as string;
    var currentYear    = ViewData["CurrentYear"] as int?;
    var allStatuses    = Enum.GetValues<RIApplicationStatus>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">RI Register</h4>
    <div class="d-flex gap-2">
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">Dashboard</a>
        <a asp-action="ExportApplications" class="btn btn-outline-success btn-sm">Export Register</a>
        <a asp-action="ExportAccessPathways" class="btn btn-outline-success btn-sm">Export Pathways</a>
        @if (User.IsInRole("Administrator") || User.IsInRole("RegulatoryManager") || User.IsInRole("RegulatoryUser"))
        {
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Application</a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- Filter Bar -->
<div class="card mb-3 border-0 bg-light">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Jurisdiction</label>
                <select name="jurisdiction" class="form-select form-select-sm">
                    <option value="">All Jurisdictions</option>
                    @foreach (var j in jurisdictions)
                    {
                        <option value="@j.Code" selected="@(currentJuris == j.Code)">@j.Code — @j.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in allStatuses)
                    {
                        <option value="@st.ToString()" selected="@(currentStatus == st.ToString())">@st.ToString()</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold mb-1">Year</label>
                <input type="number" name="year" value="@currentYear" class="form-control form-control-sm"
                       placeholder="e.g. 2026" min="2020" max="2040" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-outline-primary w-100">Filter</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- DataTable -->
<table id="riTable" class="table table-sm table-hover align-middle" style="width:100%">
    <thead class="table-light">
        <tr>
            <th>RI Number</th>
            <th>Product</th>
            <th>Jurisdiction</th>
            <th>Type</th>
            <th>Status</th>
            <th>Submission Date</th>
            <th>Target Decision</th>
            <th>Expiry</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model)
        {
            var statusBadge = app.Status switch
            {
                RIApplicationStatus.Strategy          => "secondary",
                RIApplicationStatus.Preparation       => "info",
                RIApplicationStatus.Submitted         => "primary",
                RIApplicationStatus.UnderReview       => "warning",
                RIApplicationStatus.ClockStop         => "warning",
                RIApplicationStatus.Approved          => "success",
                RIApplicationStatus.ConditionsActive  => "success",
                RIApplicationStatus.VariationRequired => "warning",
                RIApplicationStatus.RenewalDue        => "warning",
                RIApplicationStatus.Rejected          => "danger",
                RIApplicationStatus.Withdrawn         => "dark",
                RIApplicationStatus.Suspended         => "danger",
                _                                     => "secondary"
            };
            var targetClass = (app.TargetDecisionDate < SiteTime.Today &&
                               app.Status != RIApplicationStatus.Approved &&
                               app.Status != RIApplicationStatus.Rejected &&
                               app.Status != RIApplicationStatus.Withdrawn)
                              ? "text-danger fw-bold" : "";
            var expiryClass = app.ExpiryDate.HasValue
                ? (app.ExpiryDate < SiteTime.Today.AddMonths(3) ? "text-danger fw-bold"
                 : app.ExpiryDate < SiteTime.Today.AddMonths(12) ? "text-warning fw-bold" : "")
                : "";
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@app.Id" class="fw-semibold text-decoration-none">@app.RINumber</a>
                    @if (app.IsLocked) { <i class="fas fa-lock text-muted ms-1" title="Approved & locked"></i> }
                </td>
                <td>@app.Product?.Name</td>
                <td><span class="badge bg-secondary">@app.Jurisdiction?.Code</span></td>
                <td class="small">@app.ApplicationType?.Code</td>
                <td><span class="badge bg-@statusBadge">@EnumHelper.Display(app.Status)</span></td>
                <td>@app.SubmissionDate?.ToString("dd MMM yyyy")</td>
                <td class="@targetClass">@app.TargetDecisionDate?.ToString("dd MMM yyyy")</td>
                <td class="@expiryClass">@app.ExpiryDate?.ToString("dd MMM yyyy")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@app.Id">Details</a>
                    @if (!app.IsLocked && (User.IsInRole("Administrator") || User.IsInRole("RegulatoryManager") || User.IsInRole("RegulatoryUser")))
                    {
                        <text> | </text>
                        <a asp-action="Edit" asp-route-id="@app.Id">Edit</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#riTable').DataTable({ stateSave: true,
                pageLength: 25,
                order: [[0, 'desc']],
                dom: 'Bfrtip',
                buttons: ['excel', 'print', 'colvis'],
                language: { searchPlaceholder: 'Search within filtered results…', search: '' }
            });
        });
    </script>
}
