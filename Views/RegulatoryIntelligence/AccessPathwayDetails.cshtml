@model OpenQMS.Models.RI.RIAccessPathwayRecord
@using OpenQMS.Models.RI
@{
    ViewData["Title"] = Model.AccessNumber;
    int linkedAECount = (int)(ViewData["LinkedAECount"] ?? 0);
    string authority  = Model.Application?.Jurisdiction?.Authority ?? "Authority";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Details" asp-route-id="@Model.RegulatoryApplicationId" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i>@Model.Application?.RINumber
            </a>
            <h4 class="mb-0"><i class="fas fa-user-shield me-2 text-primary"></i>@Model.AccessNumber</h4>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @{
                string statusBadge = Model.Status switch
                {
                    RIAccessPathwayStatus.Active    => "success",
                    RIAccessPathwayStatus.Approved  => "success",
                    RIAccessPathwayStatus.Rejected  => "danger",
                    RIAccessPathwayStatus.Closed    => "dark",
                    RIAccessPathwayStatus.Submitted => "primary",
                    _ => "secondary"
                };
            }
            <span class="badge bg-@statusBadge fs-6">@EnumHelper.Display(Model.Status)</span>
            <span class="badge bg-info text-dark">@EnumHelper.Display(Model.PathwayType)</span>
            @if (Model.AEReportingRequired) { <span class="badge bg-warning text-dark"><i class="fas fa-exclamation-triangle me-1"></i>AE Reporting Required</span> }
            @if (Model.ExpiryDate.HasValue && Model.ExpiryDate < SiteTime.Today) { <span class="badge bg-danger">Expired</span> }
            <span class="text-muted small">@authority — @Model.Application?.RINumber</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="EditAccessPathway" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-edit me-1"></i>Edit
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- Details -->
<div class="card mb-3">
    <div class="card-header fw-semibold">Pathway Details</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3"><label class="text-muted small">AP Number</label><div class="fw-bold">@Model.AccessNumber</div></div>
            <div class="col-md-3"><label class="text-muted small">Pathway Type</label><div>@EnumHelper.Display(Model.PathwayType)</div></div>
            <div class="col-md-3"><label class="text-muted small">Status</label><div><span class="badge bg-@statusBadge">@EnumHelper.Display(Model.Status)</span></div></div>
            <div class="col-md-3"><label class="text-muted small">AE Reporting</label><div>@(Model.AEReportingRequired ? "Required" : "Not required")</div></div>

            <div class="col-md-3"><label class="text-muted small">Patient Identifier</label><div>@(Model.PatientIdentifier ?? "—")</div></div>
            <div class="col-md-3"><label class="text-muted small">Prescriber Name</label><div>@(Model.PrescriberName ?? "—")</div></div>
            <div class="col-md-3"><label class="text-muted small">Prescriber ID</label><div>@(Model.PrescriberId ?? "—")</div></div>
            <div class="col-md-3"><label class="text-muted small">Linked AEs</label>
                <div>
                    @if (linkedAECount > 0)
                    {
                        <a asp-controller="Pharmacovigilance" asp-action="Index" class="btn btn-xs btn-sm btn-outline-info py-0">@linkedAECount AE(s)</a>
                    }
                    else { <span class="text-muted">None</span> }
                </div>
            </div>

            <div class="col-md-6"><label class="text-muted small">@authority Approval Letter / Reference</label><div>@(Model.TGAApprovalLetterNumber ?? "—")</div></div>
            <div class="col-md-3"><label class="text-muted small">Approval Date</label><div>@(Model.ApprovalDate?.ToString("dd MMM yyyy") ?? "—")</div></div>
            <div class="col-md-3">
                <label class="text-muted small">Expiry Date</label>
                <div class="@(Model.ExpiryDate.HasValue && Model.ExpiryDate < SiteTime.Today ? "text-danger fw-bold" : "")">
                    @(Model.ExpiryDate?.ToString("dd MMM yyyy") ?? "—")
                </div>
            </div>
            <div class="col-md-3">
                <label class="text-muted small">Next Six-Monthly Report Due</label>
                <div class="@(Model.NextSixMonthlyReportDue.HasValue && Model.NextSixMonthlyReportDue < SiteTime.Today ? "text-warning fw-bold" : "")">
                    @(Model.NextSixMonthlyReportDue?.ToString("dd MMM yyyy") ?? "—")
                </div>
            </div>
            <div class="col-md-3"><label class="text-muted small">Created By</label><div>@Model.CreatedBy</div></div>
            <div class="col-md-3"><label class="text-muted small">Created At</label><div>@Model.CreatedAt.ToSite().ToString("dd MMM yyyy HH:mm")</div></div>

            @if (!string.IsNullOrEmpty(Model.ClinicalJustification))
            {
                <div class="col-12">
                    <label class="text-muted small">Clinical Justification</label>
                    <div class="border rounded p-2 bg-light" style="white-space:pre-wrap">@Model.ClinicalJustification</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Six-Monthly Supply Reports -->
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center fw-semibold">
        <span><i class="fas fa-chart-bar me-1"></i>Six-Monthly Supply Reports</span>
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addReportModal">
            <i class="fas fa-plus me-1"></i>Add Report
        </button>
    </div>
    <div class="card-body p-0">
        @{
            var reports = Model.SupplyReports?.OrderByDescending(r => r.PeriodEnd).ToList() ?? new();
        }
        @if (reports.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Period</th>
                            <th>Quantity</th>
                            <th>Submitted</th>
                            <th>Ref #</th>
                            <th>Status</th>
                            <th>Notes</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in reports)
                        {
                            string rBadge = r.Status switch
                            {
                                RIReportStatus.Submitted     => "success",
                                RIReportStatus.Overdue       => "danger",
                                RIReportStatus.PendingReview => "warning",
                                _ => "secondary"
                            };
                            <tr class="@(r.Status == RIReportStatus.Overdue ? "table-danger" : "")">
                                <td class="small">@r.PeriodStart.ToString("dd MMM yyyy") – @r.PeriodEnd.ToString("dd MMM yyyy")</td>
                                <td class="small">@r.QuantitySupplied @r.Unit</td>
                                <td class="small">@(r.SubmittedToAuthorityDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="small">@(r.AuthorityReferenceNumber ?? "—")</td>
                                <td><span class="badge bg-@rBadge">@EnumHelper.Display(r.Status)</span></td>
                                <td class="small text-muted">@(r.Notes ?? "—")</td>
                                <td class="text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary edit-report-btn"
                                            data-bs-toggle="modal" data-bs-target="#editReportModal"
                                            data-id="@r.Id"
                                            data-periodstart="@r.PeriodStart.ToString("yyyy-MM-dd")"
                                            data-periodend="@r.PeriodEnd.ToString("yyyy-MM-dd")"
                                            data-quantity="@r.QuantitySupplied"
                                            data-unit="@(r.Unit ?? "")"
                                            data-submitted="@(r.SubmittedToAuthorityDate?.ToString("yyyy-MM-dd") ?? "")"
                                            data-refnum="@(r.AuthorityReferenceNumber ?? "")"
                                            data-status="@((int)r.Status)"
                                            data-notes="@(r.Notes ?? "")">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </button>
                                    <form asp-action="DeleteSixMonthlyReport" method="post" class="d-inline ms-1"
                                          onsubmit="return confirm('Delete this supply report?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash me-1"></i>Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-muted text-center py-3">No supply reports recorded.</div>
        }
    </div>
</div>

<!-- Add Supply Report Modal -->
<div class="modal fade" id="addReportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="AddSixMonthlyReport" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="accessPathwayId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-plus-circle me-2 text-primary"></i>Add Six-Monthly Supply Report</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Period Start <span class="text-danger">*</span></label>
                            <input type="date" name="periodStart" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Period End <span class="text-danger">*</span></label>
                            <input type="date" name="periodEnd" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select">
                                @foreach (RIReportStatus s in Enum.GetValues(typeof(RIReportStatus)))
                                {
                                    <option value="@((int)s)">@s</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Quantity Supplied <span class="text-danger">*</span></label>
                            <input type="number" name="quantitySupplied" class="form-control" min="0" required value="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Unit</label>
                            <select name="unit" class="form-select">
                                <option value="">—</option>
                                <option>vials</option><option>tablets</option><option>capsules</option>
                                <option>packs</option><option>doses</option><option>mL</option><option>g</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Submitted to Authority</label>
                            <input type="date" name="submittedToAuthorityDate" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Authority Reference #</label>
                            <input type="text" name="authorityReferenceNumber" class="form-control" maxlength="100" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea name="notes" class="form-control" rows="2" maxlength="1000"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Add Report</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Supply Report Modal -->
<div class="modal fade" id="editReportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="UpdateSixMonthlyReport" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editReportId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-edit me-2 text-primary"></i>Edit Supply Report</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Period Start <span class="text-danger">*</span></label>
                            <input type="date" name="periodStart" id="editPeriodStart" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Period End <span class="text-danger">*</span></label>
                            <input type="date" name="periodEnd" id="editPeriodEnd" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select name="status" id="editReportStatus" class="form-select">
                                @foreach (RIReportStatus s in Enum.GetValues(typeof(RIReportStatus)))
                                {
                                    <option value="@((int)s)">@s</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Quantity Supplied <span class="text-danger">*</span></label>
                            <input type="number" name="quantitySupplied" id="editQuantity" class="form-control" min="0" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Unit</label>
                            <select name="unit" id="editUnit" class="form-select">
                                <option value="">—</option>
                                <option>vials</option><option>tablets</option><option>capsules</option>
                                <option>packs</option><option>doses</option><option>mL</option><option>g</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Submitted to Authority</label>
                            <input type="date" name="submittedToAuthorityDate" id="editSubmitted" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Authority Reference #</label>
                            <input type="text" name="authorityReferenceNumber" id="editRefNum" class="form-control" maxlength="100" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea name="notes" id="editReportNotes" class="form-control" rows="2" maxlength="1000"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.edit-report-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('editReportId').value      = this.dataset.id;
            document.getElementById('editPeriodStart').value   = this.dataset.periodstart;
            document.getElementById('editPeriodEnd').value     = this.dataset.periodend;
            document.getElementById('editQuantity').value      = this.dataset.quantity;
            document.getElementById('editSubmitted').value     = this.dataset.submitted;
            document.getElementById('editRefNum').value        = this.dataset.refnum;
            document.getElementById('editReportStatus').value  = this.dataset.status;
            document.getElementById('editReportNotes').value   = this.dataset.notes;

            // Set unit select
            var unitSel = document.getElementById('editUnit');
            for (var i = 0; i < unitSel.options.length; i++) {
                unitSel.options[i].selected = (unitSel.options[i].value === this.dataset.unit);
            }
        });
    });
</script>
}
