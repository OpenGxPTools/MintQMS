@model OpenQMS.Models.RI.RegulatoryApplication
@using OpenQMS.Models.RI
@{
    ViewData["Title"] = Model.RINumber;
    var supplierName = ViewData["ManufacturingSupplierName"] as string;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-1"><i class="fas fa-globe me-2 text-primary"></i>@Model.RINumber</h4>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @{
                var statusBadge = Model.Status switch
                {
                    RIApplicationStatus.Strategy          => "secondary",
                    RIApplicationStatus.Preparation       => "info",
                    RIApplicationStatus.Submitted         => "primary",
                    RIApplicationStatus.UnderReview       => "warning",
                    RIApplicationStatus.ClockStop         => "warning",
                    RIApplicationStatus.Approved          => "success",
                    RIApplicationStatus.ConditionsActive  => "success",
                    RIApplicationStatus.VariationRequired => "warning",
                    RIApplicationStatus.RenewalDue        => "warning",
                    RIApplicationStatus.Rejected          => "danger",
                    RIApplicationStatus.Withdrawn         => "dark",
                    RIApplicationStatus.Suspended         => "danger",
                    _                                     => "secondary"
                };
            }
            <span class="badge bg-@statusBadge fs-6">@EnumHelper.Display(Model.Status)</span>
            @if (Model.IsLocked) { <span class="badge bg-secondary"><i class="fas fa-lock me-1"></i>Locked</span> }
            @if (Model.IsOrphanDesignation)   { <span class="badge bg-info">Orphan</span> }
            @if (Model.IsPriorityReview)      { <span class="badge bg-warning text-dark">Priority</span> }
            @if (Model.IsBreakthroughTherapy) { <span class="badge bg-danger">Breakthrough</span> }
            @if (Model.IsPRIME)               { <span class="badge bg-danger">PRIME</span> }
            @if (Model.IsConditionalApproval) { <span class="badge bg-warning text-dark">Conditional</span> }
            <span class="text-muted small">@Model.Jurisdiction?.Authority — @Model.Jurisdiction?.Name</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Register
        </a>
        @if (!Model.IsLocked && !OpenQMS.Services.RIWorkflowService.IsTerminal(Model.Status))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-edit me-1"></i>Edit
            </a>
        }
        @if (User.IsInRole("Administrator"))
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Soft-delete this application?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="fas fa-trash me-1"></i>Delete
                </button>
            </form>
        }
    </div>
</div>

@if (Model.IsLocked)
{
    <div class="alert alert-info d-flex align-items-center mb-3">
        <i class="fas fa-lock me-3 fa-lg"></i>
        <div>
            <strong>This application is approved and locked.</strong>
            To make changes, create a <strong>Variation</strong> or initiate a <strong>Renewal</strong>.
        </div>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- Workflow Actions Panel -->
@{
    bool isTerminal = Model.Status is RIApplicationStatus.Rejected or RIApplicationStatus.Withdrawn;
    // Variations are post-approval changes — only offered once an authorisation exists.
    bool canVariate = Model.Status is RIApplicationStatus.Approved
                                   or RIApplicationStatus.ConditionsActive
                                   or RIApplicationStatus.VariationRequired
                                   or RIApplicationStatus.RenewalDue;
}
@if (!isTerminal)
{
    <div class="card mb-3 border-0 bg-light">
        <div class="card-body py-2 d-flex align-items-center flex-wrap gap-2">
            <small class="text-muted fw-bold">ACTIONS:</small>

            @if (Model.Status == RIApplicationStatus.Strategy)
            {
                <form asp-action="Transition" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="Preparation" />
                    <button type="submit" class="btn btn-sm btn-outline-info">
                        <i class="fas fa-arrow-right me-1"></i>Advance to Preparation
                    </button>
                </form>
            }

            @if (Model.Status == RIApplicationStatus.Preparation)
            {
                <form asp-action="Transition" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="Strategy" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Strategy
                    </button>
                </form>
                <form asp-action="Transition" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="Submitted" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-paper-plane me-1"></i>Mark Submitted
                    </button>
                </form>
            }

            @if (Model.Status == RIApplicationStatus.Submitted)
            {
                <form asp-action="Transition" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="Preparation" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Preparation
                    </button>
                </form>
                <form asp-action="Transition" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="UnderReview" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-search me-1"></i>Under Review (set Day 0)
                    </button>
                </form>
                <button class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                    <i class="fas fa-ban me-1"></i>Withdraw
                </button>
            }

            @if (Model.Status == RIApplicationStatus.UnderReview)
            {
                <form asp-action="Transition" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="ClockStop" />
                    <button type="submit" class="btn btn-sm btn-outline-warning">
                        <i class="fas fa-pause me-1"></i>Clock Stop
                    </button>
                </form>
                <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#approveModal">
                    <i class="fas fa-check me-1"></i>Approve
                </button>
                <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                    <i class="fas fa-times-circle me-1"></i>Reject
                </button>
                <button class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                    <i class="fas fa-ban me-1"></i>Withdraw
                </button>
            }

            @if (Model.Status == RIApplicationStatus.ClockStop)
            {
                <form asp-action="Transition" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="UnderReview" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-play me-1"></i>Restart Clock
                    </button>
                </form>
            }

            @if (Model.Status == RIApplicationStatus.Approved)
            {
                <form asp-action="Transition" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="VariationRequired" />
                    <button type="submit" class="btn btn-sm btn-outline-warning">
                        <i class="fas fa-edit me-1"></i>Variation Required
                    </button>
                </form>
                <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#initiateRenewalModal"
                        title="Start the renewal cycle now, ahead of the expiry-driven reminders.">
                    <i class="fas fa-sync me-1"></i>Initiate Renewal Now
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#suspendModal"
                        title="Record an authority suspension of this authorisation.">
                    <i class="fas fa-pause-circle me-1"></i>Suspend
                </button>
                <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#withdrawModal"
                        title="End this authorisation — e.g. a decision not to renew.">
                    <i class="fas fa-ban me-1"></i>Withdraw
                </button>
            }

            @if (Model.Status == RIApplicationStatus.ConditionsActive)
            {
                <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#approveModal">
                    <i class="fas fa-check me-1"></i>Approve (Conditions Met)
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#suspendModal">
                    <i class="fas fa-pause-circle me-1"></i>Suspend
                </button>
                <button class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                    <i class="fas fa-ban me-1"></i>Withdraw
                </button>
            }

            @if (Model.Status == RIApplicationStatus.Suspended)
            {
                <form asp-action="Transition" method="post" class="d-inline"
                      onsubmit="return confirm('Reinstate @Model.RINumber and re-open it for review?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="UnderReview" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-play-circle me-1"></i>Reinstate (Re-review)
                    </button>
                </form>
                <button type="button" class="btn btn-sm btn-outline-dark" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                    <i class="fas fa-ban me-1"></i>Withdraw
                </button>
            }

            @if (Model.Status == RIApplicationStatus.VariationRequired)
            {
                <form asp-action="Transition" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="UnderReview" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-arrow-right me-1"></i>Back to Under Review
                    </button>
                </form>
            }

            @if (Model.Status == RIApplicationStatus.RenewalDue)
            {
                <form asp-action="Transition" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="Submitted" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-paper-plane me-1"></i>Submit Renewal
                    </button>
                </form>
            }
        </div>
    </div>
}

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ApproveApplication" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="approveModalLabel"><i class="fas fa-check-circle me-2"></i>Approve Application</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Enter your credentials to approve <strong>@Model.RINumber</strong>.</p>
                    @if (Model.IsConditionalApproval)
                    {
                        <div class="alert alert-info small">
                            <i class="fas fa-info-circle me-1"></i>
                            <strong>Conditional Approval</strong> flag is set — status will be set to <strong>Conditions Active</strong>. All conditions must be closed before transitioning to full Approval.
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="pwd" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="fas fa-check me-1"></i>Confirm Approval</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
