        <h6 class="mb-3"><i class="fas fa-id-card me-1 text-success"></i>Linked Licences &amp; Certifications</h6>
        @if (!lcDeps.Any())
        {
            <div class="text-muted">No licence/certification records linked to this application.</div>
            <div class="mt-2 small text-muted">To link a record, open the LC record and use the <strong>Dependencies</strong> tab.</div>
        }
        else
        {
            <table class="table table-sm table-hover">
                <thead class="table-light">
                    <tr>
                        <th>LC Number</th>
                        <th>Category</th>
                        <th>Licence Type</th>
                        <th>Status</th>
                        <th>Expiry</th>
                        <th>Notes</th>
                        <th>Linked Since</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var dep in lcDeps)
                {
                    var r = dep.Record;
                    string lcBadge = r.Status switch {
                        OpenQMS.Models.LC.LCStatus.IssuedActive     => "bg-success",
                        OpenQMS.Models.LC.LCStatus.ConditionsApplied => "bg-success",
                        OpenQMS.Models.LC.LCStatus.RenewalDue       => "bg-warning text-dark",
                        OpenQMS.Models.LC.LCStatus.Expired          => "bg-danger",
                        OpenQMS.Models.LC.LCStatus.Suspended        => "bg-warning text-dark",
                        OpenQMS.Models.LC.LCStatus.Withdrawn        => "bg-secondary",
