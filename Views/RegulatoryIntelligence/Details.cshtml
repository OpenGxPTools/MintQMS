    <!-- Tab 8: Audit Log -->
    <div class="tab-pane fade" id="dtab8" role="tabpanel">
        @if (Model.AuditLogs?.Any() == true)
        {
            <table class="table table-sm table-hover">
                <thead class="table-light"><tr><th>Timestamp <span class="fw-normal text-muted">(@SiteTime.Label)</span></th><th>Action</th><th>Field</th><th>From</th><th>To</th><th>User</th><th>Notes</th></tr></thead>
                <tbody>
                    @foreach (var log in Model.AuditLogs)
                    {
                        <tr>
                            <td class="small text-muted">@log.Timestamp.ToSite().ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="badge bg-secondary">@log.Action</span></td>
                            <td class="small">@log.FieldChanged</td>
                            <td class="small text-muted">@log.OldValue</td>
                            <td class="small">@log.NewValue</td>
                            <td class="small">@log.UserId</td>
                            <td class="small text-muted">@log.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <div class="text-muted">No audit log entries.</div> }
    </div>

    <!-- Tab: Approval History -->
    <div class="tab-pane fade" id="dtabHistory" role="tabpanel">
        @if (Model.ApprovalSnapshots?.Any() != true)
        {
            <p class="text-muted">No approval cycles recorded yet. A snapshot is captured automatically each time this application is transitioned to <strong>Approved</strong>.</p>
        }
        else
        {
            @foreach (var snap in Model.ApprovalSnapshots.OrderByDescending(s => s.RenewalCycle))
            {
                var data = System.Text.Json.JsonDocument.Parse(snap.SnapshotJson).RootElement;

                // Returns the string value of a snapshot property, or null when absent/empty.
                Func<System.Text.Json.JsonElement, string, string?> getVal = (el, key) =>
                    el.TryGetProperty(key, out var p) && p.ValueKind != System.Text.Json.JsonValueKind.Null
                        ? (string.IsNullOrWhiteSpace(p.ToString()) ? null : p.ToString())
                        : null;

                // Field layout grouped to mirror the application's tabs. Only populated fields render.
                var riSections = new (string Title, (string Label, string Key)[] Fields)[]
                {
                    ("Product & Identification", new [] { ("RI Number","RINumber"), ("Product Name","ProductName"), ("Active Substance","ActiveSubstance"), ("Indication","Indication"), ("Dosage Form","DosageForm"), ("Strength","Strength"), ("Jurisdiction","Jurisdiction"), ("Application Type","ApplicationType") }),
                    ("Authority", new [] { ("Authority Reference","AuthorityReferenceNumber"), ("Submission Method","SubmissionMethod") }),
                    ("Priority / Expedited", new [] { ("Orphan Designation","IsOrphanDesignation"), ("Priority Review","IsPriorityReview"), ("Breakthrough Therapy","IsBreakthroughTherapy"), ("PRIME","IsPRIME"), ("Conditional Approval","IsConditionalApproval") }),
                    ("Key Dates", new [] { ("Strategy Start","StrategyStartDate"), ("Pre-Sub Meeting","PreSubMeetingDate"), ("Dossier Lock","DossierLockDate"), ("Submission Date","SubmissionDate"), ("Acknowledgement","AcknowledgementDate"), ("Day 0","Day0Date"), ("Target Decision","TargetDecisionDate"), ("Actual Decision","ActualDecisionDate"), ("Approval Date","ApprovalDate"), ("Expiry Date","ExpiryDate"), ("Next Renewal Due","NextRenewalDue"), ("Appeal Deadline","AppealDeadline") }),
                    ("Fees", new [] { ("Application Fee","ApplicationFee"), ("Fee Currency","FeeCurrency"), ("Fee Paid Date","FeePaidDate"), ("Fee Waiver Applied","FeeWaiverApplied"), ("Fee Waiver Reason","FeeWaiverReason") }),
                    ("Contacts", new [] { ("Internal RA Lead","InternalRALead"), ("External Consultant","ExternalConsultant"), ("Authority Rapporteur","AuthorityRapporteur"), ("Authority Contact Email","AuthorityContactEmail") }),
                    ("Notes", new [] { ("Strategy Notes","StrategyNotes"), ("Rejection Reason","RejectionReason"), ("Withdrawal Reason","WithdrawalReason") }),
                };

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-bold"><i class="fas fa-check-circle text-success me-2"></i>Cycle @snap.RenewalCycle</span>
                        <small class="text-muted">Approved @snap.TakenAt.ToSite().ToString("dd MMM yyyy HH:mm") UTC</small>
                    </div>
                    <div class="card-body">
                        @foreach (var grp in riSections)
                        {
                            var pairs = grp.Fields
                                .Select(f => (f.Label, Val: getVal(data, f.Key)))
                                .Where(x => !string.IsNullOrEmpty(x.Val))
                                .ToList();
                            if (pairs.Any())
                            {
                                <h6 class="small text-uppercase text-muted border-bottom pb-1 mb-2">@grp.Title</h6>
                                <div class="row g-2 mb-3">
                                    @foreach (var p in pairs)
                                    {
                                        <div class="col-md-3"><small class="text-muted d-block">@p.Label</small><span class="text-wrap">@p.Val</span></div>
                                    }
                                </div>
                            }
                        }

                        @if (data.TryGetProperty("Documents", out var docArr) && docArr.GetArrayLength() > 0)
                        {
                            <h6 class="small text-uppercase text-muted mb-1">Documents at Approval</h6>
                            <table class="table table-sm table-bordered mb-2">
                                <thead class="table-light"><tr><th>File Name</th><th>Type</th><th>SHA-256</th></tr></thead>
                                <tbody>
                                    @foreach (var doc in docArr.EnumerateArray())
                                    {
                                        <tr>
                                            <td>@(doc.TryGetProperty("FileName", out var fn) ? fn.GetString() : "—")</td>
                                            <td><span class="badge bg-light text-dark border small">@(doc.TryGetProperty("DocumentType", out var dt) ? dt.GetString() : "—")</span></td>
                                            <td><code class="small text-muted">@(doc.TryGetProperty("FileHash", out var fh) && fh.ValueKind != System.Text.Json.JsonValueKind.Null ? fh.GetString()?[..Math.Min(16, fh.GetString()?.Length ?? 0)] + "…" : "—")</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (data.TryGetProperty("Conditions", out var condArr) && condArr.GetArrayLength() > 0)
                        {
                            <h6 class="small text-uppercase text-muted mb-1">Conditions at Approval</h6>
                            <ul class="list-unstyled mb-0">
                                @foreach (var cond in condArr.EnumerateArray())
                                {
                                    <li class="small"><i class="fas fa-circle text-muted me-1" style="font-size:0.5em;vertical-align:middle"></i>
                                        @(cond.TryGetProperty("ConditionDescription", out var cd) ? cd.GetString() : "")
                                        <span class="badge bg-light text-dark border ms-1">@(cond.TryGetProperty("Status", out var cs) ? cs.GetString() : "")</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        }
    </div>

</div>

<!-- ── Add Condition Modal ───────────────────────────────────────────── -->
<div class="modal fade" id="addConditionModal" tabindex="-1" aria-hidden="true">
