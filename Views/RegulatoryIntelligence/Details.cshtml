                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Add Condition</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Edit Condition Modal ──────────────────────────────────────────── -->
<div class="modal fade" id="editConditionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateCondition" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editConditionId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-edit me-2 text-primary"></i>Edit Condition</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
