        <div class="d-flex justify-content-end mb-3">
            <a asp-action="CreateAccessPathway" asp-route-applicationId="@Model.Id" class="btn btn-sm btn-primary">
                <i class="fas fa-plus me-1"></i>New Access Pathway
            </a>
        </div>

        @if (Model.AccessPathways?.Any() == true)
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>AP Number</th>
                            <th>Type</th>
                            <th>Patient ID</th>
                            <th>Status</th>
                            <th>Approval</th>
                            <th>Expiry</th>
                            <th>Next Report Due</th>
                            <th class="text-center">AE Rep.</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ap in Model.AccessPathways.OrderByDescending(x => x.CreatedAt))
                        {
                            bool apExpired      = ap.ExpiryDate.HasValue && ap.ExpiryDate < SiteTime.Today;
                            bool reportOverdue  = ap.NextSixMonthlyReportDue.HasValue && ap.NextSixMonthlyReportDue < SiteTime.Today;
                            string apStatusBadge = ap.Status switch
                            {
                                RIAccessPathwayStatus.Active    => "success",
                                RIAccessPathwayStatus.Approved  => "success",
                                RIAccessPathwayStatus.Rejected  => "danger",
                                RIAccessPathwayStatus.Closed    => "dark",
                                RIAccessPathwayStatus.Submitted => "primary",
                                _ => "secondary"
                            };
                            <tr class="@(apExpired ? "table-warning" : "")">
                                <td>
                                    <a asp-action="AccessPathwayDetails" asp-route-id="@ap.Id" class="fw-semibold">@ap.AccessNumber</a>
                                </td>
                                <td><span class="badge bg-info text-dark">@ap.PathwayType</span></td>
                                <td class="small">@(ap.PatientIdentifier ?? "—")</td>
                                <td><span class="badge bg-@apStatusBadge">@ap.Status</span></td>
                                <td class="small">@(ap.ApprovalDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="small @(apExpired ? "text-danger fw-bold" : "")">@(ap.ExpiryDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="small @(reportOverdue ? "text-warning fw-bold" : "")">@(ap.NextSixMonthlyReportDue?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="text-center">
                                    @if (ap.AEReportingRequired) { <span class="badge bg-warning text-dark">Yes</span> }
                                    else { <span class="text-muted">No</span> }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="AccessPathwayDetails" asp-route-id="@ap.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye me-1"></i>View
                                    </a>
                                    <a asp-action="EditAccessPathway" asp-route-id="@ap.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </a>
                                    <form asp-action="DeleteAccessPathway" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete access pathway @ap.AccessNumber?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@ap.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-muted text-center py-4">
                <i class="fas fa-user-shield fa-2x mb-2 d-block text-secondary"></i>
                No access pathway records. Click <strong>New Access Pathway</strong> to add one.
            </div>
        }
    </div>

    <!-- Tab Milestones: Milestone Tracking -->
    <div class="tab-pane fade" id="dtabMilestones" role="tabpanel">
        @{
            var milestones  = Model.Milestones?.OrderBy(m => m.PlannedDate ?? DateTime.MaxValue).ToList() ?? new();
            var msTotal     = milestones.Count;
            var msDone      = milestones.Count(m => m.Status == RIMilestoneStatus.Completed || m.Status == RIMilestoneStatus.Skipped);
            int pct         = msTotal > 0 ? (int)Math.Round(msDone * 100.0 / msTotal) : 0;
        }

        <!-- Toolbar -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                @if (msTotal > 0)
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="progress flex-grow-1" style="height:18px;min-width:180px;" title="@msDone of @msTotal milestones complete">
                            <div class="progress-bar @(pct == 100 ? "bg-success" : "bg-primary")"
                                 role="progressbar" style="width:@pct%">@pct%</div>
                        </div>
                        <span class="text-muted small">@msDone / @msTotal milestones complete</span>
                    </div>
                }
            </div>
            <div class="d-flex gap-2">
                @if (!milestones.Any())
                {
                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#applyTemplateModal">
                        <i class="fas fa-magic me-1"></i>Apply Standard Template
                    </button>
                }
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addMilestoneModal">
                    <i class="fas fa-plus me-1"></i>Add Milestone
                </button>
            </div>
        </div>

        @if (milestones.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:30px">#</th>
                            <th>Milestone</th>
                            <th>Planned Date</th>
                            <th>Actual Date</th>
                            <th>Status</th>
                            <th>Clock Stop</th>
                            <th>Notes</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int msIdx = 0; }
                        @foreach (var m in milestones)
                        {
                            msIdx++;
                            bool isEffectivelyOverdue = (m.Status == RIMilestoneStatus.Overdue) ||
                                (m.Status == RIMilestoneStatus.Pending && m.PlannedDate.HasValue && m.PlannedDate < SiteTime.Today);
                            string rowCss = isEffectivelyOverdue ? "table-danger" :
                                            m.Status == RIMilestoneStatus.Completed ? "table-success" :
                                            m.Status == RIMilestoneStatus.Skipped   ? "table-secondary" : "";
                            string msBadge = m.Status switch
                            {
                                RIMilestoneStatus.Pending    => "secondary",
                                RIMilestoneStatus.InProgress => "primary",
                                RIMilestoneStatus.Completed  => "success",
                                RIMilestoneStatus.Overdue    => "danger",
                                RIMilestoneStatus.Skipped    => "dark",
                                _                            => "secondary"
                            };
                            string statusLabel = isEffectivelyOverdue && m.Status == RIMilestoneStatus.Pending
                                ? "Overdue" : m.Status.ToString();
                            <tr class="@rowCss">
                                <td class="text-muted small">@msIdx</td>
                                <td>
                                    @m.MilestoneName
                                    @if (m.IsClockStop) { <span class="badge bg-warning text-dark ms-1" title="Clock-stop milestone"><i class="fas fa-pause"></i></span> }
                                </td>
                                <td class="@(isEffectivelyOverdue ? "text-danger fw-bold" : "")">
                                    @(m.PlannedDate?.ToString("dd MMM yyyy") ?? "—")
                                </td>
                                <td>@(m.ActualDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td><span class="badge bg-@msBadge">@statusLabel</span></td>
                                <td class="text-center">
                                    @if (m.IsClockStop)
                                    {
                                        <i class="fas fa-pause text-warning" title="Clock-stop milestone"></i>
                                        @if (m.ClockRestartDate.HasValue)
                                        {
                                            <span class="small text-muted d-block">Restart: @m.ClockRestartDate.Value.ToString("dd MMM yyyy")</span>
                                        }
                                    }
                                </td>
                                <td class="small text-muted">@(m.Notes ?? "—")</td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary edit-milestone-btn"
                                            data-bs-toggle="modal" data-bs-target="#editMilestoneModal"
                                            data-id="@m.Id"
                                            data-name="@m.MilestoneName"
                                            data-planned="@(m.PlannedDate?.ToString("yyyy-MM-dd") ?? "")"
                                            data-actual="@(m.ActualDate?.ToString("yyyy-MM-dd") ?? "")"
                                            data-status="@((int)m.Status)"
                                            data-clockstop="@(m.IsClockStop ? "true" : "false")"
                                            data-clockrestart="@(m.ClockRestartDate?.ToString("yyyy-MM-dd") ?? "")"
                                            data-notes="@(m.Notes ?? "")">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </button>
                                    <form asp-action="DeleteMilestone" method="post" class="d-inline ms-1"
                                          onsubmit="return confirm('Delete this milestone?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-muted text-center py-4">
                <i class="fas fa-tasks fa-2x mb-2 d-block text-secondary"></i>
                No milestones recorded. Use <strong>Apply Standard Template</strong> for a jurisdiction-specific set,
                or <strong>Add Milestone</strong> to add manually.
            </div>
        }
    </div>

    <!-- LC Dependencies Tab -->
