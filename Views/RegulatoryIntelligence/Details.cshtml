    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="WithdrawApplication" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="withdrawModalLabel"><i class="fas fa-ban me-2"></i>Withdraw Application</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Enter your credentials and withdrawal reason for <strong>@Model.RINumber</strong>.</p>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="pwd" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Withdrawal Reason <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" required placeholder="State the reason for withdrawal..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark"><i class="fas fa-ban me-1"></i>Confirm Withdrawal</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Suspend Modal (password-gated, reason required) -->
<div class="modal fade" id="suspendModal" tabindex="-1" aria-labelledby="suspendModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SuspendApplication" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="suspendModalLabel"><i class="fas fa-pause-circle me-2"></i>Suspend Authorisation</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>This will mark <strong>@Model.RINumber</strong> as <strong class="text-danger">Suspended</strong> and lock the record. Enter your credentials and the suspension reason.</p>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="pwd" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Suspension Reason <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" required placeholder="State the reason for suspension..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-pause-circle me-1"></i>Confirm Suspension</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Initiate Renewal Modal (early / unscheduled renewal, reason required) ── -->
<div class="modal fade" id="initiateRenewalModal" tabindex="-1" aria-labelledby="initiateRenewalModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="InitiateRenewal" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-warning">
                    <h5 class="modal-title" id="initiateRenewalModalLabel"><i class="fas fa-sync me-2"></i>Initiate Renewal Now</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>This will move <strong>@Model.RINumber</strong> to <strong class="text-warning-emphasis">Renewal Due</strong> so the renewal submission can be progressed.</p>
                    @if (Model.NextRenewalDue.HasValue || Model.ExpiryDate.HasValue)
                    {
                        var refDate = Model.NextRenewalDue ?? Model.ExpiryDate;
                        <div class="alert alert-info small mb-3">
                            <i class="fas fa-info-circle me-1"></i>Renewal is otherwise tracked against @(Model.NextRenewalDue.HasValue ? "next renewal due" : "expiry") (@refDate!.Value.ToString("dd MMM yyyy")). Use this to start the renewal early.
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label fw-bold">Reason for early renewal <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" required placeholder="e.g. authority advised early resubmission, scheduling ahead of expiry, change in product details..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning"><i class="fas fa-sync me-1"></i>Initiate Renewal</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Upcoming Alerts -->
@{
    var upcomingAlerts = new List<(string Level, string Icon, string Message)>();

    if (Model.TargetDecisionDate.HasValue && Model.Status == RIApplicationStatus.UnderReview)
    {
        int tdDays = (Model.TargetDecisionDate.Value.Date - SiteTime.Today).Days;
        if (tdDays < 0)
            upcomingAlerts.Add(("danger", "fa-clock", $"Target decision date was {Math.Abs(tdDays)} day(s) ago ({Model.TargetDecisionDate.Value:dd MMM yyyy}). Review is overdue."));
        else if (tdDays <= 30)
            upcomingAlerts.Add(("warning", "fa-clock", $"Target decision date in {tdDays} day(s) ({Model.TargetDecisionDate.Value:dd MMM yyyy})."));
    }

    if (Model.ExpiryDate.HasValue && (Model.Status == RIApplicationStatus.Approved || Model.Status == RIApplicationStatus.ConditionsActive))
    {
        int exDays = (Model.ExpiryDate.Value.Date - SiteTime.Today).Days;
        if (exDays < 0)
            upcomingAlerts.Add(("danger", "fa-calendar-times", $"Authorisation expired {Math.Abs(exDays)} day(s) ago ({Model.ExpiryDate.Value:dd MMM yyyy}). Initiate renewal immediately."));
        else if (exDays <= 90)
            upcomingAlerts.Add(("warning", "fa-calendar-alt", $"Authorisation expires in {exDays} day(s) ({Model.ExpiryDate.Value:dd MMM yyyy}). Consider initiating renewal."));
    }

    int overdueCondCount = Model.Conditions?.Count(c => c.Status == RIConditionStatus.Outstanding && c.DueDate.HasValue && c.DueDate < SiteTime.Today) ?? 0;
    if (overdueCondCount > 0)
        upcomingAlerts.Add(("danger", "fa-clipboard-list", $"{overdueCondCount} condition(s) of approval are overdue."));

    int dueSoonCondCount = Model.Conditions?.Count(c => c.Status == RIConditionStatus.Outstanding && c.DueDate.HasValue && c.DueDate >= SiteTime.Today && c.DueDate <= SiteTime.Today.AddDays(30)) ?? 0;
    if (dueSoonCondCount > 0)
        upcomingAlerts.Add(("warning", "fa-clipboard-check", $"{dueSoonCondCount} condition(s) due within 30 days."));

    int apExpiring = Model.AccessPathways?.Count(ap => ap.ExpiryDate.HasValue && ap.ExpiryDate.Value.Date >= SiteTime.Today && ap.ExpiryDate.Value.Date <= SiteTime.Today.AddDays(60)) ?? 0;
    if (apExpiring > 0)
        upcomingAlerts.Add(("warning", "fa-user-shield", $"{apExpiring} access pathway(s) expiring within 60 days."));

    int reportsOverdue = Model.AccessPathways?.Count(ap => ap.NextSixMonthlyReportDue.HasValue && ap.NextSixMonthlyReportDue < SiteTime.Today) ?? 0;
    if (reportsOverdue > 0)
        upcomingAlerts.Add(("danger", "fa-chart-bar", $"{reportsOverdue} access pathway(s) have overdue six-monthly supply reports."));
}
@if (upcomingAlerts.Any())
{
    <div class="card border-warning mb-3">
        <div class="card-header py-2 bg-warning bg-opacity-10 text-warning fw-semibold small">
            <i class="fas fa-bell me-1"></i>Upcoming Deadlines &amp; Alerts
        </div>
        <div class="card-body py-2 px-3">
            @foreach (var (level, icon, message) in upcomingAlerts)
            {
                <div class="d-flex align-items-center gap-2 py-1 border-bottom border-light">
                    <i class="fas @icon text-@level"></i>
                    <span class="small text-@level">@message</span>
                </div>
            }
        </div>
    </div>
}

<!-- Tab Navigation -->
<ul class="nav nav-tabs mb-0" id="detailTabs" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#dtab1" type="button"><i class="fas fa-file-alt me-1"></i>Application</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtab2" type="button"><i class="fas fa-pills me-1"></i>Product</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtab3" type="button"><i class="fas fa-calendar-alt me-1"></i>Dates</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtab4" type="button"><i class="fas fa-dollar-sign me-1"></i>Fees</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtab5" type="button"><i class="fas fa-users me-1"></i>Contacts</button></li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtab6" type="button">
            <i class="fas fa-clipboard-check me-1"></i>Conditions
            @if (Model.Conditions?.Any(c => c.Status == RIConditionStatus.Outstanding) == true)
            {
                <span class="badge bg-danger ms-1">@Model.Conditions.Count(c => c.Status == RIConditionStatus.Outstanding)</span>
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtab7" type="button">
            <i class="fas fa-paperclip me-1"></i>Attachments
            @if (Model.Documents?.Any() == true) { <span class="badge bg-secondary ms-1">@Model.Documents.Count</span> }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtabVariations" type="button">
            <i class="fas fa-random me-1"></i>Variations
            @if (Model.Variations?.Any() == true)
            {
                var vApproved = Model.Variations.Count(v => v.Status == RIApplicationStatus.Approved);
                @if (vApproved > 0) { <span class="badge bg-success ms-1">@vApproved approved</span> }
                else { <span class="badge bg-secondary ms-1">@Model.Variations.Count</span> }
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtabPathways" type="button">
            <i class="fas fa-user-shield me-1"></i>Access Pathways
            @if (Model.AccessPathways?.Any() == true)
            {
                var expiredCount = Model.AccessPathways.Count(ap => ap.ExpiryDate.HasValue && ap.ExpiryDate < SiteTime.Today);
                @if (expiredCount > 0) { <span class="badge bg-danger ms-1">@expiredCount expired</span> }
                else { <span class="badge bg-secondary ms-1">@Model.AccessPathways.Count</span> }
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtabMilestones" type="button">
            <i class="fas fa-tasks me-1"></i>Milestones
            @{
                var mTotal     = Model.Milestones?.Count ?? 0;
                var mDone      = Model.Milestones?.Count(m => m.Status == RIMilestoneStatus.Completed || m.Status == RIMilestoneStatus.Skipped) ?? 0;
                var mOverdue   = Model.Milestones?.Count(m => m.Status == RIMilestoneStatus.Overdue ||
                                     (m.Status == RIMilestoneStatus.Pending && m.PlannedDate.HasValue && m.PlannedDate < SiteTime.Today)) ?? 0;
            }
            @if (mOverdue > 0)  { <span class="badge bg-danger ms-1">@mOverdue overdue</span> }
            else if (mTotal > 0){ <span class="badge bg-secondary ms-1">@mDone/@mTotal</span> }
        </button>
    </li>
    <li class="nav-item">
        @{
            var lcDeps = ViewBag.LinkedLCRecords as List<OpenQMS.Models.LC.LCDependency> ?? new List<OpenQMS.Models.LC.LCDependency>();
        }
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtabLicCert" type="button">
            <i class="fas fa-id-card me-1 text-success"></i>Licences &amp; Certs
            @if (lcDeps.Any()) { <span class="badge bg-success ms-1">@lcDeps.Count</span> }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtab8" type="button">
            <i class="fas fa-history me-1"></i>Audit Log
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#dtabHistory" type="button">
            <i class="fas fa-layer-group me-1"></i>Approval History
            @if (Model.ApprovalSnapshots?.Any() == true) { <span class="badge bg-secondary ms-1">@Model.ApprovalSnapshots.Count</span> }
        </button>
    </li>
</ul>

<div class="tab-content border border-top-0 rounded-bottom p-4 mb-3">

    <!-- Tab 1: Application Info -->
    <div class="tab-pane fade show active" id="dtab1" role="tabpanel">
        <div class="row g-3">
            <div class="col-md-3"><label class="text-muted small">RI Number</label><div class="fw-bold">@Model.RINumber</div></div>
            <div class="col-md-3"><label class="text-muted small">Jurisdiction</label><div>@Model.Jurisdiction?.Name (@Model.Jurisdiction?.Code)</div></div>
            <div class="col-md-3"><label class="text-muted small">Authority</label><div>@Model.Jurisdiction?.Authority</div></div>
            <div class="col-md-3"><label class="text-muted small">Application Type</label><div>@Model.ApplicationType?.Name</div></div>
            <div class="col-md-3"><label class="text-muted small">Submission Method</label><div>@(Model.SubmissionMethod ?? "—")</div></div>
            <div class="col-md-3"><label class="text-muted small">Authority Reference No.</label><div>@(Model.AuthorityReferenceNumber ?? "—")</div></div>
            <div class="col-md-6">
                <label class="text-muted small">Designations</label>
                <div class="d-flex flex-wrap gap-1">
                    @if (Model.IsOrphanDesignation)   { <span class="badge bg-info">Orphan</span> }
                    @if (Model.IsPriorityReview)      { <span class="badge bg-warning text-dark">Priority Review</span> }
                    @if (Model.IsBreakthroughTherapy) { <span class="badge bg-danger">Breakthrough Therapy</span> }
                    @if (Model.IsPRIME)               { <span class="badge bg-danger">PRIME</span> }
                    @if (Model.IsConditionalApproval) { <span class="badge bg-warning text-dark">Conditional Approval</span> }
                    @if (!Model.IsOrphanDesignation && !Model.IsPriorityReview && !Model.IsBreakthroughTherapy && !Model.IsPRIME && !Model.IsConditionalApproval) { <span class="text-muted">None</span> }
                </div>
            </div>
            <div class="col-md-3"><label class="text-muted small">Created By</label><div>@Model.CreatedBy</div></div>
            <div class="col-md-3"><label class="text-muted small">Created At</label><div>@Model.CreatedAt.ToSite().ToString("dd MMM yyyy HH:mm")</div></div>
            @if (Model.ModifiedBy != null)
            {
                <div class="col-md-3"><label class="text-muted small">Last Modified By</label><div>@Model.ModifiedBy</div></div>
                <div class="col-md-3"><label class="text-muted small">Last Modified</label><div>@Model.ModifiedAt.ToSite()?.ToString("dd MMM yyyy HH:mm")</div></div>
            }
        </div>
    </div>

    <!-- Tab 2: Product & Indication -->
    <div class="tab-pane fade" id="dtab2" role="tabpanel">
        <div class="row g-3">
            <div class="col-md-6"><label class="text-muted small">Product</label>
                <div>
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId">@Model.Product?.Name</a>
                </div>
            </div>
            <div class="col-md-6"><label class="text-muted small">Product Name (snapshot)</label><div>@Model.ProductName</div></div>
            <div class="col-md-4"><label class="text-muted small">Active Substance / INN</label><div>@(Model.ActiveSubstance ?? "—")</div></div>
            <div class="col-md-8"><label class="text-muted small">Indication</label><div>@(Model.Indication ?? "—")</div></div>
            <div class="col-md-4"><label class="text-muted small">Dosage Form</label><div>@(Model.DosageForm ?? "—")</div></div>
            <div class="col-md-4"><label class="text-muted small">Strength</label><div>@(Model.Strength ?? "—")</div></div>
        </div>
    </div>

    <!-- Tab 3: Key Dates -->
    <div class="tab-pane fade" id="dtab3" role="tabpanel">
        <div class="row g-3">
            @{
                void DateRow(string label, DateTime? val, bool highlight = false)
                {
                    <div class="col-md-3">
                        <label class="text-muted small">@label</label>
                        <div class="@(highlight && val < SiteTime.Today ? "text-danger fw-bold" : "")">
                            @(val?.ToString("dd MMM yyyy") ?? "—")
                        </div>
                    </div>
                }
            }
            @{ DateRow("Strategy Start", Model.StrategyStartDate); }
            @{ DateRow("Pre-Submission Meeting", Model.PreSubMeetingDate); }
            @{ DateRow("Dossier Lock Date", Model.DossierLockDate); }
            @{ DateRow("Submission Date", Model.SubmissionDate); }
            @{ DateRow("Acknowledgement Date", Model.AcknowledgementDate); }
            @{ DateRow("Day 0 (Clock Start)", Model.Day0Date); }
            @{ DateRow("Target Decision Date", Model.TargetDecisionDate, highlight: true); }
            @{ DateRow("Actual Decision Date", Model.ActualDecisionDate); }
            @{ DateRow("Approval Date", Model.ApprovalDate); }
            @{ DateRow("Expiry Date", Model.ExpiryDate, highlight: true); }
            @{ DateRow("Next Renewal Due", Model.NextRenewalDue, highlight: true); }
            @{ DateRow("Appeal Deadline", Model.AppealDeadline, highlight: true); }
        </div>
        @if (Model.ApplicationType?.ClockDays.HasValue == true)
        {
            <div class="mt-3 alert alert-light">
                <i class="fas fa-clock me-1"></i>Regulatory clock: <strong>@Model.ApplicationType.ClockDays working days</strong> from Day 0.
            </div>
        }
    </div>

    <!-- Tab 4: Fees -->
    <div class="tab-pane fade" id="dtab4" role="tabpanel">
        <div class="row g-3">
            <div class="col-md-3"><label class="text-muted small">Application Fee</label>
                <div>@(Model.ApplicationFee.HasValue ? $"{Model.FeeCurrency} {Model.ApplicationFee:N2}" : "—")</div>
            </div>
            <div class="col-md-3"><label class="text-muted small">Fee Paid Date</label><div>@(Model.FeePaidDate?.ToString("dd MMM yyyy") ?? "—")</div></div>
            <div class="col-md-3"><label class="text-muted small">Fee Waiver</label>
                <div>@(Model.FeeWaiverApplied ? "Yes — " + (Model.FeeWaiverReason ?? "") : "No")</div>
            </div>
        </div>
    </div>

    <!-- Tab 5: Contacts & Strategy -->
    <div class="tab-pane fade" id="dtab5" role="tabpanel">
        <div class="row g-3">
            <div class="col-md-6"><label class="text-muted small">Internal RA Lead</label><div>@(ViewData["RALeadName"] as string ?? Model.InternalRALead ?? "—")</div></div>
            <div class="col-md-6"><label class="text-muted small">External RA Consultant</label><div>@(Model.ExternalConsultant ?? "—")</div></div>
            <div class="col-md-6"><label class="text-muted small">Authority Rapporteur / PM</label><div>@(Model.AuthorityRapporteur ?? "—")</div></div>
            <div class="col-md-6"><label class="text-muted small">Authority Contact Email</label>
                <div>@(Model.AuthorityContactEmail != null ? Model.AuthorityContactEmail : "—")</div>
            </div>
            <div class="col-md-6"><label class="text-muted small">Manufacturing Supplier</label>
                <div>
                    @if (Model.ManufacturingSupplierId.HasValue && supplierName != null)
                    {
                        <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.ManufacturingSupplierId">@supplierName</a>
                    }
                    else { <span>—</span> }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.StrategyNotes))
            {
                <div class="col-12"><label class="text-muted small">Strategy Notes</label>
                    <div class="border rounded p-2 bg-light" style="white-space:pre-wrap">@Model.StrategyNotes</div>
                </div>
            }
        </div>
    </div>

    <!-- Tab 6: Conditions of Approval -->
    <div class="tab-pane fade" id="dtab6" role="tabpanel">
        @if (!isTerminal)
        {
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addConditionModal">
                    <i class="fas fa-plus me-1"></i>Add Condition
                </button>
            </div>
        }

        @if (Model.Conditions?.Any() == true)
        {
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr><th>Condition</th><th>Type</th><th>Due Date</th><th>Status</th><th>CAPA</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Conditions.OrderBy(x => x.DueDate))
                    {
                        bool cOverdue    = c.Status == RIConditionStatus.Outstanding && c.DueDate.HasValue && c.DueDate < SiteTime.Today;
                        bool cDueSoon    = !cOverdue && c.DueDate.HasValue && c.DueDate < SiteTime.Today.AddDays(30);
                        bool canClose    = c.Status != RIConditionStatus.Closed && c.Status != RIConditionStatus.Waived;
                        string cBadge   = c.Status switch
                        {
                            RIConditionStatus.Outstanding => "danger",
                            RIConditionStatus.InProgress  => "warning",
                            RIConditionStatus.Submitted   => "primary",
                            RIConditionStatus.Closed      => "success",
                            RIConditionStatus.Waived      => "secondary",
                            _                             => "secondary"
                        };
                        <tr class="@(cOverdue ? "table-danger" : "")">
                            <td>@c.ConditionDescription
                                @if (!string.IsNullOrEmpty(c.CompletionNotes))
                                {
                                    <div class="small text-muted fst-italic mt-1">@c.CompletionNotes</div>
                                }
                            </td>
                            <td><span class="badge bg-secondary">@c.ConditionType</span></td>
                            <td class="@(cOverdue ? "text-danger fw-bold" : cDueSoon ? "text-warning fw-bold" : "")">
                                @(c.DueDate?.ToString("dd MMM yyyy") ?? "—")
                                @if (c.CompletedDate.HasValue) { <div class="small text-success">Closed: @c.CompletedDate.Value.ToString("dd MMM yyyy")</div> }
                            </td>
                            <td><span class="badge bg-@cBadge">@EnumHelper.Display(c.Status)</span></td>
                            <td>
                                @if (c.LinkedCAPAId.HasValue)
                                {
                                    <a asp-controller="Capas" asp-action="Details" asp-route-id="@c.LinkedCAPAId" class="btn btn-xs btn-sm btn-outline-info py-0">CAPA #@c.LinkedCAPAId</a>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (!isTerminal)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary edit-condition-btn"
                                            data-bs-toggle="modal" data-bs-target="#editConditionModal"
                                            data-id="@c.Id"
                                            data-desc="@c.ConditionDescription"
                                            data-type="@((int)c.ConditionType)"
                                            data-due="@(c.DueDate?.ToString("yyyy-MM-dd") ?? "")"
                                            data-status="@((int)c.Status)">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </button>
                                    @if (canClose)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success ms-1 close-condition-btn"
                                                data-bs-toggle="modal" data-bs-target="#closeConditionModal"
                                                data-id="@c.Id"
                                                data-desc="@c.ConditionDescription">
                                            <i class="fas fa-check me-1"></i>Close
                                        </button>
                                    }
                                    @if (!c.LinkedCAPAId.HasValue)
                                    {
                                        <form asp-action="CreateCAPAFromCondition" method="post" class="d-inline ms-1"
                                              onsubmit="return confirm('Create a CAPA from this condition?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="conditionId" value="@c.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-info">
                                                <i class="fas fa-tasks me-1"></i>Raise CAPA
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="DeleteCondition" method="post" class="d-inline ms-1"
                                          onsubmit="return confirm('Delete this condition?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.Status == RIApplicationStatus.ConditionsActive)
            {
                var openRemaining = Model.Conditions.Count(c => c.Status != RIConditionStatus.Closed && c.Status != RIConditionStatus.Waived);
                <div class="alert alert-@(openRemaining == 0 ? "success" : "info") small mt-2 mb-0">
                    <i class="fas fa-info-circle me-1"></i>
                    @if (openRemaining == 0)
                    {
                        <span>All conditions are satisfied. Application will auto-transition to <strong>Approved</strong> when the final condition is closed.</span>
                    }
                    else
                    {
                        <span><strong>@openRemaining</strong> open condition(s) remaining before auto-transition to Approved.</span>
                    }
                </div>
            }
        }
        else
        {
            <div class="text-muted">No conditions of approval on record.</div>
        }

        @if (Model.RejectionReason != null) { <div class="alert alert-danger mt-3"><strong>Rejection Reason:</strong> @Model.RejectionReason</div> }
        @if (Model.WithdrawalReason != null) { <div class="alert alert-warning mt-3"><strong>Withdrawal Reason:</strong> @Model.WithdrawalReason</div> }
        @if (Model.SuspensionReason != null) { <div class="alert alert-danger mt-3"><strong>Suspension Reason:</strong> @Model.SuspensionReason @(Model.SuspendedOn.HasValue ? $"(suspended {Model.SuspendedOn.Value:dd MMM yyyy})" : "")</div> }
    </div>

    <!-- Tab 7: Documents -->
    <div class="tab-pane fade" id="dtab7" role="tabpanel">
        @{
            var riPendingDocs = Model.Documents?.Where(d => d.ApprovalCycle == null).OrderByDescending(d => d.UploadedAt).ToList() ?? new List<OpenQMS.Models.RI.RIDocument>();
            var riCycleGroups = Model.Documents?.Where(d => d.ApprovalCycle != null)
                .GroupBy(d => d.ApprovalCycle!.Value)
                .OrderByDescending(g => g.Key)
                .ToList() ?? new List<IGrouping<int, OpenQMS.Models.RI.RIDocument>>();
        }

        @if (!riPendingDocs.Any() && !riCycleGroups.Any())
        {
            <div class="text-muted mb-3">No documents uploaded.</div>
        }

        @if (riPendingDocs.Any())
        {
            <h6 class="text-uppercase small text-muted mt-2 mb-1">Current (Pending Approval)</h6>
            <table class="table table-sm table-hover mb-3">
                <thead class="table-light"><tr><th>File Name</th><th>Type</th><th>Size</th><th>Version</th><th>Uploaded</th><th></th></tr></thead>
                <tbody>
                    @foreach (var doc in riPendingDocs)
                    {
                        <tr>
                            <td><i class="fas fa-file me-1 text-muted"></i>@doc.FileName</td>
                            <td>@(doc.DocumentType ?? "—")</td>
                            <td class="text-muted small">@($"{doc.FileSizeBytes / 1024.0:N0} KB")</td>
                            <td>v@(doc.Version)</td>
                            <td>@doc.UploadedAt.ToSite().ToString("dd MMM yyyy") <span class="text-muted small">@doc.UploadedBy</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="DownloadDocument" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-download me-1"></i>Download
                                </a>
                                <form asp-action="DeleteDocument" method="post" class="d-inline" data-delete-reason="document">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@doc.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1"><i class="fas fa-trash me-1"></i>Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @foreach (var group in riCycleGroups)
        {
            var riSnap = Model.ApprovalSnapshots?.FirstOrDefault(s => s.RenewalCycle == group.Key);
            <h6 class="text-uppercase small text-muted mt-3 mb-1">
                <i class="fas fa-check-circle text-success me-1"></i>
                Cycle @group.Key
                @if (riSnap != null) { <span class="fw-normal">— Approved @riSnap.TakenAt.ToSite().ToString("dd MMM yyyy")</span> }
            </h6>
            <table class="table table-sm table-hover mb-3">
                <thead class="table-light"><tr><th>File Name</th><th>Type</th><th>Size</th><th>Version</th><th>Uploaded</th><th></th></tr></thead>
                <tbody>
                    @foreach (var doc in group.OrderByDescending(d => d.UploadedAt))
                    {
                        <tr>
                            <td><i class="fas fa-file me-1 text-muted"></i>@doc.FileName</td>
                            <td>@(doc.DocumentType ?? "—")</td>
                            <td class="text-muted small">@($"{doc.FileSizeBytes / 1024.0:N0} KB")</td>
                            <td>v@(doc.Version)</td>
                            <td>@doc.UploadedAt.ToSite().ToString("dd MMM yyyy") <span class="text-muted small">@doc.UploadedBy</span></td>
                            <td class="text-end"><a asp-action="DownloadDocument" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-secondary"><i class="fas fa-download me-1"></i>Download</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <partial name="_DeletedAttachments" model='new OpenQMS.Models.DeletedFilesView(ViewBag.DeletedFiles as IEnumerable<OpenQMS.Models.ISoftDeletedFile>, "DownloadDocument", Noun: "documents")' />

        @if (!Model.IsLocked)
        {
        <div class="border rounded p-3 bg-light">
            <h6><i class="fas fa-upload me-1"></i>Upload Document</h6>
            <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="applicationId" value="@Model.Id" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small">File</label>
                        <input type="file" name="file" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Document Type</label>
                        <select name="documentType" class="form-select form-select-sm">
                            <option value="">— Select Type —</option>
                            <option>eCTD Module</option>
                            <option>Approval Letter</option>
                            <option>PI (Product Information)</option>
                            <option>CMI (Consumer Medicine Information)</option>
                            <option>SmPC</option><option>REMS</option><option>RMP</option>
                            <option>Condition Letter</option>
                            <option>Assessment Report</option>
                            <option>Labelling</option><option>Other</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-sm btn-primary w-100">
                            <i class="fas fa-upload me-1"></i>Upload
                        </button>
                    </div>
                </div>
            </form>
        </div>
        }
    </div>

    <!-- Tab: Variations -->
    <div class="tab-pane fade" id="dtabVariations" role="tabpanel">
        @if (canVariate)
        {
            <div class="d-flex justify-content-end mb-3">
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addVariationModal">
                    <i class="fas fa-plus me-1"></i>Add Variation
                </button>
            </div>
        }
        else
        {
            <div class="alert alert-light border small mb-3">
                <i class="fas fa-info-circle me-1 text-muted"></i>Variations can only be raised once the application is approved.
            </div>
        }

        @if (Model.Variations?.Any() == true)
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Variation Number</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Approved</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Variations.OrderByDescending(x => x.CreatedAt))
                        {
                            string vBadge = v.Status switch
                            {
                                RIApplicationStatus.Approved          => "success",
                                RIApplicationStatus.ConditionsActive  => "success",
                                RIApplicationStatus.Rejected          => "danger",
                                RIApplicationStatus.Withdrawn         => "dark",
                                RIApplicationStatus.UnderReview       => "warning",
                                RIApplicationStatus.Submitted         => "primary",
                                _                                     => "secondary"
                            };
                            <tr>
                                <td class="fw-semibold small">@v.VariationNumber</td>
                                <td><span class="badge bg-info text-dark small">@v.VariationType</span></td>
                                <td class="small">@v.VariationDescription
                                    @if (!string.IsNullOrEmpty(v.Notes))
                                    {
                                        <div class="text-muted fst-italic mt-1">@v.Notes</div>
                                    }
                                </td>
                                <td><span class="badge bg-@vBadge">@EnumHelper.Display(v.Status)</span></td>
                                <td class="small">@(v.SubmissionDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="small">@(v.ApprovalDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="text-end text-nowrap">
                                    @if (!isTerminal)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary edit-variation-btn"
                                                data-bs-toggle="modal" data-bs-target="#editVariationModal"
                                                data-id="@v.Id"
                                                data-desc="@v.VariationDescription"
                                                data-type="@((int)v.VariationType)"
                                                data-status="@((int)v.Status)"
                                                data-submitted="@(v.SubmissionDate?.ToString("yyyy-MM-dd") ?? "")"
                                                data-approved="@(v.ApprovalDate?.ToString("yyyy-MM-dd") ?? "")"
                                                data-notes="@(v.Notes ?? "")">
                                            <i class="fas fa-edit me-1"></i>Edit
                                        </button>
                                        <form asp-action="DeleteVariation" method="post" class="d-inline ms-1"
                                              onsubmit="return confirm('Delete variation @v.VariationNumber?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@v.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash me-1"></i>Delete
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-muted text-center py-4">
                <i class="fas fa-random fa-2x mb-2 d-block text-secondary"></i>
                No variations recorded. Click <strong>Add Variation</strong> to log a post-approval variation application.
            </div>
        }
    </div>

    <!-- Tab: Access Pathways -->
