<div class="modal fade" id="applyTemplateModal" tabindex="-1" aria-labelledby="applyTemplateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ApplyMilestoneTemplate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="applicationId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title" id="applyTemplateModalLabel"><i class="fas fa-magic me-2 text-secondary"></i>Apply Standard Milestone Template</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>This will create standard milestones for <strong>@Model.Jurisdiction?.Authority</strong> based on the review timeline for <strong>@Model.ApplicationType?.Name</strong>.</p>
                    <div class="alert alert-info small">
                        <i class="fas fa-info-circle me-1"></i>
                        Milestone dates are calculated from <strong>Day 0 (@(Model.Day0Date?.ToString("dd MMM yyyy") ?? Model.SubmissionDate?.ToString("dd MMM yyyy") ?? "Submission Date"))</strong>.
                        You can edit individual milestone dates after applying the template.
                    </div>
                    <p class="text-muted small">This action is only available when no milestones exist.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-secondary"><i class="fas fa-magic me-1"></i>Apply Template</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Populate Edit Variation modal
    document.querySelectorAll('.edit-variation-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('editVariationId').value  = this.dataset.id;
            document.getElementById('editVarDesc').value      = this.dataset.desc;
            document.getElementById('editVarType').value      = this.dataset.type;
            document.getElementById('editVarStatus').value    = this.dataset.status;
            document.getElementById('editVarSubmitted').value = this.dataset.submitted;
            document.getElementById('editVarApproved').value  = this.dataset.approved;
            document.getElementById('editVarNotes').value     = this.dataset.notes;
        });
    });

    // Populate Edit Condition modal
    document.querySelectorAll('.edit-condition-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('editConditionId').value     = this.dataset.id;
            document.getElementById('editConditionDesc').value   = this.dataset.desc;
            document.getElementById('editConditionType').value   = this.dataset.type;
            document.getElementById('editConditionDue').value    = this.dataset.due;
            document.getElementById('editConditionStatus').value = this.dataset.status;
        });
    });

    // Populate Close Condition modal
    document.querySelectorAll('.close-condition-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('closeConditionId').value   = this.dataset.id;
            document.getElementById('closeConditionDesc').textContent = this.dataset.desc;
        });
    });

    // Populate Edit Milestone modal from data attributes
    document.querySelectorAll('.edit-milestone-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('editMilestoneId').value    = this.dataset.id;
            document.getElementById('editMilestoneName').value  = this.dataset.name;
            document.getElementById('editPlannedDate').value    = this.dataset.planned;
            document.getElementById('editActualDate').value     = this.dataset.actual;
            document.getElementById('editStatus').value         = this.dataset.status;
            document.getElementById('editIsClockStop').checked  = this.dataset.clockstop === 'true';
            document.getElementById('editClockRestartDate').value = this.dataset.clockrestart;
            document.getElementById('editNotes').value          = this.dataset.notes;
        });
    });

    // Auto-activate Milestones tab if URL hash matches
    if (window.location.hash === '#dtabMilestones') {
        var tab = document.querySelector('[data-bs-target="#dtabMilestones"]');
        if (tab) bootstrap.Tab.getOrCreateInstance(tab).show();
    }

    @if (TempData["ActiveTab"] != null)
    {
        <text>
        (function() {
            var tabId = @Json.Serialize(TempData["ActiveTab"]!.ToString());
            var el = document.querySelector('[data-bs-target="#' + tabId + '"]');
            if (el) bootstrap.Tab.getOrCreateInstance(el).show();
        })();
        </text>
    }
</script>
}
