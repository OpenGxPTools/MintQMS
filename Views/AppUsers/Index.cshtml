@using OpenQMS.Models.ViewModels
@model IEnumerable<UserRolesViewModel>

@{
    ViewData["Title"] = "Users";
}

<h4 class="mb-0">Users</h4>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
            <th>Roles</th>
            @if (User.IsInRole(Constants.AdministratorsRole) || User.IsInRole(Constants.QualityManagerRole) || User.IsInRole(Constants.RegulatoryManagerRole))
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UserName</td>
                <td>@item.Email</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </td>
                <td>
                    @if (item.Roles.Any())
                    {
                        @string.Join(", ", item.Roles.Select(r => EnumHelper.RoleName(r)))
                    }
                    else
                    {
                        <span class="text-muted fst-italic">No roles assigned</span>
                    }
                </td>
                @if (User.IsInRole(Constants.AdministratorsRole) || User.IsInRole(Constants.QualityManagerRole) || User.IsInRole(Constants.RegulatoryManagerRole))
                {
                    <td>
                        @if (User.IsInRole(Constants.AdministratorsRole))
                        {
                            <a asp-action="ManageRoles" asp-route-userId="@item.UserId" class="btn btn-sm btn-outline-secondary">Manage Roles</a>
                        }
                        <a asp-action="History" asp-route-userId="@item.UserId" class="btn btn-sm btn-outline-info ms-1">History</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@if (User.IsInRole(Constants.AdministratorsRole))
{
    <p>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary">Create New User</a>
    </p>
}