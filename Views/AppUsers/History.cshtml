@model IEnumerable<OpenQMS.Models.UserAuditLog>

@{
    ViewData["Title"] = "User Audit Log";
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">User Audit Log</h4>
        <p class="text-muted mb-0">@ViewBag.UserName &mdash; @ViewBag.Email</p>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Users</a>
</div>
<hr />

@if (!Model.Any())
{
    <p class="text-muted fst-italic">No audit log entries yet.</p>
}
else
{
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Date / Time (UTC)</th>
                <th>Action</th>
                <th>Detail</th>
                <th>Performed By</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model)
            {
                <tr>
                    <td>@entry.PerformedOn.ToSite().ToString("dd MMM yyyy HH:mm")</td>
                    <td>
                        @if (entry.Action == "User Created")
                        {
                            <span class="badge bg-success">@entry.Action</span>
                        }
                        else if (entry.Action == "Role Added")
                        {
                            <span class="badge bg-primary">@entry.Action</span>
                        }
                        else if (entry.Action == "Role Removed")
                        {
                            <span class="badge bg-warning text-dark">@entry.Action</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@entry.Action</span>
                        }
                    </td>
                    <td>
                        @if (entry.Action == "Role Added" || entry.Action == "Role Removed")
                        {
                            @EnumHelper.RoleName(entry.Detail)
                        }
                        else
                        {
                            @(entry.Detail ?? "-")
                        }
                    </td>
                    <td>@entry.PerformedBy</td>
                </tr>
            }
        </tbody>
    </table>
}
