@model OpenQMS.Models.Maintenance

@{
    ViewData["Title"] = "Delete Maintenance";

    var linkedDeviations = Model.LinkedDeviations?.Where(x => x.Deviation != null).ToList();
    var linkedCapas      = Model.LinkedCapas?.Where(x => x.Capa != null).ToList();
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">Delete Maintenance</h4>
    </div>
</div>
<hr />
<h5 class="text-danger">Are you sure you want to delete this maintenance record?</h5>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.MaintenanceId)</dt>
            <dd class="col-sm-8">@Model.MaintenanceId</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-8">@Model.Title</dd>
            <dt class="col-sm-4">Asset</dt>
            <dd class="col-sm-8">@Model.Asset?.Name</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Type)</dt>
            <dd class="col-sm-8">@Model.Type</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ScheduledDate)</dt>
            <dd class="col-sm-8">@Model.ScheduledDate.ToString("yyyy-MM-dd")</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Status)</dt>
            <dd class="col-sm-8">@EnumHelper.Display(Model.Status)</dd>
        </dl>

        @if (linkedDeviations?.Any() == true)
        {
            <h6 class="mt-3 text-uppercase small text-muted">Linked Deviations</h6>
            <table class="table table-sm">
                <thead><tr><th>ID</th><th>Title</th></tr></thead>
                <tbody>
                    @foreach (var x in linkedDeviations)
                    {
                        <tr>
                            <td><a asp-controller="Deviations" asp-action="Details" asp-route-id="@x.DeviationId">@x.Deviation!.DeviationId</a></td>
                            <td>@x.Deviation.Title</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (linkedCapas?.Any() == true)
        {
            <h6 class="mt-3 text-uppercase small text-muted">Linked CAPAs</h6>
            <table class="table table-sm">
                <thead><tr><th>ID</th><th>Title</th></tr></thead>
                <tbody>
                    @foreach (var x in linkedCapas)
                    {
                        <tr>
                            <td><a asp-controller="Capas" asp-action="Details" asp-route-id="@x.CapaId">@x.Capa!.CapaId</a></td>
                            <td>@x.Capa.Title</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-2">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Cancel</a>
    </div>
</form>
