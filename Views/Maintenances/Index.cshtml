@model IEnumerable<OpenQMS.Models.Maintenance>
@inject OpenQMS.Services.Workflow.TaskAssignmentService AssignSvc

@{
    var assignedMap = await AssignSvc.CurrentByRecordAsync("Maintenances");
    ViewData["MeId"] = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    ViewData["Title"] = L["Maintenances"].Value;
}

@section Scripts {
<script src="~/js/assigned-filter.js" asp-append-version="true"></script>
<script>
    $(document).ready(function () {
        var table = $('#maintenancesTable').DataTable({ stateSave: true,
            initComplete: function () {
                MintAssignedFilter(this.api());
                $('.status-filter').on('click', function () {
                    $('.status-filter').removeClass('active');
                    $(this).addClass('active');
                    var val = $(this).data('status');
                    table.column(5).search(val ? '^' + val + '$' : '', true, false).draw();
                });
                $('.status-filter[data-status=""]').addClass('active');
            },
            "columns": [
                null,
                null,
                null,
                { "visible": false },
                null,
                null,
                null,
                null
            ],
            paging: true,
            orderCellsTop: true,
            dom: 'lBfrtip',
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, @Json.Serialize(L["All"].Value)]],
            "order": [[0, 'asc']],
            displayLength: 10,
            buttons: [
                'colvis',
                {
                    extend: 'pdf',
                    footer: false,
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] }
                },
                {
                    extend: 'excel',
                    footer: false,
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] }
                }
            ]
        });
    });
</script>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@L["Maintenances"]</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>@L["Schedule Maintenance"]</a>
</div>
<hr />

<div class="mb-3 d-flex align-items-center gap-2 flex-wrap">
    <span class="text-muted small me-1">@L["Filter by status:"]</span>
    <button class="btn btn-outline-secondary btn-sm status-filter" data-status="">@L["All"]</button>
    <button class="btn btn-outline-secondary btn-sm status-filter" data-status="@L["Scheduled"]">@L["Scheduled"]</button>
    <button class="btn btn-outline-info btn-sm status-filter" data-status="@L["In Progress"]">@L["In Progress"]</button>
    <button class="btn btn-outline-warning btn-sm status-filter" data-status="@L["Completed"]">@L["Completed"]</button>
    <button class="btn btn-outline-success btn-sm status-filter" data-status="@L["Reviewed"]">@L["Reviewed"]</button>
    <button class="btn btn-outline-danger btn-sm status-filter" data-status="@L["Overdue"]">@L["Overdue"]</button>
    <button class="btn btn-outline-secondary btn-sm status-filter" data-status="@L["Suspended"]">@L["Suspended"]</button>
    <partial name="_AssignedToMeFilter" model="6" />
</div>

<table id="maintenancesTable" class="table" style="width:100%;">
    <thead>
        <tr>
            <th>@L["ID"]</th>
            <th>@L["Title"]</th>
            <th>@L["Asset"]</th>
            <th>@L["Type"]</th>
            <th>@L["Scheduled Date"]</th>
            <th>@L["Status"]</th>
            <th>@L["Assigned to"]</th>
            <th>@L["Action"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaintenanceId</td>
                <td>@item.Title</td>
                <td>@(item.Asset?.Name ?? "-")</td>
                <td>@L.Enum(item.Type)</td>
                <td>@item.ScheduledDate.ToShortDateString()</td>
                <td>@L.Enum(item.Status)</td>
                <partial name="_AssignedToCell" model="@(OpenQMS.Services.Workflow.TaskAssignmentService.For(assignedMap, item.Id, (int)item.Status))" />
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">@L["Details"]</a>
                    @if (item.Status != OpenQMS.Models.Maintenance.MaintenanceStatus.Reviewed
                      && item.Status != OpenQMS.Models.Maintenance.MaintenanceStatus.Approved
                      && item.Status != OpenQMS.Models.Maintenance.MaintenanceStatus.Overdue
                      && item.Status != OpenQMS.Models.Maintenance.MaintenanceStatus.Suspended)
                    {
                        <text> | </text>
                        <a asp-action="Edit" asp-route-id="@item.Id">@L["Edit"]</a>
                    }
                    @if ((User.IsInRole(Constants.AdministratorsRole) || User.IsInRole(Constants.QualityManagerRole))
                         && item.Status != OpenQMS.Models.Maintenance.MaintenanceStatus.InProgress
                         && item.Status != OpenQMS.Models.Maintenance.MaintenanceStatus.Completed
                         && item.Status != OpenQMS.Models.Maintenance.MaintenanceStatus.Reviewed
                         && item.Status != OpenQMS.Models.Maintenance.MaintenanceStatus.Approved)
                    {
                        <text> | </text>
                        <a asp-action="Delete" asp-route-id="@item.Id">@L["Delete"]</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

