@using Microsoft.AspNetCore.Identity

@model IEnumerable<AppRole>

@{
    ViewData["Title"] = L["Roles"].Value;
}

<h4 class="mb-0">@L["Roles"]</h4>
<hr />

<table class="table table-hover">
    <thead>
        <tr>
            <th>@L["Role"]</th>
            <th>@L["Description"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@L.Role(item.Name)</strong></td>
                <td class="text-muted">@L.Message(item.Description)</td>
            </tr>
        }
    </tbody>
</table>
