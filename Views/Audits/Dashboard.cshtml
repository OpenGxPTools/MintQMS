@{
    ViewData["Title"] = "Audit Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statusCounts = (Dictionary<string, int>)ViewBag.StatusCounts;
    var typeCounts   = (Dictionary<string, int>)ViewBag.TypeCounts;
    var upcoming     = (List<OpenQMS.Models.Audit>)ViewBag.Upcoming;
    var overdue      = (List<OpenQMS.Models.Audit>)ViewBag.Overdue;
    var pendingReview = (List<OpenQMS.Models.Audit>)ViewBag.PendingReview;
    var followUpDue  = (List<OpenQMS.Models.Audit>)ViewBag.FollowUpDue;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Audit Dashboard</h4>
    <div class="d-flex gap-2">
        <a asp-action="ExportRegister" class="btn btn-outline-success btn-sm">Export Excel</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Register</a>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Audit</a>
    </div>
</div>

@if ((int)ViewBag.TotalCriticalFindings > 0)
{
    <div class="alert alert-danger d-flex align-items-center mb-4">
        <strong class="me-2">&#9888;</strong>
        <span><strong>@ViewBag.TotalCriticalFindings critical finding(s)</strong> across all audits require attention.</span>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-primary">@ViewBag.Total</div>
                <div class="text-muted">Total Audits</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-warning">@ViewBag.OpenCount</div>
                <div class="text-muted">Open</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-success">@ViewBag.ClosedCount</div>
                <div class="text-muted">Closed</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100 @((int)ViewBag.CAPARequiredCount > 0 ? "border-warning" : "")">
            <div class="card-body">
                <div class="display-5 fw-bold @((int)ViewBag.CAPARequiredCount > 0 ? "text-warning" : "text-secondary")">@ViewBag.CAPARequiredCount</div>
                <div class="text-muted">CAPA Required (open)</div>
            </div>
        </div>
    </div>
</div>

<!-- Findings Summary -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100 @((int)ViewBag.TotalCriticalFindings > 0 ? "border-danger" : "")">
            <div class="card-body">
                <div class="display-6 fw-bold @((int)ViewBag.TotalCriticalFindings > 0 ? "text-danger" : "text-secondary")">@ViewBag.TotalCriticalFindings</div>
                <div class="text-muted small">Total Critical Findings</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6 fw-bold text-warning">@ViewBag.TotalMajorFindings</div>
                <div class="text-muted small">Total Major Findings</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6 fw-bold text-info">@ViewBag.TotalMinorFindings</div>
                <div class="text-muted small">Total Minor Findings</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6 fw-bold text-secondary">@(((int)ViewBag.TotalCriticalFindings + (int)ViewBag.TotalMajorFindings + (int)ViewBag.TotalMinorFindings))</div>
                <div class="text-muted small">All Findings (excl. obs.)</div>
            </div>
        </div>
    </div>
</div>

<!-- Status Chart + Status Table -->
<div class="row g-3 mb-4">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">Status Distribution</div>
            <div class="card-body d-flex justify-content-center align-items-center">
                <canvas id="statusChart" style="max-height:220px"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header">Status Breakdown</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Status</th><th>Count</th><th style="width:40%">Progress</th></tr></thead>
                    <tbody>
                        @foreach (var kv in statusCounts)
                        {
                            var pct = (int)ViewBag.Total > 0 ? (kv.Value * 100 / (int)ViewBag.Total) : 0;
                            var barClass = kv.Key switch
                            {
                                "Scheduled"    => "bg-secondary",
                                "InProgress"   => "bg-info",
                                "ReportDraft"  => "bg-warning",
                                "UnderReview"  => "bg-warning",
                                "Approved"     => "bg-primary",
                                "Closed"       => "bg-success",
                                _              => "bg-secondary"
                            };
                            var statusLabel = kv.Key switch
                            {
                                "InProgress"  => "In Progress",
                                "ReportDraft" => "Report Draft",
                                "UnderReview" => "Under Review",
                                _             => kv.Key
                            };
                            <tr>
                                <td>@statusLabel</td>
                                <td>@kv.Value</td>
                                <td><div class="progress" style="height:8px"><div class="progress-bar @barClass" style="width:@pct%"></div></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Upcoming + Pending Review -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span>Upcoming Scheduled Audits</span>
                <span class="badge bg-secondary">@upcoming.Count</span>
            </div>
            <div class="card-body p-0">
                @if (upcoming.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>ID</th><th>Title</th><th>Type</th><th>Planned Start</th></tr></thead>
                        <tbody>
                            @foreach (var a in upcoming)
                            {
                                var daysTo = (a.PlannedStartDate!.Value.Date - SiteTime.Today).Days;
                                var rowCls = daysTo <= 7 ? "table-warning" : "";
                                <tr class="@rowCls">
                                    <td><a asp-action="Details" asp-route-id="@a.Id">@a.AuditId</a></td>
                                    <td>@a.Title</td>
                                    <td>@a.Type</td>
                                    <td>@a.PlannedStartDate.Value.ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted p-3 mb-0">No upcoming audits.</p> }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span>Pending Action (Draft / Review / Approved)</span>
                <span class="badge bg-warning text-dark">@pendingReview.Count</span>
            </div>
            <div class="card-body p-0">
                @if (pendingReview.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>ID</th><th>Title</th><th>Status</th><th>Lead Auditor</th></tr></thead>
                        <tbody>
                            @foreach (var a in pendingReview)
                            {
                                var prLabel = a.Status switch
                                {
                                    OpenQMS.Models.Audit.AuditStatus.ReportDraft => "Report Draft",
                                    OpenQMS.Models.Audit.AuditStatus.UnderReview => "Under Review",
                                    OpenQMS.Models.Audit.AuditStatus.Approved    => "Approved — Pending Closure",
                                    _ => a.Status.ToString()
                                };
                                <tr>
                                    <td><a asp-action="Details" asp-route-id="@a.Id">@a.AuditId</a></td>
                                    <td>@a.Title</td>
                                    <td>@prLabel</td>
                                    <td>@(a.LeadAuditor ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted p-3 mb-0">None pending.</p> }
            </div>
        </div>
    </div>
</div>

<!-- Overdue -->
@if (overdue.Any())
{
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning d-flex justify-content-between">
            <span>Overdue Scheduled Audits (planned start date passed)</span>
            <span class="badge bg-dark">@overdue.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead><tr><th>ID</th><th>Title</th><th>Type</th><th>Planned Start</th><th>Days Overdue</th></tr></thead>
                <tbody>
                    @foreach (var a in overdue)
                    {
                        var daysOver = (SiteTime.Today - a.PlannedStartDate!.Value.Date).Days;
                        <tr class="table-warning">
                            <td><a asp-action="Details" asp-route-id="@a.Id">@a.AuditId</a></td>
                            <td>@a.Title</td>
                            <td>@a.Type</td>
                            <td>@a.PlannedStartDate.Value.ToShortDateString()</td>
                            <td><strong>@daysOver days</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Follow-Up Due -->
@if (followUpDue.Any())
{
    <div class="card mb-4 border-info">
        <div class="card-header bg-info text-dark d-flex justify-content-between">
            <span>Follow-Up Due Within 14 Days</span>
            <span class="badge bg-dark">@followUpDue.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead><tr><th>ID</th><th>Title</th><th>Follow-Up Date</th><th>Critical</th><th>Major</th></tr></thead>
                <tbody>
                    @foreach (var a in followUpDue)
                    {
                        var daysTo = a.FollowUpDate.HasValue ? (a.FollowUpDate.Value.Date - SiteTime.Today).Days : 0;
                        var rowCls = daysTo < 0 ? "table-danger" : daysTo <= 7 ? "table-warning" : "";
                        <tr class="@rowCls">
                            <td><a asp-action="Details" asp-route-id="@a.Id">@a.AuditId</a></td>
                            <td>@a.Title</td>
                            <td>@(a.FollowUpDate?.ToShortDateString() ?? "-")</td>
                            <td>@a.CriticalFindings</td>
                            <td>@a.MajorFindings</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Recent Activity -->
<div class="card">
    <div class="card-header">Recent Activity</div>
    <div class="card-body p-0">
        @{
            var recentActivity = ViewBag.RecentActivity as dynamic;
        }
        @if (recentActivity != null)
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Time</th><th>Audit</th><th>Action</th><th>By</th></tr></thead>
                <tbody>
                    @foreach (var entry in recentActivity)
                    {
                        <tr>
                            <td class="text-nowrap text-muted small">@(SiteTime.ToSite((DateTime)entry.Log.PerformedOn).ToString("yyyy-MM-dd HH:mm"))</td>
                            <td><a asp-action="Details" asp-route-id="@entry.RecordId">@entry.AuditId</a> — @entry.Title</td>
                            <td>@entry.Log.Action</td>
                            <td>@entry.Log.PerformedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <p class="text-muted p-3 mb-0">No activity recorded yet.</p> }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    var labels = @Json.Serialize(statusCounts.Keys.ToList());
    var data   = @Json.Serialize(statusCounts.Values.ToList());
    var colors = ['#6c757d','#0dcaf0','#ffc107','#fd7e14','#0d6efd','#198754'];

    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: { labels: labels, datasets: [{ data: data, backgroundColor: colors }] },
        options: { plugins: { legend: { position: 'bottom' } }, maintainAspectRatio: true }
    });
})();
</script>
}
