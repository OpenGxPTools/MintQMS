@section Scripts {
<script>
$(document).ready(function () {
    var activeTab = '@TempData["ActiveTab"]';
    var target = activeTab ? '#' + activeTab : '#overview';
    var el = document.querySelector('[data-bs-target="' + target + '"]');
    if (el) new bootstrap.Tab(el).show();
});

// ── Action Plan editable grid ──────────────────────────────────────────────
(function () {
    var rowsBody = document.getElementById('apRows');
    if (!rowsBody) return; // read-only or no action plan

    var statusData = Array.prototype.map.call(
        document.querySelectorAll('#apStatusOptions span'),
        function (s) { return { val: s.getAttribute('data-val'), txt: s.textContent }; });
    var completeVal = (statusData.find(function (o) { return o.txt.toLowerCase() === 'complete'; }) || {}).val || null;

    function statusOptions() {
        return statusData.map(function (o) { return '<option value="' + o.val + '">' + o.txt + '</option>'; }).join('');
    }
    function makeRow(actionText) {
        var tr = document.createElement('tr');
        tr.innerHTML =
            '<td><textarea name="action" class="form-control form-control-sm" rows="2" required></textarea></td>' +
            '<td><input name="owner" list="ownerList" class="form-control form-control-sm" /></td>' +
            '<td><input name="targetDate" type="date" class="form-control form-control-sm" /></td>' +
            '<td><select name="rowStatus" class="form-select form-select-sm ap-status">' + statusOptions() + '</select></td>' +
            '<td><input name="evidence" class="form-control form-control-sm" /></td>' +
            '<td><input name="completedDate" type="date" class="form-control form-control-sm ap-completed" /></td>' +
            '<td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm ap-del" title="Remove action"><i class="bi bi-trash"></i></button></td>';
        rowsBody.appendChild(tr);
        if (actionText) tr.querySelector('textarea[name="action"]').value = actionText;
        return tr;
    }

    var addBtn = document.getElementById('apAddRow');
    if (addBtn) addBtn.addEventListener('click', function () { makeRow(''); });

    var loadBtn = document.getElementById('apLoadSuggested');
    if (loadBtn) loadBtn.addEventListener('click', function () {
        var existing = Array.prototype.map.call(rowsBody.querySelectorAll('textarea[name="action"]'),
            function (t) { return t.value.trim().toLowerCase(); });
        Array.prototype.forEach.call(document.querySelectorAll('#apSuggested span'), function (s) {
            var a = s.textContent.trim();
            if (existing.indexOf(a.toLowerCase()) === -1) { makeRow(a); existing.push(a.toLowerCase()); }
        });
    });

    rowsBody.addEventListener('click', function (e) {
        var del = e.target.closest('.ap-del');
        if (del) del.closest('tr').remove();
    });

    // Keep completed date and "Complete" status consistent (server also enforces this).
    rowsBody.addEventListener('change', function (e) {
        var tr = e.target.closest('tr'); if (!tr) return;
        var status = tr.querySelector('.ap-status');
        var completed = tr.querySelector('.ap-completed');
        if (!status || !completed || !completeVal) return;
        if (e.target.classList.contains('ap-completed')) {
            if (completed.value) status.value = completeVal;
        } else if (e.target.classList.contains('ap-status')) {
            if (status.value !== completeVal) completed.value = '';
        }
    });
})();
</script>
}
