@model OpenQMS.Models.Customer

@{
    ViewData["Title"] = L["Edit Customer"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">@L["Edit Customer"] — @Model.CustomerId</h4>
    </div>
</div>
<hr />

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CustomerId" value="@Model.CustomerId" />
    <input type="hidden" asp-for="GeneratedFrom" value="@Model.GeneratedFrom" />
    <input type="hidden" asp-for="Version" />
    <input type="hidden" asp-for="EditedBy" value="@Model.EditedBy" />
    <input type="hidden" asp-for="EditedOn" value="@(Model.EditedOn.ToSite())" />
    <input type="hidden" asp-for="ApprovedBy" value="@Model.ApprovedBy" />
    <input type="hidden" asp-for="ApprovedOn" value="@(Model.ApprovedOn.ToSite())" />
    <input type="hidden" asp-for="IsLocked" value="@Model.IsLocked" />
    <input type="hidden" asp-for="Status" value="@Model.Status" />

    <div class="card mb-4">
        <div class="card-header fw-semibold">@L["Identity"]</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="LegalName" class="form-label"></label>
                    <input asp-for="LegalName" class="form-control" required />
                    <span asp-validation-for="LegalName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TradingName" class="form-label"></label>
                    <input asp-for="TradingName" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerType" class="form-label"></label>
                    <select asp-for="CustomerType" class="form-select"
                            asp-items="Html.GetEnumSelectList<OpenQMS.Models.CustomerType>()"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Industry" class="form-label"></label>
                    <select asp-for="Industry" class="form-select">
                        <option value="">@L["-- Select --"]</option>
                        <optgroup label="@L["Healthcare & Clinical"]">
                            <option value="Hospital / Health Service">@L["Hospital / Health Service"]</option>
                            <option value="Specialist Medical Practice">@L["Specialist Medical Practice"]</option>
                            <option value="General Practice / Primary Care">@L["General Practice / Primary Care"]</option>
                            <option value="Oncology Centre">@L["Oncology Centre"]</option>
                            <option value="Aged Care Facility">@L["Aged Care Facility"]</option>
                            <option value="Community Pharmacy">@L["Community Pharmacy"]</option>
                            <option value="Hospital Pharmacy">@L["Hospital Pharmacy"]</option>
                            <option value="Compounding Pharmacy">@L["Compounding Pharmacy"]</option>
                            <option value="Pathology / Diagnostics">@L["Pathology / Diagnostics"]</option>
                        </optgroup>
                        <optgroup label="@L["Research & Trials"]">
                            <option value="Contract Research Organisation (CRO)">@L["Contract Research Organisation (CRO)"]</option>
                            <option value="Academic / Research Institution">@L["Academic / Research Institution"]</option>
                            <option value="Clinical Trial Site">@L["Clinical Trial Site"]</option>
                        </optgroup>
                        <optgroup label="@L["Life Sciences Industry"]">
                            <option value="Pharmaceutical">@L["Pharmaceutical"]</option>
                            <option value="Biotechnology">@L["Biotechnology"]</option>
                            <option value="Medical Devices">@L["Medical Devices"]</option>
                        </optgroup>
                        <optgroup label="@L["Distribution & Supply"]">
                            <option value="Pharmaceutical Wholesale / Distribution">@L["Pharmaceutical Wholesale / Distribution"]</option>
                            <option value="Medical Supply / Distribution">@L["Medical Supply / Distribution"]</option>
                        </optgroup>
                        <optgroup label="@L["Government & Regulatory"]">
                            <option value="Government / Public Health">@L["Government / Public Health"]</option>
                            <option value="Defence / Military Health">@L["Defence / Military Health"]</option>
                        </optgroup>
                        <optgroup label="@L["Other"]">
                            <option value="Veterinary">@L["Veterinary"]</option>
                            <option value="Other">@L["Other"]</option>
                        </optgroup>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="LegalId" class="form-label"></label>
                    <input asp-for="LegalId" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Website" class="form-label"></label>
                    <input asp-for="Website" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">@L["Address"]</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Street" class="form-label"></label>
                    <input asp-for="Street" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="State" class="form-label"></label>
                    <input asp-for="State" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PostCode" class="form-label"></label>
                    <input asp-for="PostCode" class="form-control" />
                </div>
                <div class="col-md-8">
                    <label asp-for="Country" class="form-label"></label>
                    <input asp-for="Country" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">@L["Primary Contact"]</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="ContactName" class="form-label"></label>
                    <input asp-for="ContactName" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ContactEmail" class="form-label"></label>
                    <input asp-for="ContactEmail" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ContactPhone" class="form-label"></label>
                    <input asp-for="ContactPhone" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">@L["Commercial"]</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="AccountNumber" class="form-label"></label>
                    <input asp-for="AccountNumber" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ContractReference" class="form-label"></label>
                    <input asp-for="ContractReference" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ContractExpiryDate" class="form-label"></label>
                    <input asp-for="ContractExpiryDate" type="date" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">@L["Notes"]</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="SpecialRequirements" class="form-label"></label>
                    <textarea asp-for="SpecialRequirements" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">@L["Related Documents"]</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">@L["Linked Approved Documents"]</label>
                    <select id="relatedDocDropdown" class="form-select">
                        <option value="">@L["-- Add Document --"]</option>
                        @foreach (var d in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["EffectiveDocs"])
                        {
                            <option value="@d.Value" data-text="@d.Text">@d.Text</option>
                        }
                    </select>
                    <div id="relatedDocTags" class="mt-2 d-flex flex-wrap gap-1"></div>
                    <div id="relatedDocHidden" class="d-none"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <input type="submit" value="@L["Save"]" class="btn btn-primary" />
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>@L["Cancel"]</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function setupPicker(dropdownId, tagsId, hiddenId, inputName, preselected) {
            var selected = {};
            preselected.forEach(function (item) { selected[item.id] = item.text; });
            function render() {
                var tagsDiv = document.getElementById(tagsId);
                var hiddenDiv = document.getElementById(hiddenId);
                tagsDiv.innerHTML = ''; hiddenDiv.innerHTML = '';
                Object.keys(selected).forEach(function (id) {
                    var badge = document.createElement('span');
                    badge.className = 'badge bg-primary d-flex align-items-center gap-1';
                    badge.style.fontSize = '0.85rem';
                    badge.textContent = selected[id];
                    var btn = document.createElement('button');
                    btn.type = 'button'; btn.className = 'btn-close btn-close-white btn-sm ms-1'; btn.style.fontSize = '0.6rem';
                    btn.addEventListener('click', function () { delete selected[id]; render(); });
                    badge.appendChild(btn); tagsDiv.appendChild(badge);
                    var input = document.createElement('input');
                    input.type = 'hidden'; input.name = inputName; input.value = id;
                    hiddenDiv.appendChild(input);
                });
            }
            document.getElementById(dropdownId).addEventListener('change', function () {
                var id = this.value; var text = this.options[this.selectedIndex].dataset.text;
                if (id && !selected[id]) { selected[id] = text; render(); }
                this.value = '';
            });
            render();
        }
        var selRelatedDocs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ((List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["EffectiveDocs"])
                .Where(x => ((List<int>)ViewBag.SelectedRelatedDocIds).Contains(int.Parse(x.Value)))
                .Select(x => new { id = x.Value, text = x.Text }).ToList()));
        setupPicker('relatedDocDropdown', 'relatedDocTags', 'relatedDocHidden', 'selectedRelatedDocs', selRelatedDocs);
    </script>
}
