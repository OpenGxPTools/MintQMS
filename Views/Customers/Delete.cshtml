@model OpenQMS.Models.Customer

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">Delete Customer</h4>
    </div>
</div>
<hr />
<h5 class="text-danger">Are you sure you want to delete this?</h5>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CustomerId)</dt>
            <dd class="col-sm-8">@Model.CustomerId</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.LegalName)</dt>
            <dd class="col-sm-8">@Model.LegalName</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CustomerType)</dt>
            <dd class="col-sm-8">@Model.CustomerType</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Status)</dt>
            <dd class="col-sm-8">@EnumHelper.Display(Model.Status)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.EditedBy)</dt>
            <dd class="col-sm-8">@(Model.EditedBy ?? "-")</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.EditedOn)</dt>
            <dd class="col-sm-8">@Model.EditedOn.ToSite().ToString("dd/MM/yyyy")</dd>
        </dl>

        @if (Model.Documents != null && Model.Documents.Any())
        {
            <h5 class="mt-3">Documents</h5>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>File Name</th>
                        <th>Description</th>
                        <th>Uploaded By</th>
                        <th>Uploaded Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.Documents)
                    {
                        <tr>
                            <td>@doc.FileName</td>
                            <td>@(doc.Description ?? "-")</td>
                            <td>@doc.UploadedBy</td>
                            <td>@doc.UploadedDate.ToSite().ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if ((bool)ViewData["HasLinkedRecords"] == true)
{
    <div class="alert alert-danger">This customer has uploaded Documents. Remove them before deleting.</div>
}

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-2">
        <input type="submit" value="Delete" class="btn btn-danger"
               disabled="@((bool)ViewData["HasLinkedRecords"] == true ? "disabled" : null)" />
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
    </div>
</form>
