@using OpenQMS.Models
@using OpenQMS.Services
@{
    ViewData["Title"] = "Pharmacovigilance Dashboard";

    var overdueCases     = ViewBag.OverdueCases     as IEnumerable<AdverseEvent> ?? Enumerable.Empty<AdverseEvent>();
    var approachingCases = ViewBag.ApproachingCases as IEnumerable<AdverseEvent> ?? Enumerable.Empty<AdverseEvent>();
    var signalFlags      = ViewBag.SignalFlags      as IEnumerable<AdverseEvent> ?? Enumerable.Empty<AdverseEvent>();
    var recentActivity   = ViewBag.RecentActivity   as IEnumerable<AEAuditLog>   ?? Enumerable.Empty<AEAuditLog>();
}

@section Scripts {
<script>
$(document).ready(function () {

    // Status bar chart
    var statusCtx = document.getElementById('pvStatusChart').getContext('2d');
    new Chart(statusCtx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(ViewBag.StatusLabels ?? "[]"),
            datasets: [{
                label: 'Cases',
                data: @Html.Raw(ViewBag.StatusData ?? "[]"),
                backgroundColor: [
                    '#6c757d','#17a2b8','#ffc107','#28a745','#343a40','#dc3545'
                ],
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    // Serious doughnut
    var seriousCtx = document.getElementById('pvSeriousChart').getContext('2d');
    new Chart(seriousCtx, {
        type: 'doughnut',
        data: {
            labels: ['Serious', 'Non-Serious'],
            datasets: [{
                data: [@(ViewBag.SeriousTotal ?? 0), @(ViewBag.NonSeriousTotal ?? 0)],
                backgroundColor: ['#dc3545', '#28a745']
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 12, fontSize: 11 } }
            }
        }
    });
});
</script>
}

<h4 class="mb-0">
    <i class="fas fa-shield-virus me-2 text-primary"></i>
    Pharmacovigilance Dashboard
</h4>
<hr />

<!-- ── KPI Cards ──────────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body py-3">
                <div class="display-5 fw-bold text-primary">@ViewBag.TotalOpen</div>
                <div class="text-muted small mt-1">Open Cases</div>
            </div>
            <div class="card-footer bg-primary text-white small py-1">Active Adverse Events</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body py-3">
                <div class="display-5 fw-bold text-danger">@ViewBag.SeriousCount</div>
                <div class="text-muted small mt-1">Serious</div>
            </div>
            <div class="card-footer bg-danger text-white small py-1">Require Expedited Review</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center h-100 @(((int)(ViewBag.OverdueCount ?? 0)) > 0 ? "border-danger" : "")">
            <div class="card-body py-3">
                <div class="display-5 fw-bold @(((int)(ViewBag.OverdueCount ?? 0)) > 0 ? "text-danger" : "text-secondary")">
                    @ViewBag.OverdueCount
                </div>
                <div class="text-muted small mt-1">Overdue Submissions</div>
            </div>
            <div class="card-footer @(((int)(ViewBag.OverdueCount ?? 0)) > 0 ? "bg-danger" : "bg-secondary") text-white small py-1">
                TGA Deadline Passed
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body py-3">
                <div class="display-5 fw-bold text-success">@ViewBag.SubmittedMonth</div>
                <div class="text-muted small mt-1">Submitted This Month</div>
            </div>
            <div class="card-footer bg-success text-white small py-1">TGA Submissions</div>
        </div>
    </div>
</div>

<!-- ── Row 2: Deadline Panel + Status Chart ──────────────────────────── -->
<div class="row g-3 mb-4">

    <!-- Deadline Countdown -->
    <div class="col-md-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white">
                <i class="fas fa-clock me-1"></i> Regulatory Deadline Tracker
            </div>
            <div class="card-body p-0">
                @if (!overdueCases.Any() && !approachingCases.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="fas fa-check-circle text-success fa-2x mb-2"></i><br />
                        No overdue or approaching deadlines.
                    </div>
                }
                else
                {
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>AE Number</th>
                                <th>TGA Deadline</th>
                                <th>Days</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ae in overdueCases)
                            {
                                var days = (ae.TGADeadlineDate!.Value.Date - SiteTime.Today).Days;
                                <tr class="table-danger">
                                    <td><strong>@ae.AENumber</strong></td>
                                    <td>@ae.TGADeadlineDate!.Value.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge bg-danger">@Math.Abs(days)d overdue</span></td>
                                    <td><span class="badge bg-secondary">@EnumHelper.Display(ae.Status)</span></td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@ae.Id"
                                           class="btn btn-danger btn-sm">View</a>
                                    </td>
                                </tr>
                            }
                            @foreach (var ae in approachingCases)
                            {
                                var days = (ae.TGADeadlineDate!.Value.Date - SiteTime.Today).Days;
                                var rowClass = days <= 2 ? "table-danger" : "table-warning";
                                var badgeClass = days <= 2 ? "danger" : "warning";
                                <tr class="@rowClass">
                                    <td><strong>@ae.AENumber</strong></td>
                                    <td>@ae.TGADeadlineDate!.Value.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge bg-@badgeClass">@days d remaining</span></td>
                                    <td><span class="badge bg-secondary">@EnumHelper.Display(ae.Status)</span></td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@ae.Id"
                                           class="btn btn-@badgeClass btn-sm">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="col-md-5">
        <div class="card shadow-sm mb-3">
            <div class="card-header">Cases by Status</div>
            <div class="card-body p-2">
                <canvas id="pvStatusChart" height="160"></canvas>
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="card-header">Serious vs Non-Serious</div>
            <div class="card-body p-2">
                <canvas id="pvSeriousChart" height="140"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- ── Row 3: Signal Flags + Recent Activity ─────────────────────────── -->
<div class="row g-3">

    <!-- Signal Flags -->
    <div class="col-md-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-warning text-dark">
                <i class="fas fa-exclamation-triangle me-1"></i> Signal Flags
                @if (signalFlags.Any())
                {
                    <span class="badge bg-danger ms-2">@signalFlags.Count()</span>
                }
            </div>
            <div class="card-body p-0">
                @if (!signalFlags.Any())
                {
                    <p class="text-muted p-3 mb-0">No active signal flags.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var ae in signalFlags)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@ae.AENumber</strong>
                                    <span class="badge bg-secondary ms-1">@EnumHelper.Display(ae.Status)</span>
                                    @if (ae.IsSerious) { <span class="badge bg-danger ms-1">Serious</span> }
                                    <br />
                                    <small class="text-muted">@(ae.MedDRAPT ?? "No MedDRA term")</small>
                                </div>
                                <a asp-action="Details" asp-route-id="@ae.Id" class="btn btn-sm btn-outline-warning">
                                    <i class="fas fa-eye me-1"></i>View
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="col-md-7">
        <div class="card shadow-sm h-100">
            <div class="card-header">
                <i class="fas fa-history me-1"></i> Recent Activity
            </div>
            <div class="card-body p-0">
                @if (!recentActivity.Any())
                {
                    <p class="text-muted p-3 mb-0">No activity yet.</p>
                }
                else
                {
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>Date</th><th>Case</th><th>Action</th><th>By</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in recentActivity)
                            {
                                var actionBadge = entry.Action switch {
                                    "DeadlineOverdue"  => "danger",
                                    "DeadlineCritical" => "danger",
                                    "DeadlineWarning"  => "warning",
                                    "TGASubmission"    => "success",
                                    "StatusTransition" => "info",
                                    "FollowUpCreated"  => "primary",
                                    _ => "secondary"
                                };
                                <tr>
                                    <td class="small text-nowrap">@(SiteTime.ToSite((DateTime)entry.PerformedOn).ToString("dd MMM HH:mm"))</td>
                                    <td class="small">
                                        @if (entry.AdverseEvent != null)
                                        {
                                            <a asp-action="Details" asp-route-id="@entry.AdverseEventId">@entry.AdverseEvent.AENumber</a>
                                        }
                                        else { <span>@entry.AdverseEventId</span> }
                                    </td>
                                    <td><span class="badge bg-@actionBadge small">@entry.Action</span></td>
                                    <td class="small">@entry.PerformedBy</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-primary btn-sm">
        <i class="fas fa-list me-1"></i> All Adverse Events
    </a>
    <a asp-action="Create" class="btn btn-primary btn-sm ms-2">
        <i class="fas fa-plus me-1"></i> New Adverse Event
    </a>
</div>
