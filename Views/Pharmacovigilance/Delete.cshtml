@model OpenQMS.Models.AdverseEvent
@{
    ViewData["Title"] = L["Void Adverse Event"].Value;
}

<h4 class="mb-0">@L["Void Adverse Event"]</h4>
<div class="alert alert-warning">
    @H["Are you sure you want to void <strong>{0}</strong>? The record will be marked as Voided and will no longer appear in active lists.", Model.AENumber]
</div>

<dl class="row">
    <dt class="col-sm-3">@L["AE Number"]</dt>
    <dd class="col-sm-9">@Model.AENumber</dd>
    <dt class="col-sm-3">@L["Status"]</dt>
    <dd class="col-sm-9">@L.Enum(Model.Status)</dd>
    <dt class="col-sm-3">@L["Report Date"]</dt>
    <dd class="col-sm-9">@Model.ReportDate.ToSite().ToString("dd MMM yyyy", DisplayDates.Culture)</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">@L["Confirm Void"]</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary ms-2">@L["Cancel"]</a>
</form>
