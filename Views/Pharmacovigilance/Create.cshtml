@model OpenQMS.Models.AdverseEvent
@{
    ViewData["Title"] = L["New Adverse Event"].Value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">@L["New Adverse Event"]</h4>
        <p class="text-muted mb-0">@L["AE number will be auto-generated on save."]</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">@L["Back to List"]</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <strong>@L["Please correct the following errors:"]</strong>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

@if (ViewBag.FromComplaint != null)
{
    <div class="alert alert-info mb-3">
        <i class="fas fa-link me-1"></i>
        @H["Creating Adverse Event from Complaint <strong>{0}</strong>. Key fields have been pre-filled.", (string)ViewBag.FromComplaint]
    </div>
}

<form asp-action="Create" method="post" id="pvCreateForm" novalidate>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="LinkedComplaintId" />

    <!-- Tab Navigation -->
    <ul class="nav nav-tabs mb-0" id="aeTabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-report">@L["1. Report Info"]</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-patient">@L["2. Patient"]</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-product">@L["3. Suspect Product"]</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-ae">@L["4. AE Details"]</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-assessment">@L["5. Case Assessment"]</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-regulatory">@L["6. Regulatory"]</a></li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-4 mb-3">

        <!-- Tab 1: Report Info -->
        <div class="tab-pane fade show active" id="tab-report">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@L["Report Source"]</label>
                    <select asp-for="ReportSource" asp-items="Html.GetEnumSelectList<OpenQMS.Models.AdverseEvent.AEReportSource>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Report Type"]</label>
                    <select asp-for="ReportType" asp-items="Html.GetEnumSelectList<OpenQMS.Models.AdverseEvent.AEReportType>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="Day0Date">@L["Day 0 Date"] <span class="text-muted small">@L["(regulatory clock start)"]</span></label>
                    <input asp-for="Day0Date" type="date" class="form-control" id="day0DateInput" />
                    <span asp-validation-for="Day0Date" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["TGA Deadline"] <span class="text-muted small">@L["(auto-calculated)"]</span></label>
                    <div id="deadlineBadge" class="mt-1 text-muted">@L["Enter Day 0 date above"]</div>
                </div>
                <div class="col-md-8">
                    <label class="form-label">@L["Reporter Name / Initials"]</label>
                    <input type="text" name="reporter.ReporterName" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Reporter Type"]</label>
                    <select name="reporter.Type" class="form-select">
                        <option value="">@L["--Select--"]</option>
                        @foreach (var v in Enum.GetValues<OpenQMS.Models.AEReporter.ReporterType>())
                        {
                            <option value="@((int)v)">@L.Enum(v)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Reporter Qualification"]</label>
                    <select name="reporter.Qualification" class="form-select">
                        <option value="">@L["--Select--"]</option>
                        @foreach (var v in Enum.GetValues<OpenQMS.Models.AEReporter.ReporterQualification>())
                        {
                            <option value="@((int)v)">@L.Enum(v)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Reporter Institution"]</label>
                    <input type="text" name="reporter.Institution" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Reporter Country"]</label>
                    <input type="text" name="reporter.Country" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Reporter Email"]</label>
                    <input type="email" name="reporter.Email" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Reporter Phone"]</label>
                    <input type="text" name="reporter.Phone" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Date Reported to Reporter"]</label>
                    <input type="date" name="reporter.ReportDate" class="form-control" />
                </div>
            </div>
        </div>

        <!-- Tab 2: Patient -->
        <div class="tab-pane fade" id="tab-patient">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@L["Patient Initials / ID"] <span class="text-danger">*</span></label>
                    <input type="text" name="patient.PatientIdentifier" id="patientIdentifierInput" class="form-control" />
                    <div class="invalid-feedback">@L["Patient Initials / ID is required for a valid ICSR."]</div>
                    <div class="form-text">@L["Required for valid ICSR. Do not enter full name."]</div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@L["Age"]</label>
                    <input type="number" name="patient.Age" class="form-control" min="0" max="150" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@L["Age Unit"]</label>
                    <select name="patient.AgeUnit" class="form-select">
                        <option value="">--</option>
                        @foreach (var v in Enum.GetValues<OpenQMS.Models.AEPatient.PatientAgeUnit>())
                        {
                            <option value="@((int)v)">@L.Enum(v)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Date of Birth"]</label>
                    <input type="date" name="patient.DateOfBirth" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Sex"]</label>
                    <select name="patient.Sex" class="form-select">
                        <option value="">@L["--Select--"]</option>
                        @foreach (var v in Enum.GetValues<OpenQMS.Models.AEPatient.PatientSex>())
                        {
                            <option value="@((int)v)">@L.Enum(v)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Weight (kg)"]</label>
                    <input type="number" name="patient.WeightKg" class="form-control" step="0.1" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Height (cm)"]</label>
                    <input type="number" name="patient.HeightCm" class="form-control" step="0.1" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Pregnant?"]</label>
                    <select name="patient.IsPregnant" class="form-select">
                        <option value="">@L["Unknown"]</option>
                        <option value="true">@L["Yes"]</option>
                        <option value="false">@L["No"]</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["Medical History"]</label>
                    <textarea name="patient.MedicalHistory" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["Concomitant Medications"]</label>
                    <textarea name="patient.ConcomitantMedications" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </div>

        <!-- Tab 3: Suspect Product -->
        <div class="tab-pane fade" id="tab-product">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@L["Product (from register)"]</label>
                    <select name="suspectProduct.ProductId" id="suspectProductIdSelect" asp-items="ViewBag.ProductId" class="form-select">
                        <option value="">@L["--Select product or enter manually--"]</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["Product Name"] <span class="text-danger">*</span></label>
                    <input type="text" name="suspectProduct.ProductName" id="suspectProductNameInput" class="form-control" />
                    <div class="invalid-feedback">@L["Product Name is required for a valid ICSR."]</div>
                    <div class="form-text">@L["Required for valid ICSR."]</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["ARTG Number"]</label>
                    <input type="text" name="suspectProduct.ARTGNumber" id="artgNumberInput" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Batch / Lot Number"]</label>
                    <input type="text" name="suspectProduct.BatchNumber" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Route of Administration"]</label>
                    <input type="text" name="suspectProduct.RouteOfAdministration" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Dose"]</label>
                    <input type="text" name="suspectProduct.Dose" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Dose Unit"]</label>
                    <input type="text" name="suspectProduct.DoseUnit" class="form-control" placeholder="@L["mg, mL, etc."]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Frequency"]</label>
                    <input type="text" name="suspectProduct.DoseFrequency" class="form-control" placeholder="@L["once daily, etc."]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Indication"]</label>
                    <input type="text" name="suspectProduct.Indication" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Treatment Start Date"]</label>
                    <input type="date" name="suspectProduct.TreatmentStartDate" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Treatment End Date"]</label>
                    <input type="date" name="suspectProduct.TreatmentEndDate" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Action Taken"]</label>
                    <select name="suspectProduct.ActionTaken" class="form-select">
                        <option value="">@L["--Select--"]</option>
                        @foreach (var v in Enum.GetValues<OpenQMS.Models.AESuspectProduct.AEActionTaken>())
                        {
                            <option value="@((int)v)">@L.Enum(v)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["Dechallenge Result"]</label>
                    <select name="suspectProduct.DechallengeResult" class="form-select">
                        <option value="">@L["--Select--"]</option>
                        @foreach (var v in Enum.GetValues<OpenQMS.Models.AESuspectProduct.AEDechallengeResult>())
                        {
                            <option value="@((int)v)">@L.Enum(v)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["Rechallenge Result"]</label>
                    <select name="suspectProduct.RechallengeResult" class="form-select">
                        <option value="">@L["--Select--"]</option>
                        @foreach (var v in Enum.GetValues<OpenQMS.Models.AESuspectProduct.AEDechallengeResult>())
                        {
                            <option value="@((int)v)">@L.Enum(v)</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Tab 4: AE Details -->
        <div class="tab-pane fade" id="tab-ae">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label" asp-for="AEDescription">@L["AE Description"] <span class="text-danger">*</span></label>
                    <textarea asp-for="AEDescription" class="form-control" rows="4" placeholder="@L["Describe the adverse event in detail..."]"></textarea>
                    <div class="invalid-feedback">@L["AE Description is required."]</div>
                    <span asp-validation-for="AEDescription" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="MedDRAPT">@L["MedDRA Preferred Term"] <span class="text-danger">*</span>
                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="meddra" aria-label="@L["MedDRA guidance"]">?</button>
                    </label>
                    <input asp-for="MedDRAPT" class="form-control" />
                    <div class="invalid-feedback">@L["MedDRA Preferred Term is required."]</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="MedDRASOC">@L["MedDRA System Organ Class"]</label>
                    <input asp-for="MedDRASOC" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="AEStartDate">@L["AE Start Date"]</label>
                    <input asp-for="AEStartDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="AEEndDate">@L["AE End Date"]</label>
                    <input asp-for="AEEndDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="Outcome">@L["Outcome"]</label>
                    <select asp-for="Outcome" asp-items="Html.GetEnumSelectList<OpenQMS.Models.AdverseEvent.AEOutcome>()" class="form-select">
                        <option value="">@L["--Select--"]</option>
                    </select>
                </div>

                <!-- Seriousness -->
                <div class="col-12">
                    <div class="card border-danger">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>@L["Seriousness Criteria"]
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="seriousness" aria-label="@L["Seriousness Criteria guidance"]">?</button>
                            </strong>
                            <span id="seriousBadge" class="badge bg-secondary">@L["Non-Serious"]</span>
                        </div>
                        <div class="card-body">
                            <input type="hidden" asp-for="SeriousnessCriteria" id="seriousnessValue" />
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input seriousness-cb" type="checkbox" data-value="1" id="cb_death" />
                                        <label class="form-check-label" for="cb_death">@L["Death"]</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input seriousness-cb" type="checkbox" data-value="2" id="cb_lifethreat" />
                                        <label class="form-check-label" for="cb_lifethreat">@L["Life-Threatening"]</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input seriousness-cb" type="checkbox" data-value="4" id="cb_hosp" />
                                        <label class="form-check-label" for="cb_hosp">@L["Hospitalisation"]</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input seriousness-cb" type="checkbox" data-value="8" id="cb_disability" />
                                        <label class="form-check-label" for="cb_disability">@L["Disability / Incapacity"]</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input seriousness-cb" type="checkbox" data-value="16" id="cb_congenital" />
                                        <label class="form-check-label" for="cb_congenital">@L["Congenital Anomaly / Birth Defect"]</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input seriousness-cb" type="checkbox" data-value="32" id="cb_medimportant" />
                                        <label class="form-check-label" for="cb_medimportant">@L["Medically Important"]</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label" asp-for="Causality">@L["Causality"]
                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="causality" aria-label="@L["Causality guidance"]">?</button>
                    </label>
                    <select asp-for="Causality" asp-items="Html.GetEnumSelectList<OpenQMS.Models.AdverseEvent.AECausality>()" class="form-select">
                        <option value="">@L["--Select--"]</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="Severity">@L["Severity"]</label>
                    <select asp-for="Severity" asp-items="Html.GetEnumSelectList<OpenQMS.Models.AdverseEvent.AESeverity>()" class="form-select">
                        <option value="">@L["--Select--"]</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="Expectedness">@L["Expectedness"]
                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="expectedness" aria-label="@L["Expectedness guidance"]">?</button>
                    </label>
                    <select asp-for="Expectedness" asp-items="Html.GetEnumSelectList<OpenQMS.Models.AdverseEvent.AEExpectedness>()" class="form-select">
                        <option value="">@L["--Select--"]</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Tab 5: Case Assessment -->
        <div class="tab-pane fade" id="tab-assessment">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" asp-for="MedicalEvaluator">@L["Medical Evaluator"]</label>
                    <input asp-for="MedicalEvaluator" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="EvaluationDate">@L["Evaluation Date"]</label>
                    <input asp-for="EvaluationDate" type="date" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="MedicalNarrative">@L["Medical Narrative"]</label>
                    <textarea asp-for="MedicalNarrative" class="form-control" rows="6" placeholder="@L["Enter the full medical narrative for this case..."]"></textarea>
                    <div class="form-text">@L["Required before the case can be submitted for approval."]</div>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="SignalDetected" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" asp-for="SignalDetected">@L["Signal Detected"]</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 6: Regulatory -->
        <div class="tab-pane fade" id="tab-regulatory">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@L["Reportable to TGA?"]</label>
                    <select name="regulatoryReport.IsReportableToTGA" class="form-select">
                        <option value="">@L["Pending Assessment"]</option>
                        <option value="true">@L["Yes"]</option>
                        <option value="false">@L["No"]</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["TGA Submission Date"]</label>
                    <input type="date" name="regulatoryReport.TGASubmissionDate" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Submission Method"]</label>
                    <select name="regulatoryReport.SubmissionMethod" class="form-select">
                        <option value="">@L["--Select--"]</option>
                        @foreach (var v in Enum.GetValues<OpenQMS.Models.AERegulatoryReport.TGASubmissionMethod>())
                        {
                            <option value="@((int)v)">@L.Enum(v)</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["TGA ADRS Reference Number"]</label>
                    <input type="text" name="regulatoryReport.TGAADRSReferenceNumber" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["E2B Transmission Reference"]</label>
                    <input type="text" name="regulatoryReport.E2BTransmissionReference" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label">@L["Reporting Decision Rationale"]</label>
                    <textarea name="regulatoryReport.ReportingDecisionRationale" class="form-control" rows="3"></textarea>
                    <div class="form-text">@L["Required if Reportable = No."]</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["Overseas Authorities"]</label>
                    <input type="text" name="regulatoryReport.OverseasAuthorities" class="form-control" placeholder="@L["EMA, FDA, etc."]" />
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input type="checkbox" name="regulatoryReport.OverseasReportingRequired" value="true" class="form-check-input" />
                        <label class="form-check-label">@L["Overseas Reporting Required"]</label>
                    </div>
                    <div class="form-check form-switch mt-2">
                        <input type="checkbox" name="regulatoryReport.IncludeInNextPSUR" value="true" class="form-check-input" />
                        <label class="form-check-label">@L["Include in Next PSUR"]</label>
                    </div>
                    <div class="form-check form-switch mt-2">
                        <input type="checkbox" name="regulatoryReport.SignificantSafetyIssue" value="true" class="form-check-input" />
                        <label class="form-check-label">@L["Significant Safety Issue (SSI)"]</label>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- end tab-content -->

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@L["Save Adverse Event"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@L["Cancel"]</a>
    </div>
</form>

<!-- Field-help popover content (hidden, read by field-help.js) -->
<div class="d-none">
    <div id="help-seriousness">
        <p class="mb-1">@H["<strong>ICH seriousness criteria.</strong> An event is <strong>serious</strong> if it meets one or more of these — and serious cases usually require expedited reporting:"]</p>
        <ul class="mb-0 ps-3">
            <li><strong>@L["Death"]</strong> @L["— the event resulted in death."]</li>
            <li><strong>@L["Life-Threatening"]</strong> @L["— the patient was at immediate risk of death from the event."]</li>
            <li><strong>@L["Hospitalisation"]</strong> @L["— caused or prolonged inpatient hospitalisation."]</li>
            <li><strong>@L["Disability"]</strong> @L["— resulted in persistent or significant incapacity."]</li>
            <li><strong>@L["Congenital Anomaly"]</strong> @L["— a birth defect in the offspring."]</li>
            <li><strong>@L["Other Medically Important"]</strong> @L["— a significant medical event that may jeopardise the patient or require intervention to prevent one of the above."]</li>
        </ul>
    </div>
    <div id="help-meddra">
        <p class="mb-0">@H["<strong>MedDRA</strong> (Medical Dictionary for Regulatory Activities) is the standard terminology for coding events. The <strong>Preferred Term (PT)</strong> is the specific medical concept (e.g. \"Nausea\"); the <strong>System Organ Class (SOC)</strong> is its high-level grouping (e.g. \"Gastrointestinal disorders\"). Coding consistently lets cases be aggregated and signals detected."]</p>
    </div>
    <div id="help-causality">
        <p class="mb-0">@H["<strong>Causality</strong> is the assessed likelihood that the suspect product caused the event — typically Certain / Probable / Possible / Unlikely / Unrelated (WHO-UMC) or Related / Not Related. Base it on temporal relationship, dechallenge/rechallenge, plausibility and alternative explanations."]</p>
    </div>
    <div id="help-expectedness">
        <p class="mb-0">@H["<strong>Expectedness</strong> asks whether this event is already listed in the product's reference safety information (e.g. the approved PI / SmPC / CCDS). <strong>Unexpected</strong> = not listed, or more severe/specific than listed. A serious + unexpected + related case is typically what triggers expedited regulatory reporting."]</p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/tab-form-validation.js" asp-append-version="true"></script>
    <script src="~/js/field-help.js" asp-append-version="true"></script>
    <script>
        // Seriousness flags checkboxes
        document.querySelectorAll('.seriousness-cb').forEach(cb => {
            cb.addEventListener('change', updateSeriousness);
        });

        function updateSeriousness() {
            let combined = 0;
            document.querySelectorAll('.seriousness-cb:checked').forEach(cb => {
                combined |= parseInt(cb.dataset.value);
            });
            document.getElementById('seriousnessValue').value = combined;

            const isSerious = combined > 0;
            const badge = document.getElementById('seriousBadge');
            badge.textContent = isSerious ? @Json.Serialize(L["Serious"].Value.ToUpperInvariant()) : @Json.Serialize(L["Non-Serious"].Value);
            badge.className = isSerious ? 'badge bg-danger' : 'badge bg-secondary';
        }

        // TGA deadline calculator
        const day0Input = document.getElementById('day0DateInput');
        if (day0Input) {
            day0Input.addEventListener('change', calculateDeadline);
        }

        function calculateDeadline() {
            const day0 = day0Input.value;
            if (!day0) return;

            const isFatal = document.getElementById('cb_death')?.checked ||
                            document.getElementById('cb_lifethreat')?.checked;

            fetch(`/Pharmacovigilance/CalculateDeadline?day0Date=${day0}&isFatalOrLifeThreatening=${isFatal}`)
                .then(r => r.json())
                .then(data => {
                    const el = document.getElementById('deadlineBadge');
                    el.innerHTML = `<span class="badge bg-${data.statusClass} fs-6">${data.deadlineFormatted}</span>
                                    <span class="badge bg-${data.statusClass} ms-1">${data.label}</span>`;
                });
        }

        // Recalculate deadline if death/life-threatening changes
        ['cb_death', 'cb_lifethreat'].forEach(id => {
            document.getElementById(id)?.addEventListener('change', () => {
                if (day0Input?.value) calculateDeadline();
            });
        });

        // Auto-populate from product register
        document.getElementById('suspectProductIdSelect')?.addEventListener('change', function () {
            const id = this.value;
            if (!id) return;
            fetch(`@Url.Action("GetProductDetails", "Pharmacovigilance")?productId=${id}`)
                .then(r => r.json())
                .then(data => {
                    if (!data) return;
                    const nameInput = document.getElementById('suspectProductNameInput');
                    if (nameInput && !nameInput.value)
                        nameInput.value = data.brandName || data.name || '';
                    const artgInput = document.getElementById('artgNumberInput');
                    if (artgInput && !artgInput.value && data.artgReference)
                        artgInput.value = data.artgReference;
                });
        });

        // Tab map for required field error navigation
        const tabForField = {
            'patientIdentifierInput':  'tab-patient',
            'suspectProductNameInput': 'tab-product',
            'AEDescription':           'tab-ae',
            'MedDRAPT':                'tab-ae'
        };

        document.getElementById('pvCreateForm')?.addEventListener('submit', function (e) {
            const fields = [
                { id: 'patientIdentifierInput',  label: @Json.Serialize(L["Patient Initials / ID (Tab 2)"].Value) },
                { id: 'suspectProductNameInput', label: @Json.Serialize(L["Product Name (Tab 3)"].Value) },
                { id: 'AEDescription',           label: @Json.Serialize(L["AE Description (Tab 4)"].Value) },
                { id: 'MedDRAPT',                label: @Json.Serialize(L["MedDRA Preferred Term (Tab 4)"].Value) }
            ];

            let missing = [];
            let firstTab = null;

            fields.forEach(f => {
                const el = document.getElementById(f.id);
                if (!el) return;
                if (!el.value.trim()) {
                    el.classList.add('is-invalid');
                    missing.push(f.label);
                    if (!firstTab) firstTab = tabForField[f.id];
                } else {
                    el.classList.remove('is-invalid');
                }
            });

            if (missing.length > 0) {
                e.preventDefault();
                let banner = document.getElementById('pvValidationBanner');
                if (!banner) {
                    banner = document.createElement('div');
                    banner.id = 'pvValidationBanner';
                    banner.className = 'alert alert-danger alert-dismissible mb-3';
                    banner.innerHTML = '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
                    document.getElementById('pvCreateForm').prepend(banner);
                }
                banner.innerHTML = `<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    <strong>${@Json.Serialize(L["Please complete all required fields:"].Value)}</strong>
                    <ul class="mb-0 mt-1">${missing.map(m => `<li>${m}</li>`).join('')}</ul>`;

                if (firstTab) {
                    const tabEl = document.querySelector(`[href="#${firstTab}"]`);
                    if (tabEl) new bootstrap.Tab(tabEl).show();
                }
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });

        // Clear is-invalid on input
        ['patientIdentifierInput', 'suspectProductNameInput', 'AEDescription', 'MedDRAPT'].forEach(id => {
            document.getElementById(id)?.addEventListener('input', function () {
                this.classList.remove('is-invalid');
            });
        });
    </script>
}
