@model OpenQMS.Models.AdverseEvent
@{
    ViewData["Title"] = Model.AENumber;
    var rep = Model.Reporter;
    var pat = Model.Patient;
    var sp = Model.SuspectProduct;
    var reg = Model.RegulatoryReport;
    var auditLog = ViewData["AuditLog"] as IEnumerable<OpenQMS.Models.AEAuditLog> ?? Enumerable.Empty<OpenQMS.Models.AEAuditLog>();
    var deadlineStatus = ViewData["DeadlineStatus"] is OpenQMS.Services.PVRegulatoryService.DeadlineStatus ds
        ? ds : OpenQMS.Services.PVRegulatoryService.DeadlineStatus.NotApplicable;
    var deadlineBadgeClass = deadlineStatus switch {
        OpenQMS.Services.PVRegulatoryService.DeadlineStatus.Overdue   => "danger",
        OpenQMS.Services.PVRegulatoryService.DeadlineStatus.Critical  => "danger",
        OpenQMS.Services.PVRegulatoryService.DeadlineStatus.Warning   => "warning",
        OpenQMS.Services.PVRegulatoryService.DeadlineStatus.OnTrack   => "success",
        _ => "secondary"
    };

    var statusClass = Model.Status switch {
        AdverseEvent.AEStatus.Draft => "secondary",
        AdverseEvent.AEStatus.UnderMedicalReview => "info",
        AdverseEvent.AEStatus.PendingApproval => "warning",
        AdverseEvent.AEStatus.Approved => "success",
        AdverseEvent.AEStatus.Closed => "dark",
        AdverseEvent.AEStatus.Voided => "voided",
        _ => "secondary"
    };
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-1">@Model.AENumber</h4>
        <div class="d-flex gap-2 align-items-center">
            @if (statusClass == "voided")
            {
                <span class="badge text-bg-light border text-muted text-decoration-line-through fs-6">@L.Enum(Model.Status)</span>
            }
            else
            {
                <span class="badge bg-@statusClass fs-6">@L.Enum(Model.Status)</span>
            }
            @if (Model.IsSerious) { <span class="badge bg-danger">@L["Serious"]</span> }
            @if (Model.IsFatalOrLifeThreatening) { <span class="badge bg-dark">@L["Fatal / Life-Threatening"]</span> }
            @if (Model.IsLocked) { <span class="badge bg-warning text-dark"><i class="bi bi-lock-fill"></i> @L["Locked"]</span> }
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (!Model.IsLocked && Model.Status != AdverseEvent.AEStatus.Voided)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">@L["Edit"]</a>
        }
        <a href="#tab-attachments" data-bs-toggle="tab" class="btn btn-outline-secondary">
            <i class="fas fa-paperclip me-1"></i>@L["Documents ({0})", Model.Attachments?.Count(a => !a.IsDeleted) ?? 0]
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">@L["Back to List"]</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@L.Message(TempData["Success"])<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@L.Message(TempData["Error"])<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- TGA Deadline Alert -->
@if (Model.IsSerious && Model.TGADeadlineDate.HasValue)
{
    var daysLeft = (Model.TGADeadlineDate.Value.Date - SiteTime.Today).Days;
    var alertClass = daysLeft < 0 ? "danger" : daysLeft <= 2 ? "danger" : daysLeft <= 5 ? "warning" : "info";
    <div class="alert alert-@alertClass mb-3">
        <strong>@L["Reporting Deadline:"]</strong> @Model.TGADeadlineDate.Value.ToString("dd MMM yyyy", DisplayDates.Culture)
        @if (daysLeft < 0) { <span class="badge bg-danger ms-2">@L["OVERDUE by {0} days", Math.Abs(daysLeft)]</span> }
        else if (daysLeft == 0) { <span class="badge bg-danger ms-2">@L["Due TODAY"]</span> }
        else { <span class="badge bg-@alertClass ms-2">@L["{0} day(s) remaining", daysLeft]</span> }
    </div>
}

<!-- Parent AE link -->
@if (Model.ParentAE != null)
{
    <div class="alert alert-secondary">
        @L["Follow-up to:"] <a asp-action="Details" asp-route-id="@Model.ParentAE.Id">@Model.ParentAE.AENumber</a>
    </div>
}

<!-- Tabs -->
<ul class="nav nav-tabs mb-0" id="detailTabs">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-report">@L["Report Info"]</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-patient">@L["Patient"]</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-product">@L["Suspect Product"]</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-ae">@L["AE Details"]</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-assessment">@L["Case Assessment"]</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-regulatory">@L["Regulatory"]</a></li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-attachments">
            @L["Documents"]
            @{ var attCount = Model.Attachments?.Count(a => !a.IsDeleted) ?? 0; }
            @if (attCount > 0) { <span class="badge bg-secondary">@attCount</span> }
        </a>
    </li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-audit">@L["Audit Trail"]</a></li>
</ul>

<div class="tab-content border border-top-0 rounded-bottom p-4 mb-3">

    <!-- Tab 1: Report Info -->
    <div class="tab-pane fade show active" id="tab-report">
        <dl class="row">
            <dt class="col-sm-3">@L["Report Date"]</dt>
            <dd class="col-sm-9">@Model.ReportDate.ToSite().ToString("dd MMM yyyy HH:mm", DisplayDates.Culture)</dd>
            <dt class="col-sm-3">@L["Report Source"]</dt>
            <dd class="col-sm-9">@L.Enum(Model.ReportSource)</dd>
            <dt class="col-sm-3">@L["Report Type"]</dt>
            <dd class="col-sm-9">@L.Enum(Model.ReportType)</dd>
            <dt class="col-sm-3">@L["Day 0 Date"]</dt>
            <dd class="col-sm-9">@(Model.Day0Date?.ToString("dd MMM yyyy", DisplayDates.Culture) ?? "-")</dd>
            <dt class="col-sm-3">@L["Reporting Deadline"]</dt>
            <dd class="col-sm-9">@(Model.TGADeadlineDate?.ToString("dd MMM yyyy", DisplayDates.Culture) ?? "-")</dd>
            <dt class="col-sm-3">@L["Created By"]</dt>
            <dd class="col-sm-9">@L["{0} on {1}", Model.CreatedBy, Model.CreatedOn.ToSite().ToString("dd MMM yyyy HH:mm", DisplayDates.Culture)]</dd>
            @if (Model.ModifiedBy != null)
            {
                <dt class="col-sm-3">@L["Last Modified"]</dt>
                <dd class="col-sm-9">@L["{0} on {1}", Model.ModifiedBy ?? "", Model.ModifiedOn.ToSite()?.ToString("dd MMM yyyy HH:mm", DisplayDates.Culture) ?? ""]</dd>
            }
        </dl>
        @if (rep != null)
        {
            <hr /><h6>@L["Reporter"]</h6>
            <dl class="row">
                <dt class="col-sm-3">@L["Name / Initials"]</dt>
                <dd class="col-sm-9">@(rep.ReporterName ?? "-")</dd>
                <dt class="col-sm-3">@L["Type"]</dt>
                <dd class="col-sm-9">@(rep.Type == null ? "-" : L.Enum(rep.Type))</dd>
                <dt class="col-sm-3">@L["Qualification"]</dt>
                <dd class="col-sm-9">@(rep.Qualification == null ? "-" : L.Enum(rep.Qualification))</dd>
                <dt class="col-sm-3">@L["Institution"]</dt>
                <dd class="col-sm-9">@(rep.Institution ?? "-")</dd>
                <dt class="col-sm-3">@L["Country"]</dt>
                <dd class="col-sm-9">@(rep.Country ?? "-")</dd>
            </dl>
        }
    </div>

    <!-- Tab 2: Patient -->
    <div class="tab-pane fade" id="tab-patient">
        @if (pat != null)
        {
            <dl class="row">
                <dt class="col-sm-3">@L["Patient Identifier"]</dt>
                <dd class="col-sm-9">@(pat.PatientIdentifier ?? "-")</dd>
                <dt class="col-sm-3">@L["Age"]</dt>
                <dd class="col-sm-9">@(pat.Age.HasValue ? $"{pat.Age} {pat.AgeUnit}" : "-")</dd>
                <dt class="col-sm-3">@L["Date of Birth"]</dt>
                <dd class="col-sm-9">@(pat.DateOfBirth?.ToString("dd MMM yyyy", DisplayDates.Culture) ?? "-")</dd>
                <dt class="col-sm-3">@L["Sex"]</dt>
                <dd class="col-sm-9">@(pat.Sex == null ? "-" : L.Enum(pat.Sex))</dd>
                <dt class="col-sm-3">@L["Weight / Height"]</dt>
                <dd class="col-sm-9">@(pat.WeightKg.HasValue ? $"{pat.WeightKg} kg" : "-") / @(pat.HeightCm.HasValue ? $"{pat.HeightCm} cm" : "-")</dd>
                <dt class="col-sm-3">@L["Pregnant"]</dt>
                <dd class="col-sm-9">@(pat.IsPregnant.HasValue ? (pat.IsPregnant.Value ? L["Yes"] : L["No"]) : L["Unknown"])</dd>
                <dt class="col-sm-3">@L["Medical History"]</dt>
                <dd class="col-sm-9" style="white-space:pre-wrap">@(pat.MedicalHistory ?? "-")</dd>
                <dt class="col-sm-3">@L["Concomitant Medications"]</dt>
                <dd class="col-sm-9" style="white-space:pre-wrap">@(pat.ConcomitantMedications ?? "-")</dd>
            </dl>
        }
        else { <p class="text-muted">@L["No patient data recorded."]</p> }
    </div>

    <!-- Tab 3: Suspect Product -->
    <div class="tab-pane fade" id="tab-product">
        @if (sp != null)
        {
            <dl class="row">
                <dt class="col-sm-3">@L["Product Name"]</dt>
                <dd class="col-sm-9">
                    @(sp.ProductName ?? "-")
                    @if (sp.Product != null) { <a asp-controller="Products" asp-action="Details" asp-route-id="@sp.ProductId" class="ms-2 badge bg-light text-dark">@L["View in Register"]</a> }
                </dd>
                <dt class="col-sm-3">@L["Registration Number"]</dt>
                <dd class="col-sm-9">@(sp.ARTGNumber ?? "-")</dd>
                <dt class="col-sm-3">@L["Batch / Lot"]</dt>
                <dd class="col-sm-9">@(sp.BatchNumber ?? "-")</dd>
                <dt class="col-sm-3">@L["Route / Dose"]</dt>
                <dd class="col-sm-9">@(sp.RouteOfAdministration ?? "-") — @(sp.Dose ?? "-") @(sp.DoseUnit ?? "") @(sp.DoseFrequency ?? "")</dd>
                <dt class="col-sm-3">@L["Indication"]</dt>
                <dd class="col-sm-9">@(sp.Indication ?? "-")</dd>
                <dt class="col-sm-3">@L["Treatment Dates"]</dt>
                <dd class="col-sm-9">@(sp.TreatmentStartDate?.ToString("dd MMM yyyy", DisplayDates.Culture) ?? "-") → @(sp.TreatmentEndDate?.ToString("dd MMM yyyy", DisplayDates.Culture) ?? "-")</dd>
                <dt class="col-sm-3">@L["Action Taken"]</dt>
                <dd class="col-sm-9">@(sp.ActionTaken == null ? "-" : L.Enum(sp.ActionTaken))</dd>
                <dt class="col-sm-3">@L["Dechallenge / Rechallenge"]</dt>
                <dd class="col-sm-9">@(sp.DechallengeResult == null ? "-" : L.Enum(sp.DechallengeResult)) / @(sp.RechallengeResult == null ? "-" : L.Enum(sp.RechallengeResult))</dd>
            </dl>
        }
        else { <p class="text-muted">@L["No suspect product data recorded."]</p> }
    </div>

    <!-- Tab 4: AE Details -->
    <div class="tab-pane fade" id="tab-ae">
        <dl class="row">
            <dt class="col-sm-3">@L["AE Description"]</dt>
            <dd class="col-sm-9" style="white-space:pre-wrap">@(Model.AEDescription ?? "-")</dd>
            <dt class="col-sm-3">@L["MedDRA Preferred Term"]</dt>
            <dd class="col-sm-9">@(Model.MedDRAPT ?? "-")</dd>
            <dt class="col-sm-3">@L["MedDRA System Organ Class"]</dt>
            <dd class="col-sm-9">@(Model.MedDRASOC ?? "-")</dd>
            <dt class="col-sm-3">@L["AE Dates"]</dt>
            <dd class="col-sm-9">@(Model.AEStartDate?.ToString("dd MMM yyyy", DisplayDates.Culture) ?? "-") → @(Model.AEEndDate?.ToString("dd MMM yyyy", DisplayDates.Culture) ?? "-")</dd>
            <dt class="col-sm-3">@L["Outcome"]</dt>
            <dd class="col-sm-9">@(Model.Outcome == null ? "-" : L.Enum(Model.Outcome))</dd>
            <dt class="col-sm-3">@L["Seriousness Criteria"]</dt>
            <dd class="col-sm-9">
                @if (Model.SeriousnessCriteria == AdverseEvent.SeriousnessFlags.None)
                {
                    <span class="badge bg-secondary">@L["None"]</span>
                }
                else
                {
                    foreach (AdverseEvent.SeriousnessFlags flag in Enum.GetValues(typeof(AdverseEvent.SeriousnessFlags)))
                    {
                        if (flag != AdverseEvent.SeriousnessFlags.None && Model.SeriousnessCriteria.HasFlag(flag))
                        {
                            <span class="badge bg-danger me-1">@L.Enum(flag)</span>
                        }
                    }
                }
            </dd>
            <dt class="col-sm-3">@L["Causality"]</dt>
            <dd class="col-sm-9">@(Model.Causality == null ? "-" : L.Enum(Model.Causality))</dd>
            <dt class="col-sm-3">@L["Severity"]</dt>
            <dd class="col-sm-9">@(Model.Severity == null ? "-" : L.Enum(Model.Severity))</dd>
            <dt class="col-sm-3">@L["Expectedness"]</dt>
            <dd class="col-sm-9">@(Model.Expectedness == null ? "-" : L.Enum(Model.Expectedness))</dd>
        </dl>
    </div>

    <!-- Tab 5: Case Assessment -->
    <div class="tab-pane fade" id="tab-assessment">
        <dl class="row">
            <dt class="col-sm-3">@L["Medical Evaluator"]</dt>
            <dd class="col-sm-9">@(Model.MedicalEvaluator ?? "-")</dd>
            <dt class="col-sm-3">@L["Evaluation Date"]</dt>
            <dd class="col-sm-9">@(Model.EvaluationDate?.ToString("dd MMM yyyy", DisplayDates.Culture) ?? "-")</dd>
            <dt class="col-sm-3">@L["Signal Detected"]</dt>
            <dd class="col-sm-9">@Html.Raw(Model.SignalDetected ? "<span class=\"badge bg-warning text-dark\">Yes</span>" : "No")</dd>
            <dt class="col-sm-3">@L["Medical Narrative"]</dt>
            <dd class="col-sm-9" style="white-space:pre-wrap">@(Model.MedicalNarrative ?? "-")</dd>
        </dl>
    </div>

    <!-- Tab 6: Regulatory -->
    <div class="tab-pane fade" id="tab-regulatory">
        @if (reg != null)
        {
            <!-- Deadline Status Banner -->
            @if (deadlineStatus != OpenQMS.Services.PVRegulatoryService.DeadlineStatus.NotApplicable)
            {
                var bannerText = deadlineStatus switch {
                    OpenQMS.Services.PVRegulatoryService.DeadlineStatus.Overdue =>
                        L["OVERDUE — reporting deadline was {0}. Submission not yet recorded.", Model.TGADeadlineDate!.Value.ToString("dd MMM yyyy", DisplayDates.Culture)].Value,
                    OpenQMS.Services.PVRegulatoryService.DeadlineStatus.Critical =>
                        L["CRITICAL — reporting deadline in {0} day(s) ({1}).", (Model.TGADeadlineDate!.Value.Date - SiteTime.Today).Days, Model.TGADeadlineDate!.Value.ToString("dd MMM yyyy", DisplayDates.Culture)].Value,
                    OpenQMS.Services.PVRegulatoryService.DeadlineStatus.Warning =>
                        L["WARNING — reporting deadline in {0} day(s) ({1}).", (Model.TGADeadlineDate!.Value.Date - SiteTime.Today).Days, Model.TGADeadlineDate!.Value.ToString("dd MMM yyyy", DisplayDates.Culture)].Value,
                    _ => L["Authority submission deadline: {0}.", Model.TGADeadlineDate!.Value.ToString("dd MMM yyyy", DisplayDates.Culture)].Value
                };
                <div class="alert alert-@deadlineBadgeClass d-flex align-items-center mb-3" role="alert">
                    <i class="fas fa-clock me-2"></i>
                    <div>@bannerText</div>
                </div>
            }

            <dl class="row">
                <dt class="col-sm-3">@L["Deadline Status"]</dt>
                <dd class="col-sm-9"><span class="badge bg-@deadlineBadgeClass">@deadlineStatus</span></dd>
                <dt class="col-sm-3">@L["Reportable to Authority"]</dt>
                <dd class="col-sm-9">
                    @if (reg.IsReportableToTGA == null) { <span class="badge bg-secondary">@L["Pending Assessment"]</span> }
                    else if (reg.IsReportableToTGA == true) { <span class="badge bg-danger">@L["Yes — Expedited Reporting Required"]</span> }
                    else { <span class="badge bg-success">@L["No"]</span> }
                </dd>
                <dt class="col-sm-3">@L["Authority Submission Date"]</dt>
                <dd class="col-sm-9">
                    @if (reg.TGASubmissionDate.HasValue) {
                        <span class="badge bg-success">@reg.TGASubmissionDate.Value.ToString("dd MMM yyyy", DisplayDates.Culture)</span>
                    } else { <span class="text-muted">@L["Not yet submitted"]</span> }
                </dd>
                <dt class="col-sm-3">@L["Submission Method"]</dt>
                <dd class="col-sm-9">@(reg.SubmissionMethod == null ? "-" : L.Enum(reg.SubmissionMethod))</dd>
                <dt class="col-sm-3">@L["Authority Case Reference"]</dt>
                <dd class="col-sm-9">@(reg.TGAADRSReferenceNumber ?? "-")</dd>
                <dt class="col-sm-3">@L["E2B Reference"]</dt>
                <dd class="col-sm-9">@(reg.E2BTransmissionReference ?? "-")</dd>
                <dt class="col-sm-3">@L["Decision Rationale"]</dt>
                <dd class="col-sm-9" style="white-space:pre-wrap">@(reg.ReportingDecisionRationale ?? "-")</dd>
                <dt class="col-sm-3">@L["Overseas Reporting"]</dt>
                <dd class="col-sm-9">
                    @(reg.OverseasReportingRequired ? L["Yes"] : L["No"])
                    @if (!string.IsNullOrWhiteSpace(reg.OverseasAuthorities)) { <span class="ms-1 text-muted">— @reg.OverseasAuthorities</span> }
                </dd>
                <dt class="col-sm-3">@L["Include in PSUR"]</dt>
                <dd class="col-sm-9">@Html.Raw(reg.IncludeInNextPSUR ? "<span class=\"badge bg-info\">Yes</span>" : "No")</dd>
                <dt class="col-sm-3">@L["Significant Safety Issue"]</dt>
                <dd class="col-sm-9">@Html.Raw(reg.SignificantSafetyIssue ? "<span class=\"badge bg-danger\">SSI Flagged</span>" : "No")</dd>
                <dt class="col-sm-3">@L["Regulatory Status"]</dt>
                <dd class="col-sm-9"><span class="badge bg-secondary">@L.Enum(reg.Status)</span></dd>
            </dl>

            <hr />

            <!-- Log TGA Submission (only if not yet submitted) -->
            @if (!reg.TGASubmissionDate.HasValue && reg.IsReportableToTGA == true)
            {
                <div class="card border-warning mb-3">
                    <div class="card-header bg-warning text-dark">
                        <strong><i class="fas fa-paper-plane me-1"></i>@L["Log Authority Submission"]</strong>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-action="LogTGASubmission" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">@L["Submission Date"] <span class="text-danger">*</span></label>
                                    <input type="date" name="submissionDate" class="form-control form-control-sm"
                                           value="@SiteTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-bold">@L["Submission Method"]</label>
                                    <select name="method" class="form-select form-select-sm">
                                        <option value="">@L["— select —"]</option>
                                        <option value="AEMSPortal">@L["Authority Online Portal"]</option>
                                        <option value="E2BEDI">@L["E2B(R3) EDI"]</option>
                                        <option value="CIOMSEmail">@L["CIOMS-I Email"]</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">@L["Authority Case Reference Number"]</label>
                                    <input type="text" name="adrsRef" class="form-control form-control-sm"
                                           placeholder="@L["Reference issued by the authority"]" />
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-warning btn-sm w-100">
                                        <i class="fas fa-check me-1"></i>@L["Record"]
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <!-- Export CIOMS-I Button -->
            <div class="mt-2">
                <a asp-action="ExportCIOMS" asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary btn-sm" target="_blank">
                    <i class="fas fa-file-pdf me-1"></i>@L["Export CIOMS-I Form (PDF)"]
                </a>
            </div>
        }
        else { <p class="text-muted">@L["No regulatory data recorded."]</p> }
    </div>

    <!-- Tab: Documents / Attachments -->
    <div class="tab-pane fade" id="tab-attachments">
        @if (!Model.IsLocked)
        {
            <div class="card mb-3">
                <div class="card-header bg-light"><strong><i class="fas fa-upload me-1"></i>@L["Upload Document"]</strong></div>
                <div class="card-body">
                    <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="aeId" value="@Model.Id" />
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label small">@L["File"]</label>
                                <input type="file" name="file" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">@L["Document Type"]</label>
                                <select name="documentType" class="form-select form-select-sm">
                                    <option value="">@L["— Select Type —"]</option>
                                    <option value="CIOMS Form">@L["CIOMS Form"]</option>
                                    <option value="MedWatch / Authority Form">@L["MedWatch / Authority Form"]</option>
                                    <option value="Source Document">@L["Source Document"]</option>
                                    <option value="Medical Records">@L["Medical Records"]</option>
                                    <option value="Lab Report">@L["Lab Report"]</option>
                                    <option value="Medical Narrative">@L["Medical Narrative"]</option>
                                    <option value="Causality Assessment">@L["Causality Assessment"]</option>
                                    <option value="Correspondence">@L["Correspondence"]</option>
                                    <option value="Other">@L["Other"]</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">@L["Description"]</label>
                                <input type="text" name="description" class="form-control form-control-sm" placeholder="@L["optional"]" />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="fas fa-upload me-1"></i>@L["Upload"]</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-secondary small"><i class="fas fa-lock me-1"></i>@L["This case is locked (finalised) — documents can be viewed but not added or removed."]</div>
        }

        @{ var atts = Model.Attachments?.Where(a => !a.IsDeleted).OrderByDescending(a => a.UploadedDate).ToList() ?? new(); }
        @if (atts.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@L["File Name"]</th>
                            <th>@L["Type"]</th>
                            <th>@L["Description"]</th>
                            <th>@L["Uploaded By"]</th>
                            <th>@L["Date"]</th>
                            <th>@L["Size"]</th>
                            <th class="text-end">@L["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var att in atts)
                        {
                            <tr>
                                <td><i class="bi bi-paperclip"></i> @att.FileName</td>
                                <td>@(string.IsNullOrEmpty(att.DocumentType) ? "—" : att.DocumentType)</td>
                                <td>@(att.Description ?? "—")</td>
                                <td>@att.UploadedBy</td>
                                <td>@att.UploadedDate.ToSite().ToString("dd MMM yyyy", DisplayDates.Culture)</td>
                                <td>@((att.FileSize / 1024.0).ToString("F1")) KB</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="ViewAttachment" asp-route-id="@att.Id" class="btn btn-sm btn-outline-secondary" target="_blank"><i class="bi bi-eye me-1"></i>@L["View"]</a>
                                    <a asp-action="DownloadAttachment" asp-route-id="@att.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-download me-1"></i>@L["Download"]</a>
                                    @if (!Model.IsLocked)
                                    {
                                        <form asp-action="DeleteAttachment" method="post" class="d-inline ms-1" data-delete-reason="attachment">
                                            <input type="hidden" name="id" value="@att.Id" />
                                            <input type="hidden" name="aeId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>@L["Delete"]</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">@L["No documents uploaded yet."]</p>
        }
        <partial name="_DeletedAttachments" model='new OpenQMS.Models.DeletedFilesView(ViewBag.DeletedFiles as IEnumerable<OpenQMS.Models.ISoftDeletedFile>, "DownloadAttachment", Noun: "attachments")' />
    </div>

    <!-- Tab 7: Audit Trail -->
    <div class="tab-pane fade" id="tab-audit">
        @if (auditLog.Any())
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr><th>@L["Date / Time"] <span class="fw-normal text-muted">(@SiteTime.Label)</span></th><th>@L["Action"]</th><th>@L["Performed By"]</th><th>@L["Details"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in auditLog)
                    {
                        <tr>
                            <td>@(SiteTime.ToSite((DateTime)entry.PerformedOn).ToString("dd MMM yyyy HH:mm", DisplayDates.Culture))</td>
                            <td><span class="badge bg-secondary">@entry.Action</span></td>
                            <td>@entry.PerformedBy</td>
                            <td>@(!string.IsNullOrEmpty(entry.Notes) ? entry.Notes : (entry.NewValue ?? "-"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <p class="text-muted">@L["No audit trail entries yet."]</p> }
    </div>

</div><!-- end tab-content -->

<!-- ── Workflow Action Buttons ──────────────────────────────────────── -->
<hr />

@if (ViewData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@ViewData["ErrorMessage"]</div>
}

@if (Model.Status == AdverseEvent.AEStatus.Draft)
{
    <div class="card mb-3 border-primary">
        <div class="card-header bg-primary text-white"><strong>@L["Submit for Medical Review"]</strong></div>
        <div class="card-body">
            <p class="text-muted small">@L["Minimum ICSR requirements: identifiable reporter, patient, suspect product, and AE description."]</p>
            <form method="post" asp-action="SubmitForReview" asp-route-id="@Model.Id">
                <div class="row g-2">
                    <div class="col-md-4"><input type="email" name="email" class="form-control" placeholder="@L["Your email"]" required /></div>
                    <div class="col-md-4"><input type="password" name="pwd" class="form-control" placeholder="@L["Your password"]" required /></div>
                    <div class="col-md-4"><button type="submit" class="btn btn-primary w-100">@L["Submit for Review"]</button></div>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.Status == AdverseEvent.AEStatus.UnderMedicalReview)
{
    <div class="card mb-3 border-success">
        <div class="card-header bg-success text-white"><strong>@L["Complete Medical Evaluation"]</strong></div>
        <div class="card-body">
            <p class="text-muted small">@L["Ensure MedDRA coding, causality, and medical narrative are complete before proceeding."]</p>
            <form method="post" asp-action="CompleteEvaluation" asp-route-id="@Model.Id">
                <div class="row g-2">
                    <div class="col-md-4"><input type="email" name="email" class="form-control" placeholder="@L["Your email"]" required /></div>
                    <div class="col-md-4"><input type="password" name="pwd" class="form-control" placeholder="@L["Your password"]" required /></div>
                    <div class="col-md-4"><button type="submit" class="btn btn-success w-100">@L["Complete Evaluation"]</button></div>
                </div>
            </form>
        </div>
    </div>
    <div class="card mb-3 border-warning">
        <div class="card-header bg-warning"><strong>@L["Send Back to Draft"]</strong></div>
        <div class="card-body">
            <form method="post" asp-action="SendBack" asp-route-id="@Model.Id">
                <div class="row g-2">
                    <div class="col-md-3"><input type="email" name="email" class="form-control" placeholder="@L["Your email"]" required /></div>
                    <div class="col-md-3"><input type="password" name="pwd" class="form-control" placeholder="@L["Your password"]" required /></div>
                    <div class="col-md-4"><input type="text" name="comment" class="form-control" placeholder="@L["Reason for sending back"]" /></div>
                    <div class="col-md-2"><button type="submit" class="btn btn-warning w-100">@L["Send Back"]</button></div>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.Status == AdverseEvent.AEStatus.PendingApproval)
{
    <div class="card mb-3 border-success">
        <div class="card-header bg-success text-white"><strong>@L["Approve & Lock Record"]</strong></div>
        <div class="card-body">
            <p class="text-muted small">@L["Approving will lock this record. A Follow-up Report must be created to add further information."]</p>
            <form method="post" asp-action="Approve" asp-route-id="@Model.Id">
                <div class="row g-2">
                    <div class="col-md-4"><input type="email" name="email" class="form-control" placeholder="@L["Your email"]" required /></div>
                    <div class="col-md-4"><input type="password" name="pwd" class="form-control" placeholder="@L["Your password"]" required /></div>
                    <div class="col-md-4"><button type="submit" class="btn btn-success w-100">@L["Approve"]</button></div>
                </div>
            </form>
        </div>
    </div>
    <div class="card mb-3 border-warning">
        <div class="card-header bg-warning"><strong>@L["Reject — Return to Medical Review"]</strong></div>
        <div class="card-body">
            <form method="post" asp-action="Reject" asp-route-id="@Model.Id">
                <div class="row g-2">
                    <div class="col-md-3"><input type="email" name="email" class="form-control" placeholder="@L["Your email"]" required /></div>
                    <div class="col-md-3"><input type="password" name="pwd" class="form-control" placeholder="@L["Your password"]" required /></div>
                    <div class="col-md-4"><input type="text" name="comment" class="form-control" placeholder="@L["Reason for rejection"]" /></div>
                    <div class="col-md-2"><button type="submit" class="btn btn-warning w-100">@L["Reject"]</button></div>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.Status == AdverseEvent.AEStatus.Approved)
{
    <div class="card mb-3 border-dark">
        <div class="card-header bg-dark text-white"><strong>@L["Close Case"]</strong></div>
        <div class="card-body">
            <p class="text-muted small">@L["Closing flags this case for PSUR inclusion."]</p>
            <form method="post" asp-action="CloseCase" asp-route-id="@Model.Id">
                <div class="row g-2">
                    <div class="col-md-4"><input type="email" name="email" class="form-control" placeholder="@L["Your email"]" required /></div>
                    <div class="col-md-4"><input type="password" name="pwd" class="form-control" placeholder="@L["Your password"]" required /></div>
                    <div class="col-md-4"><button type="submit" class="btn btn-dark w-100">@L["Close Case"]</button></div>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.Status == AdverseEvent.AEStatus.Approved || Model.Status == AdverseEvent.AEStatus.Closed)
{
    <div class="card mb-3 border-info">
        <div class="card-header bg-info text-white"><strong>@L["Create Follow-up Report"]</strong></div>
        <div class="card-body">
            <p class="text-muted small">@L["Creates a new AE record linked to this case with suffix /F1, /F2, etc."]</p>
            <form method="post" asp-action="CreateFollowUp" asp-route-id="@Model.Id">
                <div class="row g-2">
                    <div class="col-md-4"><input type="email" name="email" class="form-control" placeholder="@L["Your email"]" required /></div>
                    <div class="col-md-4"><input type="password" name="pwd" class="form-control" placeholder="@L["Your password"]" required /></div>
                    <div class="col-md-4"><button type="submit" class="btn btn-info w-100">@L["Create Follow-up"]</button></div>
                </div>
            </form>
        </div>
    </div>
}

<!-- Cross-module links: Complaint -->
@{
    var canEditLinks = !Model.IsLocked && Model.Status != AdverseEvent.AEStatus.Voided;
    var availableComplaints = ViewData["AvailableComplaints"] as System.Collections.IEnumerable;
}
<div class="card mb-3 border-info">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <strong><i class="fas fa-comment-medical me-1"></i>@L["Linked Complaint"]</strong>
        @if (Model.LinkedComplaint != null && canEditLinks)
        {
            <form asp-action="UnlinkComplaint" method="post" class="d-inline"
                  data-confirm="@L["Remove the link to complaint {0}?", Model.LinkedComplaint.ComplaintId]" onsubmit="return confirm(this.dataset.confirm);">
                @Html.AntiForgeryToken()
                <input type="hidden" name="aeId" value="@Model.Id" />
                <button type="submit" class="btn btn-sm btn-light"><i class="fas fa-unlink me-1"></i>@L["Unlink"]</button>
            </form>
        }
        else if (Model.LinkedComplaint == null && canEditLinks)
        {
            <button type="button" class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#linkComplaintModal">
                <i class="fas fa-link me-1"></i>@L["Link Complaint"]
            </button>
        }
    </div>
    <div class="card-body">
        @if (Model.LinkedComplaint != null)
        {
            <a asp-controller="Complaints" asp-action="Details" asp-route-id="@Model.LinkedComplaintId" class="fw-bold">@Model.LinkedComplaint.ComplaintId</a>
            <text>— @Model.LinkedComplaint.Title</text>
        }
        else
        {
            <span class="text-muted">@L["Not linked to any complaint."]</span>
        }
    </div>
</div>

@if (Model.LinkedComplaint == null && canEditLinks)
{
    <div class="modal fade" id="linkComplaintModal" tabindex="-1">
        <div class="modal-dialog"><div class="modal-content">
            <form asp-action="LinkComplaint" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="aeId" value="@Model.Id" />
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title"><i class="fas fa-link me-1"></i>@L["Link to Complaint"] — @Model.AENumber</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @{
                        var anyComplaint = false;
                        if (availableComplaints != null) { foreach (var _ in availableComplaints) { anyComplaint = true; break; } }
                    }
                    @if (anyComplaint)
                    {
                        <p class="text-muted small">@L["Select an open complaint to associate with this adverse event."]</p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@L["Complaint"] <span class="text-danger">*</span></label>
                            <select name="complaintId" class="form-select" required>
                                <option value="">@L["— Select a complaint —"]</option>
                                @foreach (dynamic c in availableComplaints!)
                                {
                                    <option value="@c.Id">@c.Label</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">@L["There are no open complaints available to link."]</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    @if (anyComplaint)
                    {
                        <button type="submit" class="btn btn-info text-white"><i class="fas fa-link me-1"></i>@L["Link"]</button>
                    }
                </div>
            </form>
        </div></div>
    </div>
}

<!-- Cross-module links: CAPA -->
@if (Model.LinkedCapa != null)
{
    <div class="card mb-3 border-success">
        <div class="card-header bg-success text-white"><strong><i class="fas fa-tasks me-1"></i>@L["Linked CAPA"]</strong></div>
        <div class="card-body">
            <a asp-controller="Capas" asp-action="Details" asp-route-id="@Model.LinkedCapaId" class="fw-bold">@Model.LinkedCapa.CapaId</a>
            — @Model.LinkedCapa.Title
            <span class="badge bg-secondary ms-2">@L.Enum(Model.LinkedCapa.Status)</span>
        </div>
    </div>
}
@if (Model.Status == AdverseEvent.AEStatus.Approved && Model.LinkedCapaId == null)
{
    <div class="card mb-3 border-warning">
        <div class="card-header bg-warning text-dark"><strong><i class="fas fa-exclamation-triangle me-1"></i>@L["No CAPA Linked"]</strong></div>
        <div class="card-body d-flex align-items-center justify-content-between">
            <span class="text-muted small">@L["This approved AE has no linked CAPA. Consider raising a CAPA to address root causes."]</span>
            <a asp-controller="Capas" asp-action="Create" asp-route-aeId="@Model.Id" class="btn btn-warning btn-sm ms-3">
                <i class="fas fa-plus me-1"></i>@L["Create CAPA"]
            </a>
        </div>
    </div>
}

<!-- Follow-up Reports -->
@if (Model.FollowUpReports?.Any() == true)
{
    <div class="card mb-3">
        <div class="card-header"><strong>@L["Follow-up Reports"]</strong></div>
        <ul class="list-group list-group-flush">
            @foreach (var fu in Model.FollowUpReports)
            {
                <li class="list-group-item">
                    <a asp-action="Details" asp-route-id="@fu.Id">@fu.AENumber</a>
                    <span class="badge bg-secondary ms-2">@L.Enum(fu.Status)</span>
                </li>
            }
        </ul>
    </div>
}

<!-- Delete (void) -->
@if (Model.Status == AdverseEvent.AEStatus.Draft
     && (User.IsInRole("Administrator") || User.IsInRole("RegulatoryManager") || User.IsInRole("RegulatoryUser")))
{
    <details class="mt-3">
        <summary class="text-danger" style="cursor:pointer">@L["Void this record"]</summary>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-2">
            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Void this adverse event? This action will mark it as Voided.')">@L["Void Record"]</button>
        </form>
    </details>
}

@section Scripts {
    <script>
        // Re-open a specific tab after a server redirect (e.g. document upload/delete).
        (function () {
            var activeTab = @Json.Serialize(TempData["ActiveTab"] as string);
            if (activeTab) {
                var trigger = document.querySelector('[data-bs-toggle="tab"][href="#' + activeTab + '"]');
                if (trigger) { new bootstrap.Tab(trigger).show(); }
            }
        })();
    </script>
}
