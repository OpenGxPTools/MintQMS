@* ══════════════════════════════════════════════════════════════════
   REGULATORY ITEMS
   ══════════════════════════════════════════════════════════════════ *@

<p class="text-uppercase text-muted fw-semibold small mb-3">Regulatory Items</p>
<div class="row g-4">

    @* Open Adverse Events *@
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Open Adverse Events</span>
                <a asp-controller="Pharmacovigilance" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
            </div>
            @if (!Model.RecentAdverseEvents.Any()) { <div class="card-body text-muted small">No open adverse events.</div> }
            else {
                <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                    <thead class="table-light"><tr><th class="ps-3">AE#</th><th>MedDRA Term</th><th>Status</th><th class="pe-3">Deadline</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.RecentAdverseEvents) {
                            <tr>
                                <td class="ps-3"><a asp-controller="Pharmacovigilance" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                <td class="text-truncate" style="max-width:180px;">@item.Title</td>
                                <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div>
    </div>

    @* LC Expiring Soon *@
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Licences &amp; Certs Expiring (@(ViewBag.LcExpiryWarningDays ?? 90) days)</span>
                <a asp-controller="LicencesCertifications" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
            </div>
            @if (!Model.LCExpiringSoon.Any()) { <div class="card-body text-muted small">No licences or certifications expiring within @(ViewBag.LcExpiryWarningDays ?? 90) days.</div> }
            else {
                <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                    <thead class="table-light"><tr><th class="ps-3">LC#</th><th>Holder</th><th>Status</th><th class="pe-3">Expiry</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.LCExpiringSoon) {
                            <tr>
                                <td class="ps-3"><a asp-controller="LicencesCertifications" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                <td class="text-truncate" style="max-width:180px;">@item.Title</td>
                                <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div>
    </div>

    @* Active RI Applications *@
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Active RI Applications</span>
                <a asp-controller="RegulatoryIntelligence" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
            </div>
            @if (!Model.RecentRIApplications.Any()) { <div class="card-body text-muted small">No active regulatory applications.</div> }
            else {
                <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                    <thead class="table-light"><tr><th class="ps-3">RI#</th><th>Product</th><th>Status</th><th class="pe-3">Target</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.RecentRIApplications) {
                            <tr>
                                <td class="ps-3"><a asp-controller="RegulatoryIntelligence" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                <td class="text-truncate" style="max-width:180px;">@item.Title</td>
                                <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div>
    </div>

    @* Open Signal Reviews *@
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Open Signal Reviews</span>
                <a asp-controller="PVSignalReview" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
            </div>
            @if (!Model.RecentSignalReviews.Any()) { <div class="card-body text-muted small">No open signal reviews.</div> }
            else {
                <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                    <thead class="table-light"><tr><th class="ps-3">ID</th><th>MedDRA Term</th><th>Status</th><th class="pe-3">Detected</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.RecentSignalReviews) {
                            <tr>
                                <td class="ps-3"><a asp-controller="PVSignalReview" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                <td class="text-truncate" style="max-width:180px;">@item.Title</td>
                                <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div>
    </div>

</div>
