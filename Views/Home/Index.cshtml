@model OpenQMS.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = L["Home"].Value;

    string Badge(string cls) => cls == "warning" ? "bg-warning text-dark" : "bg-" + cls;
}

@* ── Page header ──────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0" id="my-work-title">@L["My Work"]</h2>
    <span class="text-muted small">@DisplayDates.Long(SiteTime.Today)</span>
</div>

@* ══════════════════════════════════════════════════════════════════
   MY WORK  (assigned to me · available tasks · coming up · raised by me)
   ══════════════════════════════════════════════════════════════════ *@
@{
    var regWaiting = Model.IsRegulatoryManager
        ? Model.PendingAdverseEvents.Count + Model.PendingSignalReviews.Count + Model.PendingLCRenewals.Count : 0;
    var myCount = Model.MyTasks.Count + Model.MyRecentTrainings.Count;
    var waitCount = Model.WaitingForMyRoles.Count + regWaiting;
    var firstTab = myCount > 0 || waitCount == 0 ? "tasks" : "waiting";
    var today = SiteTime.Today;
}
<div class="card border-0 shadow-sm mb-5" id="my-work">
    <div class="card-header bg-transparent pb-0">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(firstTab == "tasks" ? "active" : "")" id="tab-my-tasks" data-bs-toggle="tab" data-bs-target="#pane-my-tasks" type="button" role="tab">
                    @L["My Tasks"] <span class="badge bg-primary ms-1" id="count-my-tasks">@myCount</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(firstTab == "waiting" ? "active" : "")" id="tab-waiting" data-bs-toggle="tab" data-bs-target="#pane-waiting" type="button" role="tab">
                    @L["Available Tasks"] <span class="badge bg-secondary ms-1" id="count-waiting">@waitCount</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-coming" data-bs-toggle="tab" data-bs-target="#pane-coming" type="button" role="tab">
                    @L["Coming Up"] <span class="badge bg-secondary ms-1" id="count-coming">@Model.ComingUp.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-raised" data-bs-toggle="tab" data-bs-target="#pane-raised" type="button" role="tab">
                    @L["Raised by me"] <span class="badge bg-secondary ms-1" id="count-raised">@Model.RaisedByMe.Count</span>
                </button>
            </li>
        </ul>
    </div>
    <div class="tab-content">

        @* ── My Tasks: assigned to me, plus trainings I attend ── *@
        <div class="tab-pane fade @(firstTab == "tasks" ? "show active" : "")" id="pane-my-tasks" role="tabpanel">
            @if (myCount == 0)
            {
                <div class="card-body text-muted small">@L["Nothing is assigned to you."]</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-sm table-hover mb-0" id="table-my-tasks">
                    <thead class="table-light"><tr><th class="ps-3">@L["Record"]</th><th>@L["Title"]</th><th>@L["Module"]</th><th>@L["Task"]</th><th>@L["Assigned"]</th><th class="pe-3">@L["Due"]</th></tr></thead>
                    <tbody>
                        @foreach (var w in Model.MyTasks)
                        {
                            var overdue = w.IsOverdue(today);
                            <tr class="@(overdue ? "table-danger" : "")" data-module="@w.Module" data-record="@w.RecordId">
                                <td class="ps-3 text-nowrap"><a asp-controller="@w.Module" asp-action="Details" asp-route-id="@w.RecordId" class="text-decoration-none fw-semibold">@w.Number</a></td>
                                <td class="text-truncate" style="max-width:220px;">@w.Title</td>
                                <td class="small">@L[w.ModuleName]</td>
                                <td>@foreach (var st in w.Steps) { <span class="badge bg-primary me-1">@L[st]</span> }<div class="small text-muted">@L.Enum(w.StageValue)</div></td>
                                <td class="text-muted small text-nowrap">@w.Assignment!.AssignedOn.ToSite().ToString("dd MMM yy", DisplayDates.Culture)
                                    @if (!string.IsNullOrEmpty(w.Assignment.Note)) { <i class="bi bi-chat-left-text ms-1" title="@w.Assignment.Note"></i> }</td>
                                <td class="small pe-3 text-nowrap @(overdue ? "text-danger fw-semibold" : "text-muted")">@(w.Due?.ToString("dd MMM yy", DisplayDates.Culture) ?? "—")@if (w.Assignment.DueDate == null && w.TargetDate != null) { <div class="small text-muted fw-normal">@L["Target date"]</div> }</td>
                            </tr>
                        }
                        @foreach (var t in Model.MyRecentTrainings)
                        {
                            var overdue = t.Date.Date < today;
                            <tr class="@(overdue ? "table-danger" : "")" data-module="Trainings" data-record="@t.Id">
                                <td class="ps-3 text-nowrap"><a asp-controller="Trainings" asp-action="Details" asp-route-id="@t.Id" class="text-decoration-none fw-semibold">@t.RecordId</a></td>
                                <td class="text-truncate" style="max-width:220px;">@t.Title</td>
                                <td class="small">@L["Training"]</td>
                                <td><span class="badge bg-success">@L["Attend training"]</span><div class="small text-muted">@L.Message(t.Status)</div></td>
                                <td class="text-muted small">—</td>
                                <td class="small pe-3 text-nowrap @(overdue ? "text-danger fw-semibold" : "text-muted")">@t.Date.ToSite().ToString("dd MMM yy", DisplayDates.Culture)</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div>

        @* ── Available Tasks: unassigned records whose next step I may sign ── *@
        <div class="tab-pane fade @(firstTab == "waiting" ? "show active" : "")" id="pane-waiting" role="tabpanel">
            @if (waitCount == 0)
            {
                <div class="card-body text-muted small">@L["No tasks are available for your roles."]</div>
            }
            @if (Model.WaitingForMyRoles.Any())
            {
                <div class="card-body small text-muted pb-0">@L["Tasks your role lets you do that are not assigned to you, with who is named for them now. The earliest due date first."]</div>
                <div class="table-responsive"><table class="table table-sm table-hover mb-0" id="table-waiting">
                    <thead class="table-light"><tr><th class="ps-3">@L["Record"]</th><th>@L["Title"]</th><th>@L["Module"]</th><th>@L["Task"]</th><th>@L["Assigned to"]</th><th>@L["Created"]</th><th class="pe-3">@L["Due"]</th></tr></thead>
                    <tbody>
                        @foreach (var w in Model.WaitingForMyRoles)
                        {
                            var wOver = w.IsOverdue(today);
                            <tr class="@(wOver ? "table-danger" : "")" data-module="@w.Module" data-record="@w.RecordId">
                                <td class="ps-3 text-nowrap"><a asp-controller="@w.Module" asp-action="Details" asp-route-id="@w.RecordId" class="text-decoration-none fw-semibold">@w.Number</a></td>
                                <td class="text-truncate" style="max-width:220px;">@w.Title</td>
                                <td class="small">@L[w.ModuleName]</td>
                                <td>@foreach (var st in w.Steps) { <span class="badge bg-warning text-dark me-1">@L[st]</span> }<div class="small text-muted">@L.Enum(w.StageValue)</div></td>
                                <td class="small assigned-now">@(w.Assignment?.AssignedToUser is { } au ? OpenQMS.Services.Workflow.TaskAssignmentService.DisplayName(au) : L["No one named"].Value)</td>
                                <td class="text-muted small text-nowrap">@(w.RaisedOn?.ToSite().ToString("dd MMM yy", DisplayDates.Culture) ?? "—")</td>
                                <td class="small pe-3 text-nowrap @(wOver ? "text-danger fw-semibold" : "text-muted")">@(w.Due?.ToString("dd MMM yy", DisplayDates.Culture) ?? "—")@if (w.TargetDate != null) { <div class="small text-muted fw-normal">@L["Target date"]</div> }</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
            @if (Model.IsRegulatoryManager && regWaiting > 0)
            {
                <div class="row g-4 p-3">

        @* Pending Adverse Events *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">@L["Adverse Events Pending Approval"]</span>
                    <a asp-controller="Pharmacovigilance" asp-action="Index" class="small text-muted text-decoration-none">@L["View all"] &rarr;</a>
                </div>
                @if (!Model.PendingAdverseEvents.Any()) { <div class="card-body text-muted small">@L["No adverse events pending approval."]</div> }
                else {
                    <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                        <thead class="table-light"><tr><th class="ps-3">@L["AE#"]</th><th>@L["MedDRA Term"]</th><th>@L["Action Required"]</th><th class="pe-3">@L["Deadline"]</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.PendingAdverseEvents) {
                                <tr>
                                    <td class="ps-3"><a asp-controller="Pharmacovigilance" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                    <td class="text-truncate" style="max-width:160px;">@item.Title</td>
                                    <td><span class="badge @Badge(item.BadgeClass)">@L.Message(item.Status)</span></td>
                                    <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy", DisplayDates.Culture)</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        @* Pending Signal Reviews *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">@L["Confirmed Signals — Action Required"]</span>
                    <a asp-controller="PVSignalReview" asp-action="Index" class="small text-muted text-decoration-none">@L["View all"] &rarr;</a>
                </div>
                @if (!Model.PendingSignalReviews.Any()) { <div class="card-body text-muted small">@L["No confirmed signals requiring action."]</div> }
                else {
                    <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                        <thead class="table-light"><tr><th class="ps-3">@L["SIG#"]</th><th>@L["MedDRA Term"]</th><th>@L["Action Required"]</th><th class="pe-3">@L["Detected"]</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.PendingSignalReviews) {
                                <tr>
                                    <td class="ps-3"><a asp-controller="PVSignalReview" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                    <td class="text-truncate" style="max-width:160px;">@item.Title</td>
                                    <td><span class="badge @Badge(item.BadgeClass)">@L.Message(item.Status)</span></td>
                                    <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy", DisplayDates.Culture)</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>

        @* Pending LC Renewals *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">@L["Licences & Certs — Renewal Due"]</span>
                    <a asp-controller="LicencesCertifications" asp-action="Index" class="small text-muted text-decoration-none">@L["View all"] &rarr;</a>
                </div>
                @if (!Model.PendingLCRenewals.Any()) { <div class="card-body text-muted small">@L["No licences or certifications with renewal due."]</div> }
                else {
                    <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                        <thead class="table-light"><tr><th class="ps-3">@L["LC#"]</th><th>@L["Holder"]</th><th>@L["Action Required"]</th><th class="pe-3">@L["Expiry"]</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.PendingLCRenewals) {
                                <tr>
                                    <td class="ps-3"><a asp-controller="LicencesCertifications" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                    <td class="text-truncate" style="max-width:160px;">@item.Title</td>
                                    <td><span class="badge @Badge(item.BadgeClass)">@L.Message(item.Status)</span></td>
                                    <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy", DisplayDates.Culture)</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
        </div>
                </div>
            }
        </div>

        @* ── Raised by me: records I raised that are still waiting for a step ── *@
        @* ── Coming Up: steps planned for me that the record has not reached yet ── *@
        <div class="tab-pane fade" id="pane-coming" role="tabpanel">
            @if (!Model.ComingUp.Any())
            {
                <div class="card-body text-muted small">@L["No steps are planned for you."]</div>
            }
            else
            {
                <div class="card-body small text-muted pb-0">@L["Steps planned for you. They move to My Tasks, and you get an e-mail, when the record reaches them."]</div>
                <div class="table-responsive"><table class="table table-sm table-hover mb-0" id="table-coming">
                    <thead class="table-light"><tr><th class="ps-3">@L["Record"]</th><th>@L["Title"]</th><th>@L["Module"]</th><th>@L["Your task"]</th><th>@L["Record now at"]</th><th>@L["Planned by"]</th><th class="pe-3">@L["Due"]</th></tr></thead>
                    <tbody>
                        @foreach (var w in Model.ComingUp)
                        {
                            <tr data-module="@w.Module" data-record="@w.RecordId">
                                <td class="ps-3 text-nowrap"><a asp-controller="@w.Module" asp-action="Details" asp-route-id="@w.RecordId" class="text-decoration-none fw-semibold">@w.Number</a></td>
                                <td class="text-truncate" style="max-width:220px;">@w.Title</td>
                                <td class="small">@L[w.ModuleName]</td>
                                <td>@foreach (var st in w.Steps) { <span class="badge bg-light text-dark border me-1">@L[st]</span> }</td>
                                <td class="small text-muted">@L.Enum(w.StageValue)</td>
                                <td class="small text-muted">@w.AssignedByName</td>
                                <td class="small pe-3 text-muted">@(w.Assignment!.DueDays is { } dd ? L["{0} day(s) after it starts", dd].Value : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div>

        <div class="tab-pane fade" id="pane-raised" role="tabpanel">
            @if (!Model.RaisedByMe.Any())
            {
                <div class="card-body text-muted small">@L["No records you raised are in progress."]</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-sm table-hover mb-0" id="table-raised">
                    <thead class="table-light"><tr><th class="ps-3">@L["Record"]</th><th>@L["Title"]</th><th>@L["Module"]</th><th>@L["Status"]</th><th>@L["Responsible"]</th><th>@L["Created"]</th><th class="pe-3">@L["Due"]</th></tr></thead>
                    <tbody>
                        @foreach (var w in Model.RaisedByMe)
                        {
                            <tr data-module="@w.Module" data-record="@w.RecordId">
                                <td class="ps-3 text-nowrap"><a asp-controller="@w.Module" asp-action="Details" asp-route-id="@w.RecordId" class="text-decoration-none fw-semibold">@w.Number</a></td>
                                <td class="text-truncate" style="max-width:220px;">@w.Title</td>
                                <td class="small">@L[w.ModuleName]</td>
                                <td class="small">@L.Enum(w.StageValue)</td>
                                <td class="small">@(w.Assignment?.AssignedToUser is { } u ? OpenQMS.Services.Workflow.TaskAssignmentService.DisplayName(u) : L["No one named"].Value)</td>
                                <td class="text-muted small text-nowrap">@(w.RaisedOn?.ToSite().ToString("dd MMM yy", DisplayDates.Culture) ?? "—")</td>
                                <td class="small pe-3 text-nowrap @(w.IsOverdue(today) ? "text-danger fw-semibold" : "text-muted")">@(w.Due?.ToString("dd MMM yy", DisplayDates.Culture) ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div>

    </div>
</div>

@* ── Site-wide picture ──────────────────────────────────────────── *@
<h2 class="mb-3" id="quality-overview-title">@L["Quality Overview"]</h2>

@* ══════════════════════════════════════════════════════════════════
   QUALITY EVENTS
   ══════════════════════════════════════════════════════════════════ *@

<p class="text-uppercase text-muted fw-semibold small mb-2">@L["Quality Events"]</p>
<div class="row g-3 mb-4">

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #fd7e14 !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">@L["Open CAPAs"]</p>
                <h2 class="fw-bold mb-0">@Model.OpenCAPAs</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Capas" asp-action="Index" class="small text-muted text-decoration-none">@L["View register"] &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #fd7e14 !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">@L["Open Deviations"]</p>
                <h2 class="fw-bold mb-0">@Model.OpenDeviations</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Deviations" asp-action="Index" class="small text-muted text-decoration-none">@L["View register"] &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #dc3545 !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">@L["Open Complaints"]</p>
                <h2 class="fw-bold mb-0">@Model.OpenComplaints</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Complaints" asp-action="Index" class="small text-muted text-decoration-none">@L["View register"] &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #0d6efd !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">@L["Open Changes"]</p>
                <h2 class="fw-bold mb-0">@Model.OpenChanges</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Changes" asp-action="Index" class="small text-muted text-decoration-none">@L["View register"] &rarr;</a>
            </div>
        </div>
    </div>

</div>

@* ══════════════════════════════════════════════════════════════════
   QUALITY SYSTEMS
   ══════════════════════════════════════════════════════════════════ *@

<p class="text-uppercase text-muted fw-semibold small mb-2">@L["Quality Systems"]</p>
<div class="row g-3 mb-4">

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #0dcaf0 !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">@L["Active Audits"]</p>
                <h2 class="fw-bold mb-0">@Model.ActiveAudits</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Audits" asp-action="Index" class="small text-muted text-decoration-none">@L["View register"] &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #dc3545 !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">@L["Open Risks"]</p>
                <h2 class="fw-bold mb-0">@Model.OpenRisks</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Risks" asp-action="Index" class="small text-muted text-decoration-none">@L["View register"] &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #198754 !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">@L["Scheduled Trainings"]</p>
                <h2 class="fw-bold mb-0">@Model.ScheduledTrainings</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Trainings" asp-action="Index" class="small text-muted text-decoration-none">@L["View register"] &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #6c757d !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">@L["Documents in Progress"]</p>
                <h2 class="fw-bold mb-0">@Model.DocumentsForReview</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="AppDocuments" asp-action="Index" class="small text-muted text-decoration-none">@L["View register"] &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid @(Model.DocsReviewOverdue > 0 ? "#dc3545" : "#6c757d") !important;">
            <div class="card-body pb-2">
