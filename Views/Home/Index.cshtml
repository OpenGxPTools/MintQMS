@model OpenQMS.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";

    string Badge(string cls) => cls == "warning" ? "bg-warning text-dark" : "bg-" + cls;
}

@* ── Page header ──────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Quality Overview</h2>
    <span class="text-muted small">@SiteTime.Today.ToString("dddd, d MMMM yyyy")</span>
</div>

@* ══════════════════════════════════════════════════════════════════
   MY ITEMS  (personalised)
   ══════════════════════════════════════════════════════════════════ *@

<p class="text-uppercase text-muted fw-semibold small mb-2">My Items</p>
<div class="row g-3 mb-3">

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #fd7e14 !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">My Open CAPAs</p>
                <h2 class="fw-bold mb-0">@Model.MyCAPAs</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Capas" asp-action="Index" class="small text-muted text-decoration-none">View register &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #fd7e14 !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">My Open Deviations</p>
                <h2 class="fw-bold mb-0">@Model.MyDeviations</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Deviations" asp-action="Index" class="small text-muted text-decoration-none">View register &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #6c757d !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">My Documents</p>
                <h2 class="fw-bold mb-0">@Model.MyDocuments</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="AppDocuments" asp-action="Index" class="small text-muted text-decoration-none">View register &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #198754 !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">My Trainings</p>
                <h2 class="fw-bold mb-0">@Model.MyTrainings</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Trainings" asp-action="Index" class="small text-muted text-decoration-none">View register &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #0d6efd !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">My Open Changes</p>
                <h2 class="fw-bold mb-0">@Model.MyChanges</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Changes" asp-action="Index" class="small text-muted text-decoration-none">View register &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #dc3545 !important;">
            <div class="card-body pb-2">
                <p class="text-uppercase text-muted small fw-semibold mb-1">My Open Risks</p>
                <h2 class="fw-bold mb-0">@Model.MyRisks</h2>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Risks" asp-action="Index" class="small text-muted text-decoration-none">View register &rarr;</a>
            </div>
        </div>
    </div>

</div>

@if (Model.MyCAPAs > 0 || Model.MyDeviations > 0 || Model.MyDocuments > 0 || Model.MyTrainings > 0 || Model.MyChanges > 0 || Model.MyRisks > 0)
{
    <div class="row g-4 mb-5">

        @if (Model.MyRecentCAPAs.Any())
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">My Open CAPAs</span>
                        <a asp-controller="Capas" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Status</th><th class="pe-3">Date</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.MyRecentCAPAs)
                                {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="Capas" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:180px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (Model.MyRecentDeviations.Any())
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">My Open Deviations</span>
                        <a asp-controller="Deviations" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Status</th><th class="pe-3">Date</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.MyRecentDeviations)
                                {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="Deviations" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:180px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (Model.MyRecentDocuments.Any())
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">My Documents for Review</span>
                        <a asp-controller="AppDocuments" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Status</th><th class="pe-3">Authored</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.MyRecentDocuments)
                                {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="AppDocuments" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:180px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (Model.MyRecentTrainings.Any())
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">My Scheduled Trainings</span>
                        <a asp-controller="Trainings" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Name</th><th>Status</th><th class="pe-3">Date</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.MyRecentTrainings)
                                {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="Trainings" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:180px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (Model.MyRecentChanges.Any())
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">My Open Changes</span>
                        <a asp-controller="Changes" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Status</th><th class="pe-3">Proposed</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.MyRecentChanges)
                                {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="Changes" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:180px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (Model.MyRecentRisks.Any())
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">My Open Risks</span>
                        <a asp-controller="Risks" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Status</th><th class="pe-3">Identified</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.MyRecentRisks)
                                {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="Risks" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:180px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

    </div>
}
else
{
    <p class="text-muted small mb-5">Nothing currently assigned to you.</p>
}

@* ══════════════════════════════════════════════════════════════════
   PENDING MY ACTION  (Quality Manager / Regulatory Manager)
   ══════════════════════════════════════════════════════════════════ *@

@if (Model.IsQualityManager || Model.IsRegulatoryManager)
{
    <p class="text-uppercase text-muted fw-semibold small mb-3">Pending My Action</p>
    <div class="row g-4 mb-5">

        @* ── Quality Manager tables ── *@
        @if (Model.IsQualityManager)
        {
            @* Pending CAPAs *@
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">CAPAs Pending Action</span>
                        <a asp-controller="Capas" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    @if (!Model.PendingCAPAs.Any()) { <div class="card-body text-muted small">No CAPAs pending your action.</div> }
                    else {
                        <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Action Required</th><th class="pe-3">Date</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.PendingCAPAs) {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="Capas" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:160px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>
            </div>

            @* Pending Deviations *@
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Deviations Pending Action</span>
                        <a asp-controller="Deviations" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    @if (!Model.PendingDeviations.Any()) { <div class="card-body text-muted small">No deviations pending your action.</div> }
                    else {
                        <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Action Required</th><th class="pe-3">Date</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.PendingDeviations) {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="Deviations" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:160px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>
            </div>

            @* Pending Changes *@
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Changes Pending Action</span>
                        <a asp-controller="Changes" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    @if (!Model.PendingChanges.Any()) { <div class="card-body text-muted small">No changes pending your action.</div> }
                    else {
                        <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Action Required</th><th class="pe-3">Date</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.PendingChanges) {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="Changes" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:160px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>
            </div>

            @* Pending Audits *@
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Audits Pending Action</span>
                        <a asp-controller="Audits" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    @if (!Model.PendingAudits.Any()) { <div class="card-body text-muted small">No audits pending action.</div> }
                    else {
                        <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Action Required</th><th class="pe-3">Scheduled</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.PendingAudits) {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="Audits" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:160px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>
            </div>

            @* Pending Documents *@
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Documents Pending Approval</span>
                        <a asp-controller="AppDocuments" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    @if (!Model.PendingDocuments.Any()) { <div class="card-body text-muted small">No documents pending approval.</div> }
                    else {
                        <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Action Required</th><th class="pe-3">Authored</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.PendingDocuments) {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="AppDocuments" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:160px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>
            </div>

            @* Pending Complaints *@
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Complaints Pending Action</span>
                        <a asp-controller="Complaints" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    @if (!Model.PendingComplaints.Any()) { <div class="card-body text-muted small">No complaints pending your action.</div> }
                    else {
                        <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Action Required</th><th class="pe-3">Received</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.PendingComplaints) {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="Complaints" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:160px;">@item.Title</td>
                                        <td><span class="badge @Badge(item.BadgeClass)">@item.Status</span></td>
                                        <td class="text-muted small pe-3 text-nowrap">@item.Date.ToSite().ToString("dd MMM yy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table></div>
                    }
                </div>
            </div>

            @* Pending Risks *@
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Risks Pending Action</span>
                        <a asp-controller="Risks" asp-action="Index" class="small text-muted text-decoration-none">View all &rarr;</a>
                    </div>
                    @if (!Model.PendingRisks.Any()) { <div class="card-body text-muted small">No risks pending your action.</div> }
                    else {
                        <div class="table-responsive"><table class="table table-sm table-hover mb-0">
                            <thead class="table-light"><tr><th class="ps-3">ID</th><th>Title</th><th>Action Required</th><th class="pe-3">Identified</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.PendingRisks) {
                                    <tr>
                                        <td class="ps-3"><a asp-controller="Risks" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-semibold">@item.RecordId</a></td>
                                        <td class="text-truncate" style="max-width:160px;">@item.Title</td>
