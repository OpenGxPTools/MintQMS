@model OpenQMS.Models.Material

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var products = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Products"];
    var processes = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Processes"];
    var selProductIds = (List<int>)(ViewBag.SelectedProductIds ?? new List<int>());
    var selProcessIds = (List<int>)(ViewBag.SelectedProcessIds ?? new List<int>());
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">Edit Material — @Model.MaterialId</h4>
    </div>
</div>
<hr />

<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="MaterialId" />
    <input type="hidden" asp-for="GeneratedFrom" value="@Model.GeneratedFrom" />
    <input type="hidden" asp-for="Version" />
    <input type="hidden" asp-for="EditedBy" value="@Model.EditedBy" />
    <input type="hidden" asp-for="EditedOn" value="@(Model.EditedOn.ToSite())" />
    <input type="hidden" asp-for="ApprovedBy" value="@Model.ApprovedBy" />
    <input type="hidden" asp-for="ApprovedOn" value="@(Model.ApprovedOn.ToSite())" />
    <input type="hidden" asp-for="IsLocked" value="@Model.IsLocked" />
    <input type="hidden" asp-for="Status" value="@Model.Status" />

    <div class="card mb-4">
        <div class="card-header fw-semibold">Material Details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MaterialCategory" class="form-label"></label>
                    <select asp-for="MaterialCategory" class="form-select">
                        <option value="">-- Select Type / Category --</option>
                        <option value="API">API</option>
                        <option value="Excipient">Excipient</option>
                        <option value="Cosmetic Ingredient">Cosmetic Ingredient</option>
                        <option value="Packaging">Packaging</option>
                        <option value="Device Part">Device Part</option>
                        <option value="Device Subcomponent">Device Subcomponent</option>
                        <option value="Consumable">Consumable</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Products</label>
                    <select id="productDropdown" class="form-select">
                        <option value="">-- Add Product --</option>
                        @foreach (var p in products)
                        {
                            <option value="@p.Value" data-text="@p.Text">@p.Text</option>
                        }
                    </select>
                    <div id="productTags" class="mt-2 d-flex flex-wrap gap-1"></div>
                    <div id="productHidden" class="d-none"></div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Processes</label>
                    <select id="processDropdown" class="form-select">
                        <option value="">-- Add Process --</option>
                        @foreach (var p in processes)
                        {
                            <option value="@p.Value" data-text="@p.Text">@p.Text</option>
                        }
                    </select>
                    <div id="processTags" class="mt-2 d-flex flex-wrap gap-1"></div>
                    <div id="processHidden" class="d-none"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Related Documents</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">Linked Approved Documents</label>
                    <select id="relatedDocDropdown" class="form-select">
                        <option value="">-- Add Document --</option>
                        @foreach (var d in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["EffectiveDocs"])
                        {
                            <option value="@d.Value" data-text="@d.Text">@d.Text</option>
                        }
                    </select>
                    <div id="relatedDocTags" class="mt-2 d-flex flex-wrap gap-1"></div>
                    <div id="relatedDocHidden" class="d-none"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function setupPicker(dropdownId, tagsId, hiddenId, inputName, preselected) {
            var selected = {};
            preselected.forEach(function (item) { selected[item.id] = item.text; });

            function render() {
                var tagsDiv = document.getElementById(tagsId);
                var hiddenDiv = document.getElementById(hiddenId);
                tagsDiv.innerHTML = '';
                hiddenDiv.innerHTML = '';
                Object.keys(selected).forEach(function (id) {
                    var badge = document.createElement('span');
                    badge.className = 'badge bg-primary d-flex align-items-center gap-1';
                    badge.style.fontSize = '0.85rem';
                    badge.textContent = selected[id];
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn-close btn-close-white btn-sm ms-1';
                    btn.style.fontSize = '0.6rem';
                    btn.addEventListener('click', function () { delete selected[id]; render(); });
                    badge.appendChild(btn);
                    tagsDiv.appendChild(badge);
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = inputName;
                    input.value = id;
                    hiddenDiv.appendChild(input);
                });
            }

            document.getElementById(dropdownId).addEventListener('change', function () {
                var id = this.value;
                var text = this.options[this.selectedIndex].dataset.text;
                if (id && !selected[id]) { selected[id] = text; render(); }
                this.value = '';
            });

            render();
        }

        var selProducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            products.Where(x => selProductIds.Contains(int.Parse(x.Value)))
                    .Select(x => new { id = x.Value, text = x.Text }).ToList()));

        var selProcesses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            processes.Where(x => selProcessIds.Contains(int.Parse(x.Value)))
                     .Select(x => new { id = x.Value, text = x.Text }).ToList()));

        setupPicker('productDropdown', 'productTags', 'productHidden', 'selectedProducts', selProducts);
        setupPicker('processDropdown', 'processTags', 'processHidden', 'selectedProcesses', selProcesses);

        var selRelatedDocs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ((List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["EffectiveDocs"])
                .Where(x => ((List<int>)ViewBag.SelectedRelatedDocIds).Contains(int.Parse(x.Value)))
                .Select(x => new { id = x.Value, text = x.Text }).ToList()));
        setupPicker('relatedDocDropdown', 'relatedDocTags', 'relatedDocHidden', 'selectedRelatedDocs', selRelatedDocs);
    </script>
}
