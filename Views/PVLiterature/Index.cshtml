@model IEnumerable<OpenQMS.Models.PVLiteratureSearch>
@{
    ViewData["Title"] = "Literature Monitoring Log";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-book-open me-2 text-primary"></i>Literature Monitoring Log</h4>
    @if (User.IsInRole("Administrator") || User.IsInRole("RegulatoryManager") || User.IsInRole("RegulatoryUser"))
    {
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i>Log New Search
        </a>
    }
</div>

<div class="alert alert-info small mb-3">
    <i class="fas fa-info-circle me-1"></i>
    TGA requires documented evidence of regular literature monitoring for any product under PV surveillance.
    All searches should be logged here promptly after completion.
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-striped table-hover" id="litTable">
    <thead class="table-dark">
        <tr>
            <th>Search Date</th>
            <th>Searched By</th>
            <th>Databases</th>
            <th>Date Range</th>
            <th class="text-center">Results</th>
            <th class="text-center">Relevant</th>
            <th class="text-center">AEs Found</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr class="@(s.AEsIdentified > 0 ? "table-warning" : "")">
                <td>@s.SearchDate.ToString("dd MMM yyyy")</td>
                <td>@s.SearchedBy</td>
                <td><small>@(s.DatabasesSearched ?? "—")</small></td>
                <td>
                    <small>
                        @(s.DateRangeFrom?.ToString("dd MMM yyyy") ?? "—")
                        @if (s.DateRangeFrom.HasValue) { <span>→</span> }
                        @(s.DateRangeTo?.ToString("dd MMM yyyy") ?? "")
                    </small>
                </td>
                <td class="text-center">@s.ResultsCount</td>
                <td class="text-center">@s.RelevantResults</td>
                <td class="text-center">
                    @if (s.AEsIdentified > 0) {
                        <span class="badge bg-warning text-dark">@s.AEsIdentified</span>
                    } else { <span class="text-muted">0</span> }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">View</a>
                    <a asp-action="Edit"    asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted text-center mt-4">No literature search records yet.</p>
}

@section Scripts {
<script>
    $(document).ready(function () {
        $('#litTable').DataTable({ stateSave: true, order: [[0, 'desc']], language: { searchPlaceholder: 'Search within filtered results…', search: '' } });
    });
</script>
}
