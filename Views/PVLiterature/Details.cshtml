@model OpenQMS.Models.PVLiteratureSearch
@{
    ViewData["Title"] = $"Literature Search — {Model.SearchDate:dd MMM yyyy}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-book-open me-2 text-primary"></i>Literature Search — @Model.SearchDate.ToString("dd MMM yyyy")</h4>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-edit me-1"></i>Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-2">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-0" id="litTabs">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-details">Details</a></li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-audit">
            Audit Trail
            @if ((Model.AuditLogs?.Count ?? 0) > 0) { <span class="badge bg-secondary">@Model.AuditLogs!.Count</span> }
        </a>
    </li>
</ul>
<div class="tab-content border border-top-0 rounded-bottom p-3 mb-3">
<div class="tab-pane fade show active" id="tab-details">

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Search Date</dt>
            <dd class="col-sm-9">@Model.SearchDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Searched By</dt>
            <dd class="col-sm-9">@Model.SearchedBy</dd>
            <dt class="col-sm-3">Databases Searched</dt>
            <dd class="col-sm-9">@(Model.DatabasesSearched ?? "—")</dd>
            <dt class="col-sm-3">Search Terms</dt>
            <dd class="col-sm-9" style="white-space:pre-wrap">@(Model.SearchTerms ?? "—")</dd>
            <dt class="col-sm-3">Publication Date Range</dt>
            <dd class="col-sm-9">
                @(Model.DateRangeFrom?.ToString("dd MMM yyyy") ?? "—")
                @if (Model.DateRangeFrom.HasValue && Model.DateRangeTo.HasValue) { <span> → </span> }
                @(Model.DateRangeTo?.ToString("dd MMM yyyy") ?? "")
            </dd>
            <dt class="col-sm-3">Total Results</dt>
            <dd class="col-sm-9">@Model.ResultsCount</dd>
            <dt class="col-sm-3">Relevant Results</dt>
            <dd class="col-sm-9">@Model.RelevantResults</dd>
            <dt class="col-sm-3">AEs Identified</dt>
            <dd class="col-sm-9">
                @if (Model.AEsIdentified > 0) {
                    <span class="badge bg-warning text-dark fs-6">@Model.AEsIdentified</span>
                } else { <span>0</span> }
            </dd>
            <dt class="col-sm-3">Notes / Findings</dt>
            <dd class="col-sm-9" style="white-space:pre-wrap">@(Model.Notes ?? "—")</dd>
        </dl>
    </div>
</div>

</div><!-- end tab-details -->

<div class="tab-pane fade" id="tab-audit">
<!-- Audit Log -->
<div class="card shadow-sm">
    <div class="card-header fw-bold">
        <i class="fas fa-history me-1"></i>Audit Trail
        <span class="badge bg-secondary ms-2">@(Model.AuditLogs?.Count ?? 0)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.AuditLogs != null && Model.AuditLogs.Any())
        {
            <table class="table table-sm table-bordered mb-0">
                <thead class="table-light">
                    <tr><th>Date/Time <span class="fw-normal text-muted">(@SiteTime.Label)</span></th><th>Action</th><th>From</th><th>To</th><th>Performed By</th><th>Notes</th></tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.AuditLogs.OrderByDescending(l => l.PerformedOn))
                    {
                        <tr>
                            <td>@log.PerformedOn.ToSite().ToString("dd MMM yyyy HH:mm")</td>
                            <td>@log.Action</td>
                            <td>@(log.FromStatus ?? "-")</td>
                            <td>@(log.ToStatus ?? "-")</td>
                            <td>@log.PerformedBy</td>
                            <td>@(log.Notes ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <p class="text-muted p-3 mb-0">No audit log entries yet.</p> }
    </div>
</div>
</div><!-- end tab-audit -->
</div><!-- end tab-content -->
