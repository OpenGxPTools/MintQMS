@model OpenQMS.Models.Deviation

@{
    ViewData["Title"] = "Attachments";
}

<h2>Attachments for Deviation: @Model.Title</h2>
<hr />

@if (Model.Status != OpenQMS.Models.Deviation.DeviationStatus.Approved)
{
    <div class="row">
        <div class="col-md-8">
            <h4>Upload New Attachment</h4>
            <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data">
                <input type="hidden" name="deviationId" value="@Model.Id" />
                
                <div class="form-group mb-3">
                    <label>Select File:</label>
                    <input type="file" class="form-control" name="file" required />
                </div>
                
                <div class="form-group mb-3">
                    <label>Description (optional):</label>
                    <input type="text" class="form-control" name="description" placeholder="e.g., Investigation Report" />
                </div>
                
                <button type="submit" class="btn btn-primary">Upload</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back to Deviation</a>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <strong>Record Approved:</strong> This deviation is approved. No new attachments can be uploaded.
        <br />
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary mt-2">Back to Deviation</a>
    </div>
}

<hr />

<h4>Attached Files (@(Model.Attachments?.Count ?? 0))</h4>

@if (Model.Attachments != null && Model.Attachments.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>File Name</th>
                <th>Description</th>
                <th>Size</th>
                <th>Uploaded By</th>
                <th>Uploaded Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attachment in Model.Attachments.OrderByDescending(a => a.UploadedDate))
            {
                <tr>
                    <td>@attachment.FileName</td>
                    <td>@(attachment.Description ?? "-")</td>
                    <td>@((attachment.FileSize / 1024.0).ToString("N2")) KB</td>
                    <td>@attachment.UploadedBy</td>
                    <td>@attachment.UploadedDate.ToSite().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a asp-action="ViewAttachment" asp-route-id="@attachment.Id" class="btn btn-sm btn-outline-secondary" target="_blank"><i class="bi bi-eye me-1"></i>View</a>
                        <a asp-action="DownloadAttachment" asp-route-id="@attachment.Id" class="btn btn-sm btn-primary">Download</a>
                        @if (Model.Status != OpenQMS.Models.Deviation.DeviationStatus.Approved)
                        {
                            <form asp-action="DeleteAttachment" method="post" style="display:inline;" data-delete-reason="attachment">
                                <input type="hidden" name="id" value="@attachment.Id" />
                                <input type="hidden" name="deviationId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No attachments yet.</p>
}
