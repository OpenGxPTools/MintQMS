@model OpenQMS.Models.Deviation

@{
    ViewData["Title"] = "Delete Deviation";

    var iLinked = new List<string>();
    if (Model.LinkedProducts?.Any()  == true) iLinked.AddRange(Model.LinkedProducts.Select(x => x.Product?.Name ?? "").Where(n => n != ""));
    if (Model.LinkedProcesses?.Any() == true) iLinked.AddRange(Model.LinkedProcesses.Select(x => x.Process?.Name ?? "").Where(n => n != ""));
    if (Model.LinkedAssets?.Any()    == true) iLinked.AddRange(Model.LinkedAssets.Select(x => x.Asset?.Name ?? "").Where(n => n != ""));
    if (Model.LinkedMaterials?.Any() == true) iLinked.AddRange(Model.LinkedMaterials.Select(x => x.Material?.Name ?? "").Where(n => n != ""));
    if (Model.LinkedSuppliers?.Any() == true) iLinked.AddRange(Model.LinkedSuppliers.Select(x => x.Supplier?.LegalName ?? "").Where(n => n != ""));
    if (!iLinked.Any())
    {
        if (Model.Product  != null) iLinked.Add(Model.Product.Name);
        if (Model.Process  != null) iLinked.Add(Model.Process.Name);
        if (Model.Asset    != null) iLinked.Add(Model.Asset.Name);
        if (Model.Material != null) iLinked.Add(Model.Material.Name);
        if (Model.Supplier != null) iLinked.Add(Model.Supplier.LegalName);
    }
}

<h4>Delete Deviation</h4>
<hr />
<h5 class="text-danger">Are you sure you want to delete this?</h5>
<div>
    <dl class="row">
        <dt class="col-sm-2">Deviation ID</dt>
        <dd class="col-sm-10">@Model.DeviationId</dd>

        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Linked Records</dt>
        <dd class="col-sm-10">@(iLinked.Any() ? string.Join(", ", iLinked) : "-")</dd>

        <dt class="col-sm-2">Identification</dt>
        <dd class="col-sm-10">@Model.Identification</dd>

        <dt class="col-sm-2">Identified By</dt>
        <dd class="col-sm-10">@Model.IdentifiedBy</dd>

        <dt class="col-sm-2">Identified On</dt>
        <dd class="col-sm-10">@Model.IdentifiedOn.ToSite().ToShortDateString()</dd>

        <dt class="col-sm-2">Evaluation</dt>
        <dd class="col-sm-10">@(Model.Evaluation ?? "-")</dd>

        <dt class="col-sm-2">Evaluated By</dt>
        <dd class="col-sm-10">@(Model.EvaluatedBy ?? "-")</dd>

        <dt class="col-sm-2">Evaluated On</dt>
        <dd class="col-sm-10">@(Model.EvaluatedOn.HasValue ? Model.EvaluatedOn.Value.ToSite().ToShortDateString() : "-")</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@EnumHelper.Display(Model.Status)</dd>
    </dl>

    @if (Model.Capas != null && Model.Capas.Any())
    {
        <h5 class="mt-3">Linked CAPAs</h5>
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Capas)
                {
                    <tr>
                        <td><a href="/Capas/Details/@item.Id">@item.CapaId</a></td>
                        <td>@item.Title</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <br />
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
