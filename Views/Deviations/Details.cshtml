<!-- Return for Rework Modal -->
@if (canReturn)
{
    <div class="modal fade" id="returnModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="ReturnDeviation" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-header bg-warning">
                        <h5 class="modal-title"><i class="fas fa-undo me-1"></i>Return for Rework — @Model.DeviationId</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small">
                            @if (Model.Status == OpenQMS.Models.Deviation.DeviationStatus.Evaluation)
                            { <text>Returns to <strong>Identification</strong> status.</text> }
                            else if (Model.Status == OpenQMS.Models.Deviation.DeviationStatus.PendingAcceptance)
                            { <text>Returns to <strong>Evaluation</strong> status — evaluation fields will be unlocked for rework.</text> }
                            else if (Model.Status == OpenQMS.Models.Deviation.DeviationStatus.Accepted)
                            { <text>Returns to <strong>Evaluation</strong> status — evaluation fields will be unlocked for full rework.</text> }
                            else
                            { <text>Returns to <strong>Accepted</strong> status — resolution field will be unlocked for rework.</text> }
                        </p>
                        <div class="mb-3">
                            <label class="form-label">Reason for Return <span class="text-danger">*</span></label>
                            <textarea name="reason" class="form-control" rows="3" required
                                placeholder="Describe why this record is being returned and what needs to be addressed."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="email" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" name="pwd" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning">Confirm Return</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

