@using OpenQMS.Authorization
@{
    ViewData["Title"] = "Deviations Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statusCounts = (Dictionary<string, int>)ViewBag.StatusCounts;
    var aged = (List<OpenQMS.Models.Deviation>)ViewBag.Aged;
    var overdue = (List<OpenQMS.Models.Deviation>)ViewBag.Overdue;
    var pendingAcceptance = (List<OpenQMS.Models.Deviation>)ViewBag.PendingAcceptance;
    var pendingApproval = (List<OpenQMS.Models.Deviation>)ViewBag.PendingApproval;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Deviations Dashboard</h2>
    <div class="d-flex gap-2">
        <a asp-action="ExportRegister" class="btn btn-outline-success">Export Excel</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Register</a>
        @if (User.IsInRole(Constants.AdministratorsRole) || User.IsInRole(Constants.QualityManagerRole) || User.IsInRole(Constants.QualityUserRole))
        {
            <a asp-action="Create" class="btn btn-primary">+ New Deviation</a>
        }
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-primary">@ViewBag.Total</div>
                <div class="text-muted">Total Deviations</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-warning">@ViewBag.OpenCount</div>
                <div class="text-muted">Open</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-success">@ViewBag.ApprovedCount</div>
                <div class="text-muted">Approved</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100 @(aged.Count > 0 ? "border-warning" : "")">
            <div class="card-body">
                <div class="display-5 fw-bold @(aged.Count > 0 ? "text-warning" : "text-secondary")">@aged.Count</div>
                <div class="text-muted">Aged (&gt;30 days)</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100 @(overdue.Count > 0 ? "border-danger" : "")">
            <div class="card-body">
                <div class="display-5 fw-bold @(overdue.Count > 0 ? "text-danger" : "text-secondary")">@overdue.Count</div>
                <div class="text-muted">Overdue (past target)</div>
            </div>
        </div>
    </div>
</div>

<!-- Status Chart + Breakdown -->
<div class="row g-3 mb-4">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">Status Distribution</div>
            <div class="card-body d-flex justify-content-center align-items-center">
                <canvas id="statusChart" style="max-height:220px"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header">Status Breakdown</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Status</th><th>Count</th><th style="width:40%">Progress</th></tr></thead>
                    <tbody>
                        @foreach (var kv in statusCounts)
                        {
                            var pct = ViewBag.Total > 0 ? (kv.Value * 100 / (int)ViewBag.Total) : 0;
                            var barClass = kv.Key switch
                            {
                                "Identification"    => "bg-secondary",
                                "Evaluation"        => "bg-info",
                                "Pending Acceptance" => "bg-primary",
                                "Accepted"          => "bg-warning",
                                "Resolution"        => "bg-warning",
                                "Approved"          => "bg-success",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td>@kv.Key</td>
                                <td>@kv.Value</td>
                                <td>
                                    <div class="progress" style="height:8px">
                                        <div class="progress-bar @barClass" style="width:@pct%"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Pending Workflow -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span>Pending Acceptance</span>
                <span class="badge bg-warning text-dark">@pendingAcceptance.Count</span>
            </div>
            <div class="card-body p-0">
                @if (pendingAcceptance.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>ID</th><th>Title</th><th>Identified</th></tr></thead>
                        <tbody>
                            @foreach (var d in pendingAcceptance)
                            {
                                <tr>
                                    <td><a asp-action="Details" asp-route-id="@d.Id">@d.DeviationId</a></td>
                                    <td>@d.Title</td>
                                    <td>@d.IdentifiedOn.ToSite().ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted p-3 mb-0">None pending.</p> }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span>Pending Approval</span>
                <span class="badge bg-warning text-dark">@pendingApproval.Count</span>
            </div>
            <div class="card-body p-0">
                @if (pendingApproval.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>ID</th><th>Title</th><th>Identified</th></tr></thead>
                        <tbody>
                            @foreach (var d in pendingApproval)
                            {
                                <tr>
                                    <td><a asp-action="Details" asp-route-id="@d.Id">@d.DeviationId</a></td>
                                    <td>@d.Title</td>
                                    <td>@d.IdentifiedOn.ToSite().ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted p-3 mb-0">None pending.</p> }
            </div>
        </div>
    </div>
</div>

<!-- Overdue Deviations -->
@if (overdue.Any())
{
    <div class="card mb-4 border-danger">
        <div class="card-header bg-danger text-white d-flex justify-content-between">
            <span>Overdue Open Deviations (past target resolution date)</span>
            <span class="badge bg-dark">@overdue.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead><tr><th>ID</th><th>Title</th><th>Status</th><th>Target Resolution</th><th>Days Overdue</th></tr></thead>
                <tbody>
                    @foreach (var d in overdue)
                    {
                        var over = (SiteTime.Today - d.TargetResolutionDate!.Value.Date).Days;
                        <tr class="table-danger">
                            <td><a asp-action="Details" asp-route-id="@d.Id">@d.DeviationId</a></td>
                            <td>@d.Title</td>
                            <td>@EnumHelper.Display(d.Status)</td>
                            <td>@d.TargetResolutionDate!.Value.ToShortDateString()</td>
                            <td><strong>@over days</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Aged Deviations -->
@if (aged.Any())
{
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning d-flex justify-content-between">
            <span>Aged Open Deviations (&gt;30 days)</span>
            <span class="badge bg-dark">@aged.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead><tr><th>ID</th><th>Title</th><th>Status</th><th>Identified On</th><th>Age (days)</th></tr></thead>
                <tbody>
                    @foreach (var d in aged)
                    {
                        var age = (SiteTime.Today - d.IdentifiedOn.Date).Days;
                        <tr class="table-warning">
                            <td><a asp-action="Details" asp-route-id="@d.Id">@d.DeviationId</a></td>
                            <td>@d.Title</td>
                            <td>@EnumHelper.Display(d.Status)</td>
                            <td>@d.IdentifiedOn.ToSite().ToShortDateString()</td>
                            <td><strong>@age days</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Recent Activity -->
<div class="card">
    <div class="card-header">Recent Activity</div>
    <div class="card-body p-0">
        @{
            var recentActivity = ViewBag.RecentActivity as dynamic;
        }
        @if (recentActivity != null)
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Time</th><th>Deviation</th><th>Action</th><th>By</th></tr></thead>
                <tbody>
                    @foreach (var entry in recentActivity)
                    {
                        <tr>
                            <td class="text-nowrap text-muted small">@(SiteTime.ToSite((DateTime)entry.Log.PerformedOn).ToString("yyyy-MM-dd HH:mm"))</td>
                            <td><a asp-action="Details" asp-route-id="@entry.RecordId">@entry.DeviationId</a> — @entry.Title</td>
                            <td>@entry.Log.Action</td>
                            <td>@entry.Log.PerformedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <p class="text-muted p-3 mb-0">No activity recorded yet.</p> }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    var labels = @Json.Serialize(statusCounts.Keys.ToList());
    var data   = @Json.Serialize(statusCounts.Values.ToList());
    var colors = ['#6c757d','#0dcaf0','#0d6efd','#ffc107','#fd7e14','#198754'];
    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: { labels: labels, datasets: [{ data: data, backgroundColor: colors }] },
        options: { plugins: { legend: { position: 'bottom' } }, maintainAspectRatio: true }
    });
})();
</script>
}
