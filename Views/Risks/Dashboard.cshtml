@{
    ViewData["Title"] = "Risk Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statusCounts   = (Dictionary<string, int>)ViewBag.StatusCounts;
    var categoryCounts = (Dictionary<string, int>)ViewBag.CategoryCounts;
    var overdue        = (List<OpenQMS.Models.Risk>)ViewBag.Overdue;
    var approaching    = (List<OpenQMS.Models.Risk>)ViewBag.Approaching;
    var highRPNList    = (List<OpenQMS.Models.Risk>)ViewBag.HighRPNList;
    var pendingAssess  = (List<OpenQMS.Models.Risk>)ViewBag.PendingAssessment;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Risk Dashboard</h4>
    <div class="d-flex gap-2">
        <a asp-action="ExportRegister" class="btn btn-outline-success btn-sm">Export Excel</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Register</a>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Risk</a>
    </div>
</div>

@if ((int)ViewBag.HighRPN > 0)
{
    <div class="alert alert-danger d-flex align-items-center mb-4">
        <strong class="me-2">&#9888;</strong>
        <span><strong>@ViewBag.HighRPN high-RPN open risk(s)</strong> (RPN ≥ 80) require immediate attention.</span>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-primary">@ViewBag.Total</div>
                <div class="text-muted">Total Risks</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-warning">@ViewBag.OpenCount</div>
                <div class="text-muted">Open</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-success">@ViewBag.ClosedCount</div>
                <div class="text-muted">Closed</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100 @((int)ViewBag.HighRPN > 0 ? "border-danger" : "")">
            <div class="card-body">
                <div class="display-5 fw-bold @((int)ViewBag.HighRPN > 0 ? "text-danger" : "text-secondary")">@ViewBag.HighRPN</div>
                <div class="text-muted">High RPN Open</div>
            </div>
        </div>
    </div>
</div>

<!-- RPN Band Breakdown -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-danger">
            <div class="card-header bg-danger text-white d-flex justify-content-between">
                <span>High Risk (RPN ≥ 80)</span>
                <span class="badge bg-white text-danger">@ViewBag.HighRPN</span>
            </div>
            <div class="card-body text-center">
                <div class="display-6 fw-bold text-danger">@ViewBag.HighRPN</div>
                <small class="text-muted">Immediate action required</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-warning">
            <div class="card-header bg-warning d-flex justify-content-between">
                <span>Medium Risk (RPN 40–79)</span>
                <span class="badge bg-dark">@ViewBag.MediumRPN</span>
            </div>
            <div class="card-body text-center">
                <div class="display-6 fw-bold text-warning">@ViewBag.MediumRPN</div>
                <small class="text-muted">Action plan required</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-success">
            <div class="card-header bg-success text-white d-flex justify-content-between">
                <span>Low Risk (RPN &lt; 40)</span>
                <span class="badge bg-white text-success">@ViewBag.LowRPN</span>
            </div>
            <div class="card-body text-center">
                <div class="display-6 fw-bold text-success">@ViewBag.LowRPN</div>
                <small class="text-muted">Monitor</small>
            </div>
        </div>
    </div>
</div>

<!-- Status Chart + Status Table -->
<div class="row g-3 mb-4">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">Status Distribution</div>
            <div class="card-body d-flex justify-content-center align-items-center">
                <canvas id="statusChart" style="max-height:220px"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header">Status Breakdown</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Status</th><th>Count</th><th style="width:40%">Progress</th></tr></thead>
                    <tbody>
                        @foreach (var kv in statusCounts)
                        {
                            var pct = (int)ViewBag.Total > 0 ? (kv.Value * 100 / (int)ViewBag.Total) : 0;
                            var barClass = kv.Key switch
                            {
                                "Identification" => "bg-secondary",
                                "Assessment"     => "bg-info",
                                "Mitigation"     => "bg-warning",
                                "Review"         => "bg-primary",
                                "Closed"         => "bg-success",
                                _                => "bg-secondary"
                            };
                            <tr>
                                <td>@kv.Key</td>
                                <td>@kv.Value</td>
                                <td><div class="progress" style="height:8px"><div class="progress-bar @barClass" style="width:@pct%"></div></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- High RPN + Pending Assessment -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100 @(highRPNList.Any() ? "border-danger" : "")">
            <div class="card-header d-flex justify-content-between @(highRPNList.Any() ? "bg-danger text-white" : "")">
                <span>Open High-RPN Risks</span>
                <span class="badge @(highRPNList.Any() ? "bg-white text-danger" : "bg-secondary")">@highRPNList.Count</span>
            </div>
            <div class="card-body p-0">
                @if (highRPNList.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>ID</th><th>Title</th><th>RPN</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var r in highRPNList)
                            {
                                <tr class="table-danger">
                                    <td><a asp-action="Details" asp-route-id="@r.Id">@r.RiskId</a></td>
                                    <td>@r.Title</td>
                                    <td><strong>@r.InitialRPN</strong></td>
                                    <td>@EnumHelper.Display(r.Status)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted p-3 mb-0">No high-RPN open risks.</p> }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span>Pending Assessment (Identification)</span>
                <span class="badge bg-warning text-dark">@pendingAssess.Count</span>
            </div>
            <div class="card-body p-0">
                @if (pendingAssess.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>ID</th><th>Title</th><th>RPN</th><th>Identified</th></tr></thead>
                        <tbody>
                            @foreach (var r in pendingAssess)
                            {
                                <tr>
                                    <td><a asp-action="Details" asp-route-id="@r.Id">@r.RiskId</a></td>
                                    <td>@r.Title</td>
                                    <td>@r.InitialRPN</td>
                                    <td>@r.IdentifiedOn.ToSite().ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted p-3 mb-0">None pending.</p> }
            </div>
        </div>
    </div>
</div>

<!-- Overdue + Approaching -->
@if (overdue.Any())
{
    <div class="card mb-4 border-danger">
        <div class="card-header bg-danger text-white d-flex justify-content-between">
            <span>Overdue Risks</span>
            <span class="badge bg-white text-danger">@overdue.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead><tr><th>ID</th><th>Title</th><th>Status</th><th>RPN</th><th>Target Date</th><th>Days Overdue</th></tr></thead>
                <tbody>
                    @foreach (var r in overdue)
                    {
                        var daysOver = (SiteTime.Today - r.TargetCompletionDate!.Value.Date).Days;
                        <tr class="table-danger">
                            <td><a asp-action="Details" asp-route-id="@r.Id">@r.RiskId</a></td>
                            <td>@r.Title</td>
                            <td>@EnumHelper.Display(r.Status)</td>
                            <td>@r.InitialRPN</td>
                            <td>@r.TargetCompletionDate.Value.ToShortDateString()</td>
                            <td><strong>@daysOver days</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (approaching.Any())
{
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning d-flex justify-content-between">
            <span>Due Within 14 Days</span>
            <span class="badge bg-dark">@approaching.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead><tr><th>ID</th><th>Title</th><th>Status</th><th>Target Date</th><th>Days Remaining</th></tr></thead>
                <tbody>
                    @foreach (var r in approaching)
                    {
                        var daysLeft = (r.TargetCompletionDate!.Value.Date - SiteTime.Today).Days;
                        <tr class="table-warning">
                            <td><a asp-action="Details" asp-route-id="@r.Id">@r.RiskId</a></td>
                            <td>@r.Title</td>
                            <td>@EnumHelper.Display(r.Status)</td>
                            <td>@r.TargetCompletionDate.Value.ToShortDateString()</td>
                            <td>@daysLeft days</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Recent Activity -->
<div class="card">
    <div class="card-header">Recent Activity</div>
    <div class="card-body p-0">
        @{
            var recentActivity = ViewBag.RecentActivity as dynamic;
        }
        @if (recentActivity != null)
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Time</th><th>Risk</th><th>Action</th><th>By</th></tr></thead>
                <tbody>
                    @foreach (var entry in recentActivity)
                    {
                        <tr>
                            <td class="text-nowrap text-muted small">@(SiteTime.ToSite((DateTime)entry.Log.PerformedOn).ToString("yyyy-MM-dd HH:mm"))</td>
                            <td><a asp-action="Details" asp-route-id="@entry.RecordId">@entry.RiskId</a> — @entry.Title</td>
                            <td>@entry.Log.Action</td>
                            <td>@entry.Log.PerformedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <p class="text-muted p-3 mb-0">No activity recorded yet.</p> }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    var labels = @Json.Serialize(statusCounts.Keys.ToList());
    var data   = @Json.Serialize(statusCounts.Values.ToList());
    var colors = ['#6c757d','#0dcaf0','#ffc107','#0d6efd','#198754'];

    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: { labels: labels, datasets: [{ data: data, backgroundColor: colors }] },
        options: { plugins: { legend: { position: 'bottom' } }, maintainAspectRatio: true }
    });
})();
</script>
}
