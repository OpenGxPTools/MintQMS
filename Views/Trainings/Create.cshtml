@using Microsoft.AspNetCore.Identity
@model OpenQMS.Models.Training

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var policies = (List<AppDocument>)ViewData["Policies"];
    var trainer = (List<AppUser>)ViewData["Trainer"];
    var roles = (List<AppRole>)ViewData["Roles"];
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">New Training</h4>
    </div>
</div>
<hr />

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="TrainingId" value="X" />
    <input type="hidden" asp-for="PolicyTitle" value="X" />
    <input type="hidden" asp-for="TrainerEmail" value="X" />

    <div class="card mb-4">
        <div class="card-header fw-semibold">Training Details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Training Type</label>
                    <div class="d-flex gap-4 mt-1">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="TrainingType" value="1" id="typeRA" checked />
                            <label class="form-check-label" for="typeRA">Read &amp; Acknowledge</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="TrainingType" value="2" id="typeCA" />
                            <label class="form-check-label" for="typeCA">Competency Assessment</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="DueDate" class="form-label"></label>
                    <input asp-for="DueDate" class="form-control" type="date" />
                    <small class="form-text text-muted">Optional — deadline for trainees to complete this training.</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Document</label>
                    <select asp-for="PolicyId" class="form-select" asp-items='new SelectList(policies,"Id","Title")'></select>
                    <span asp-validation-for="PolicyId" class="text-danger small"></span>
                </div>
                <div class="col-md-6" id="trainerField">
                    <label class="form-label">Trainer <span id="trainerRequired" class="text-danger d-none">*</span></label>
                    <select asp-for="TrainerId" class="form-select" asp-items='new SelectList(trainer,"Id","Email")'><option value="">— None —</option></select>
                    <span asp-validation-for="TrainerId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Role</label>
                    <select name="roles" class="form-select"
                            asp-items='new SelectList(roles.Select(r => new { Value = r.Name, Text = EnumHelper.RoleName(r.Name) }), "Value", "Text")'></select>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back to List</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function updateTrainerField() {
            var isCA = document.getElementById('typeCA').checked;
            document.getElementById('trainerRequired').classList.toggle('d-none', !isCA);
        }
        document.querySelectorAll('input[name="TrainingType"]').forEach(r => r.addEventListener('change', updateTrainerField));
        updateTrainerField();
    </script>
}
