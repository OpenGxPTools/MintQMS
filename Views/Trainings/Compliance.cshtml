@model IEnumerable<OpenQMS.Models.Navigation.UserTraining>
@using OpenQMS.Authorization
@using OpenQMS.Models.Navigation

@{
    ViewData["Title"] = "Training Compliance Matrix";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var documents   = ViewBag.Documents   as List<OpenQMS.Models.AppDocument> ?? new();
    var allUsers    = ViewBag.AllUsers    as List<OpenQMS.Models.AppUser>     ?? new();
    var statusValues = ViewBag.StatusValues as IEnumerable<UserTrainingStatus> ?? Array.Empty<UserTrainingStatus>();

    int? filterDocId  = ViewBag.DocumentId as int?;
    string? filterUser = ViewBag.UserId   as string;
    string? filterStatus = ViewBag.Status as string;
    bool overdueOnly   = (bool)(ViewBag.OverdueOnly ?? false);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Training Compliance Matrix</h4>
    <div class="d-flex gap-2">
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm"><i class="fas fa-tachometer-alt me-1"></i>Dashboard</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-list me-1"></i>Training Register</a>
    </div>
</div>
<hr />

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Filters</div>
    <div class="card-body">
        <form method="get" asp-action="Compliance" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Document</label>
                <select name="documentId" class="form-select form-select-sm">
                    <option value="">— All Documents —</option>
                    @foreach (var d in documents)
                    {
                        <option value="@d.Id" selected="@(filterDocId == d.Id)">@d.DocumentId — @d.Title</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Trainee</label>
                <select name="userId" class="form-select form-select-sm">
                    <option value="">— All Trainees —</option>
                    @foreach (var u in allUsers)
                    {
                        <option value="@u.Id" selected="@(filterUser == u.Id.ToString())">@u.UserName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">— All Statuses —</option>
                    @foreach (var s in statusValues)
                    {
                        <option value="@s" selected="@(filterStatus == s.ToString())">@EnumHelper.Display(s)</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check mb-1">
                    <input type="checkbox" class="form-check-input" name="overdueOnly" value="true" id="overdueCheck" @(overdueOnly ? "checked" : "") />
                    <label class="form-check-label" for="overdueCheck">Overdue Only</label>
                </div>
            </div>
            <div class="col-md-1 d-flex align-items-end gap-1">
                <button type="submit" class="btn btn-primary btn-sm">Filter</button>
                <a asp-action="Compliance" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Results -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
        <span>Results <span class="badge bg-secondary ms-1">@Model.Count()</span></span>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-sm table-hover mb-0" id="complianceTable">
                <thead class="table-light">
                    <tr>
                        <th>Trainee</th>
                        <th>Training</th>
                        <th>Type</th>
                        <th>Document</th>
                        <th>Date Created</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Completed On</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ut in Model)
                    {
                        var badge = ut.Status switch {
                            UserTrainingStatus.Completed                 => "bg-success",
                            UserTrainingStatus.Failed                    => "bg-danger",
                            UserTrainingStatus.PendingTrainerConfirmation => "bg-info text-dark",
                            UserTrainingStatus.InProgress                => "bg-warning text-dark",
                            _                                            => "bg-secondary"
                        };
                        var isOverdue = ut.Training?.DueDate.HasValue == true
                                     && ut.Training.DueDate!.Value.Date < SiteTime.Today
                                     && ut.Status != UserTrainingStatus.Completed;
                        var completedOn = ut.Training?.TrainingType == TrainingType.CompetencyAssessment
                            ? ut.CompetencyVerifiedOn.ToSite()?.ToString("dd MMM yyyy")
                            : ut.ReadAcknowledgedOn.ToSite()?.ToString("dd MMM yyyy");
                        <tr class="@(isOverdue ? "table-danger" : "")">
                            <td>
                                <strong>@(ut.Trainee?.UserName ?? "-")</strong><br />
                                <small class="text-muted">@(ut.Trainee?.Email ?? "")</small>
                            </td>
                            <td>
                                @if (ut.Training != null)
                                {
                                    <a asp-action="Details" asp-route-id="@ut.Training.Id">@ut.Training.TrainingId</a>
                                    <br /><small class="text-muted">@ut.Training.Name</small>
                                }
                            </td>
                            <td>
                                @if (ut.Training != null)
                                {
                                    <span class="badge @(ut.Training.TrainingType == TrainingType.CompetencyAssessment ? "bg-primary" : "bg-info text-dark")">
                                        @(ut.Training.TrainingType == TrainingType.CompetencyAssessment ? "CA" : "R&A")
                                    </span>
                                }
                            </td>
                            <td>
                                @if (ut.Training != null)
                                {
                                    <small>@ut.Training.PolicyTitle</small>
                                }
                            </td>
                            <td>@(ut.Training?.CreatedOn.ToSite().ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="@(isOverdue ? "fw-semibold" : "")">
                                @if (ut.Training?.DueDate.HasValue == true)
                                {
                                    @ut.Training.DueDate.Value.ToString("dd/MM/yyyy")
                                    @if (isOverdue) { <span class="badge bg-danger ms-1">Overdue</span> }
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td><span class="badge @badge">@EnumHelper.Display(ut.Status)</span></td>
                            <td>@(completedOn ?? "—")</td>
                            <td>
                                @if (ut.Training != null)
                                {
                                    <a asp-action="Details" asp-route-id="@ut.Training.Id" class="btn btn-outline-secondary btn-sm">View</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted p-3 mb-0">No records match the current filters.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#complianceTable').DataTable({
                paging: true,
                order: [[0, 'asc']],
                dom: 'lBfrtip',
                lengthMenu: [[25, 50, 100, -1], [25, 50, 100, "All"]],
                buttons: [
                    { extend: 'pdf',   footer: false },
                    { extend: 'excel', footer: false }
                ]
            });
        });
    </script>
}
