@{
    ViewData["Title"] = "Trainings Dashboard";

    var overdue          = ViewBag.OverdueTrainings   as List<OpenQMS.Models.Training> ?? new();
    var upcoming         = ViewBag.UpcomingTrainings  as List<OpenQMS.Models.Training> ?? new();
    var recentlyCompleted = ViewBag.RecentlyCompleted as List<OpenQMS.Models.Training> ?? new();
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Trainings Dashboard</h4>
    <div class="d-flex gap-2">
        <a asp-action="Compliance" class="btn btn-outline-info btn-sm">
            <i class="fas fa-clipboard-check me-1"></i>Compliance Matrix
        </a>
        <a asp-action="ExportRegister" class="btn btn-outline-success btn-sm">
            <i class="fas fa-file-excel me-1"></i>Export Register
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-list me-1"></i>Training Register
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus-circle me-1"></i>New Training
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <div class="fs-1 fw-bold text-primary">@ViewBag.TotalTrainings</div>
                <div class="text-muted small">Total</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100 border-start border-warning border-3">
            <div class="card-body text-center">
                <div class="fs-1 fw-bold text-warning">@ViewBag.ScheduledCount</div>
                <div class="text-muted small">Scheduled</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100 border-start border-success border-3">
            <div class="card-body text-center">
                <div class="fs-1 fw-bold text-success">@ViewBag.CompletedCount</div>
                <div class="text-muted small">Completed</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100 border-start border-danger border-3">
            <div class="card-body text-center">
                <div class="fs-1 fw-bold text-danger">@ViewBag.OverdueCount</div>
                <div class="text-muted small">Overdue (Scheduled past date)</div>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row g-3 mb-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Status Distribution</div>
            <div class="card-body d-flex justify-content-center align-items-center">
                <canvas id="statusDoughnut" style="max-height:220px;"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Status Counts</div>
            <div class="card-body">
                <canvas id="statusBar" style="max-height:220px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Overdue Alert -->
@if (overdue.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-danger text-white fw-semibold">
            <i class="fas fa-exclamation-circle me-1"></i>Overdue — Scheduled Past Date
            <span class="badge bg-white text-danger ms-1">@overdue.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr><th>ID</th><th>Name</th><th>Due Date</th><th>Days Overdue</th><th>Trainer</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in overdue)
                    {
                        var daysOver = t.DueDate.HasValue ? (int)(SiteTime.Today - t.DueDate.Value.Date).TotalDays : 0;
                        <tr class="table-danger">
                            <td>@t.TrainingId</td>
                            <td>@t.Name</td>
                            <td>@(t.DueDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td><span class="badge bg-danger">@daysOver days</span></td>
                            <td>@t.TrainerEmail</td>
                            <td><a asp-action="Details" asp-route-id="@t.Id" class="btn btn-outline-danger btn-sm">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Upcoming + Recently Completed -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-warning text-dark fw-semibold">
                <i class="fas fa-calendar me-1"></i>Upcoming Trainings
                <span class="badge bg-dark ms-1">@upcoming.Count</span>
            </div>
            <div class="card-body p-0">
                @if (upcoming.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>ID</th><th>Name</th><th>Due Date</th><th>Trainees</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in upcoming)
                            {
                                <tr>
                                    <td>@t.TrainingId</td>
                                    <td>@t.Name</td>
                                    <td>@(t.DueDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                    <td>@(t.Trainees?.Count ?? 0)</td>
                                    <td><a asp-action="Details" asp-route-id="@t.Id" class="btn btn-outline-secondary btn-sm">View</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No upcoming trainings.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-success text-white fw-semibold">
                <i class="fas fa-check-circle me-1"></i>Recently Completed
            </div>
            <div class="card-body p-0">
                @if (recentlyCompleted.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>ID</th><th>Name</th><th>Completed On</th><th>Trainees</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in recentlyCompleted)
                            {
                                <tr>
                                    <td>@t.TrainingId</td>
                                    <td>@t.Name</td>
                                    <td>@(t.CompletedOn.HasValue ? SiteTime.ToSite((DateTime)t.CompletedOn.Value).ToString("dd MMM yyyy") : "-")</td>
                                    <td>@(t.Trainees?.Count ?? 0)</td>
                                    <td><a asp-action="Details" asp-route-id="@t.Id" class="btn btn-outline-secondary btn-sm">View</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No completed trainings yet.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script>
        var labels = ['Scheduled', 'Completed'];
        var counts = [@ViewBag.ScheduledCount, @ViewBag.CompletedCount];
        var colors = ['#ffc107', '#198754'];

        new Chart(document.getElementById('statusDoughnut'), {
            type: 'doughnut',
            data: { labels: labels, datasets: [{ data: counts, backgroundColor: colors, borderWidth: 1 }] },
            options: { plugins: { legend: { position: 'bottom' } }, maintainAspectRatio: false }
        });

        new Chart(document.getElementById('statusBar'), {
            type: 'bar',
            data: { labels: labels, datasets: [{ label: 'Trainings', data: counts, backgroundColor: colors }] },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }, maintainAspectRatio: false }
        });
    </script>
}
