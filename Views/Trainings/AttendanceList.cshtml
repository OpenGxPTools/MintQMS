@model OpenQMS.Services.IssuedCopyResult

@{
    var training = (OpenQMS.Models.Training)ViewBag.Training;
    var liveHtml = ViewBag.LiveHtml as string;
    ViewData["Title"] = L["Attendance List — {0}", training.TrainingId].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@media print {
        .navbar, header, footer, .no-print, .btn, nav { display: none !important; }
        .card { border: 1px solid #dee2e6 !important; box-shadow: none !important; }
        body { font-size: 10pt; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <a asp-action="Details" asp-route-id="@training.Id" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>@L["Back to Training"]
    </a>
    <button onclick="window.print()" class="btn btn-outline-primary btn-sm">
        <i class="fas fa-print me-1"></i>@L["Print / Save as PDF"]
    </button>
</div>

@if (Model.Copy != null && !Model.IntegrityOk)
{
    <div class="alert alert-danger" id="integrity-failed">
        <strong>@L["Integrity check failed."]</strong>
        @L["The stored copy of this attendance list does not match the checksum recorded when it was fixed, so it is not shown. The event has been recorded in the audit trail. Contact your administrator."]
    </div>
}
else if (Model.Copy != null)
{
    @Html.Raw(Model.Copy.Html)
    <partial name="~/Views/Shared/_IssuedCopyBanner.cshtml" model="Model.Copy" />
}
else
{
    @* Printed too: an open training's list is a working copy, not the final record. *@
    <div class="alert alert-warning fw-semibold" id="attendance-live">
        @L["NOT FINAL — this training is not completed yet. This list shows the current state and will be fixed when the training is completed."]
    </div>
    @Html.Raw(liveHtml)
}
