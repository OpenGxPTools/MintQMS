@using Microsoft.AspNetCore.Identity
@model OpenQMS.Models.Training

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var policies = (List<AppDocument>)ViewData["Policies"];
    var trainer = (List<AppUser>)ViewData["Trainer"];
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">Edit Training — @Model.TrainingId</h4>
    </div>
</div>
<hr />

<form asp-action="Edit" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PolicyTitle" />
    <input type="hidden" asp-for="TrainerEmail" />
    <input type="hidden" asp-for="Trainees" />
    <input type="hidden" asp-for="TrainingId" />

    <div class="card mb-4">
        <div class="card-header fw-semibold">Training Details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DueDate" class="form-label"></label>
                    <input asp-for="DueDate" class="form-control" type="date" />
                    <small class="form-text text-muted">Optional — deadline for trainees to complete this training.</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Policy</label>
                    <select asp-for="PolicyId" class="form-select" asp-items='new SelectList(policies,"Id","Title")'>
                    </select>
                    <span asp-validation-for="PolicyId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Trainer</label>
                    <select asp-for="TrainerId" class="form-select" asp-items='new SelectList(trainer,"Id","Email")'>
                    </select>
                    <span asp-validation-for="TrainerId" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Trainees</label>
                    <table>
                        <tr>
                            @{
                                int cnt = 0;
                                List<OpenQMS.Models.ViewModels.AssignedTrainees> assignedTrainees = ViewBag.Trainees;

                                foreach (var trainee in assignedTrainees)
                                {
                                    {
                                        @:</tr><tr>
                                    }
                                    @:<td>
                                        <input type="checkbox"
                                            name="selectedTrainees"
                                            value="@trainee.UserID"
                                            @(Html.Raw(trainee.Assigned ? "checked=\"checked\"" : "")) />
                                            @:  @trainee.Email
                                    @:</td>
                                }
                                @:</tr>
                            }
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye me-1"></i>Details</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
