@section Scripts {
<script>
// Assessment recommendation → show/hide relevant fields
var assessRec = document.getElementById('assessRecommendation');
if (assessRec) {
    function updateAssessFields() {
        var val = assessRec.value;
        var suspensionFields = document.getElementById('suspensionFields');
        var cancellationFields = document.getElementById('cancellationFields');
        if (suspensionFields) suspensionFields.style.display = val === 'suspend' ? 'block' : 'none';
        if (cancellationFields) cancellationFields.style.display = val === 'cancel' ? 'block' : 'none';
        var suspTa = document.getElementById('suspensionReason');
        var cancelTa = document.getElementById('cancellationReason');
        if (suspTa) suspTa.required = val === 'suspend';
        if (cancelTa) cancelTa.required = val === 'cancel';
    }
    assessRec.addEventListener('change', updateAssessFields);
    updateAssessFields();
}

// TempData active tab
@if (TempData["ActiveTab"] != null)
{
    <text>
    (function() {
        var tabMap = { 'auditlog': '#tabAuditLog', 'lc': '#tabLC' };
        var key = '@TempData["ActiveTab"]'.toLowerCase();
        var selector = tabMap[key];
        if (selector) {
            var el = document.querySelector('[data-bs-target="' + selector + '"]');
            if (el) new bootstrap.Tab(el).show();
        }
    })();
    </text>
}
</script>
}
