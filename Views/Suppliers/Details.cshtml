@model OpenQMS.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isLocked = Model.Status == OpenQMS.Models.SupplierStatus.Approved
                    || Model.Status == OpenQMS.Models.SupplierStatus.Qualified
                    || Model.Status == OpenQMS.Models.SupplierStatus.Suspended
                    || Model.Status == OpenQMS.Models.SupplierStatus.Cancelled
                    || Model.Status == OpenQMS.Models.SupplierStatus.PendingSuspension
                    || Model.Status == OpenQMS.Models.SupplierStatus.PendingCancellation;
    bool everCompleted = Model.ApprovalStatus != null
                      && Model.ApprovalStatus != OpenQMS.Models.SupplierStatus.Pending;
    int docCount = Model.Documents?.Count ?? 0;
    int reviewCount = Model.Reviews?.Count ?? 0;
    int qrCount = Model.QualityRecords?.Count ?? 0;
    int logCount = Model.AuditLogs?.Count ?? 0;

    var lcRecords = ViewBag.LCRecords as List<OpenQMS.Models.LC.LicenceCertificationRecord> ?? new();

    var statusBadge = Model.Status switch
    {
        OpenQMS.Models.SupplierStatus.Approved         => "bg-success",
        OpenQMS.Models.SupplierStatus.Qualified        => "bg-primary",
        OpenQMS.Models.SupplierStatus.Suspended        => "bg-warning text-dark",
        OpenQMS.Models.SupplierStatus.Cancelled        => "bg-secondary",
        OpenQMS.Models.SupplierStatus.Rejected         => "bg-danger",
        OpenQMS.Models.SupplierStatus.UnderAssessment  => "bg-info text-dark",
        OpenQMS.Models.SupplierStatus.PendingSuspension => "bg-warning text-dark",
        OpenQMS.Models.SupplierStatus.PendingCancellation => "bg-warning text-dark",
        _                                              => "bg-light text-dark border"
    };

    bool isPending = Model.Status == OpenQMS.Models.SupplierStatus.Pending;
    bool isUnderAssessment = Model.Status == OpenQMS.Models.SupplierStatus.UnderAssessment;
    bool isPendingSuspension = Model.Status == OpenQMS.Models.SupplierStatus.PendingSuspension;
    bool isPendingCancellation = Model.Status == OpenQMS.Models.SupplierStatus.PendingCancellation;
    bool isApproved = Model.Status == OpenQMS.Models.SupplierStatus.Approved;
    bool isQualified = Model.Status == OpenQMS.Models.SupplierStatus.Qualified;
    bool isSuspended = Model.Status == OpenQMS.Models.SupplierStatus.Suspended;

    bool overdueReview = (isApproved || isQualified)
        && Model.NextReviewDate.HasValue && Model.NextReviewDate.Value < SiteTime.Today;
    bool approachingReview = (isApproved || isQualified)
        && Model.NextReviewDate.HasValue
        && Model.NextReviewDate.Value >= SiteTime.Today
        && Model.NextReviewDate.Value <= SiteTime.Today.AddDays(30);

    bool holdsApproval = Model.ApprovalStatus == OpenQMS.Models.SupplierStatus.Approved
                      || Model.ApprovalStatus == OpenQMS.Models.SupplierStatus.Qualified;
    bool isExpired = holdsApproval && Model.ExpiryDate.HasValue && Model.ExpiryDate.Value.Date < SiteTime.Today;
    bool approachingExpiry = holdsApproval && Model.ExpiryDate.HasValue && !isExpired
        && Model.ExpiryDate.Value.Date <= SiteTime.Today.AddDays(30);
}

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">@Model.LegalName &mdash; <span class="fw-bold">@Model.SupplierCode</span></h4>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @if (Model.ApprovalStatus.HasValue && Model.ApprovalStatus != Model.Status)
        {
            var approvalBadge = Model.ApprovalStatus switch
            {
                OpenQMS.Models.SupplierStatus.Approved  => "bg-success",
                OpenQMS.Models.SupplierStatus.Qualified => "bg-success",
                OpenQMS.Models.SupplierStatus.Suspended => "bg-warning text-dark",
                OpenQMS.Models.SupplierStatus.Cancelled => "bg-danger",
                _                                       => "bg-secondary"
            };
            <span class="badge @approvalBadge fs-6">Approval: @EnumHelper.Display(Model.ApprovalStatus.Value)</span>
        }
        <span class="badge @statusBadge fs-6">@EnumHelper.Display(Model.Status)</span>
    </div>
</div>
<hr />
<partial name="_ReReviewBanner" model="Model" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Success"]</div>
}
@if (TempData["WorkflowError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button><strong>Error:</strong> @TempData["WorkflowError"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Error"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show"><button type="button" class="btn-close" data-bs-dismiss="alert"></button>@TempData["Warning"]</div>
}

@if (overdueReview)
{
    <div class="alert alert-danger mb-3">
        <strong>&#9888; Overdue for Review</strong> — Next review was due @Model.NextReviewDate!.Value.ToString("dd MMM yyyy").
    </div>
}
@if (approachingReview && !overdueReview)
{
    <div class="alert alert-warning mb-3">
        <strong>&#9888; Review Due Soon</strong> — Next review due @Model.NextReviewDate!.Value.ToString("dd MMM yyyy").
    </div>
}
@if (Model.Status == OpenQMS.Models.SupplierStatus.Suspended)
{
    <div class="alert alert-warning mb-3">
        <strong>Suspended</strong> by @Model.SuspendedBy on @(Model.SuspendedOn.HasValue ? Model.SuspendedOn.Value.ToSite().ToString("dd/MM/yyyy") : "-").
        Reason: @(Model.SuspensionReason ?? "-")
    </div>
}
@if (Model.Status == OpenQMS.Models.SupplierStatus.Cancelled)
{
    <div class="alert alert-secondary mb-3">
        <strong>Cancelled</strong> by @Model.CancelledBy on @(Model.CancelledOn.HasValue ? Model.CancelledOn.Value.ToSite().ToString("dd/MM/yyyy") : "-").
        Reason: @(Model.CancellationReason ?? "-")
    </div>
}
@if (isExpired)
{
    <div class="alert alert-danger mb-3">
        <strong>&#9888; Approval Expired</strong> — the supplier approval expired on @Model.ExpiryDate!.Value.ToString("dd MMM yyyy").
    </div>
}
@if (approachingExpiry)
{
    <div class="alert alert-warning mb-3">
        <strong>&#9888; Approval Expiring Soon</strong> — the supplier approval expires on @Model.ExpiryDate!.Value.ToString("dd MMM yyyy").
    </div>
}

<!-- Workflow Action Card -->
@{
    bool canApprove     = User.IsInRole("Administrator") || User.IsInRole("QualityManager") || User.IsInRole("AuthorisedPerson");
    bool canAssess      = canApprove || User.IsInRole("QualityUser");
    // Matches SuppliersController.AddAddress / DeleteAddress role gate
    bool canManageAddresses = canAssess || User.IsInRole("OperationsUser") || User.IsInRole("CommercialUser");
    bool showWorkflow   = (isPending && canAssess)
                       || ((isUnderAssessment || isPendingSuspension || isPendingCancellation) && canApprove)
                       || ((isApproved || isQualified || isSuspended) && canApprove);
}
@if (showWorkflow)
{
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">Workflow Actions</div>
        <div class="card-body d-flex flex-wrap gap-2">
            @if (isPending && canAssess)
            {
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#startAssessmentModal">Submit Assessment</button>
            }
            @if (isSuspended && canApprove)
            {
                <button class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#reactivateModal">Reactivate</button>
            }
            @if (isUnderAssessment && canApprove)
            {
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal">Approve</button>
                <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#returnToAssessmentModal">Return to Assessment</button>
            }
            @if (isPendingSuspension && canApprove)
            {
                <button class="btn btn-warning text-dark" data-bs-toggle="modal" data-bs-target="#confirmSuspendModal">Confirm Suspension</button>
                <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#returnToAssessmentModal">Return to Assessment</button>
            }
            @if (isPendingCancellation && canApprove)
            {
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmCancelModal">Confirm Cancellation</button>
                <button class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#returnToAssessmentModal">Return to Assessment</button>
            }
            @if ((isApproved || isQualified) && canApprove)
            {
                @if (isApproved && Model.QualificationRequired)
                {
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#qualifyModal">Progress to Qualified</button>
                }
                <button class="btn btn-warning text-dark" data-bs-toggle="modal" data-bs-target="#suspendModal">Suspend</button>
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">Cancel Supplier</button>
            }
        </div>
    </div>
}

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" id="supplierTabs">
    <li class="nav-item">
        <button class="nav-link active" type="button" data-bs-toggle="tab" data-bs-target="#tabOverview">Overview</button>
    </li>
    @if (lcRecords.Any())
    {
        <li class="nav-item">
            <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#tabLC">
                Licences &amp; Certifications <span class="badge bg-secondary ms-1">@lcRecords.Count</span>
            </button>
        </li>
    }
    <li class="nav-item">
        <a asp-action="Documents" asp-route-id="@Model.Id" class="nav-link">
            Attachments <span class="badge bg-secondary ms-1">@docCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a asp-action="QualityRecords" asp-route-id="@Model.Id" class="nav-link">
            Quality Records <span class="badge bg-secondary ms-1">@qrCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a asp-action="Reviews" asp-route-id="@Model.Id" class="nav-link">
            Reviews <span class="badge bg-secondary ms-1">@reviewCount</span>
        </a>
    </li>
    <li class="nav-item">
        <button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#tabAuditLog">
            Audit Log <span class="badge bg-secondary ms-1">@logCount</span>
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- Overview Tab -->
    <div class="tab-pane fade show active" id="tabOverview">
        <div class="row">
            <div class="col-md-6">
                <h6 class="text-muted text-uppercase small">Identity</h6>
                <dl class="row">
                    <dt class="col-sm-5">Supplier ID</dt><dd class="col-sm-7"><strong>@Model.SupplierCode</strong></dd>
                    <dt class="col-sm-5">Legal Name</dt><dd class="col-sm-7">@Model.LegalName</dd>
                    <dt class="col-sm-5">Trading Name</dt><dd class="col-sm-7">@(Model.TradingName ?? "-")</dd>
                    <dt class="col-sm-5">Legal ID</dt><dd class="col-sm-7">@(Model.LegalId ?? "-")</dd>
                    <dt class="col-sm-5">Website</dt><dd class="col-sm-7">@(Model.Website ?? "-")</dd>
                    <dt class="col-sm-5">Created By</dt><dd class="col-sm-7">@(Model.CreatedBy ?? "-")</dd>
                    <dt class="col-sm-5">Created On</dt><dd class="col-sm-7">@Model.CreatedOn.ToSite().ToString("dd/MM/yyyy")</dd>
                </dl>

                <h6 class="text-muted text-uppercase small mt-3">Primary Address</h6>
                <dl class="row">
                    <dt class="col-sm-5">Street</dt><dd class="col-sm-7">@(Model.Street ?? "-")</dd>
                    <dt class="col-sm-5">City</dt><dd class="col-sm-7">@(Model.City ?? "-")</dd>
                    <dt class="col-sm-5">State</dt><dd class="col-sm-7">@(Model.State ?? "-")</dd>
                    <dt class="col-sm-5">Post Code</dt><dd class="col-sm-7">@(Model.PostCode ?? "-")</dd>
                    <dt class="col-sm-5">Country</dt><dd class="col-sm-7">@(Model.Country ?? "-")</dd>
                </dl>

                <h6 class="text-muted text-uppercase small mt-3">Primary Contact</h6>
                <dl class="row">
                    <dt class="col-sm-5">Contact Name</dt><dd class="col-sm-7">@(Model.ContactName ?? "-")</dd>
                    <dt class="col-sm-5">Contact Email</dt><dd class="col-sm-7">@(Model.ContactEmail ?? "-")</dd>
                    <dt class="col-sm-5">Contact Phone</dt><dd class="col-sm-7">@(Model.ContactPhone ?? "-")</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h6 class="text-muted text-uppercase small">Classification</h6>
                <dl class="row">
                    <dt class="col-sm-5">Supplier Type</dt><dd class="col-sm-7">@Model.SupplierType</dd>
                    @if (Model.SupplierProducts != null && Model.SupplierProducts.Any())
                    {
                        <dt class="col-sm-5">Products</dt>
                        <dd class="col-sm-7">@string.Join(", ", Model.SupplierProducts.Select(sp => sp.Product?.Name ?? "-"))</dd>
                    }
                    @if (Model.SupplierMaterials != null && Model.SupplierMaterials.Any())
                    {
                        <dt class="col-sm-5">Materials</dt>
                        <dd class="col-sm-7">@string.Join(", ", Model.SupplierMaterials.Select(sm => sm.Material?.Name ?? "-"))</dd>
                    }
                    @if (Model.SupplierServices != null && Model.SupplierServices.Any())
                    {
                        <dt class="col-sm-5">Services</dt>
                        <dd class="col-sm-7">@string.Join(", ", Model.SupplierServices.Select(ss => ss.Service?.Name ?? "-"))</dd>
                    }
                </dl>

                <h6 class="text-muted text-uppercase small mt-3">Assessment</h6>
                <dl class="row">
                    @if (Model.AssessedBy != null)
                    {
                        <dt class="col-sm-5">Assessed By</dt><dd class="col-sm-7">@Model.AssessedBy</dd>
                        <dt class="col-sm-5">Assessed On</dt>
                        <dd class="col-sm-7">@(Model.AssessedOn.HasValue ? Model.AssessedOn.Value.ToSite().ToString("dd/MM/yyyy") : "-")</dd>
                    }
                    <dt class="col-sm-5">Risk Level</dt>
                    <dd class="col-sm-7">
                        @{
                            var rl = Model.RiskLevel;
                            var rlBadge = rl == OpenQMS.Models.SupplierRiskLevel.Critical ? "bg-danger"
                                        : rl == OpenQMS.Models.SupplierRiskLevel.High ? "bg-warning text-dark"
                                        : rl == OpenQMS.Models.SupplierRiskLevel.Medium ? "bg-info text-dark"
                                        : rl == OpenQMS.Models.SupplierRiskLevel.Low ? "bg-light text-dark border"
                                        : "bg-secondary";
                        }
                        <span class="badge @rlBadge">@Model.RiskLevel</span>
                    </dd>
                    <dt class="col-sm-5">Risk Justification</dt>
                    <dd class="col-sm-7">@(Model.RiskJustification ?? "-")</dd>
                    <dt class="col-sm-5">Review Frequency</dt><dd class="col-sm-7">@Model.ReviewFrequency</dd>
                    @if (Model.NextReviewDate.HasValue)
                    {
                        <dt class="col-sm-5">Next Review Date</dt>
                        <dd class="col-sm-7">@Model.NextReviewDate.Value.ToString("dd/MM/yyyy")</dd>
                    }
                    @if (!string.IsNullOrEmpty(Model.ApprovalComments))
                    {
                        <dt class="col-sm-5">Approval Comments</dt>
                        <dd class="col-sm-7">@Model.ApprovalComments</dd>
                    }
                    @if (Model.ApprovalStatus != null)
                    {
                        <dt class="col-sm-5">Qualification Required</dt>
                        <dd class="col-sm-7">@(Model.QualificationRequired ? "Yes" : "No")</dd>
                        @if (!string.IsNullOrEmpty(Model.QualificationJustification))
                        {
                            <dt class="col-sm-5">Qualification Justification</dt>
                            <dd class="col-sm-7">@Model.QualificationJustification</dd>
                        }
                    }
                </dl>

                @if (Model.ApprovedBy != null)
                {
                    <h6 class="text-muted text-uppercase small mt-3">Approval</h6>
                    <dl class="row">
                        <dt class="col-sm-5">Approved By</dt><dd class="col-sm-7">@Model.ApprovedBy</dd>
                        <dt class="col-sm-5">Approved On</dt>
                        <dd class="col-sm-7">@(Model.ApprovedOn.HasValue ? Model.ApprovedOn.Value.ToSite().ToString("dd/MM/yyyy") : "-")</dd>
                        <dt class="col-sm-5">Effective Date</dt>
                        <dd class="col-sm-7">@(Model.EffectiveDate.HasValue ? Model.EffectiveDate.Value.ToSite().ToString("dd/MM/yyyy") : "-")</dd>
                        <dt class="col-sm-5">Approval Expiry</dt>
                        <dd class="col-sm-7">@(Model.ExpiryDate.HasValue ? Model.ExpiryDate.Value.ToString("dd/MM/yyyy") : "None (valid until next review)")</dd>
                        @if (Model.ExpiryDate.HasValue && !string.IsNullOrWhiteSpace(Model.ApprovalExpiryReason))
                        {
                            <dt class="col-sm-5">Expiry Reason</dt><dd class="col-sm-7">@Model.ApprovalExpiryReason</dd>
                        }
                        <dt class="col-sm-5">Approval Comments</dt><dd class="col-sm-7">@(Model.ApprovalComments ?? "-")</dd>
                        <dt class="col-sm-5">Next Review</dt>
                        <dd class="col-sm-7">@(Model.NextReviewDate.HasValue ? Model.NextReviewDate.Value.ToString("dd/MM/yyyy") : "-")</dd>
                        <dt class="col-sm-5">Last Review</dt>
                        <dd class="col-sm-7">@(Model.LastReviewDate.HasValue ? Model.LastReviewDate.Value.ToSite().ToString("dd/MM/yyyy") : "-")</dd>
                        @if (Model.SupplierType != OpenQMS.Models.SupplierType.Service)
                        {
                            <dt class="col-sm-5">Testing</dt><dd class="col-sm-7">@Model.TestingRequirement</dd>
                        }
                    </dl>
                }

                @if (Model.QualifiedBy != null)
                {
                    <h6 class="text-muted text-uppercase small mt-3">Qualification</h6>
                    <dl class="row">
                        <dt class="col-sm-5">Qualified By</dt><dd class="col-sm-7">@Model.QualifiedBy</dd>
                        <dt class="col-sm-5">Qualified On</dt>
                        <dd class="col-sm-7">@(Model.QualifiedOn.HasValue ? Model.QualifiedOn.Value.ToSite().ToString("dd/MM/yyyy") : "-")</dd>
                        <dt class="col-sm-5">Qual. Basis</dt>
                        <dd class="col-sm-7">@(Model.QualificationBasis.HasValue ? Model.QualificationBasis.ToString() : "-")</dd>
                        <dt class="col-sm-5">Qual. Justification</dt>
                        <dd class="col-sm-7">@(Model.QualificationJustification ?? "-")</dd>
                        <dt class="col-sm-5">Reference Doc</dt>
                        <dd class="col-sm-7">@(Model.QualificationReferenceDoc ?? "-")</dd>
                        <dt class="col-sm-5">Qual. Comments</dt>
                        <dd class="col-sm-7">@(Model.QualificationComments ?? "-")</dd>
                    </dl>
                }
            </div>
        </div>

        <!-- Addresses -->
        <div class="card mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Additional Addresses</span>
                <span class="badge bg-secondary" id="addrCount">@(Model.Addresses?.Count ?? 0)</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Addresses != null && Model.Addresses.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Street</th><th>City</th><th>State</th><th>Post Code</th><th>Country</th><th>Notes</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var addr in Model.Addresses)
                            {
                                <tr>
                                    <td>@(addr.Street ?? "-")</td>
                                    <td>@(addr.City ?? "-")</td>
                                    <td>@(addr.State ?? "-")</td>
                                    <td>@(addr.PostCode ?? "-")</td>
                                    <td>@(addr.Country ?? "-")</td>
                                    <td>@(addr.Notes ?? "-")</td>
                                    <td class="text-end">
                                        @if (isPending && canManageAddresses)
                                        {
                                            <form asp-action="DeleteAddress" method="post" class="d-inline"
                                                  onsubmit="return confirm('Remove this address?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@addr.Id" />
                                                <input type="hidden" name="supplierId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No additional addresses recorded.</p>
                }
            </div>
            @if (isPending && canManageAddresses)
            {
            <div class="card-footer">
                <form asp-action="AddAddress" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="supplierId" value="@Model.Id" />
                    <div class="row g-2">
                        <div class="col-md-3">
                            <input type="text" name="street" class="form-control form-control-sm" placeholder="Street" />
                        </div>
                        <div class="col-md-2">
                            <input type="text" name="city" class="form-control form-control-sm" placeholder="City" />
                        </div>
                        <div class="col-md-1">
                            <input type="text" name="state" class="form-control form-control-sm" placeholder="State" />
                        </div>
                        <div class="col-md-1">
                            <input type="text" name="postCode" class="form-control form-control-sm" placeholder="Post Code" />
                        </div>
                        <div class="col-md-2">
                            <input type="text" name="country" class="form-control form-control-sm" placeholder="Country" />
                        </div>
                        <div class="col-md-2">
                            <input type="text" name="notes" class="form-control form-control-sm" placeholder="Notes" />
                        </div>
                        <div class="col-md-1">
                            <button type="submit" class="btn btn-primary btn-sm w-100">Add</button>
                        </div>
                    </div>
                </form>
            </div>
            }
            </div>
        </div>
        <div class="mt-3 d-flex flex-wrap gap-2">
            @if (isPending)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="fas fa-edit me-1"></i>Edit</a>
            }
            <a asp-action="ExportDetailInCSV" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><i class="fas fa-file-csv me-1"></i>Export CSV</a>
            <a asp-action="ExportSupplierDetail" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><i class="fas fa-file-pdf me-1"></i>Export PDF</a>
            <a asp-action="ExportRegister" class="btn btn-outline-success btn-sm">Export Excel</a>
            @if (User.IsInRole(OpenQMS.Authorization.Constants.AdministratorsRole)
                 && (Model.Status == OpenQMS.Models.SupplierStatus.Pending
                     || Model.Status == OpenQMS.Models.SupplierStatus.UnderAssessment))
            {
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash me-1"></i>Delete</a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Register</a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">Dashboard</a>
        </div>
    </div>

    <!-- LC Tab -->
    @if (lcRecords.Any())
    {
        <div class="tab-pane fade" id="tabLC">
            <h6 class="mt-2 mb-3"><i class="fas fa-id-card me-1 text-success"></i>Licences &amp; Certifications</h6>
            <table class="table table-sm table-hover">
                <thead class="table-light">
                    <tr><th>LC Number</th><th>Category</th><th>Licence Type</th><th>Status</th><th>Expiry Date</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in lcRecords)
                    {
                        string lcBadge = r.Status switch {
                            OpenQMS.Models.LC.LCStatus.IssuedActive      => "bg-success",
                            OpenQMS.Models.LC.LCStatus.ConditionsApplied => "bg-success",
                            OpenQMS.Models.LC.LCStatus.RenewalDue        => "bg-warning text-dark",
                            OpenQMS.Models.LC.LCStatus.Expired           => "bg-danger",
                            OpenQMS.Models.LC.LCStatus.Suspended         => "bg-warning text-dark",
                            OpenQMS.Models.LC.LCStatus.Withdrawn         => "bg-secondary",
                            _                                            => "bg-light text-dark"
                        };
                        <tr>
                            <td><a asp-controller="LicencesCertifications" asp-action="Details" asp-route-id="@r.Id">@r.LCNumber</a></td>
                            <td>@r.Category</td>
                            <td>@(r.LicenceType?.DisplayName ?? "—")</td>
                            <td><span class="badge @lcBadge">@EnumHelper.Display(r.Status)</span></td>
                            <td>@(r.ExpiryDate.HasValue ? r.ExpiryDate.Value.ToString("dd MMM yyyy") : "—")</td>
                            <td><a asp-controller="LicencesCertifications" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Audit Log Tab -->
    <div class="tab-pane fade" id="tabAuditLog">
        @await Html.PartialAsync("_AuditLogTable", (Model.AuditLogs ?? Enumerable.Empty<OpenQMS.Models.SupplierAuditLog>())
            .Select(l => new OpenQMS.ViewModels.AuditLogRow(l.PerformedOn, l.PerformedBy, l.Action, l.FromStatus, l.ToStatus, l.Notes)))
    </div>
</div>


