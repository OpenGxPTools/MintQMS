@model IEnumerable<OpenQMS.Models.Supplier>
@inject OpenQMS.Services.Workflow.TaskAssignmentService AssignSvc

@{
    var assignedMap = await AssignSvc.CurrentByRecordAsync("Suppliers");
    ViewData["MeId"] = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    ViewData["Title"] = L["Suppliers"].Value;
}

@section Scripts {
<script src="~/js/assigned-filter.js" asp-append-version="true"></script>
<script>
    $(document).ready(function () {
        var table = $('#suppliersTable').DataTable({ stateSave: true,
            initComplete: function () {
                MintAssignedFilter(this.api());
                $('.status-filter').on('click', function () {
                    $('.status-filter').removeClass('active');
                    $(this).addClass('active');
                    var val = $(this).data('status');
                    // Most buttons filter the Approval Status column (4). "Under Assessment" is a workflow
                    // stage, not an approval outcome, so that button filters the Workflow column (5),
                    // matching "Under Assessment" and "Re-review: Under Assessment".
                    table.column(4).search('', true, false);
                    table.column(5).search('', true, false);
                    if (val) {
                        if ($(this).data('col') === 5)
                            table.column(5).search('(^|: )' + $.fn.dataTable.util.escapeRegex(val) + '$', true, false);
                        else
                            table.column(4).search('^' + val + '$', true, false);
                    }
                    table.draw();
                });
                $('.status-filter[data-status=""]').addClass('active');
            },
            "columns": [
                null,
                null,
                { "visible": false },
                { "visible": false },
                null,
                { "visible": false },
                { "visible": false },
                null,
                null
            ],
            paging: true,
            orderCellsTop: true,
            dom: 'lBfrtip',
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, @Json.Serialize(L["All"].Value)]],
            "order": [[0, 'asc']],
            displayLength: 10,
            buttons: [
                'colvis',
                {
                    extend: 'pdf',
                    footer: false,
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6, 7] }
                },
                {
                    extend: 'excel',
                    footer: false,
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6, 7] }
                }
            ]
        });
    });
</script>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@L["Suppliers"]</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>@L["New Supplier"]</a>
</div>
<hr />

<div class="mb-3 d-flex align-items-center gap-2 flex-wrap">
    <span class="text-muted small me-1">@L["Filter by status:"]</span>
    <button class="btn btn-outline-secondary btn-sm status-filter" data-status="">@L["All"]</button>
    <button class="btn btn-outline-secondary btn-sm status-filter" data-status="Pending">@L["Pending"]</button>
    <button class="btn btn-outline-info btn-sm status-filter" data-status="@L["Under Assessment"]" data-col="5">@L["Under Assessment"]</button>
    <button class="btn btn-outline-success btn-sm status-filter" data-status="Approved">@L["Approved"]</button>
    <button class="btn btn-outline-primary btn-sm status-filter" data-status="Qualified">@L["Qualified"]</button>
    <button class="btn btn-outline-warning btn-sm status-filter" data-status="Suspended">@L["Suspended"]</button>
    <button class="btn btn-outline-secondary btn-sm status-filter" data-status="Cancelled">@L["Cancelled"]</button>
    <partial name="_AssignedToMeFilter" model="7" />
</div>

<table id="suppliersTable" class="table" style="width:100%;">
    <thead>
        <tr>
            <th>@L["Supplier ID"]</th>
            <th>@L["Legal Name"]</th>
            <th>@L["Type"]</th>
            <th>@L["Risk Level"]</th>
            <th>@L["Approval Status"]</th>
            <th>@L["Workflow"]</th>
            <th>@L["Next Review"]</th>
            <th>@L["Assigned to"]</th>
            <th>@L["Action"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string approvalLabel = item.ApprovalStatus == null ? "Pending"
                : item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Approved ? "Approved"
                : item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Qualified ? "Qualified"
                : item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Suspended ? "Suspended"
                : item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Cancelled ? "Cancelled"
                : item.ApprovalStatus.ToString()!;
            bool itemReReview = (item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Approved
                                 || item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Qualified)
                             && (item.Status == OpenQMS.Models.SupplierStatus.Pending
                                 || item.Status == OpenQMS.Models.SupplierStatus.UnderAssessment);
            string workflowLabel = item.Status == OpenQMS.Models.SupplierStatus.Approved
                                || item.Status == OpenQMS.Models.SupplierStatus.Qualified
                                ? "Complete"
                                : itemReReview
                                    ? "Re-review: " + L.Enum(item.Status)
                                    : L.Enum(item.Status);
            bool itemLocked = item.Status == OpenQMS.Models.SupplierStatus.Approved
                           || item.Status == OpenQMS.Models.SupplierStatus.Qualified
                           || item.Status == OpenQMS.Models.SupplierStatus.Suspended
                           || item.Status == OpenQMS.Models.SupplierStatus.Cancelled
                           || item.Status == OpenQMS.Models.SupplierStatus.PendingSuspension
                           || item.Status == OpenQMS.Models.SupplierStatus.PendingCancellation;
            bool itemEverCompleted = item.ApprovalStatus != null && item.ApprovalStatus != OpenQMS.Models.SupplierStatus.Pending;
            <tr>
                <td>@item.SupplierCode</td>
                <td>@item.LegalName</td>
                <td>@L.Enum(item.SupplierType)</td>
                <td>@(item.ApprovalStatus != null ? L.Enum(item.RiskLevel) : "-")</td>
                <td>@L[approvalLabel]</td>
                <td>@workflowLabel</td>
                <td>@(item.NextReviewDate.HasValue ? item.NextReviewDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                <partial name="_AssignedToCell" model="@(OpenQMS.Services.Workflow.TaskAssignmentService.For(assignedMap, item.Id, (int)item.Status))" />
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">@L["Details"]</a>
                    @if (item.Status == OpenQMS.Models.SupplierStatus.Pending)
                    {
                        <text> | </text>
                        <a asp-action="Edit" asp-route-id="@item.Id">@L["Edit"]</a>
                    }
                    @if (User.IsInRole(OpenQMS.Authorization.Constants.AdministratorsRole)
                         && (item.Status == OpenQMS.Models.SupplierStatus.Pending
                             || item.Status == OpenQMS.Models.SupplierStatus.UnderAssessment))
                    {
                        <text> | </text>
                        <a asp-action="Delete" asp-route-id="@item.Id">@L["Delete"]</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

