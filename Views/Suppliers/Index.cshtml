@model IEnumerable<OpenQMS.Models.Supplier>

@{
    ViewData["Title"] = "Index";
}

@section Scripts {
<script>
    $(document).ready(function () {
        var table = $('#suppliersTable').DataTable({ stateSave: true,
            initComplete: function () {
                $('.status-filter').on('click', function () {
                    $('.status-filter').removeClass('active');
                    $(this).addClass('active');
                    var val = $(this).data('status');
                    table.column(4).search(val ? '^' + val + '$' : '', true, false).draw();
                });
                $('.status-filter[data-status=""]').addClass('active');
            },
            "columns": [
                null,
                null,
                { "visible": false },
                { "visible": false },
                null,
                { "visible": false },
                { "visible": false },
                null
            ],
            paging: true,
            orderCellsTop: true,
            dom: 'lBfrtip',
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]],
            "order": [[0, 'asc']],
            displayLength: 10,
            buttons: [
                'colvis',
                {
                    extend: 'pdf',
                    footer: false,
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] }
                },
                {
                    extend: 'excel',
                    footer: false,
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] }
                }
            ]
        });
    });
</script>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Suppliers</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Supplier</a>
</div>
<hr />

<div class="mb-3 d-flex align-items-center gap-2 flex-wrap">
    <span class="text-muted small me-1">Filter by status:</span>
    <button class="btn btn-outline-secondary btn-sm status-filter" data-status="">All</button>
    <button class="btn btn-outline-secondary btn-sm status-filter" data-status="Pending">Pending</button>
    <button class="btn btn-outline-info btn-sm status-filter" data-status="UnderAssessment">Under Assessment</button>
    <button class="btn btn-outline-success btn-sm status-filter" data-status="Approved">Approved</button>
    <button class="btn btn-outline-primary btn-sm status-filter" data-status="Qualified">Qualified</button>
    <button class="btn btn-outline-warning btn-sm status-filter" data-status="Suspended">Suspended</button>
    <button class="btn btn-outline-secondary btn-sm status-filter" data-status="Cancelled">Cancelled</button>
</div>

<table id="suppliersTable" class="table" style="width:100%;">
    <thead>
        <tr>
            <th>Supplier ID</th>
            <th>Legal Name</th>
            <th>Type</th>
            <th>Risk Level</th>
            <th>Approval Status</th>
            <th>Workflow</th>
            <th>Next Review</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string approvalLabel = item.ApprovalStatus == null ? "Pending"
                : item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Approved ? "Approved"
                : item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Qualified ? "Qualified"
                : item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Suspended ? "Suspended"
                : item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Cancelled ? "Cancelled"
                : item.ApprovalStatus.ToString()!;
            bool itemReReview = (item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Approved
                                 || item.ApprovalStatus == OpenQMS.Models.SupplierStatus.Qualified)
                             && (item.Status == OpenQMS.Models.SupplierStatus.Pending
                                 || item.Status == OpenQMS.Models.SupplierStatus.UnderAssessment);
            string workflowLabel = item.Status == OpenQMS.Models.SupplierStatus.Approved
                                || item.Status == OpenQMS.Models.SupplierStatus.Qualified
                                ? "Complete"
                                : itemReReview
                                    ? "Re-review: " + EnumHelper.Display(item.Status)
                                    : EnumHelper.Display(item.Status);
            bool itemLocked = item.Status == OpenQMS.Models.SupplierStatus.Approved
                           || item.Status == OpenQMS.Models.SupplierStatus.Qualified
                           || item.Status == OpenQMS.Models.SupplierStatus.Suspended
                           || item.Status == OpenQMS.Models.SupplierStatus.Cancelled
                           || item.Status == OpenQMS.Models.SupplierStatus.PendingSuspension
                           || item.Status == OpenQMS.Models.SupplierStatus.PendingCancellation;
            bool itemEverCompleted = item.ApprovalStatus != null && item.ApprovalStatus != OpenQMS.Models.SupplierStatus.Pending;
            <tr>
                <td>@item.SupplierCode</td>
                <td>@item.LegalName</td>
                <td>@item.SupplierType</td>
                <td>@(item.ApprovalStatus != null ? item.RiskLevel.ToString() : "-")</td>
                <td>@approvalLabel</td>
                <td>@workflowLabel</td>
                <td>@(item.NextReviewDate.HasValue ? item.NextReviewDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    @if (item.Status == OpenQMS.Models.SupplierStatus.Pending)
                    {
                        <text> | </text>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    }
                    @if (User.IsInRole(OpenQMS.Authorization.Constants.AdministratorsRole)
                         && (item.Status == OpenQMS.Models.SupplierStatus.Pending
                             || item.Status == OpenQMS.Models.SupplierStatus.UnderAssessment))
                    {
                        <text> | </text>
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

