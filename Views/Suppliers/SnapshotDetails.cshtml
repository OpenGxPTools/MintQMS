@model OpenQMS.Models.SupplierSnapshot

@{
    ViewData["Title"] = L["Review Snapshot"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">@L["Review Snapshot — {0}", Model.SupplierCode]</h4>
        <small class="text-muted">@Model.LegalName &middot; @L["Completed {0} by {1}", Model.SnapshotDate.ToSite().ToString("dd/MM/yyyy HH:mm"), Model.CompletedBy ?? ""]</small>
    </div>
</div>
<hr />

<div>

        @{
            var badgeClass = Model.ApprovalStatus switch
            {
                OpenQMS.Models.SupplierStatus.Approved => "badge bg-success fs-6",
                OpenQMS.Models.SupplierStatus.Qualified => "badge bg-primary fs-6",
                OpenQMS.Models.SupplierStatus.Suspended => "badge bg-warning text-dark fs-6",
                OpenQMS.Models.SupplierStatus.Cancelled => "badge bg-secondary fs-6",
                _ => "badge bg-light text-dark fs-6"
            };
        }
        <div class="mb-3"><span class="@badgeClass">@L.Enum(Model.ApprovalStatus)</span></div>

        @if (Model.ReviewTrigger.HasValue)
        {
            <div class="alert alert-info">
                <strong>@L["Review Trigger:"]</strong> @L.Enum(Model.ReviewTrigger.Value)
                @if (!string.IsNullOrEmpty(Model.ReasonForReview))
                {
                    <br /><strong>@L["Reason for Review:"]</strong> @Model.ReasonForReview
                }
                @if (!string.IsNullOrEmpty(Model.LinkedQualityRecordCode))
                {
                    <br /><strong>@L["Linked Record:"]</strong> @(Model.LinkedQualityRecordCode + " - " + Model.LinkedQualityRecordTitle)
                }
            </div>
        }

        <h5>@L["Identity"]</h5>
        <dl class="row">
            <dt class="col-sm-4">@L["Supplier ID"]</dt><dd class="col-sm-8">@Model.SupplierCode</dd>
            <dt class="col-sm-4">@L["Legal Name"]</dt><dd class="col-sm-8">@Model.LegalName</dd>
            <dt class="col-sm-4">@L["Trading Name"]</dt><dd class="col-sm-8">@(Model.TradingName ?? "-")</dd>
            <dt class="col-sm-4">@L["Legal ID"]</dt><dd class="col-sm-8">@(Model.LegalId ?? "-")</dd>
            <dt class="col-sm-4">@L["Website"]</dt><dd class="col-sm-8">@(Model.Website ?? "-")</dd>
        </dl>

        <hr />
        <h5>@L["Address"]</h5>
        <dl class="row">
            <dt class="col-sm-4">@L["Street"]</dt><dd class="col-sm-8">@(Model.Street ?? "-")</dd>
            <dt class="col-sm-4">@L["City"]</dt><dd class="col-sm-8">@(Model.City ?? "-")</dd>
            <dt class="col-sm-4">@L["State"]</dt><dd class="col-sm-8">@(Model.State ?? "-")</dd>
            <dt class="col-sm-4">@L["Post Code"]</dt><dd class="col-sm-8">@(Model.PostCode ?? "-")</dd>
            <dt class="col-sm-4">@L["Country"]</dt><dd class="col-sm-8">@(Model.Country ?? "-")</dd>
        </dl>

        <hr />
        <h5>@L["Primary Contact"]</h5>
        <dl class="row">
            <dt class="col-sm-4">@L["Contact Name"]</dt><dd class="col-sm-8">@(Model.ContactName ?? "-")</dd>
            <dt class="col-sm-4">@L["Contact Email"]</dt><dd class="col-sm-8">@(Model.ContactEmail ?? "-")</dd>
            <dt class="col-sm-4">@L["Contact Phone"]</dt><dd class="col-sm-8">@(Model.ContactPhone ?? "-")</dd>
        </dl>

        <hr />
        <h5>@L["Classification"]</h5>
        <dl class="row">
            <dt class="col-sm-4">@L["Supplier Type"]</dt><dd class="col-sm-8">@L.Enum(Model.SupplierType)</dd>
            <dt class="col-sm-4">@L["Products / Materials / Services"]</dt><dd class="col-sm-8">@(Model.LinkedItems ?? "-")</dd>
        </dl>

        <hr />
        <h5>@L["Assessment"]</h5>
        <dl class="row">
            <dt class="col-sm-4">@L["Assessed By"]</dt><dd class="col-sm-8">@(Model.AssessedBy ?? "-")</dd>
            <dt class="col-sm-4">@L["Assessed On"]</dt><dd class="col-sm-8">@(Model.AssessedOn.HasValue ? Model.AssessedOn.Value.ToSite().ToString("dd/MM/yyyy HH:mm") : "-")</dd>
        </dl>

        <hr />
        <h5>@L["Approval"]</h5>
        <dl class="row">
            <dt class="col-sm-4">@L["Risk Level"]</dt><dd class="col-sm-8">@L.Enum(Model.RiskLevel)</dd>
            <dt class="col-sm-4">@L["Risk Justification"]</dt><dd class="col-sm-8">@(Model.RiskJustification ?? "-")</dd>
            <dt class="col-sm-4">@L["Review Frequency"]</dt><dd class="col-sm-8">@Model.ReviewFrequency</dd>
            <dt class="col-sm-4">@L["Qualification Required"]</dt><dd class="col-sm-8">@(Model.QualificationRequired ? "Yes" : "No")</dd>
            <dt class="col-sm-4">@L["Approved By"]</dt><dd class="col-sm-8">@(Model.ApprovedBy ?? "-")</dd>
            <dt class="col-sm-4">@L["Approved On"]</dt><dd class="col-sm-8">@(Model.ApprovedOn.HasValue ? Model.ApprovedOn.Value.ToSite().ToString("dd/MM/yyyy HH:mm") : "-")</dd>
            <dt class="col-sm-4">@L["Next Review Date"]</dt><dd class="col-sm-8">@(Model.NextReviewDate.HasValue ? Model.NextReviewDate.Value.ToString("dd/MM/yyyy") : "-")</dd>
            <dt class="col-sm-4">@L["Approval Expiry"]</dt><dd class="col-sm-8">@(Model.ExpiryDate.HasValue ? Model.ExpiryDate.Value.ToString("dd/MM/yyyy") : "None")</dd>
            @if (Model.ExpiryDate.HasValue && !string.IsNullOrWhiteSpace(Model.ApprovalExpiryReason))
            {
                <dt class="col-sm-4">@L["Expiry Reason"]</dt><dd class="col-sm-8">@Model.ApprovalExpiryReason</dd>
            }
            <dt class="col-sm-4">@L["Approval Comments"]</dt><dd class="col-sm-8">@(Model.ApprovalComments ?? "-")</dd>
        </dl>

        @if (Model.QualifiedBy != null)
        {
            <hr />
            <h5>@L["Qualification"]</h5>
            <dl class="row">
                <dt class="col-sm-4">@L["Qualified By"]</dt><dd class="col-sm-8">@Model.QualifiedBy</dd>
                <dt class="col-sm-4">@L["Qualified On"]</dt><dd class="col-sm-8">@(Model.QualifiedOn.HasValue ? Model.QualifiedOn.Value.ToSite().ToString("dd/MM/yyyy HH:mm") : "-")</dd>
                <dt class="col-sm-4">@L["Qualification Basis"]</dt><dd class="col-sm-8">@(Model.QualificationBasis.HasValue ? L.Enum(Model.QualificationBasis) : "-")</dd>
                <dt class="col-sm-4">@L["Qualification Justification"]</dt><dd class="col-sm-8">@(Model.QualificationJustification ?? "-")</dd>
                <dt class="col-sm-4">@L["Reference Document"]</dt><dd class="col-sm-8">@(Model.QualificationReferenceDoc ?? "-")</dd>
                <dt class="col-sm-4">@L["Qualification Comments"]</dt><dd class="col-sm-8">@(Model.QualificationComments ?? "-")</dd>
            </dl>
        }

        @if (Model.SuspendedBy != null)
        {
            <hr />
            <div class="alert alert-warning">
                <strong>@L["Suspended"]</strong> @L["by {0} on {1}", Model.SuspendedBy ?? "-", Model.SuspendedOn.HasValue ? Model.SuspendedOn.Value.ToSite().ToString("dd/MM/yyyy") : "-"]<br />
                @L["Reason: {0}", Model.SuspensionReason ?? "-"]
            </div>
        }

        @if (Model.CancelledBy != null)
        {
            <hr />
            <div class="alert alert-secondary">
                <strong>@L["Cancelled"]</strong> @L["by {0} on {1}", Model.CancelledBy ?? "-", Model.CancelledOn.HasValue ? Model.CancelledOn.Value.ToSite().ToString("dd/MM/yyyy") : "-"]<br />
                @L["Reason: {0}", Model.CancellationReason ?? "-"]
            </div>
        }

        @if (Model.Addresses != null && Model.Addresses.Any())
        {
            <hr />
            <h5>@L["Additional Addresses"]</h5>
            <table class="table table-sm">
                <thead><tr><th>@L["Street"]</th><th>@L["City"]</th><th>@L["State"]</th><th>@L["Post Code"]</th><th>@L["Country"]</th><th>@L["Notes"]</th></tr></thead>
                <tbody>
                    @foreach (var addr in Model.Addresses)
                    {
                        <tr>
                            <td>@(addr.Street ?? "-")</td>
                            <td>@(addr.City ?? "-")</td>
                            <td>@(addr.State ?? "-")</td>
                            <td>@(addr.PostCode ?? "-")</td>
                            <td>@(addr.Country ?? "-")</td>
                            <td>@(addr.Notes ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Model.Documents != null && Model.Documents.Any())
        {
            <hr />
            <h5>@L["Documents at Time of Completion"]</h5>
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>@L["Type"]</th>
                        <th>@L["File Name"]</th>
                        <th>@L["Description"]</th>
                        <th>@L["Issue Date"]</th>
                        <th>@L["Expiry Date"]</th>
                        <th>@L["Uploaded By"]</th>
                        <th>@L["Action"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.Documents)
                    {
                        <tr>
                            <td>@L.Enum(doc.DocumentType)</td>
                            <td>@doc.FileName</td>
                            <td>@(doc.Description ?? "-")</td>
                            <td>@(doc.IssueDate.HasValue ? doc.IssueDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>@(doc.ExpiryDate.HasValue ? doc.ExpiryDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>@(doc.UploadedBy ?? "-")</td>
                            <td><a asp-action="DownloadSnapshotDocument" asp-route-id="@doc.Id">@L["Download"]</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Model.QualityRecords != null && Model.QualityRecords.Any())
        {
            <hr />
            <h5>@L["Quality Records at Time of Completion"]</h5>
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>@L["Type"]</th>
                        <th>@L["ID"]</th>
                        <th>@L["Title"]</th>
                        <th>@L["Notes"]</th>
                        <th>@L["Linked By"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var qr in Model.QualityRecords)
                    {
                        var detailsUrl = qr.RecordType switch
                        {
                            OpenQMS.Models.QualityRecordType.Deviation => "/Deviations/Details/" + qr.DeviationId,
                            OpenQMS.Models.QualityRecordType.CAPA => "/Capas/Details/" + qr.CapaId,
                            OpenQMS.Models.QualityRecordType.Change => "/Changes/Details/" + qr.ChangeId,
                            OpenQMS.Models.QualityRecordType.Complaint => "/Complaints/Details/" + qr.ComplaintId,
                            OpenQMS.Models.QualityRecordType.Risk => "/Risks/Details/" + qr.RiskId,
                            OpenQMS.Models.QualityRecordType.Audit => "/Audits/Details/" + qr.AuditId,
                            _ => "#"
                        };
                        <tr>
                            <td>@qr.RecordType</td>
                            <td><a href="@detailsUrl">@(qr.RecordCode ?? "-")</a></td>
                            <td>@(qr.RecordTitle ?? "-")</td>
                            <td>@(qr.Notes ?? "-")</td>
                            <td>@(qr.LinkedBy ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Reviews" asp-route-id="@Model.SupplierId" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-left me-1"></i>@L["Back to Reviews"]</a>
    <a asp-action="Details" asp-route-id="@Model.SupplierId" class="btn btn-outline-secondary btn-sm">@L["Supplier Details"]</a>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-list me-1"></i>@L["Back to List"]</a>
</div>
