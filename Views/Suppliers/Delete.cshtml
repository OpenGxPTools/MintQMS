@model OpenQMS.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">Delete Supplier</h4>
    </div>
</div>
<hr />
<h5 class="text-danger">Are you sure you want to delete this supplier? This cannot be undone.</h5>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Supplier ID</dt>
            <dd class="col-sm-8">@Model.SupplierCode</dd>
            <dt class="col-sm-4">Legal Name</dt>
            <dd class="col-sm-8">@Model.LegalName</dd>
            <dt class="col-sm-4">Type</dt>
            <dd class="col-sm-8">@Model.SupplierType</dd>
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@EnumHelper.Display(Model.Status)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-2">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
    </div>
</form>
