@model IEnumerable<OpenQMS.Models.SettingsAuditLog>

@{
    ViewData["Title"] = L["Settings Audit Log"].Value;
}

<h4>@L["Settings Audit Log"]</h4>
<hr />

<p>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; @L["Back to Settings"]</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">@L["No settings changes have been recorded yet."]</div>
}
else
{
    <table id="settingsAuditTable" class="table table-hover table-sm">
        <thead>
            <tr>
                <th>@L["Date / Time"] <span class="fw-normal text-muted">(@SiteTime.Label)</span></th>
                <th>@L["Changed By"]</th>
                <th>@L["Field"]</th>
                <th>@L["Previous Value"]</th>
                <th>@L["New Value"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.ChangedOn.ToSite().ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@log.ChangedBy</td>
                    <td><code>@log.FieldName</code></td>
                    <td class="text-muted">@(log.OldValue ?? "—")</td>
                    <td>@(log.NewValue ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#settingsAuditTable').DataTable({
                pageLength: 25,
                order: [[0, 'desc']],
                dom: 'Bfrtip',
                buttons: ['excel', 'print']
            });
        });
    </script>
}
