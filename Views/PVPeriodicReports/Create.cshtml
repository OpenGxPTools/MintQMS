@model OpenQMS.Models.PVPeriodicReport
@{
    ViewData["Title"] = "New PSUR Period";
    var productItems = ViewData["ProductId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<h4 class="mb-0"><i class="fas fa-plus-circle me-2 text-primary"></i>New PSUR Period</h4>
<hr />

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CreatedBy" />
    <input type="hidden" asp-for="CreatedOn" />

    <div class="row g-3">
        <div class="col-md-12">
            <label asp-for="Title" class="form-label fw-bold"></label>
            <input asp-for="Title" class="form-control" placeholder="e.g. PSUR Period 3 — ProductName — Jan–Dec 2025" required />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="ProductId" class="form-label fw-bold">Product</label>
            <select asp-for="ProductId" asp-items="productItems" class="form-select">
                <option value="">— All Products —</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="PeriodStart" class="form-label fw-bold"></label>
            <input asp-for="PeriodStart" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="PeriodEnd" class="form-label fw-bold"></label>
            <input asp-for="PeriodEnd" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="DueDate" class="form-label fw-bold"></label>
            <input asp-for="DueDate" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Status" class="form-label fw-bold"></label>
            <select asp-for="Status" class="form-select">
                @Html.Raw(string.Join("", Enum.GetValues<PVPeriodicReport.PSURStatus>()
                    .Select(s => $"<option value=\"{(int)s}\">{s}</option>")))
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="TGAReferenceNumber" class="form-label fw-bold"></label>
            <input asp-for="TGAReferenceNumber" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="ExposureData" class="form-label fw-bold"></label>
            <input asp-for="ExposureData" class="form-control" placeholder="e.g. 1,250 patient-years; 45,000 units sold" />
        </div>
        <div class="col-md-12">
            <label asp-for="BenefitRiskConclusion" class="form-label fw-bold"></label>
            <textarea asp-for="BenefitRiskConclusion" class="form-control" rows="4"
                      placeholder="Benefit-risk narrative for the period..."></textarea>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-1"></i>Create PSUR
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
    </div>
</form>
