@model OpenQMS.Models.PVPeriodicReport
@using OpenQMS.Models
@{
    ViewData["Title"] = Model.Title;
    var linkedCases    = Model.LinkedAECases ?? Enumerable.Empty<AERegulatoryReport>();
    var unlinkedCases  = ViewBag.UnlinkedCases as IEnumerable<AdverseEvent> ?? Enumerable.Empty<AdverseEvent>();

    var statusClass = Model.Status switch {
        PVPeriodicReport.PSURStatus.InPreparation => "secondary",
        PVPeriodicReport.PSURStatus.UnderReview   => "info",
        PVPeriodicReport.PSURStatus.Submitted     => "primary",
        PVPeriodicReport.PSURStatus.Accepted      => "success",
        _ => "secondary"
    };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@L.Message(TempData["Success"])
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@L.Message(TempData["Error"])
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-0"><i class="fas fa-file-medical-alt me-2 text-primary"></i>@Model.Title</h4>
        <span class="badge bg-@statusClass fs-6">@L.Enum(Model.Status)</span>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-edit me-1"></i>@L["Edit"]
        </a>
        <a asp-action="ExportPSURData" asp-route-id="@Model.Id" class="btn btn-success btn-sm ms-2">
            <i class="fas fa-file-excel me-1"></i>@L["Export PSUR Data (Excel)"]
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-2">
            <i class="fas fa-arrow-left me-1"></i>@L["Back"]
        </a>
    </div>
</div>

<!-- ── Workflow Actions ──────────────────────────────────────────────── -->
<div class="card mb-3 border-primary">
    <div class="card-header bg-primary bg-opacity-10 d-flex align-items-center py-2">
        <i class="fas fa-exchange-alt me-2 text-primary"></i>
        <strong class="text-primary">@L["Workflow Actions"]</strong>
        <span class="ms-2 text-muted small">@H["Current status: <strong>{0}</strong>", L.Enum(Model.Status)]</span>
    </div>
    <div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
        @if (Model.Status == PVPeriodicReport.PSURStatus.InPreparation)
        {
            <form asp-action="Transition" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="newStatus" value="UnderReview" />
                <button type="submit" class="btn btn-sm btn-info"><i class="fas fa-search me-1"></i>@L["Move to Under Review"]</button>
            </form>
        }
        else if (Model.Status == PVPeriodicReport.PSURStatus.UnderReview)
        {
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#submitModal">
                <i class="fas fa-paper-plane me-1"></i>@L["Submit to Authority"]
            </button>
            <form asp-action="Transition" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="newStatus" value="InPreparation" />
                <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>@L["Revert to In Preparation"]</button>
            </form>
        }
        else if (Model.Status == PVPeriodicReport.PSURStatus.Submitted)
        {
            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#acceptModal">
                <i class="fas fa-check-circle me-1"></i>@L["Mark Accepted"]
            </button>
        }
        else
        {
            <span class="text-success mb-0"><i class="fas fa-lock me-1"></i>@L["This report is Accepted and locked."]</span>
        }
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-0" id="psurTabs">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-report">@L["Report"]</a></li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#tab-audit">
            @L["Audit Trail"]
            @if ((Model.AuditLogs?.Count ?? 0) > 0) { <span class="badge bg-secondary">@Model.AuditLogs!.Count</span> }
        </a>
    </li>
</ul>
<div class="tab-content border border-top-0 rounded-bottom p-3 mb-3">
<div class="tab-pane fade show active" id="tab-report">

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">@L["PSUR Details"]</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@L["Product"]</dt>
                    <dd class="col-sm-8">@(Model.Product?.Name ?? L["All Products"].Value)</dd>
                    <dt class="col-sm-4">@L["Period"]</dt>
                    <dd class="col-sm-8">
                        @(Model.PeriodStart?.ToString("dd MMM yyyy", DisplayDates.Culture) ?? "—")
                        @if (Model.PeriodStart.HasValue && Model.PeriodEnd.HasValue) { <span>→</span> }
                        @(Model.PeriodEnd?.ToString("dd MMM yyyy", DisplayDates.Culture) ?? "")
                    </dd>
                    <dt class="col-sm-4">@L["Due Date"]</dt>
                    <dd class="col-sm-8">@(Model.DueDate?.ToString("dd MMM yyyy", DisplayDates.Culture) ?? "—")</dd>
                    <dt class="col-sm-4">@L["Submission Date"]</dt>
                    <dd class="col-sm-8">
                        @if (Model.SubmissionDate.HasValue) {
                            <span class="badge bg-success">@Model.SubmissionDate.Value.ToString("dd MMM yyyy", DisplayDates.Culture)</span>
                        } else { <span class="text-muted">@L["Not yet submitted"]</span> }
                    </dd>
                    <dt class="col-sm-4">@L["Authority Reference"]</dt>
                    <dd class="col-sm-8">@(Model.TGAReferenceNumber ?? "—")</dd>
                    <dt class="col-sm-4">@L["Exposure Data"]</dt>
                    <dd class="col-sm-8">@(Model.ExposureData ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white">@L["Benefit-Risk Conclusion"]</div>
            <div class="card-body" style="white-space:pre-wrap">@(Model.BenefitRiskConclusion ?? L["Not yet completed."].Value)</div>
        </div>
    </div>
</div>

<!-- ── Linked AE Cases ───────────────────────────────────────────────── -->
<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-list me-1"></i>@L["Linked AE Cases"]
            <span class="badge bg-primary ms-2">@linkedCases.Count()</span>
        </span>
        <small class="text-muted">@L["{0} serious", linkedCases.Count(r => r.AdverseEvent?.IsSerious == true)]</small>
    </div>
    <div class="card-body p-0">
        @if (!linkedCases.Any())
        {
            <p class="text-muted p-3 mb-0">@L["No AE cases linked to this PSUR yet."]</p>
        }
        else
        {
            <table class="table table-sm table-hover mb-0" id="linkedTable">
                <thead class="table-light">
                    <tr>
                        <th>#</th><th>@L["AE Number"]</th><th>@L["Report Date"]</th>
                        <th>@L["Patient"]</th><th>@L["Suspect Drug"]</th><th>@L["MedDRA PT"]</th>
                        <th>@L["Serious"]</th><th>@L["Outcome"]</th><th>@L["Causality"]</th><th>@L["Submitted to Authority"]</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int caseNo = 1; }
                    @foreach (var reg in linkedCases)
                    {
                        var ae = reg.AdverseEvent;
                        if (ae == null) continue;
                        <tr class="@(ae.IsSerious ? "table-danger" : "")">
                            <td>@caseNo</td>
                            <td><a asp-controller="Pharmacovigilance" asp-action="Details" asp-route-id="@ae.Id">@ae.AENumber</a></td>
                            <td>@(SiteTime.ToSite((DateTime)ae.ReportDate).ToString("dd MMM yyyy", DisplayDates.Culture))</td>
                            <td>@(ae.Patient?.PatientIdentifier ?? "—")</td>
                            <td>@(ae.SuspectProduct?.ProductName ?? "—")</td>
                            <td>@(ae.MedDRAPT ?? "—")</td>
                            <td>@Html.Raw(ae.IsSerious ? "<span class=\"badge bg-danger\">Yes</span>" : "No")</td>
                            <td>@(ae.Outcome == null ? "—" : L.Enum(ae.Outcome))</td>
                            <td>@(ae.Causality == null ? "—" : L.Enum(ae.Causality))</td>
                            <td>
                                @if (reg.TGASubmissionDate.HasValue) {
                                    <span class="badge bg-success">@reg.TGASubmissionDate.Value.ToString("dd MMM yy", DisplayDates.Culture)</span>
                                } else { <span class="text-muted">—</span> }
                            </td>
                        </tr>
                        caseNo++;
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- ── Unlinked cases awaiting inclusion ────────────────────────────── -->
@if (unlinkedCases.Any())
{
    <div class="card shadow-sm border-warning mb-4">
        <div class="card-header bg-warning text-dark">
            <i class="fas fa-inbox me-1"></i>@L["Cases Flagged for PSUR (Not Yet Linked)"]
            <span class="badge bg-dark ms-2">@unlinkedCases.Count()</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr><th>@L["AE Number"]</th><th>@L["MedDRA PT"]</th><th>@L["Serious"]</th><th>@L["Status"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var ae in unlinkedCases)
                    {
                        <tr>
                            <td><a asp-controller="Pharmacovigilance" asp-action="Details" asp-route-id="@ae.Id">@ae.AENumber</a></td>
                            <td>@(ae.MedDRAPT ?? "—")</td>
                            <td>@Html.Raw(ae.IsSerious ? "<span class=\"badge bg-danger\">Yes</span>" : "No")</td>
                            <td><span class="badge bg-secondary">@L.Enum(ae.Status)</span></td>
                            <td>
                                <form asp-action="LinkCase" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="psurId" value="@Model.Id" />
                                    <input type="hidden" name="aeRegId" value="@ae.RegulatoryReport!.Id" />
                                    <button type="submit" class="btn btn-warning btn-sm">
                                        <i class="fas fa-link me-1"></i>@L["Link to This PSUR"]
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ── Attachments ───────────────────────────────────────────────────── -->
<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-paperclip me-1"></i>@L["Attachments"]
            @{ var attCount = Model.Attachments?.Count ?? 0; }
            @if (attCount > 0) { <span class="badge bg-secondary ms-2">@attCount</span> }
        </span>
        @if (Model.Status != PVPeriodicReport.PSURStatus.Accepted)
        {
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#uploadCollapse">
                <i class="fas fa-upload me-1"></i>@L["Upload"]
            </button>
        }
    </div>

    <div class="collapse" id="uploadCollapse">
        <div class="card-body border-bottom bg-light">
            <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="psurId" value="@Model.Id" />
                <div class="col-md-5">
                    <label class="form-label small">@L["File"] <span class="text-danger">*</span></label>
                    <input type="file" name="file" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label small">@L["Description"]</label>
                    <input type="text" name="description" class="form-control form-control-sm" maxlength="500"
                           placeholder="@L["e.g. Final PSUR document, Benefit-risk appendix…"]" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100">@L["Upload"]</button>
                </div>
            </form>
            <small class="text-muted mt-1 d-block">@L["Accepted: {0}. Max 25 MB.", UploadRules.AcceptedLabel]</small>
        </div>
    </div>

    <div class="card-body p-0">
        @if (attCount == 0)
        {
            <p class="text-muted p-3 mb-0">@L["No attachments uploaded. Upload the PSUR document, appendices, or authority correspondence here."]</p>
        }
        else
        {
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr><th>@L["File Name"]</th><th>@L["Description"]</th><th>@L["Uploaded By"]</th><th>@L["Date"]</th><th>@L["Size"]</th><th>@L["SHA-256"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var att in Model.Attachments!.OrderByDescending(a => a.UploadedAt))
                    {
                        <tr>
                            <td><a asp-action="DownloadAttachment" asp-route-id="@att.Id"><i class="fas fa-file me-1 text-muted"></i>@att.FileName</a></td>
                            <td><small class="text-muted">@att.Description</small></td>
                            <td><small>@att.UploadedBy</small></td>
                            <td><small>@att.UploadedAt.ToSite().ToString("dd MMM yyyy", DisplayDates.Culture)</small></td>
                            <td><small>@(att.FileSize > 1024 ? $"{att.FileSize / 1024:N0} KB" : $"{att.FileSize} B")</small></td>
                            <td><code class="small text-muted">@(att.FileHash != null ? att.FileHash[..Math.Min(12, att.FileHash.Length)] + "…" : "—")</code></td>
                            <td class="text-nowrap">
                                <a asp-action="DownloadAttachment" asp-route-id="@att.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-download me-1"></i>@L["Download"]
                                </a>
                                @if (Model.Status != PVPeriodicReport.PSURStatus.Accepted)
                                {
                                    <form asp-action="DeleteAttachment" method="post" class="d-inline ms-1" data-delete-reason="attachment">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@att.Id" />
                                        <input type="hidden" name="psurId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash me-1"></i>@L["Delete"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <partial name="_DeletedAttachments" model='new OpenQMS.Models.DeletedFilesView(ViewBag.DeletedFiles as IEnumerable<OpenQMS.Models.ISoftDeletedFile>, "DownloadAttachment", Noun: "attachments")' />
    </div>
</div>

</div><!-- end tab-report -->

<div class="tab-pane fade" id="tab-audit">
<!-- Audit Log -->
<div class="card shadow-sm">
    <div class="card-header fw-bold">
        <i class="fas fa-history me-1"></i>@L["Audit Trail"]
        <span class="badge bg-secondary ms-2">@(Model.AuditLogs?.Count ?? 0)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.AuditLogs != null && Model.AuditLogs.Any())
        {
            <table class="table table-sm table-bordered mb-0">
                <thead class="table-light">
                    <tr><th>@L["Date/Time"] <span class="fw-normal text-muted">(@SiteTime.Label)</span></th><th>@L["Action"]</th><th>@L["From"]</th><th>@L["To"]</th><th>@L["Performed By"]</th><th>@L["Notes"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.AuditLogs.OrderByDescending(l => l.PerformedOn))
                    {
                        <tr>
                            <td>@log.PerformedOn.ToSite().ToString("dd MMM yyyy HH:mm", DisplayDates.Culture)</td>
                            <td>@log.Action</td>
                            <td>@(log.FromStatus ?? "-")</td>
                            <td>@(log.ToStatus ?? "-")</td>
                            <td>@log.PerformedBy</td>
                            <td>@(log.Notes ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <p class="text-muted p-3 mb-0">@L["No audit log entries yet."]</p> }
    </div>
</div>
</div><!-- end tab-audit -->
</div><!-- end tab-content -->

<!-- ── Submit to Authority Modal (password-gated) ────────────────────── -->
<div class="modal fade" id="submitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SubmitReport" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fas fa-paper-plane me-2"></i>@L["Submit PSUR to Authority"]</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>@H["This records <strong>{0}</strong> as <strong class=\"text-primary\">{1}</strong>. Confirm with your credentials.", Model.Title, L["Submitted"].Value]</p>
                    <div class="mb-3">
                        <label class="form-label">@L["Email"]</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Password"]</label>
                        <input type="password" name="pwd" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane me-1"></i>@L["Confirm Submission"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Mark Accepted Modal (password-gated; locks the report) ─────────── -->
<div class="modal fade" id="acceptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AcceptReport" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fas fa-check-circle me-2"></i>@L["Mark PSUR Accepted"]</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>@H["This marks <strong>{0}</strong> as <strong class=\"text-success\">{1}</strong> and locks the report. Confirm with your credentials.", Model.Title, L["Accepted"].Value]</p>
                    <div class="mb-3">
                        <label class="form-label">@L["Email"]</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Password"]</label>
                        <input type="password" name="pwd" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="submit" class="btn btn-success"><i class="fas fa-check-circle me-1"></i>@L["Confirm Acceptance"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        $('#linkedTable').DataTable({ pageLength: 25 });
    });
</script>
}
