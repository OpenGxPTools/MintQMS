@model OpenQMS.Models.Product
@using OpenQMS.Models

@{
    ViewData["Title"] = "New Product";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var dosageForms = new[] {
        "Tablet","Modified Release Tablet","Dispersible Tablet","Effervescent Tablet","Chewable Tablet","Sublingual Tablet",
        "Capsule (Hard)","Capsule (Soft)","Modified Release Capsule","Lozenge","Granules",
        "Oral Solution","Oral Suspension","Oral Drops","Syrup","Powder for Oral Solution",
        "Solution for Injection","Powder for Injection","Lyophilised Powder for Injection",
        "Suspension for Injection","Concentrate for Solution for Infusion","Solution for Infusion",
        "Cream","Ointment","Gel","Lotion","Transdermal Patch","Topical Solution","Foam",
        "Metered Dose Inhaler (MDI)","Dry Powder Inhaler (DPI)","Nebuliser Solution","Nasal Spray","Nasal Drops",
        "Eye Drops","Eye Ointment","Ear Drops","Suppository","Pessary","Rectal Solution"
    };
    var cosmeticForms = new[] {
        "Cream","Lotion","Gel","Spray","Powder","Liquid","Serum","Foam","Oil","Balm","Stick",
        "Wax","Emulsion","Toner","Exfoliating Scrub","Mask","Mist","Mousse","Ointment","Paste",
        "Solution","Suspension","Roll-on","Pencil","Foundation","Concealer"
    };
    var deviceCategories = new[] {
        "Implant","Diagnostic Imaging Device","Software (SaMD)","Surgical Instrument",
        "In Vitro Diagnostic (IVD)","Patient Monitoring Device","Therapeutic Device",
        "Orthopaedic Device","Cardiovascular Device","Ophthalmic Device","Dental Device",
        "Sterile Single-Use Device","Wearable Device","Prosthetic & Orthotic",
        "Combination Product","General Hospital Device","Laboratory Equipment"
    };
    var rawMatCategories = new[] { "API","Excipient","Cosmetic Ingredient","Packaging","Device Part","Device Subcomponent","Consumable" };
    var rawMatForms = new[] {
        "Solid","Liquid","Gel","Granules","Powder","Device Part","Device Sub-Assembly",
        "Metal Component","Plastic Component","Ceramic Component","Glass Component",
        "Electronic Component","Carton","Plastic Bottle","Glass Bottle","Glass Jar",
        "Plastic Jar","Tray","Grease/Lubricant","Cleaning Product"
    };
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <h4 class="mb-0">New Product</h4>
</div>
<hr />

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="ProductId" value="X" />

    <div class="card mb-4">
        <div class="card-header fw-semibold">Product Identification</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProductType" class="form-label fw-semibold"></label>
                    <select id="ProductType" name="ProductType" class="form-select" required>
                        <option value="">-- Select Product Type --</option>
                        <option value="Pharmaceutical">Pharmaceutical</option>
                        <option value="Biological">Biological</option>
                        <option value="MedicalDevice">Medical Device</option>
                        <option value="ConsumerHealth">Consumer Health</option>
                        <option value="Cosmetic">Cosmetic</option>
                        <option value="RawMaterial">Raw Material</option>
                    </select>
                </div>

                <!-- Pharma / Bio / Consumer Health -->
                <div class="col-md-6" data-pt="Pharmaceutical,Biological,ConsumerHealth" style="display:none">
                    <label asp-for="InnName" class="form-label"></label>
                    <input asp-for="InnName" class="form-control" placeholder="e.g. paracetamol" />
                </div>

                <!-- Cosmetic -->
                <div class="col-md-6" data-pt="Cosmetic" style="display:none">
                    <label asp-for="InciName" class="form-label"></label>
                    <input asp-for="InciName" class="form-control" placeholder="e.g. Aqua, Glycerin..." />
                </div>

                <!-- Medical Device -->
                <div class="col-md-6" data-pt="MedicalDevice" style="display:none">
                    <label asp-for="DeviceTypeCategory" class="form-label"></label>
                    <select asp-for="DeviceTypeCategory" class="form-select">
                        <option value="">-- Select --</option>
                        @foreach (var opt in deviceCategories) { <option>@opt</option> }
                    </select>
                </div>
                <div class="col-md-6" data-pt="MedicalDevice" style="display:none">
                    <label asp-for="ModelVersion" class="form-label"></label>
                    <input asp-for="ModelVersion" class="form-control" placeholder="e.g. v2.1" />
                </div>

                <!-- Raw Material -->
                <div class="col-md-6" data-pt="RawMaterial" style="display:none">
                    <label asp-for="StandardScientificName" class="form-label"></label>
                    <input asp-for="StandardScientificName" class="form-control" />
                </div>
                <div class="col-md-6" data-pt="RawMaterial" style="display:none">
                    <label asp-for="RawMaterialTypeCategory" class="form-label"></label>
                    <select asp-for="RawMaterialTypeCategory" class="form-select">
                        <option value="">-- Select --</option>
                        @foreach (var opt in rawMatCategories) { <option>@opt</option> }
                    </select>
                </div>

                <!-- Brand / Trade Name — all types -->
                <div class="col-md-6">
                    <label asp-for="BrandName" class="form-label"></label>
                    <input asp-for="BrandName" class="form-control" placeholder="e.g. Panadol" />
                </div>

                <!-- Dosage Form — Pharma / Bio / Consumer only -->
                <div class="col-md-6" data-pt="Pharmaceutical,Biological,ConsumerHealth" style="display:none">
                    <label asp-for="DosageForm" class="form-label"></label>
                    <select asp-for="DosageForm" class="form-select">
                        <option value="">-- Select --</option>
                        @foreach (var df in dosageForms) { <option>@df</option> }
                    </select>
                </div>

                <!-- Presentation / Form — Cosmetic -->
                <div class="col-md-6" data-pt="Cosmetic" style="display:none">
                    <label asp-for="PresentationForm" class="form-label"></label>
                    <select asp-for="PresentationForm" class="form-select">
                        <option value="">-- Select --</option>
                        @foreach (var opt in cosmeticForms) { <option>@opt</option> }
                    </select>
                </div>

                <!-- Presentation / Form — Raw Material -->
                <div class="col-md-6" data-pt="RawMaterial" style="display:none">
                    <label asp-for="PresentationForm" class="form-label"></label>
                    <select asp-for="PresentationForm" class="form-select">
                        <option value="">-- Select --</option>
                        @foreach (var opt in rawMatForms) { <option>@opt</option> }
                    </select>
                </div>

                <!-- Grade — Raw Material -->
                <div class="col-md-6" data-pt="RawMaterial" style="display:none">
                    <label asp-for="Grade" class="form-label"></label>
                    <input asp-for="Grade" class="form-control" placeholder="e.g. Pharmaceutical Grade" />
                </div>

                <!-- ARTG — all types -->
                <div class="col-md-6">
                    <label asp-for="ArtgReference" class="form-label"></label>
                    <input asp-for="ArtgReference" class="form-control" placeholder="e.g. AUST R 12345" />
                </div>

                <!-- Description — all types -->
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Related Documents</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">Linked Approved Documents</label>
                    <select id="relatedDocDropdown" class="form-select">
                        <option value="">-- Add Document --</option>
                        @foreach (var d in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["EffectiveDocs"])
                        {
                            <option value="@d.Value" data-text="@d.Text">@d.Text</option>
                        }
                    </select>
                    <div id="relatedDocTags" class="mt-2 d-flex flex-wrap gap-1"></div>
                    <div id="relatedDocHidden" class="d-none"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info small mb-4">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Strength / Presentation</strong> entries can be added after saving. Create the product first, then use the Edit page.
    </div>

    <div class="d-flex gap-2">
        <input type="submit" value="Create Product" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script>
(function () {
    function applyProductType(type) {
        document.querySelectorAll('[data-pt]').forEach(function(el) {
            var types = el.dataset.pt.split(',');
            el.style.display = (type && types.includes(type)) ? '' : 'none';
        });
    }
    var sel = document.getElementById('ProductType');
    sel.addEventListener('change', function () { applyProductType(this.value); });
    applyProductType(sel.value);
})();

function setupPicker(dropdownId, tagsId, hiddenId, inputName, preselected) {
    var selected = {};
    preselected.forEach(function (item) { selected[item.id] = item.text; });
    function render() {
        var tagsDiv = document.getElementById(tagsId);
        var hiddenDiv = document.getElementById(hiddenId);
        tagsDiv.innerHTML = ''; hiddenDiv.innerHTML = '';
        Object.keys(selected).forEach(function (id) {
            var badge = document.createElement('span');
            badge.className = 'badge bg-primary d-flex align-items-center gap-1';
            badge.style.fontSize = '0.85rem';
            badge.textContent = selected[id];
            var btn = document.createElement('button');
            btn.type = 'button'; btn.className = 'btn-close btn-close-white btn-sm ms-1'; btn.style.fontSize = '0.6rem';
            btn.addEventListener('click', function () { delete selected[id]; render(); });
            badge.appendChild(btn); tagsDiv.appendChild(badge);
            var input = document.createElement('input');
            input.type = 'hidden'; input.name = inputName; input.value = id;
            hiddenDiv.appendChild(input);
        });
    }
    document.getElementById(dropdownId).addEventListener('change', function () {
        var id = this.value; var text = this.options[this.selectedIndex].dataset.text;
        if (id && !selected[id]) { selected[id] = text; render(); }
        this.value = '';
    });
    render();
}
var selRelatedDocs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    ((List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["EffectiveDocs"])
        .Where(x => ((List<int>)ViewBag.SelectedRelatedDocIds).Contains(int.Parse(x.Value)))
        .Select(x => new { id = x.Value, text = x.Text }).ToList()));
setupPicker('relatedDocDropdown', 'relatedDocTags', 'relatedDocHidden', 'selectedRelatedDocs', selRelatedDocs);
</script>
}
