@model OpenQMS.Services.IssuedOrgHeader
@* Organisation header of an issued document, as it was at the moment of issue (logo embedded). *@
@if (Model.LogoDataUri != null || !string.IsNullOrEmpty(Model.Name))
{
    <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
        <div>
            @if (Model.LogoDataUri != null)
            {
                <img src="@Model.LogoDataUri" alt="@(Model.Name ?? L["Organisation"].Value)"
                     style="max-height:60px; max-width:200px;" />
            }
        </div>
        <div class="text-end">
            @if (!string.IsNullOrEmpty(Model.Name))
            {
                <div class="fw-bold fs-6">@Model.Name</div>
            }
            @if (!string.IsNullOrEmpty(Model.Address))
            {
                <div class="small text-muted" style="white-space: pre-line;">@Model.Address</div>
            }
        </div>
    </div>
}
