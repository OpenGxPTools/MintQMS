                                    <li><a class="dropdown-item" asp-area="" asp-controller="Release" asp-action="Register"><i class="bi bi-box-seam me-1 text-muted"></i>Release Register</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Release" asp-action="Index"><i class="bi bi-list-ul me-1 text-muted"></i>Release Records</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Release" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>Release Dashboard</a></li>
                                }
                            </ul>
                        </li>
                        @if (Can("Regulatory"))
                        {
                        <li class="nav-item dropdown @Active("Pharmacovigilance", "PVPeriodicReports", "PVLiterature", "PVSignalReview", "RegulatoryIntelligence", "LicencesCertifications")">
