@using System.Linq
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@{
    // Highlight the top-level menu matching the controller of the current page.
    var _curCtrl = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    string Active(params string[] ctrls) =>
        ctrls.Any(c => string.Equals(c, _curCtrl, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

    // Permission-aware menu visibility. These lists MIRROR the controllers' [Authorize]
    // attributes so the menu never offers a link the user can't open. Items not listed
    // here use bare [Authorize] (any authenticated user) and are always shown.
    bool InAny(params string[] roles) => roles.Any(r => User.IsInRole(r));
    bool Can(string key) => key switch
    {
        "Audits"            => InAny("Administrator", "QualityManager", "QualityUser", "AuthorisedPerson", "Auditor", "ReadOnly"),
        "Risks"             => InAny("Administrator", "QualityManager", "QualityUser", "RegulatoryManager", "RegulatoryUser", "AuthorisedPerson", "Auditor", "Trainer", "ReadOnly"),
        "Maintenances"      => InAny("Administrator", "QualityManager", "QualityUser", "AuthorisedPerson", "Auditor", "Trainer", "ReadOnly", "OperationsUser"),
        "Release"           => InAny("Administrator", "QualityManager", "QualityUser", "RegulatoryManager", "RegulatoryUser", "AuthorisedPerson", "Auditor", "Trainer", "ReadOnly", "OperationsUser"),
        "Regulatory"        => InAny("Administrator", "QualityManager", "QualityUser", "RegulatoryManager", "RegulatoryUser", "AuthorisedPerson", "Auditor", "Trainer", "ReadOnly"),
        "Reports"           => InAny("Administrator", "QualityManager", "QualityUser", "AuthorisedPerson", "Auditor", "Trainer", "ReadOnly"),
        "TrainingDashboard" => InAny("Administrator", "QualityManager", "RegulatoryManager", "Trainer", "AuthorisedPerson", "Auditor"),
        _                   => true,
    };
}

@if (SignInManager.IsSignedIn(User))
{
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark mint-navbar mb-3">
            <div class="container-fluid">
                <div class="d-flex flex-column align-items-start me-3">
                    <a class="navbar-brand mb-0 pb-0" asp-area="" asp-controller="Home" asp-action="Index">MintQMS</a>
                    <a class="nav-link p-0" style="font-size:0.75rem;" asp-area="" asp-controller="Home" asp-action="About">About</a>
                </div>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <a class="nav-link px-2 @Active("Home")" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Home"><i class="bi bi-house-fill" style="font-size:1.6rem;"></i></a>
                    <ul class="navbar-nav justify-content-center flex-grow-1">
                        <li class="nav-item dropdown @Active("Deviations", "Complaints", "Capas")">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false"><i class="bi bi-exclamation-triangle me-1"></i>Quality Events <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Deviations" asp-action="Index"><i class="bi bi-exclamation-circle me-1 text-muted"></i>Deviation Register</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Deviations" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>Deviation Dashboard</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Complaints" asp-action="Index"><i class="bi bi-chat-square-text me-1 text-muted"></i>Complaint Register</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Complaints" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>Complaint Dashboard</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Capas" asp-action="Index"><i class="bi bi-arrow-repeat me-1 text-muted"></i>CAPA Register</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Capas" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>CAPA Dashboard</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown @Active("Changes", "Audits", "Risks")">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false"><i class="bi bi-shield-check me-1"></i>Quality Assurance <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Changes" asp-action="Index"><i class="bi bi-arrow-left-right me-1 text-muted"></i>Change Register</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Changes" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>Change Dashboard</a></li>
                                @if (Can("Audits"))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Audits" asp-action="Index"><i class="bi bi-clipboard2-check me-1 text-muted"></i>Audit Register</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Audits" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>Audit Dashboard</a></li>
                                }
                                @if (Can("Risks"))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Risks" asp-action="Index"><i class="bi bi-shield-exclamation me-1 text-muted"></i>Risk Register</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Risks" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>Risk Dashboard</a></li>
                                }
                            </ul>
                        </li>
                        <li class="nav-item dropdown @Active("Suppliers", "Maintenances", "Release")">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false"><i class="bi bi-tools me-1"></i>Quality Operations <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck me-1 text-muted"></i>Supplier Register</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Suppliers" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>Supplier Dashboard</a></li>
                                @if (Can("Maintenances"))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Maintenances" asp-action="Index"><i class="bi bi-wrench me-1 text-muted"></i>Maintenance Register</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Maintenances" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>Maintenance Dashboard</a></li>
                                }
                                @if (Can("Release"))
