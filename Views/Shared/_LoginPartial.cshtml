                            <ul class="dropdown-menu">
                                <li><h6 class="dropdown-header text-uppercase small"><i class="bi bi-heart-pulse me-1 text-danger"></i>Pharmacovigilance</h6></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Pharmacovigilance" asp-action="Index"><i class="bi bi-exclamation-triangle me-1 text-muted"></i>Adverse Events</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Pharmacovigilance" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>PV Dashboard</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PVPeriodicReports" asp-action="Index"><i class="bi bi-file-earmark-bar-graph me-1 text-muted"></i>PSUR / Periodic Reports</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PVLiterature" asp-action="Index"><i class="bi bi-journal-text me-1 text-muted"></i>Literature Monitoring</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PVSignalReview" asp-action="Index"><i class="bi bi-graph-up-arrow me-1 text-muted"></i>Signal Reviews</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header text-uppercase small"><i class="bi bi-globe2 me-1 text-primary"></i>Regulatory Intelligence</h6></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="RegulatoryIntelligence" asp-action="Index"><i class="bi bi-table me-1 text-muted"></i>RI Register</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="RegulatoryIntelligence" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>RI Dashboard</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header text-uppercase small"><i class="bi bi-patch-check me-1 text-success"></i>Licences &amp; Certifications</h6></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="LicencesCertifications" asp-action="Index"><i class="bi bi-table me-1 text-muted"></i>LC Register</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="LicencesCertifications" asp-action="Calendar"><i class="bi bi-calendar3 me-1 text-muted"></i>LC Calendar</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="LicencesCertifications" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>LC Dashboard</a></li>
                            </ul>
                        </li>
                        }
                        <li class="nav-item dropdown @Active("AppDocuments")">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false"><i class="bi bi-file-earmark-text me-1"></i>Documents <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="AppDocuments" asp-action="Index"><i class="bi bi-table me-1 text-muted"></i>Document Register</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="AppDocuments" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>Doc Dashboard</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="AppDocuments" asp-action="Library"><i class="bi bi-collection me-1"></i>Document Library</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown @Active("Trainings")">
                            <a class="people nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false"><i class="bi bi-mortarboard me-1"></i>Training <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Trainings" asp-action="Index"><i class="bi bi-table me-1 text-muted"></i>Training Register</a></li>
                                @if (Can("TrainingDashboard"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Trainings" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>Training Dashboard</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Trainings" asp-action="MyTraining"><i class="bi bi-person-check me-1"></i>My Training</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown @Active("Products", "Processes", "Assets", "Materials", "Services", "Customers")">
                            <a class="plant nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false"><i class="bi bi-database me-1"></i>Reference Data <span class="caret"></span></a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Products" asp-action="Index"><i class="bi bi-box me-1 text-muted"></i>Products</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Processes" asp-action="Index"><i class="bi bi-diagram-3 me-1 text-muted"></i>Processes</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Assets" asp-action="Index"><i class="bi bi-building me-1 text-muted"></i>Assets</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Materials" asp-action="Index"><i class="bi bi-layers me-1 text-muted"></i>Materials</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Services" asp-action="Index"><i class="bi bi-headset me-1 text-muted"></i>Services</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Customers" asp-action="Index"><i class="bi bi-people me-1 text-muted"></i>Customers</a></li>
                                <li><a class="dropdown-item ps-4" asp-area="" asp-controller="Customers" asp-action="Dashboard"><i class="bi bi-speedometer2 me-1 text-muted"></i>Customer Dashboard</a></li>
                            </ul>
                        </li>
                        @if (Can("Reports"))
                        {
                        <li class="nav-item dropdown @Active("Reports")">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false"><i class="bi bi-bar-chart-line me-1"></i>Reports</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Reports" asp-action="ManagementReview"><i class="bi bi-person-workspace me-1 text-muted"></i>Management Review</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Reports" asp-action="TrainingCompliance"><i class="bi bi-clipboard2-data me-1 text-muted"></i>Training Compliance</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Reports" asp-action="OverdueItems"><i class="bi bi-clock-history me-1 text-muted"></i>Overdue Items</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Reports" asp-action="SupportingDocumentExpiry"><i class="bi bi-calendar-x me-1 text-muted"></i>Record Attachments — Expiry Register</a></li>
                            </ul>
                        </li>
                        }
                        @if (User.IsInRole(Constants.AdministratorsRole) || User.IsInRole(Constants.QualityManagerRole) || User.IsInRole(Constants.RegulatoryManagerRole))
                        {
                            <li class="nav-item dropdown @Active("Settings", "ReleaseCertSettings", "AppUsers", "AppRoles", "LoginAudit", "Disposal")">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-expanded="false"><i class="bi bi-sliders me-1"></i>Settings</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear me-1 text-muted"></i>System Settings</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="ReleaseCertSettings" asp-action="Index"><i class="bi bi-file-earmark-check me-1 text-muted"></i>Release Certification Statements</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="AppUsers" asp-action="Index"><i class="bi bi-people me-1 text-muted"></i>Users</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="AppRoles" asp-action="Index"><i class="bi bi-key me-1 text-muted"></i>Roles</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="LoginAudit" asp-action="Index"><i class="bi bi-clock-history me-1 text-muted"></i>Login History</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Disposal" asp-action="Index"><i class="bi bi-trash3 me-1 text-muted"></i>Data Disposal</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @UserManager.GetUserAsync(User).Result.FirstName!</a>
                        </li>
                        <li class="nav-item">
                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit" class="nav-link btn btn-link">Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
}
@*else
{
    <ul class="navbar-nav">
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    </ul>
}*@
