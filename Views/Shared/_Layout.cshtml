@inject OpenQMS.Data.ApplicationDbContext _layoutDb
@inject Microsoft.Extensions.Configuration.IConfiguration _layoutConfig
@{ var _layoutSettings = await _layoutDb.SystemSettings.FindAsync(1); }

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MintQMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Icon libraries vendored locally (wwwroot/lib) so the app renders fully in air-gapped
       GMP deployments. Bootstrap Icons drive the navbar; FontAwesome (fas fa-*) is used by
       hundreds of icons across the module views. *@
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OpenQMS.styles.css" asp-append-version="true" />
</head>
<body>
    <partial name="_LoginPartial" />
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container-fluid px-4">
            &copy; 2026 MintQMS contributors &middot; Free software (AGPLv3), provided without warranty and not
            validated for regulated use &middot; <a asp-area="" asp-controller="Home" asp-action="About">About &amp; disclaimer</a>
            @if (!string.IsNullOrWhiteSpace(_layoutConfig["SourceCodeUrl"]))
            {
                <text>&middot; <a href="@_layoutConfig["SourceCodeUrl"]" target="_blank" rel="noopener">Source code</a></text>
            }
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        window.qmsPageSize      = @(_layoutSettings?.DefaultPageSize ?? 25);
        window.qmsIdleTimeout   = @(_layoutSettings?.IdleTimeoutMinutes ?? 0);
    </script>

    <link href="~/lib/DataTables/DataTables/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="~/lib/DataTables/Buttons/css/buttons.dataTables.min.css" rel="stylesheet" />

    <script src="~/lib/DataTables/DataTables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/DataTables/Buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/lib/DataTables/Buttons/js/buttons.html5.min.js"></script>
    <script src="~/lib/DataTables/Buttons/js/buttons.print.min.js"></script>
