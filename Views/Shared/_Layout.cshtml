@* ── Gap 7: Idle session timeout ────────────────────────────────────────── *@
@if (User.Identity?.IsAuthenticated == true && (_layoutSettings?.IdleTimeoutMinutes ?? 0) > 0)
{
    <form id="idle-logout-form" method="post"
          asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
    </form>

    <div class="modal fade" id="idleWarningModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="idleWarningLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title" id="idleWarningLabel">
                        <i class="fas fa-clock me-2"></i>Session Expiring
                    </h5>
                </div>
                <div class="modal-body">
                    <p>You have been inactive for a while. For security, you will be logged out in:</p>
                    <p class="text-center fs-3 fw-bold" id="idle-countdown"></p>
                    <p class="text-muted small mb-0">Click <strong>Stay Signed In</strong> to continue your session.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="idle-stay-btn">Stay Signed In</button>
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="document.getElementById('idle-logout-form').submit()">Log Out Now</button>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        const TIMEOUT_MS  = window.qmsIdleTimeout * 60 * 1000;
        const WARNING_MS  = 60 * 1000;   // show warning 60 s before logout
        const TICK_MS     = 1000;

        let idleTimer, countdownTimer;
        const modal       = new bootstrap.Modal(document.getElementById('idleWarningModal'), {});
        const countdownEl = document.getElementById('idle-countdown');
        const stayBtn     = document.getElementById('idle-stay-btn');

        function formatTime(ms) {
            const s = Math.ceil(ms / 1000);
            return s >= 60
                ? Math.floor(s / 60) + 'm ' + (s % 60) + 's'
                : s + 's';
        }

        function doLogout() {
            clearInterval(countdownTimer);
            document.getElementById('idle-logout-form').submit();
        }

        function showWarning() {
            let remaining = WARNING_MS;
            countdownEl.textContent = formatTime(remaining);
            modal.show();
            countdownTimer = setInterval(function () {
                remaining -= TICK_MS;
                countdownEl.textContent = formatTime(remaining);
                if (remaining <= 0) {
                    clearInterval(countdownTimer);
                    doLogout();
                }
            }, TICK_MS);
        }

        function resetTimer() {
            clearTimeout(idleTimer);
            idleTimer = setTimeout(showWarning, TIMEOUT_MS - WARNING_MS);
        }

        stayBtn.addEventListener('click', function () {
            clearInterval(countdownTimer);
            modal.hide();
            resetTimer();
        });

        ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach(function (evt) {
            document.addEventListener(evt, resetTimer, { passive: true });
        });

        resetTimer();
    })();
    </script>
}

@* ── Attachment soft delete: shared reason prompt ──────────────────────────
   Any form with data-delete-reason="<item label>" asks for a mandatory reason
   before submitting; the reason is posted as "deletionReason" (enforced server-side too). *@
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="modal fade" id="deleteReasonModal" tabindex="-1" aria-labelledby="deleteReasonLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteReasonLabel">Delete <span id="delete-reason-item"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">The file is removed from the list but retained in the system for traceability. The deletion and its reason are recorded in the audit trail.</p>
                    <label for="delete-reason-text" class="form-label">Reason for deletion <span class="text-danger">*</span></label>
                    <textarea id="delete-reason-text" class="form-control" rows="3" maxlength="1000"></textarea>
                    <div class="invalid-feedback">A reason is required.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="delete-reason-confirm">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        const modalEl  = document.getElementById('deleteReasonModal');
        const modal    = new bootstrap.Modal(modalEl, {});
        const textEl   = document.getElementById('delete-reason-text');
        const itemEl   = document.getElementById('delete-reason-item');
        let pendingForm = null;

        document.addEventListener('submit', function (e) {
            const form = e.target;
            if (!form.matches || !form.matches('form[data-delete-reason]')) return;
            e.preventDefault();
            pendingForm = form;
            itemEl.textContent = form.getAttribute('data-delete-reason') || 'attachment';
            textEl.value = '';
            textEl.classList.remove('is-invalid');
            modal.show();
        });

        modalEl.addEventListener('shown.bs.modal', function () { textEl.focus(); });

        document.getElementById('delete-reason-confirm').addEventListener('click', function () {
            const reason = textEl.value.trim();
            if (!reason) { textEl.classList.add('is-invalid'); return; }
            let input = pendingForm.querySelector('input[name="deletionReason"]');
            if (!input) {
                input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'deletionReason';
                pendingForm.appendChild(input);
            }
            input.value = reason;
            modal.hide();
            pendingForm.submit();   // native submit — does not re-trigger the listener
        });
    })();
    </script>
}
</body>
</html>
