@model OpenQMS.Models.DeletedFilesView
@*
    Collapsed list of soft-deleted attachments/documents for the current record, shown under the
    live list. Files are retained for traceability; "View" downloads the retained copy with a
    DELETED watermark. Renders nothing when there are no deleted files.
*@
@{
    var items = Model.Items?.ToList() ?? new List<OpenQMS.Models.ISoftDeletedFile>();
}
@if (items.Any())
{
    <details class="mt-3 border rounded">
        <summary class="px-3 py-2 bg-light text-muted" style="cursor:pointer">
            <i class="bi bi-trash3 me-1"></i>Deleted @Model.Noun (@items.Count)
            <small class="ms-1">— retained for traceability; click to show</small>
        </summary>
        <div class="p-2">
            <p class="small text-muted mb-2">
                These files were deleted and are no longer part of the current record. They are kept,
                unchanged, for audit purposes. Each deletion is also recorded in the audit trail.
            </p>
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th>File</th><th>Deleted by</th><th>Deleted on</th><th>Reason</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var f in items)
                    {
                        var route = new Microsoft.AspNetCore.Routing.RouteValueDictionary { [Model.RouteKey] = f.Id, ["deleted"] = true };
                        <tr class="text-muted">
                            <td><s>@f.FileName</s></td>
                            <td>@(f.DeletedBy ?? "-")</td>
                            <td class="text-nowrap">@(f.DeletedOn.HasValue ? f.DeletedOn.Value.ToSite().ToString("dd MMM yyyy HH:mm") : "-")</td>
                            <td>@(f.DeletionReason ?? "-")</td>
                            <td class="text-end">
                                <a href="@Url.Action(Model.DownloadAction, route)" class="btn btn-sm btn-outline-secondary py-0"
                                   title="Download the retained copy (watermarked DELETED)">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}
