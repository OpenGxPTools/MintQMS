@model OpenQMS.Models.LC.LicenceCertificationRecord
@using OpenQMS.Models.LC
@{
    ViewData["Title"] = $"{L["Edit"]} — {Model.LCNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="fas fa-edit me-2 text-warning"></i>@L["Edit"] — @Model.LCNumber</h4>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="fas fa-eye me-1"></i>@L["Details"]</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>@L["Register"]</a>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" id="saveErrorBanner">
        <h6 class="fw-bold mb-2"><i class="fas fa-exclamation-triangle me-1"></i>@L["Your changes were not saved"]</h6>
        <p class="mb-2 small">@H["Please correct the following and click <strong>Save Changes</strong> again. Fields needing attention may be on other tabs."]</p>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="LCNumber" />

    <!-- 6-Tab Navigation -->
    <ul class="nav nav-tabs mb-0" id="lcTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1" type="button"><i class="fas fa-fingerprint me-1"></i>@L["Identification"]</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab2-tab" data-bs-toggle="tab" data-bs-target="#tab2" type="button"><i class="fas fa-tag me-1"></i>@L["Classification"]</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab3-tab" data-bs-toggle="tab" data-bs-target="#tab3" type="button"><i class="fas fa-calendar-alt me-1"></i>@L["Licence Details"]</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab4-tab" data-bs-toggle="tab" data-bs-target="#tab4" type="button"><i class="fas fa-microscope me-1"></i>@L["GMP / ISO Specifics"]</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab5-tab" data-bs-toggle="tab" data-bs-target="#tab5" type="button"><i class="fas fa-user me-1"></i>@L["Contacts"]</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab6-tab" data-bs-toggle="tab" data-bs-target="#tab6" type="button"><i class="fas fa-dollar-sign me-1"></i>@L["Fees & Notes"]</button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-4 mb-3">

        <!-- ── Tab 1: Identification ─────────────────────────────────────── -->
        <div class="tab-pane fade show active" id="tab1" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">@L["LC Number"]</label>
                    <input type="text" class="form-control" value="@Model.LCNumber" disabled />
                </div>
                <div class="col-md-4">
                    <label asp-for="HolderType" class="form-label fw-bold"></label>
                    <select asp-for="HolderType" class="form-select" id="holderTypeSelect">
                        <option value="OwnCompany">@L["Own Company"]</option>
                        <option value="ThirdParty">@L["Third Party / CMO / CDMO"]</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="HolderName" class="form-label fw-bold"></label>
                    <input asp-for="HolderName" class="form-control" />
                    <span asp-validation-for="HolderName" class="text-danger small"></span>
                </div>
                <div class="col-md-6" id="supplierSection">
                    <label asp-for="SupplierId" class="form-label fw-bold">@L["Linked Supplier (optional)"]</label>
                    <select asp-for="SupplierId" asp-items='@(ViewBag.SuppliersList as SelectList)' class="form-select select2-supplier">
                        <option value="">@L["— No linked supplier —"]</option>
                    </select>
                </div>
                <div class="col-md-6" id="supplierSection2">
                    <label asp-for="LinkedSiteCountry" class="form-label fw-bold"></label>
                    <input asp-for="LinkedSiteCountry" class="form-control" />
                </div>
                <div class="col-12" id="supplierSection3">
                    <label asp-for="LinkedSiteAddress" class="form-label fw-bold"></label>
                    <input asp-for="LinkedSiteAddress" class="form-control" />
                </div>
            </div>
        </div>

        <!-- ── Tab 2: Classification ─────────────────────────────────────── -->
        <div class="tab-pane fade" id="tab2" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label fw-bold">@L["Category"]
                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="lccategory" aria-label="@L["Category guidance"]">?</button>
                    </label>
                    <select asp-for="Category" class="form-select" id="categorySelect">
                        <option value="RegulatoryLicence">@L["Regulatory Licence"]</option>
                        <option value="ISOPrivateCertification">@L["ISO / Private Certification"]</option>
                        <option value="ThirdPartySiteApproval">@L["Third-Party Site Approval"]</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label asp-for="LicenceTypeId" class="form-label fw-bold">@L["Licence / Certification Type"]</label>
                    <select asp-for="LicenceTypeId" asp-items='@(ViewBag.LicenceTypesList as SelectList)' class="form-select select2-type" id="licenceTypeSelect">
                        <option value="">@L["— Select Type —"]</option>
                    </select>
                    <span asp-validation-for="LicenceTypeId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IssuingBody" class="form-label fw-bold"></label>
                    <input asp-for="IssuingBody" class="form-control" id="issuingBodyInput" />
                </div>
                <div class="col-md-6">
                    <label asp-for="IssuingBodyUrl" class="form-label fw-bold"></label>
                    <input asp-for="IssuingBodyUrl" class="form-control" />
                </div>
                <div class="col-md-8">
                    <label asp-for="IssuingBodyPortal" class="form-label fw-bold">@L["Authority Portal / Login URL"]</label>
                    <input asp-for="IssuingBodyPortal" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="AuthorityPortalUsername" class="form-label fw-bold"></label>
                    <input asp-for="AuthorityPortalUsername" class="form-control" />
                </div>
            </div>
        </div>

        <!-- ── Tab 3: Licence Details ────────────────────────────────────── -->
        <div class="tab-pane fade" id="tab3" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="LicenceNumber" class="form-label fw-bold"></label>
                    <input asp-for="LicenceNumber" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ApplicationDate" class="form-label fw-bold"></label>
                    <input asp-for="ApplicationDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="IssueDate" class="form-label fw-bold"></label>
                    <input asp-for="IssueDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ExpiryDate" class="form-label fw-bold"></label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="NextRenewalDue" class="form-label fw-bold"></label>
                    <input asp-for="NextRenewalDue" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="RenewalLeadTimeDays" class="form-label fw-bold"></label>
                    <input asp-for="RenewalLeadTimeDays" type="number" class="form-control" min="0" max="730" />
                </div>
                <div class="col-12">
                    <label asp-for="Scope" class="form-label fw-bold"></label>
                    <textarea asp-for="Scope" class="form-control" rows="4"></textarea>
                </div>
            </div>
        </div>

        <!-- ── Tab 4: GMP / ISO Specifics ────────────────────────────────── -->
        <div class="tab-pane fade" id="tab4" role="tabpanel">
            <div id="gmpSection">
                <h6 class="text-muted text-uppercase small mb-3 border-bottom pb-1"><i class="fas fa-shield-alt me-1"></i>@L["Overseas Site GMP Evidence"]</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="GmcPathway" class="form-label fw-bold">@L["GMP Evidence Pathway"]
                            <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="gmcpathway" aria-label="@L["GMP Evidence Pathway guidance"]">?</button>
                        </label>
                        <select asp-for="GmcPathway" class="form-select">
                            <option value="">@L["— Select Pathway —"]</option>
                            <option value="MRA">@L["MRA (Mutual Recognition Agreement)"]</option>
                            <option value="CV">@L["Review of Another Authority's Inspection (CV)"]</option>
                            <option value="TGAInspection">@L["On-Site Inspection by the Authority"]</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SiteCountry" class="form-label fw-bold"></label>
                        <input asp-for="SiteCountry" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="InspectionAuthority" class="form-label fw-bold"></label>
                        <input asp-for="InspectionAuthority" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="LastInspectionDate" class="form-label fw-bold"></label>
                        <input asp-for="LastInspectionDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RFIDate" class="form-label fw-bold">@L["RFI Issued Date"]
                            <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="rfi" aria-label="@L["RFI guidance"]">?</button>
                        </label>
                        <input asp-for="RFIDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RFIResponseDueDate" class="form-label fw-bold"></label>
                        <input asp-for="RFIResponseDueDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RFIResponseSubmittedDate" class="form-label fw-bold">@L["RFI Response Submitted"]</label>
                        <input asp-for="RFIResponseSubmittedDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-8">
                        <label asp-for="ManufacturingStepsScope" class="form-label fw-bold"></label>
                        <input asp-for="ManufacturingStepsScope" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4">
                            <input asp-for="LetterOfAccessAvailable" class="form-check-input" type="checkbox" />
                            <label asp-for="LetterOfAccessAvailable" class="form-check-label fw-bold">@L["Letter of Access Available"]</label>
                        </div>
                    </div>
                </div>
            </div>
            <div id="isoSection" class="mt-4">
                <h6 class="text-muted text-uppercase small mb-3 border-bottom pb-1"><i class="fas fa-certificate me-1"></i>@L["ISO / Certification Body Details"]
                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="isolifecycle" aria-label="@L["ISO certification lifecycle guidance"]">?</button>
                </h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CertificationBody" class="form-label fw-bold"></label>
                        <input asp-for="CertificationBody" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CertificationBodyAccreditation" class="form-label fw-bold">@L["Certification Body Accreditation No."]</label>
                        <input asp-for="CertificationBodyAccreditation" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StandardVersion" class="form-label fw-bold">@L["Standard Version"]</label>
                        <input asp-for="StandardVersion" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Stage1AuditDate" class="form-label fw-bold"></label>
                        <input asp-for="Stage1AuditDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Stage2AuditDate" class="form-label fw-bold"></label>
                        <input asp-for="Stage2AuditDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NextSurveillanceAuditDate" class="form-label fw-bold"></label>
                        <input asp-for="NextSurveillanceAuditDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RecertificationDueDate" class="form-label fw-bold"></label>
                        <input asp-for="RecertificationDueDate" type="date" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="CertificateScope" class="form-label fw-bold"></label>
                        <textarea asp-for="CertificateScope" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Tab 5: Contacts ───────────────────────────────────────────── -->
        <div class="tab-pane fade" id="tab5" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="InternalResponsiblePersonId" class="form-label fw-bold">@L["Internal Responsible Person"]</label>
                    <select asp-for="InternalResponsiblePersonId" asp-items='@(ViewBag.UsersList as SelectList)' class="form-select select2-users">
                        <option value="">@L["— Select user —"]</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ExternalConsultant" class="form-label fw-bold"></label>
                    <input asp-for="ExternalConsultant" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="AuthorityContactEmail" class="form-label fw-bold"></label>
                    <input asp-for="AuthorityContactEmail" class="form-control" type="email" />
                </div>
            </div>
        </div>

        <!-- ── Tab 6: Fees & Notes ───────────────────────────────────────── -->
        <div class="tab-pane fade" id="tab6" role="tabpanel">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="ApplicationFee" class="form-label fw-bold"></label>
                    <input asp-for="ApplicationFee" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="FeeCurrency" class="form-label fw-bold"></label>
                    <input asp-for="FeeCurrency" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="FeePaidDate" class="form-label fw-bold"></label>
                    <input asp-for="FeePaidDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="FeeReference" class="form-label fw-bold"></label>
                    <input asp-for="FeeReference" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="JustificationReason" class="form-label fw-bold">@L["Justification / Reason"]</label>
                    <textarea asp-for="JustificationReason" class="form-control bg-light" rows="3" readonly disabled></textarea>
                    <div class="form-text"><i class="fas fa-info-circle me-1"></i>@L["Set automatically when the record is Suspended, Withdrawn, or marked Not Applicable. Not editable here."]</div>
                </div>
                <div class="col-12">
                    <label asp-for="RegulatoryActionNotes" class="form-label fw-bold"></label>
                    <textarea asp-for="RegulatoryActionNotes" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </div>

    </div>

    <div class="d-flex justify-content-between">
        @if (User.IsInRole("Administrator"))
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this record? This cannot be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash me-1"></i>@L["Delete Record"]</button>
            </form>
        }
        else
        {
            <div></div>
        }
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">@L["Cancel"]</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>@L["Save Changes"]</button>
        </div>
    </div>
</form>

<!-- Field-help popover content (hidden, read by field-help.js) -->
<div class="d-none">
    <div id="help-lccategory">
        <p class="mb-1">@H["<strong>What kind of credential this record tracks</strong> (this choice drives the GMP / ISO tab):"]</p>
        <ul class="mb-0 ps-3">
            <li><strong>@L["Regulatory Licence"]</strong> @L["— a federal or state licence/permit (e.g. manufacturing licence, wholesale/import permit)."]</li>
            <li><strong>@L["ISO / Private Certification"]</strong> @L["— a quality-system certification issued by a certification body (e.g. ISO 9001, ISO 13485)."]</li>
            <li><strong>@L["Third-Party Site Approval"]</strong> @L["— a GMP clearance or approval for an external manufacturing/supply site."]</li>
        </ul>
    </div>
    <div id="help-gmcpathway">
        <p class="mb-1">@H["<strong>How GMP compliance of the overseas site is being evidenced</strong>:"]</p>
        <ul class="mb-0 ps-3">
            <li><strong>@L["MRA"]</strong> @L["— Mutual Recognition Agreement: the site is in a country whose GMP inspections your authority recognises."]</li>
            <li><strong>@L["CV"]</strong> @L["— Compliance Verification: clearance based on an inspection report from a recognised authority."]</li>
            <li><strong>@L["Authority Inspection"]</strong> @L["— an on-site inspection by the authority, used where no MRA/CV pathway is available."]</li>
        </ul>
    </div>
    <div id="help-rfi">
        <p class="mb-0">@H["<strong>RFI = Request for Information.</strong> A formal query the authority issues during assessment asking for additional information or clarification. Record when it was <strong>issued</strong>, the <strong>response due</strong> date (the record flags it red if overdue and unanswered), and when your <strong>response was submitted</strong>."]</p>
    </div>
    <div id="help-isolifecycle">
        <p class="mb-1">@H["<strong>The ISO certification cycle</strong> (typically a 3-year certificate):"]</p>
        <ul class="mb-0 ps-3">
            <li><strong>@L["Stage 1 Audit"]</strong> @L["— readiness/documentation review by the certification body."]</li>
            <li><strong>@L["Stage 2 Audit"]</strong> @L["— the full on-site certification audit; passing it leads to the certificate being issued."]</li>
            <li><strong>@L["Surveillance Audit"]</strong> @L["— periodic (usually annual) checks that the system remains compliant."]</li>
            <li><strong>@L["Recertification Due"]</strong> @L["— the full re-audit before the certificate expires (end of the cycle)."]</li>
        </ul>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/tab-form-validation.js" asp-append-version="true"></script>
    <script src="~/js/field-help.js" asp-append-version="true"></script>
    <link href="~/lib/select2-4.1.0-rc.0/select2.min.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/lib/select2-4.1.0-rc.0/select2.min.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $('.select2-users, .select2-supplier, .select2-type').select2({ theme: 'classic', width: '100%' });

            var ownCompanyName = @Json.Serialize(ViewBag.OrganisationName ?? "");

            function toggleHolderSections() {
                var isThirdParty = $('#holderTypeSelect').val() === 'ThirdParty';
                $('#supplierSection, #supplierSection2, #supplierSection3').toggle(isThirdParty);
                if (!isThirdParty && ownCompanyName) {
                    $('#HolderName').val(ownCompanyName);
                } else if (isThirdParty) {
                    if ($('#HolderName').val() === ownCompanyName) $('#HolderName').val('');
                }
            }
            $('#holderTypeSelect').on('change', toggleHolderSections);
            toggleHolderSections();

            // Show/hide GMP vs ISO specifics based on current category
            function toggleSpecifics() {
                var cat = $('#categorySelect').val();
                $('#gmpSection').toggle(cat === 'ThirdPartySiteApproval');
                $('#isoSection').toggle(cat === 'ISOPrivateCertification');
            }
            $('#categorySelect').on('change', function () {
                toggleSpecifics();
                // reload types on category change
                var catNum = { 'RegulatoryLicence': 1, 'ISOPrivateCertification': 2, 'ThirdPartySiteApproval': 3 }[$(this).val()] || 1;
                $.getJSON('@Url.Action("GetLicenceTypes")', { category: catNum }, function (data) {
                    var $sel = $('#licenceTypeSelect');
                    var current = $sel.val();
                    $sel.empty().append('<option value="">— Select Type —</option>');
                    $.each(data, function (i, t) {
                        $sel.append($('<option>').val(t.id).text(t.displayName)
                            .data('lead', t.defaultRenewalLeadTimeDays)
                            .data('issuingBody', t.issuingBody || ''));
                    });
                    $sel.val(current);
                });
            });
            toggleSpecifics();
        });
    </script>
}
