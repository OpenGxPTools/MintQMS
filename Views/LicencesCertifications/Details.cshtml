                <div class="modal-body">
                    <div class="alert alert-info small"><i class="fas fa-info-circle me-1"></i>A waiver records that this condition will not be formally fulfilled. Document the authority's or management's approval below.</div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Waiver Justification <span class="text-danger">*</span></label>
                        <textarea name="waiverReason" class="form-control" rows="3"
                                  placeholder="Authority waiver reference, management approval, documented justification..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info text-white"><i class="fas fa-ban me-1"></i>Confirm Waiver</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Upload Document Modal ───────────────────────────────────────────── -->
<div class="modal fade" id="uploadDocModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="recordId" value="@Model.Id" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fas fa-upload me-2"></i>Upload Document</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Document Type <span class="text-danger">*</span></label>
                        <select name="documentType" class="form-select" required>
                            @foreach (var dt in Enum.GetValues<LCDocumentType>())
                            {
                                <option value="@dt">@dt</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">File <span class="text-danger">*</span></label>
                        <input type="file" name="file" class="form-control" required
                               accept="@UploadRules.Accept" />
                        <small class="text-muted">Accepted: @UploadRules.AcceptedLabel. Max 25 MB.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description (optional)</label>
                        <input type="text" name="description" class="form-control"
                               placeholder="Brief description of this document's purpose" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-upload me-1"></i>Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Add Dependency Modal ────────────────────────────────────────────── -->
<div class="modal fade" id="addDependencyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="AddDependency" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="recordId" value="@Model.Id" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fas fa-link me-2"></i>Link RegIntel Application</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Select a product registration that depends on this licence/certification being current.</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">RegIntel Application <span class="text-danger">*</span></label>
                        <select name="regulatoryApplicationId" asp-items='@(ViewBag.RIApplicationsList as SelectList)'
                                class="form-select select2-ri" required>
                            <option value="">— Search for application —</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Notes (optional)</label>
                        <input type="text" name="notes" class="form-control"
                               placeholder="e.g. GMP Clearance required for ARTG 123456 supply" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-link me-1"></i>Link Application</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Issue Modal (password-gated) ─────────────────────────────────────── -->
<!-- ── Initiate Renewal Modal (early / unscheduled renewal, reason required) ── -->
<div class="modal fade" id="initiateRenewalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="InitiateRenewal" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"><i class="fas fa-sync me-2"></i>Initiate Renewal Now</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>This will move <strong>@Model.LCNumber</strong> to <strong class="text-warning-emphasis">Renewal Due</strong> so the renewal application can be progressed.</p>
                    @if (Model.ExpiryDate.HasValue)
                    {
                        <div class="alert alert-info small mb-3">
                            <i class="fas fa-info-circle me-1"></i>This record would otherwise be transitioned automatically within @(Model.RenewalLeadTimeDays > 0 ? Model.RenewalLeadTimeDays : 90) day(s) of its expiry (@Model.ExpiryDate.Value.ToString("dd MMM yyyy")). Use this to start the renewal early.
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label fw-bold">Reason for early renewal <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="e.g. authority advised early resubmission, scheduling ahead of lead time, change in supply arrangements..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning"><i class="fas fa-sync me-1"></i>Initiate Renewal</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="issueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="IssueRecord" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fas fa-check-circle me-2"></i>Issue / Activate Licence</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>This will mark <strong>@Model.LCNumber</strong> as <strong class="text-success">Issued &amp; Active</strong>.</p>
                    <p class="text-muted small">Ensure the Licence Number and Issue Date are recorded in Edit before proceeding.</p>
                    <div class="alert alert-warning small"><i class="fas fa-lock me-1"></i>This action requires Licence Manager credentials.</div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Email Address</label>
                        <input type="email" name="email" class="form-control" placeholder="manager@company.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Password</label>
                        <input type="password" name="pwd" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="fas fa-check-circle me-1"></i>Confirm Issue</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Suspend Modal (password-gated, reason required) ──────────────────── -->
<div class="modal fade" id="suspendModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="SuspendRecord" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fas fa-pause-circle me-2"></i>Suspend Licence / Certification</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>This will mark <strong>@Model.LCNumber</strong> as <strong class="text-danger">Suspended</strong> and lock the record.</p>
                    <div class="alert alert-danger small"><i class="fas fa-exclamation-triangle me-1"></i>All linked product applications will be flagged as Supply Credential At Risk.</div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Suspension Reason <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="Regulatory action, inspection finding, authority-directed suspension..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Email Address</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Password</label>
                        <input type="password" name="pwd" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-pause-circle me-1"></i>Confirm Suspension</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Withdraw Modal (password-gated, reason required) ─────────────────── -->
<div class="modal fade" id="withdrawModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="WithdrawRecord" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title"><i class="fas fa-times-circle me-2"></i>Withdraw Licence / Certification</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>This will mark <strong>@Model.LCNumber</strong> as <strong>Withdrawn</strong> and lock the record.</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Withdrawal Reason <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="Voluntary surrender, business model change, superseded by new record..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Email Address</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Password</label>
                        <input type="password" name="pwd" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark"><i class="fas fa-times-circle me-1"></i>Confirm Withdrawal</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Not Applicable Modal (reason required, no password) ───────────────── -->
<div class="modal fade" id="notApplicableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Transition" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="newStatus" value="NotApplicable" />
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title"><i class="fas fa-ban me-2"></i>Mark as Not Applicable</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>This will mark <strong>@Model.LCNumber</strong> as <strong>Not Applicable</strong> with documented justification.</p>
                    <div class="alert alert-info small"><i class="fas fa-info-circle me-1"></i>Recording N/A with justification is compliance-positive and demonstrates considered determination during TGA inspections.</div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Justification <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="4" placeholder="Reason this licence type is not required for the current operating model..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-secondary"><i class="fas fa-ban me-1"></i>Confirm Not Applicable</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            // Select2 for Add Dependency modal RI application lookup
            $('.select2-ri').select2({ theme: 'classic', width: '100%', dropdownParent: $('#addDependencyModal') });

            // Wire Edit Condition modal data-attributes
            $('#editConditionModal').on('show.bs.modal', function (e) {
                var btn = $(e.relatedTarget);
                $('#editConditionId').val(btn.data('id'));
                var desc = btn.data('desc');
                try { desc = JSON.parse(desc); } catch(ex) {}
                $('#editConditionDesc').val(desc);
                $('#editConditionDue').val(btn.data('due'));
            });

            // Wire Complete Condition modal
            $('#completeConditionModal').on('show.bs.modal', function (e) {
                var btn = $(e.relatedTarget);
                $('#completeConditionId').val(btn.data('id'));
            });

            // Wire Waive Condition modal
            $('#waiveConditionModal').on('show.bs.modal', function (e) {
                var btn = $(e.relatedTarget);
                $('#waiveConditionId').val(btn.data('id'));
            });
        });

        @if (TempData["ActiveTab"] != null)
        {
            <text>
            (function() {
                var tabId = @Json.Serialize(TempData["ActiveTab"]!.ToString());
                var el = document.querySelector('[data-bs-target="#' + tabId + '"]');
                if (el) bootstrap.Tab.getOrCreateInstance(el).show();
            })();
            </text>
        }
    </script>
}
