@{
    ViewData["Title"] = "LC Calendar";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="fas fa-calendar-alt me-2 text-success"></i>LC Compliance Calendar</h4>
        <div class="btn-group">
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm"><i class="fas fa-tachometer-alt me-1"></i>Dashboard</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-list me-1"></i>Register</a>
        </div>
    </div>

    @* Legend *@
    <div class="d-flex flex-wrap gap-3 mb-3 small">
        <span><span class="badge" style="background:#dc3545">&nbsp;</span> Expired / Overdue</span>
        <span><span class="badge" style="background:#fd7e14">&nbsp;</span> Expiry / RFI Due (soon)</span>
        <span><span class="badge" style="background:#ffc107;color:#000">&nbsp;</span> Expiry (30–90d)</span>
        <span><span class="badge" style="background:#198754">&nbsp;</span> Expiry (&gt;90d)</span>
        <span><span class="badge" style="background:#0dcaf0;color:#000">&nbsp;</span> Renewal Window Start</span>
        <span><span class="badge" style="background:#6610f2">&nbsp;</span> ISO Surveillance Audit</span>
        <span><span class="badge" style="background:#20c997">&nbsp;</span> Condition Due</span>
    </div>

    <div id="calendar" style="min-height:600px;"></div>
</div>

@section Scripts {
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var calendarEl = document.getElementById('calendar');
    var eventsData = @Html.Raw(ViewBag.CalendarEventsJson ?? "[]");

    var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        headerToolbar: {
            left:   'prev,next today',
            center: 'title',
            right:  'dayGridMonth,listMonth'
        },
        events: eventsData,
        eventClick: function (info) {
            if (info.event.url) {
                info.jsEvent.preventDefault();
                window.location.href = info.event.url;
            }
        },
        eventDidMount: function (info) {
            var props = info.event.extendedProps;
            var tooltip = props.type + ': ' + props.lcNumber;
            if (props.desc) tooltip += '\n' + props.desc;
            info.el.setAttribute('title', tooltip);
        },
        height: 'auto'
    });

    calendar.render();
});
</script>
}
