@model List<OpenQMS.Models.AppDocument>

@{
    ViewData["Title"] = "Document Review Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today        = (DateTime)ViewBag.Today;
    var overdueCount = (int)ViewBag.OverdueCount;
    var dueSoonCount = (int)ViewBag.DueSoonCount;
    var currentCount = (int)ViewBag.CurrentCount;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Document Review Register</h4>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Dashboard
    </a>
</div>

<p class="text-muted mb-3">
    Approved documents that require periodic review, ordered by review due date.
    Generated: @SiteTime.Now.ToString("dd MMM yyyy HH:mm") @SiteTime.Label.
</p>

@* Summary cards *@
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm text-center" style="border-left: 4px solid @(overdueCount > 0 ? "#dc3545" : "#6c757d") !important;">
            <div class="card-body py-3">
                <p class="text-uppercase text-muted small fw-semibold mb-1">Overdue</p>
                <h2 class="fw-bold mb-0 @(overdueCount > 0 ? "text-danger" : "")">@overdueCount</h2>
                <p class="text-muted small mb-0">past review date</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm text-center" style="border-left: 4px solid @(dueSoonCount > 0 ? "#fd7e14" : "#6c757d") !important;">
            <div class="card-body py-3">
                <p class="text-uppercase text-muted small fw-semibold mb-1">Due Within 30 Days</p>
                <h2 class="fw-bold mb-0 @(dueSoonCount > 0 ? "text-warning" : "")">@dueSoonCount</h2>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm text-center" style="border-left: 4px solid #198754 !important;">
            <div class="card-body py-3">
                <p class="text-uppercase text-muted small fw-semibold mb-1">Current</p>
                <h2 class="fw-bold mb-0 text-success">@currentCount</h2>
                <p class="text-muted small mb-0">review not due yet</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm text-center" style="border-left: 4px solid #0d6efd !important;">
            <div class="card-body py-3">
                <p class="text-uppercase text-muted small fw-semibold mb-1">Total Tracked</p>
                <h2 class="fw-bold mb-0">@Model.Count</h2>
                <p class="text-muted small mb-0">with review date set</p>
            </div>
        </div>
    </div>
</div>

@* Colour legend *@
@if (Model.Any())
{
    <div class="alert alert-light border small mb-4">
        <strong>Colour coding:</strong>
        <span class="badge bg-danger me-1">Red</span> Overdue (past review date) &nbsp;
        <span class="badge bg-warning text-dark me-1">Amber</span> Due within 30 days &nbsp;
        <span class="badge bg-success me-1">Green</span> Current (more than 30 days remaining)
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Document ID</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Doc Type</th>
                            <th>Version</th>
                            <th class="text-nowrap">Approved On</th>
                            <th class="text-nowrap">Review Due</th>
                            <th class="text-nowrap">Days</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                            var isOverdue  = d.ReviewDueDate!.Value.Date < today;
                            var isDueSoon  = !isOverdue && d.ReviewDueDate!.Value.Date <= today.AddDays(30);
                            var rowClass   = isOverdue ? "table-danger" : isDueSoon ? "table-warning" : "";
                            var badgeClass = isOverdue ? "bg-danger" : isDueSoon ? "bg-warning text-dark" : "bg-success";
                            var statusText = isOverdue ? "Overdue" : isDueSoon ? "Due Soon" : "Current";
                            var daysVal    = isOverdue
                                ? $"{(int)(today - d.ReviewDueDate!.Value.Date).TotalDays}d overdue"
                                : $"{(int)(d.ReviewDueDate!.Value.Date - today).TotalDays}d remaining";
                            var daysClass  = isOverdue ? "text-danger" : isDueSoon ? "text-warning" : "text-muted";

                            <tr class="@rowClass">
                                <td class="fw-semibold">@d.DocumentId</td>
                                <td class="text-truncate" style="max-width:240px;">@d.Title</td>
                                <td class="small text-muted">@(d.Category.HasValue ? d.Category.Value.ToString() : "—")</td>
                                <td class="small text-muted">@(d.DocType.HasValue ? d.DocType.Value.ToString() : "—")</td>
                                <td>@d.Version.ToString("0.0")</td>
                                <td class="text-nowrap">@(d.ApprovedOn.HasValue ? d.ApprovedOn.Value.ToSite().ToString("dd MMM yyyy") : "—")</td>
                                <td class="text-nowrap fw-semibold">@d.ReviewDueDate!.Value.ToString("dd MMM yyyy")</td>
                                <td class="text-nowrap small @daysClass">@daysVal</td>
                                <td><span class="badge @badgeClass">@statusText</span></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@d.Id"
                                       class="btn btn-outline-secondary btn-sm">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-muted text-center py-5">
            <i class="fas fa-check-circle text-success fs-3 d-block mb-2"></i>
            No approved documents with a periodic review date are currently tracked.
        </div>
    </div>
}
