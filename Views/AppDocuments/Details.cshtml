                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning">Initiate Periodic Review</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var tabMap = { 'overview': '#tab-overview', 'versions': '#tab-versions', 'trainings': '#tab-trainings', 'auditlog': '#tab-auditlog' };
        var tabEl = document.querySelector(tabMap['@activeTab'] || '#tab-overview');
        if (tabEl) { new bootstrap.Tab(tabEl).show(); }
    </script>
}
