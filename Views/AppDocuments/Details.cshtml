@* Initiate Periodic Review Modal *@
@if (canInitiateReview)
{
    <div class="modal fade" id="initiateReviewModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="InitiatePeriodicReview" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title"><i class="fas fa-sync-alt me-1"></i>@L["Initiate Periodic Review"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning mb-3">
                            <strong>@L["Review Overdue"]</strong> — @H["This document was due for review on <strong>{0}</strong>.", Model.ReviewDueDate!.Value.ToString("dd MMM yyyy", DisplayDates.Culture)]
                        </div>
                        <p>Initiating a periodic review will create a new draft (v@((Model.Version + 0.01m).ToString("0.00"))) with <em>@L["Periodic Review"]</em> as the reason for change. The current version will be locked pending re-approval.</p>
