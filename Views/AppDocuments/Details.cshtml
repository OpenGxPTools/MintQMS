@* Reassign Author Modal *@
@if (canReassign)
{
    var reassignCandidates = ViewBag.ReassignCandidates as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                             ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    <div class="modal fade" id="reassignAuthorModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="ReassignAuthor" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title"><i class="fas fa-user-edit me-1"></i>Reassign Author</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2">Transfer ownership of <strong>@Model.Title</strong> v@(Model.Version.ToString("0.00")) to another user — for example, when the current author has left the company or can no longer work on the draft.</p>
                        <p class="small text-muted">Current author: <strong>@Model.AuthoredBy</strong>. This does not change the document's status or version; the change is recorded in the audit log.</p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">New Author</label>
                            @if (reassignCandidates.Any())
                            {
                                <select name="NewAuthorId" class="form-select" required>
                                    <option value="">&mdash; select a user &mdash;</option>
                                    @foreach (var c in reassignCandidates)
                                    {
                                        <option value="@c.Value">@c.Text</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <div class="text-muted small">No eligible users are available to reassign to.</div>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Reason for Reassignment</label>
                            <textarea name="ReassignReason" class="form-control" rows="2" required
                                      placeholder="e.g. Original author has left the company; draft handed over to continue."></textarea>
                        </div>
                        <hr />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Your Email</label>
                            <input type="email" name="InputEmail" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <input type="password" name="InputPassword" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark btn-sm"><i class="fas fa-user-edit me-1"></i>Reassign Author</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

