            <div class="modal-content">
                <form asp-action="InitiatePeriodicReview" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title"><i class="fas fa-sync-alt me-1"></i>Initiate Periodic Review</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning mb-3">
                            <strong>Review Overdue</strong> — This document was due for review on <strong>@Model.ReviewDueDate!.Value.ToString("dd MMM yyyy")</strong>.
                        </div>
                        <p>Initiating a periodic review will create a new draft (v@((Model.Version + 0.01m).ToString("0.00"))) with <em>Periodic Review</em> as the reason for change. The current version will be locked pending re-approval.</p>
                        <hr />
                        <p class="text-muted small mb-2">Enter your credentials to confirm this action (electronic signature).</p>
                        <div class="mb-3">
                            <label class="form-label">Your Email <span class="text-danger">*</span></label>
                            <input type="email" name="InputEmail" class="form-control" required autocomplete="email" />
