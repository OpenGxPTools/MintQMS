                        <p class="text-muted small mb-2">@L["Enter your credentials to confirm this action (electronic signature)."]</p>
                        <div class="mb-3">
                            <label class="form-label">@L["Your Email"] <span class="text-danger">*</span></label>
                            <input type="email" name="InputEmail" class="form-control" required autocomplete="email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["Password"] <span class="text-danger">*</span></label>
                            <input type="password" name="InputPassword" class="form-control" required autocomplete="current-password" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                        <button type="submit" class="btn btn-warning">@L["Initiate Periodic Review"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var tabMap = { 'overview': '#tab-overview', 'versions': '#tab-versions', 'trainings': '#tab-trainings', 'auditlog': '#tab-auditlog' };
        var tabEl = document.querySelector(tabMap['@activeTab'] || '#tab-overview');
        if (tabEl) { new bootstrap.Tab(tabEl).show(); }
    </script>
}
