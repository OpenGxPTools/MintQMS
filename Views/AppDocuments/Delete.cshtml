@model OpenQMS.Models.AppDocument

@{
    ViewData["Title"] = "Delete Document";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var statusBadge = Model.Status switch {
        AppDocument.DocumentStatus.Effective   => "bg-success",
        AppDocument.DocumentStatus.Approved    => "bg-primary",
        AppDocument.DocumentStatus.Rejected    => "bg-danger",
        AppDocument.DocumentStatus.Obsolete    => "bg-secondary",
        AppDocument.DocumentStatus.UnderReview => "bg-info text-dark",
        _ => "bg-warning text-dark"
    };
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">Document &mdash; <span class="fw-bold">@Model.DocumentId</span></h4>
        <small class="text-muted">@Model.Title</small>
    </div>
    <span class="badge @statusBadge fs-6">@EnumHelper.Display(Model.Status)</span>
</div>
<hr />

<div class="alert alert-danger">
    <i class="fas fa-exclamation-triangle me-2"></i>Are you sure you want to delete this document? This action cannot be undone.
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt>
            <dd class="col-sm-8">@Model.DocumentId</dd>
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>
            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8">@(Model.Description ?? "-")</dd>
            <dt class="col-sm-4">Version</dt>
            <dd class="col-sm-8">@Model.Version.ToString("0.00")</dd>
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8"><span class="badge @statusBadge">@EnumHelper.Display(Model.Status)</span></dd>
            <dt class="col-sm-4">Authored By</dt>
            <dd class="col-sm-8">@Model.AuthoredBy</dd>
            <dt class="col-sm-4">Authored On</dt>
            <dd class="col-sm-8">@Model.AuthoredOn.ToSite().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="mt-3 d-flex gap-3">
        <button type="submit" class="btn btn-danger btn-sm">
            <i class="fas fa-trash me-1"></i>Delete
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</form>
