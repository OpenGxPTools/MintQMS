@{
    ViewData["Title"] = "Complaints Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statusCounts = (Dictionary<string, int>)ViewBag.StatusCounts;
    var severityCounts = (Dictionary<string, int>)ViewBag.SeverityCounts;
    var aged = (List<OpenQMS.Models.Complaint>)ViewBag.Aged;
    var pendingEvaluation = (List<OpenQMS.Models.Complaint>)ViewBag.PendingEvaluation;
    var pendingAcceptanceQueue = (List<OpenQMS.Models.Complaint>)ViewBag.PendingAcceptanceQueue;
    var critical = (List<OpenQMS.Models.Complaint>)ViewBag.Critical;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Complaints Dashboard</h4>
    <div class="d-flex gap-2">
        <a asp-action="ExportRegister" class="btn btn-outline-success btn-sm">Export Excel</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Register</a>
        @if (User.IsInRole("Administrator") || User.IsInRole("QualityManager") || User.IsInRole("QualityUser"))
        {
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Complaint</a>
        }
    </div>
</div>

@if ((int)ViewBag.CriticalCount > 0)
{
    <div class="alert alert-danger d-flex align-items-center mb-4">
        <strong class="me-2">&#9888;</strong>
        <span><strong>@ViewBag.CriticalCount critical open complaint(s)</strong> require immediate attention.</span>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-2">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-primary">@ViewBag.Total</div>
                <div class="text-muted">Total</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-2">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-warning">@ViewBag.OpenCount</div>
                <div class="text-muted">Open</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-2">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-5 fw-bold text-success">@ViewBag.ClosedCount</div>
                <div class="text-muted">Closed</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center h-100 @((int)ViewBag.CriticalCount > 0 ? "border-danger" : "")">
            <div class="card-body">
                <div class="display-5 fw-bold @((int)ViewBag.CriticalCount > 0 ? "text-danger" : "text-secondary")">@ViewBag.CriticalCount</div>
                <div class="text-muted">Critical Open</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        @{ var agedCount = ((List<OpenQMS.Models.Complaint>)ViewBag.Aged).Count; }
        <div class="card text-center h-100 @(agedCount > 0 ? "border-warning" : "")">
            <div class="card-body">
                <div class="display-5 fw-bold @(agedCount > 0 ? "text-warning" : "text-secondary")">@agedCount</div>
                <div class="text-muted">Aged (&gt;30 days)</div>
            </div>
        </div>
    </div>
</div>

<!-- Status Chart + Severity Breakdown -->
<div class="row g-3 mb-4">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">Status Distribution</div>
            <div class="card-body d-flex justify-content-center align-items-center">
                <canvas id="statusChart" style="max-height:220px"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">Status Breakdown</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr><th>Status</th><th>Count</th><th style="width:40%">Progress</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var kv in statusCounts)
                        {
                            var pct = (int)ViewBag.Total > 0 ? (kv.Value * 100 / (int)ViewBag.Total) : 0;
                            var barClass = kv.Key switch
                            {
                                "Received"          => "bg-secondary",
                                "Evaluation"        => "bg-info",
                                "PendingAcceptance" => "bg-warning",
                                "Resolution"        => "bg-warning",
                                "Closed"            => "bg-success",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td>@kv.Key</td>
                                <td>@kv.Value</td>
                                <td>
                                    <div class="progress" style="height:8px">
                                        <div class="progress-bar @barClass" style="width:@pct%"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-header">Severity Breakdown</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr><th>Severity</th><th>Count</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var kv in severityCounts)
                        {
                            var badgeClass = kv.Key switch
                            {
                                "Critical" => "bg-danger",
                                "Major" => "bg-warning text-dark",
                                "Minor" => "bg-light text-dark border",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td><span class="badge @badgeClass">@kv.Key</span></td>
                                <td><strong>@kv.Value</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Pending Evaluation + Pending Acceptance + Critical panels -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between">
                <span>Pending Evaluation (Received)</span>
                <span class="badge bg-warning text-dark">@pendingEvaluation.Count</span>
            </div>
            <div class="card-body p-0">
                @if (pendingEvaluation.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>ID</th><th>Title</th><th>Severity</th><th>Received</th></tr></thead>
                        <tbody>
                            @foreach (var c in pendingEvaluation)
                            {
                                var sev = c.Severity == OpenQMS.Models.Complaint.ComplaintSeverity.Critical ? "bg-danger"
                                        : c.Severity == OpenQMS.Models.Complaint.ComplaintSeverity.Major ? "bg-warning text-dark"
                                        : "bg-light text-dark border";
                                <tr>
                                    <td><a asp-action="Details" asp-route-id="@c.Id">@c.ComplaintId</a></td>
                                    <td>@c.Title</td>
                                    <td><span class="badge @sev">@c.Severity</span></td>
                                    <td>@c.ReceivedOn.ToSite().ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted p-3 mb-0">None pending.</p> }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 @(pendingAcceptanceQueue.Any() ? "border-warning" : "")">
            <div class="card-header d-flex justify-content-between">
                <span>Awaiting Acceptance</span>
                <span class="badge @(pendingAcceptanceQueue.Any() ? "bg-warning text-dark" : "bg-secondary")">@pendingAcceptanceQueue.Count</span>
            </div>
            <div class="card-body p-0">
                @if (pendingAcceptanceQueue.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>ID</th><th>Title</th><th>Severity</th><th>Submitted</th></tr></thead>
                        <tbody>
                            @foreach (var c in pendingAcceptanceQueue)
                            {
                                var sev = c.Severity == OpenQMS.Models.Complaint.ComplaintSeverity.Critical ? "bg-danger"
                                        : c.Severity == OpenQMS.Models.Complaint.ComplaintSeverity.Major ? "bg-warning text-dark"
                                        : "bg-light text-dark border";
                                <tr>
                                    <td><a asp-action="Details" asp-route-id="@c.Id">@c.ComplaintId</a></td>
                                    <td>@c.Title</td>
                                    <td><span class="badge @sev">@c.Severity</span></td>
                                    <td>@c.ReceivedOn.ToSite().ToShortDateString()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted p-3 mb-0">None awaiting acceptance.</p> }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 @(critical.Any() ? "border-danger" : "")">
            <div class="card-header d-flex justify-content-between @(critical.Any() ? "bg-danger text-white" : "")">
                <span>Open Critical Complaints</span>
                <span class="badge @(critical.Any() ? "bg-white text-danger" : "bg-secondary")">@critical.Count</span>
            </div>
            <div class="card-body p-0">
                @if (critical.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>ID</th><th>Title</th><th>Status</th><th>Customer</th></tr></thead>
                        <tbody>
                            @foreach (var c in critical)
                            {
                                <tr class="table-danger">
                                    <td><a asp-action="Details" asp-route-id="@c.Id">@c.ComplaintId</a></td>
                                    <td>@c.Title</td>
                                    <td>@EnumHelper.Display(c.Status)</td>
                                    <td>@(c.Customer?.LegalName ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted p-3 mb-0">No open critical complaints.</p> }
            </div>
        </div>
    </div>
</div>

<!-- Aged Complaints -->
@if (aged.Any())
{
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning d-flex justify-content-between">
            <span>Aged Open Complaints (&gt;30 days)</span>
            <span class="badge bg-dark">@aged.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead><tr><th>ID</th><th>Title</th><th>Severity</th><th>Status</th><th>Received</th><th>Age (days)</th></tr></thead>
                <tbody>
                    @foreach (var c in aged)
                    {
                        var age = (SiteTime.Today - c.ReceivedOn.Date).Days;
                        var sev = c.Severity == OpenQMS.Models.Complaint.ComplaintSeverity.Critical ? "bg-danger"
                                : c.Severity == OpenQMS.Models.Complaint.ComplaintSeverity.Major ? "bg-warning text-dark"
                                : "bg-light text-dark border";
                        <tr class="table-warning">
                            <td><a asp-action="Details" asp-route-id="@c.Id">@c.ComplaintId</a></td>
                            <td>@c.Title</td>
                            <td><span class="badge @sev">@c.Severity</span></td>
                            <td>@EnumHelper.Display(c.Status)</td>
                            <td>@c.ReceivedOn.ToSite().ToShortDateString()</td>
                            <td><strong>@age</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Recent Activity -->
<div class="card">
    <div class="card-header">Recent Activity</div>
    <div class="card-body p-0">
        @{
            var recentActivity = ViewBag.RecentActivity as dynamic;
        }
        @if (recentActivity != null)
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Time</th><th>Complaint</th><th>Action</th><th>By</th></tr></thead>
                <tbody>
                    @foreach (var entry in recentActivity)
                    {
                        <tr>
                            <td class="text-nowrap text-muted small">@(SiteTime.ToSite((DateTime)entry.Log.PerformedOn).ToString("yyyy-MM-dd HH:mm"))</td>
                            <td><a asp-action="Details" asp-route-id="@entry.RecordId">@entry.ComplaintId</a> — @entry.Title</td>
                            <td>@entry.Log.Action</td>
                            <td>@entry.Log.PerformedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted p-3 mb-0">No activity recorded yet.</p>
        }
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    var labels = @Json.Serialize(statusCounts.Keys.ToList());
    var data   = @Json.Serialize(statusCounts.Values.ToList());
    var colors = ['#6c757d','#0dcaf0','#ffc107','#fd7e14','#198754'];

    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: { labels: labels, datasets: [{ data: data, backgroundColor: colors }] },
        options: { plugins: { legend: { position: 'bottom' } }, maintainAspectRatio: true }
    });
})();
</script>
}
