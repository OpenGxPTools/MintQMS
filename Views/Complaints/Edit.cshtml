@model OpenQMS.Models.Complaint
@{
    ViewData["Title"] = $"Edit — {Model.ComplaintId}";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var s = Model.Status;
    var isReceived   = s == OpenQMS.Models.Complaint.ComplaintStatus.Received;
    var isEvaluation = s == OpenQMS.Models.Complaint.ComplaintStatus.Evaluation;
    var isAccepted   = s == OpenQMS.Models.Complaint.ComplaintStatus.Accepted;
    var intakeEditable = isReceived || isEvaluation;

    var statusBadge = s switch
    {
        OpenQMS.Models.Complaint.ComplaintStatus.Received          => "bg-light text-dark border",
        OpenQMS.Models.Complaint.ComplaintStatus.Evaluation        => "bg-info text-dark",
        OpenQMS.Models.Complaint.ComplaintStatus.PendingAcceptance => "bg-primary text-white",
        OpenQMS.Models.Complaint.ComplaintStatus.Accepted          => "bg-warning text-dark",
        OpenQMS.Models.Complaint.ComplaintStatus.Resolution        => "bg-warning text-dark",
        OpenQMS.Models.Complaint.ComplaintStatus.Closed            => "bg-success",
        _ => "bg-secondary"
    };
    var statusLabel = s == OpenQMS.Models.Complaint.ComplaintStatus.PendingAcceptance
        ? "Pending Acceptance" : s.ToString();
    var severityBadge = Model.Severity switch
    {
        OpenQMS.Models.Complaint.ComplaintSeverity.Critical => "bg-danger",
        OpenQMS.Models.Complaint.ComplaintSeverity.Major    => "bg-warning text-dark",
        _ => "bg-light text-dark border"
    };

    var products  = ViewData["Products"]  as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var processes = ViewData["Processes"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var materials = ViewData["Materials"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var suppliers = ViewData["Suppliers"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();

    var selProductIds  = ViewBag.SelectedProductIds  as List<int> ?? new List<int>();
    var selProcessIds  = ViewBag.SelectedProcessIds  as List<int> ?? new List<int>();
    var selMaterialIds = ViewBag.SelectedMaterialIds as List<int> ?? new List<int>();
    var selSupplierIds = ViewBag.SelectedSupplierIds as List<int> ?? new List<int>();
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">Edit Complaint — <span class="fw-bold">@Model.ComplaintId</span></h4>
        <small class="text-muted">@Model.Title</small>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge @severityBadge fs-6">@Model.Severity</span>
        <span class="badge @statusBadge fs-6">@statusLabel</span>
    </div>
</div>
<hr />


<form asp-action="Edit">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <!-- ── Section 1: Complaint Intake ───────────────────────────────── -->
            <div class="card mb-4 @(isAccepted ? "opacity-50" : "")">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    Complaint Intake
                    @if (isAccepted)
                    {
                        <span class="badge bg-secondary"><i class="bi bi-lock-fill"></i> Locked</span>
                    }
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Record the complaint source, product involved, and the full description of the issue reported.</p>
                    @if (isAccepted)
                    {
                        <!-- Read-only view — intake is locked once accepted -->
                        <dl class="row mb-0">
                            <dt class="col-sm-3">Title</dt>
                            <dd class="col-sm-9">@Model.Title</dd>
                            <input type="hidden" asp-for="Title" />

                            <dt class="col-sm-3">Severity</dt>
                            <dd class="col-sm-9"><span class="badge @severityBadge">@Model.Severity</span></dd>
                            <input type="hidden" asp-for="Severity" />

                            <dt class="col-sm-3">Customer</dt>
                            <dd class="col-sm-9">
                                @if (Model.Customer != null) { <span>@Model.Customer.LegalName</span> }
                                else if (!string.IsNullOrEmpty(Model.CustomerName)) { <span>@Model.CustomerName <span class="badge bg-secondary ms-1 small">Not in system</span></span> }
                                else { <span class="text-muted">-</span> }
                            </dd>
                            <input type="hidden" asp-for="CustomerId" />
                            <input type="hidden" asp-for="CustomerName" />

                            <dt class="col-sm-3">Customer Contact</dt>
                            <dd class="col-sm-9">@(Model.CustomerContact ?? "-")</dd>
                            <input type="hidden" asp-for="CustomerContact" />

                            <dt class="col-sm-3">Customer Reference</dt>
                            <dd class="col-sm-9">@(Model.CustomerReference ?? "-")</dd>
                            <input type="hidden" asp-for="CustomerReference" />

                            <dt class="col-sm-3">Products</dt>
                            <dd class="col-sm-9">
                                @{
                                    var lockedProducts = Model.LinkedProducts?.Any() == true
                                        ? Model.LinkedProducts.Select(x => x.Product?.Name).Where(n => n != null)
                                        : (Model.Product != null ? new[] { Model.Product.Name }.AsEnumerable() : Enumerable.Empty<string?>());
                                    var lpList = lockedProducts.ToList();
                                }
                                @(lpList.Any() ? string.Join(", ", lpList) : "-")
                            </dd>

                            <dt class="col-sm-3">Processes</dt>
                            <dd class="col-sm-9">
                                @{
                                    var lockedProcesses = Model.LinkedProcesses?.Any() == true
                                        ? Model.LinkedProcesses.Select(x => x.Process?.Name).Where(n => n != null)
                                        : (Model.Process != null ? new[] { Model.Process.Name }.AsEnumerable() : Enumerable.Empty<string?>());
                                    var lprList = lockedProcesses.ToList();
                                }
                                @(lprList.Any() ? string.Join(", ", lprList) : "-")
                            </dd>

                            <dt class="col-sm-3">Materials</dt>
                            <dd class="col-sm-9">
                                @{
                                    var lockedMaterials = Model.LinkedMaterials?.Any() == true
                                        ? Model.LinkedMaterials.Select(x => x.Material?.Name).Where(n => n != null)
                                        : (Model.Material != null ? new[] { Model.Material.Name }.AsEnumerable() : Enumerable.Empty<string?>());
                                    var lmList = lockedMaterials.ToList();
                                }
                                @(lmList.Any() ? string.Join(", ", lmList) : "-")
                            </dd>

                            <dt class="col-sm-3">Suppliers</dt>
                            <dd class="col-sm-9">
                                @{
                                    var lockedSuppliers = Model.LinkedSuppliers?.Any() == true
                                        ? Model.LinkedSuppliers.Select(x => x.Supplier?.LegalName).Where(n => n != null)
                                        : (Model.Supplier != null ? new[] { Model.Supplier.LegalName }.AsEnumerable() : Enumerable.Empty<string?>());
                                    var lsList = lockedSuppliers.ToList();
                                }
                                @(lsList.Any() ? string.Join(", ", lsList) : "-")
                            </dd>

                            <dt class="col-sm-3">Description</dt>
                            <dd class="col-sm-9">@(Model.Description ?? "-")</dd>
                            <input type="hidden" asp-for="Description" />
                        </dl>
                    }
                    else
                    {
                        <fieldset>
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label asp-for="Title" class="form-label"></label>
                                    <input asp-for="Title" class="form-control" />
                                    <span asp-validation-for="Title" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Severity" class="form-label">
                                        Severity
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="severity"
                                                aria-label="Severity guidance">?</button>
                                    </label>
                                    <select asp-for="Severity" class="form-select"
                                            asp-items="Html.GetEnumSelectList<OpenQMS.Models.Complaint.ComplaintSeverity>()"></select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CustomerId" class="form-label">Customer (from Master Data)</label>
                                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId" id="CustomerIdSelect">
                                        <option value="">-- Select Customer --</option>
                                    </select>
                                </div>
                                <div class="col-md-6" id="CustomerNameRow">
                                    <label asp-for="CustomerName" class="form-label">
                                        Customer Name <span class="text-muted small">(if not in system)</span>
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="customername"
                                                aria-label="Customer name guidance">?</button>
                                    </label>
                                    <input asp-for="CustomerName" class="form-control"
                                           placeholder="e.g. Pharmacy name, patient reference..." />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CustomerContact" class="form-label">
                                        @Html.DisplayNameFor(m => m.CustomerContact)
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="customercontact"
                                                aria-label="Customer contact guidance">?</button>
                                    </label>
                                    <input asp-for="CustomerContact" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CustomerReference" class="form-label"></label>
                                    <input asp-for="CustomerReference" class="form-control" />
                                </div>

                                <!-- Product picker -->
                                <div class="col-md-6">
                                    <label class="form-label">Products</label>
                                    <select id="productDropdown" class="form-select">
                                        <option value="">-- Add Product --</option>
                                        @foreach (var p in products)
                                        {
                                            <option value="@p.Value" data-text="@p.Text">@p.Text</option>
                                        }
                                    </select>
                                    <div id="productTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                    <div id="productHidden" class="d-none"></div>
                                </div>

                                <!-- Process picker -->
                                <div class="col-md-6">
                                    <label class="form-label">Processes</label>
                                    <select id="processDropdown" class="form-select">
                                        <option value="">-- Add Process --</option>
                                        @foreach (var p in processes)
                                        {
                                            <option value="@p.Value" data-text="@p.Text">@p.Text</option>
                                        }
                                    </select>
                                    <div id="processTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                    <div id="processHidden" class="d-none"></div>
                                </div>

                                <!-- Material picker -->
                                <div class="col-md-6">
                                    <label class="form-label">Materials</label>
                                    <select id="materialDropdown" class="form-select">
                                        <option value="">-- Add Material --</option>
                                        @foreach (var p in materials)
                                        {
                                            <option value="@p.Value" data-text="@p.Text">@p.Text</option>
                                        }
                                    </select>
                                    <div id="materialTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                    <div id="materialHidden" class="d-none"></div>
                                </div>

                                <!-- Supplier picker -->
                                <div class="col-md-6">
                                    <label class="form-label">Suppliers</label>
                                    <select id="supplierDropdown" class="form-select">
                                        <option value="">-- Add Supplier --</option>
                                        @foreach (var p in suppliers)
                                        {
                                            <option value="@p.Value" data-text="@p.Text">@p.Text</option>
                                        }
                                    </select>
                                    <div id="supplierTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                    <div id="supplierHidden" class="d-none"></div>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Description" class="form-label">
                                        Description
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="description"
                                                aria-label="Description guidance">?</button>
                                    </label>
                                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>
                            </div>
                        </fieldset>
                    }
                </div>
            </div>

            <!-- ── Section 2: Evaluation & Investigation (hidden at Received) ──── -->
            @if (!isReceived)
            {
                <div class="card mb-4 @(isAccepted ? "opacity-50" : "")">
                    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                        Evaluation &amp; Investigation
                        @if (isAccepted)
                        {
                            <span class="badge bg-secondary"><i class="bi bi-lock-fill"></i> Locked</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">In Progress</span>
                        }
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">Assess the complaint, conduct the investigation, identify the root cause, and plan corrective actions.</p>
                        @if (isAccepted)
                        {
                            <dl class="row mb-0">
                                <dt class="col-sm-3">Evaluation</dt>
                                <dd class="col-sm-9">@(Model.Evaluation ?? "-")</dd>
                                <dt class="col-sm-3">Investigation</dt>
                                <dd class="col-sm-9">@(Model.Investigation ?? "-")</dd>
                                <dt class="col-sm-3">Root Cause Category</dt>
                                <dd class="col-sm-9">@(Model.RootCauseCategory?.ToString() ?? "-")</dd>
                                <dt class="col-sm-3">Corrective and Preventive Action</dt>
                                <dd class="col-sm-9">@(Model.CorrectiveAction ?? "-")</dd>
                            </dl>
                            <input type="hidden" asp-for="Evaluation" />
                            <input type="hidden" asp-for="Investigation" />
                            <input type="hidden" asp-for="RootCauseCategory" />
                            <input type="hidden" asp-for="CorrectiveAction" />
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="Evaluation" class="form-label">
                                        Evaluation <span class="text-danger">*</span>
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="evaluation"
                                                aria-label="Evaluation guidance">?</button>
                                    </label>
                                    <textarea asp-for="Evaluation" class="form-control" rows="4"></textarea>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Investigation" class="form-label">
                                        Investigation
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="investigation"
                                                aria-label="Investigation guidance">?</button>
                                    </label>
                                    <textarea asp-for="Investigation" class="form-control" rows="4"></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="RootCauseCategory" class="form-label">
                                        Root Cause Category <span class="text-danger">*</span>
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="rootcause"
                                                aria-label="Root cause category guidance">?</button>
                                    </label>
                                    <select asp-for="RootCauseCategory" class="form-select"
                                            asp-items="Html.GetEnumSelectList<OpenQMS.Models.RootCauseCategory>()">
                                        <option value="">-- Select Root Cause Category --</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label asp-for="CorrectiveAction" class="form-label">
                                        Corrective and Preventive Action <span class="text-danger">*</span>
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="capa"
                                                aria-label="CAPA guidance">?</button>
                                    </label>
                                    <textarea asp-for="CorrectiveAction" class="form-control" rows="4"></textarea>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ── Section 3: Resolution (only shown at Accepted stage) ──────── -->
            @if (isAccepted)
            {
                <div class="card mb-4">
                    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                        Resolution
                        <span class="badge bg-warning text-dark">Action Required</span>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">Summarise how the complaint was resolved, confirm all actions are complete, and document the outcome for the customer.</p>
                        <div class="col-12">
                            <label asp-for="Resolution" class="form-label">
                                Resolution <span class="text-danger">*</span>
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="resolution"
                                        aria-label="Resolution guidance">?</button>
                            </label>
                            <textarea asp-for="Resolution" class="form-control" rows="5"></textarea>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex gap-2">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">View Details</a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
            </div>
        </form>

        @if (!Model.LinkedCapaId.HasValue)
        {
            <form asp-action="CreateCapa" method="post" class="mt-3 d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-primary btn-sm">+ Create Linked CAPA</button>
            </form>
        }
        else
        {
            <div class="alert alert-info mt-3">
                <strong>Linked CAPA:</strong>
                <a asp-controller="Capas" asp-action="Details" asp-route-id="@Model.LinkedCapaId">View CAPA</a>
            </div>
        }

<!-- Popover help content (hidden, read by JS) -->
<div class="d-none">
    <div id="help-severity">
        <p class="mb-1"><strong>Severity Definitions</strong></p>
        <ul class="mb-0 ps-3">
            <li><strong>Critical</strong> — Poses an immediate or potential risk to patient safety, product sterility or efficacy. Requires priority handling and may trigger regulatory reporting or recall assessment.</li>
            <li><strong>Major</strong> — Significant quality failure or departure from specifications. No immediate safety risk but requires full investigation and CAPA. Typical SLA: 30 days.</li>
            <li><strong>Minor</strong> — Low-risk issue with no direct impact on product quality or patient safety. Administrative or cosmetic in nature. Typical SLA: 60 days.</li>
        </ul>
    </div>
    <div id="help-customername">
        <p class="mb-0">Only complete if the complainant is not recorded in the Customer Master. If entered here, no linked customer record will be created.</p>
    </div>
    <div id="help-customercontact">
        <p class="mb-1"><strong>Customer Contact details:</strong></p>
        <ul class="mb-0 ps-3">
            <li>Contact name</li>
            <li>Role / job title</li>
            <li>Phone number</li>
            <li>Email address</li>
        </ul>
    </div>
    <div id="help-description">
        <p class="mb-1"><strong>Description must cover:</strong></p>
        <ul class="mb-0 ps-3">
            <li>What the complainant reported (verbatim or paraphrased)</li>
            <li>Product or batch involved, if known</li>
            <li>When the issue was first observed</li>
            <li>How the complaint was received (phone, email, written)</li>
            <li>Any immediate actions already taken</li>
        </ul>
    </div>
    <div id="help-evaluation">
        <p class="mb-1"><strong>Evaluation must address:</strong></p>
        <ul class="mb-0 ps-3">
            <li>Whether the complaint is substantiated (verified)</li>
            <li>Impact on product quality and patient safety</li>
            <li>Whether a regulatory report (e.g. MDR, PSUR) is required</li>
            <li>Whether a batch recall or field safety action is needed</li>
            <li>Whether the complaint is an isolated event or part of a trend</li>
        </ul>
    </div>
    <div id="help-investigation">
        <p class="mb-1"><strong>Investigation must document:</strong></p>
        <ul class="mb-0 ps-3">
            <li>Methodology used (e.g. 5-Why, fishbone/Ishikawa)</li>
            <li>Evidence reviewed (batch records, complaints history, samples, distribution data)</li>
            <li>Timeline of events</li>
            <li>Personnel involved</li>
            <li>Findings that led to the root cause determination</li>
        </ul>
    </div>
    <div id="help-rootcause">
        <p class="mb-0"><strong>Root Cause Category</strong> — Select the primary category. If multiple categories apply, select the most significant one and document the others in Investigation.</p>
    </div>
    <div id="help-capa">
        <p class="mb-1"><strong>Corrective and Preventive Action must include:</strong></p>
        <ul class="mb-0 ps-3">
            <li>A description of each action (corrective and preventive)</li>
            <li>The responsible person for each action</li>
            <li>Target completion date for each action</li>
            <li>How effectiveness will be verified (success criteria)</li>
            <li>Whether a formal CAPA record has been raised (link below)</li>
        </ul>
    </div>
    <div id="help-resolution">
        <p class="mb-1"><strong>Resolution must document:</strong></p>
        <ul class="mb-0 ps-3">
            <li>All CAPA actions completed, with evidence (e.g. SOP revised on [date], training completed by [names] on [date])</li>
            <li>Confirmation that the root cause has been addressed</li>
            <li>Whether a response or compensation was issued to the complainant</li>
            <li>Effectiveness check result — confirm the issue has not recurred</li>
        </ul>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    function setupPicker(dropdownId, tagsId, hiddenId, inputName, preselected) {
        var selected = {};
        preselected.forEach(function (item) { selected[item.id] = item.text; });

        function render() {
            var tagsDiv   = document.getElementById(tagsId);
            var hiddenDiv = document.getElementById(hiddenId);
            tagsDiv.innerHTML   = '';
            hiddenDiv.innerHTML = '';
            Object.keys(selected).forEach(function (id) {
                var badge = document.createElement('span');
                badge.className   = 'badge bg-primary d-flex align-items-center gap-1';
                badge.textContent = selected[id];
                var btn = document.createElement('button');
                btn.type      = 'button';
                btn.className = 'btn-close btn-close-white btn-sm ms-1';
                btn.style.fontSize = '0.6rem';
                btn.addEventListener('click', function () { delete selected[id]; render(); });
                badge.appendChild(btn);
                tagsDiv.appendChild(badge);

                var input = document.createElement('input');
                input.type  = 'hidden';
                input.name  = inputName;
                input.value = id;
                hiddenDiv.appendChild(input);
            });
        }

        document.getElementById(dropdownId).addEventListener('change', function () {
            var dd   = this;
            var id   = dd.value;
            var text = dd.options[dd.selectedIndex].dataset.text;
            if (id && !selected[id]) { selected[id] = text; render(); }
            dd.value = '';
        });

        render();
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.help-btn').forEach(function (btn) {
            var contentEl = document.getElementById('help-' + btn.dataset.help);
            new bootstrap.Popover(btn, {
                html: true, trigger: 'click', placement: 'right',
                content: contentEl ? contentEl.innerHTML : '', title: '', container: 'body'
            });
        });
        document.addEventListener('click', function (e) {
            if (!e.target.classList.contains('help-btn')) {
                document.querySelectorAll('.help-btn').forEach(function (btn) {
                    var pop = bootstrap.Popover.getInstance(btn);
                    if (pop) pop.hide();
                });
            }
        });

        // CustomerName free-text visibility
        var customerSelect  = document.getElementById('CustomerIdSelect');
        var customerNameRow = document.getElementById('CustomerNameRow');
        function toggleCustomerName() {
            if (customerSelect && customerNameRow)
                customerNameRow.style.display = customerSelect.value ? 'none' : '';
        }
        if (customerSelect) { customerSelect.addEventListener('change', toggleCustomerName); toggleCustomerName(); }
    });
    </script>
    @if (intakeEditable)
    {
        <script>
        document.addEventListener('DOMContentLoaded', function () {
            var selProducts  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                products.Where(x => selProductIds.Contains(int.Parse(x.Value)))
                        .Select(x => new { id = x.Value, text = x.Text }).ToList()));
            var selProcesses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                processes.Where(x => selProcessIds.Contains(int.Parse(x.Value)))
                         .Select(x => new { id = x.Value, text = x.Text }).ToList()));
            var selMaterials = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                materials.Where(x => selMaterialIds.Contains(int.Parse(x.Value)))
                         .Select(x => new { id = x.Value, text = x.Text }).ToList()));
            var selSuppliers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                suppliers.Where(x => selSupplierIds.Contains(int.Parse(x.Value)))
                         .Select(x => new { id = x.Value, text = x.Text }).ToList()));

            setupPicker('productDropdown',  'productTags',  'productHidden',  'selectedProducts',  selProducts);
            setupPicker('processDropdown',  'processTags',  'processHidden',  'selectedProcesses', selProcesses);
            setupPicker('materialDropdown', 'materialTags', 'materialHidden', 'selectedMaterials', selMaterials);
            setupPicker('supplierDropdown', 'supplierTags', 'supplierHidden', 'selectedSuppliers', selSuppliers);
        });
        </script>
    }
}
