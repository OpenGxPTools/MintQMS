@using static OpenQMS.Models.Capa
@{
    ViewData["Title"] = "CAPA Dashboard";

    var statusCounts     = ViewBag.StatusCounts     as Dictionary<string, int>    ?? new();
    var overdueCAPAs     = ViewBag.OverdueCAPAs     as List<OpenQMS.Models.Capa>   ?? new();
    var approachingCAPAs = ViewBag.ApproachingCAPAs as List<OpenQMS.Models.Capa>   ?? new();
    var pendingAccept    = ViewBag.PendingAcceptance as List<OpenQMS.Models.Capa>   ?? new();
    var pendingApprove   = ViewBag.PendingApproval   as List<OpenQMS.Models.Capa>   ?? new();
    var recentActivity   = ViewBag.RecentActivity    as List<OpenQMS.Models.CapaAuditLog> ?? new();
    var recentCapaMap    = ViewBag.RecentCapaMap     as Dictionary<int, string>     ?? new();
    var today            = SiteTime.Today;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">CAPA Dashboard</h4>
    <div class="d-flex gap-2">
        <a asp-action="ExportRegister" class="btn btn-outline-success btn-sm">Export Register</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">CAPA Register</a>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New CAPA</a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <div class="fs-1 fw-bold text-primary">@ViewBag.TotalCapas</div>
                <div class="text-muted small">Total CAPAs</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm h-100 border-start border-warning border-3">
            <div class="card-body text-center">
                <div class="fs-1 fw-bold text-warning">@ViewBag.OpenCount</div>
                <div class="text-muted small">Open</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm h-100 border-start border-success border-3">
            <div class="card-body text-center">
                <div class="fs-1 fw-bold text-success">@ViewBag.ApprovedCount</div>
                <div class="text-muted small">Approved</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm h-100 border-start border-danger border-3">
            <div class="card-body text-center">
                <div class="fs-1 fw-bold text-danger">@ViewBag.OverdueCount</div>
                <div class="text-muted small">Overdue</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm h-100 border-start border-info border-3">
            <div class="card-body text-center">
                <div class="fs-1 fw-bold text-info">@pendingAccept.Count</div>
                <div class="text-muted small">Awaiting Acceptance</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm h-100 border-start border-secondary border-3">
            <div class="card-body text-center">
                <div class="fs-1 fw-bold text-secondary">@pendingApprove.Count</div>
                <div class="text-muted small">Awaiting Approval</div>
            </div>
        </div>
    </div>
</div>

<!-- Status Breakdown & Chart -->
<div class="row g-3 mb-4">
    <div class="col-md-5">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="fas fa-chart-bar me-1"></i>CAPAs by Status</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        @{
                            var badgeMap = new Dictionary<string, string>
                            {
                                ["Determination"]     = "bg-secondary",
                                ["Assessment"]        = "bg-info text-dark",
                                ["Pending Assessment"]= "bg-primary text-white",
                                ["Implementation"]    = "bg-warning text-dark",
                                ["Pending Approval"]  = "bg-primary text-white",
                                ["Approved"]          = "bg-success"
                            };
                            var total = ViewBag.TotalCapas > 0 ? (int)ViewBag.TotalCapas : 1;
                        }
                        @foreach (var kvp in statusCounts)
                        {
                            var pct = (int)Math.Round(kvp.Value * 100.0 / total);
                            var bc  = badgeMap.TryGetValue(kvp.Key, out var bv) ? bv : "bg-secondary";
                            <tr>
                                <td class="ps-3" style="width:150px">
                                    <span class="badge @bc">@kvp.Key</span>
                                </td>
                                <td>
                                    <div class="progress mt-1" style="height:14px">
                                        <div class="progress-bar @bc" style="width:@pct%"></div>
                                    </div>
                                </td>
                                <td class="text-end pe-3" style="width:50px">@kvp.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="fas fa-chart-pie me-1"></i>Status Distribution</div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="statusChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="fas fa-clock me-1 text-warning"></i>Approaching Deadline</div>
            <div class="card-body p-0">
                @if (approachingCAPAs.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var c in approachingCAPAs)
                        {
                            var daysLeft = (c.TargetCompletionDate!.Value - today).Days;
                            <li class="list-group-item px-3 py-2">
                                <a asp-action="Details" asp-route-id="@c.Id" class="fw-semibold text-decoration-none">@c.CapaId</a>
                                <div class="text-truncate small text-muted">@c.Title</div>
                                <span class="badge bg-warning text-dark">@daysLeft day@(daysLeft == 1 ? "" : "s") left</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-3 text-muted small">None approaching in the next 14 days.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Overdue CAPAs -->
@if (overdueCAPAs.Any())
{
    <div class="card shadow-sm border-danger mb-4">
        <div class="card-header bg-danger text-white fw-semibold">
            <i class="fas fa-exclamation-circle me-1"></i>Overdue CAPAs (@overdueCAPAs.Count)
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr><th>ID</th><th>Title</th><th>Status</th><th>Target Date</th><th>Days Overdue</th><th>Linked To</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in overdueCAPAs)
                    {
                        var daysOver = (today - c.TargetCompletionDate!.Value).Days;
                        var csLabel = c.Status == CapaStatus.PendingAssessment ? "Pending Assessment"
                                    : c.Status == CapaStatus.PendingApproval   ? "Pending Approval"
                                    : c.Status.ToString();
                        var csBadge = badgeMap.TryGetValue(csLabel, out var csv) ? csv : "bg-secondary";
                        <tr class="table-danger">
                            <td><a asp-action="Details" asp-route-id="@c.Id">@c.CapaId</a></td>
                            <td>@c.Title</td>
                            <td><span class="badge @csBadge">@csLabel</span></td>
                            <td>@c.TargetCompletionDate!.Value.ToString("dd MMM yyyy")</td>
                            <td class="text-danger fw-bold">@daysOver day@(daysOver == 1 ? "" : "s")</td>
                            <td class="small">
                                @if (c.Deviation != null) { <span>Dev: @c.Deviation.DeviationId</span> }
                                else if (c.Complaint != null) { <span>Cmp: @c.Complaint.ComplaintId</span> }
                                else if (c.Audit != null) { <span>Aud: @c.Audit.AuditId</span> }
                                else { <span class="text-muted">—</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Awaiting Acceptance / Awaiting Approval -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="fas fa-check-circle me-1 text-info"></i>Awaiting Acceptance (@pendingAccept.Count)</div>
            <div class="card-body p-0">
                @if (pendingAccept.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>ID</th><th>Title</th><th>Submitted By</th><th>Submitted On</th></tr></thead>
                        <tbody>
                            @foreach (var c in pendingAccept)
                            {
                                <tr>
                                    <td><a asp-action="Details" asp-route-id="@c.Id">@c.CapaId</a></td>
                                    <td class="text-truncate" style="max-width:180px">@c.Title</td>
                                    <td>@(c.AssessedBy ?? "-")</td>
                                    <td>@(SiteTime.ToSite((DateTime?)c.AssessedOn)?.ToString("dd MMM yyyy") ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3 text-muted small">No CAPAs awaiting acceptance.</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="fas fa-thumbs-up me-1 text-secondary"></i>Awaiting Approval (@pendingApprove.Count)</div>
            <div class="card-body p-0">
                @if (pendingApprove.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>ID</th><th>Title</th><th>Accepted By</th><th>Accepted On</th></tr></thead>
                        <tbody>
                            @foreach (var c in pendingApprove)
                            {
                                <tr>
                                    <td><a asp-action="Details" asp-route-id="@c.Id">@c.CapaId</a></td>
                                    <td class="text-truncate" style="max-width:180px">@c.Title</td>
                                    <td>@(c.AcceptedBy ?? "-")</td>
                                    <td>@(SiteTime.ToSite((DateTime?)c.AcceptedOn)?.ToString("dd MMM yyyy") ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3 text-muted small">No CAPAs awaiting approval.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold"><i class="fas fa-history me-1"></i>Recent Activity</div>
    <div class="card-body p-0">
        @if (recentActivity.Any())
        {
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr><th>Date/Time <span class="fw-normal text-muted">(@SiteTime.Label)</span></th><th>CAPA</th><th>Action</th><th>From</th><th>To</th><th>Performed By</th></tr>
                </thead>
                <tbody>
                    @foreach (var log in recentActivity)
                    {
                        var capaLabel = recentCapaMap.TryGetValue(log.CapaId, out var lbl) ? lbl : $"#{log.CapaId}";
                        <tr>
                            <td>@(SiteTime.ToSite((DateTime)log.PerformedOn).ToString("dd MMM yyyy HH:mm"))</td>
                            <td><a asp-action="Details" asp-route-id="@log.CapaId">@capaLabel</a></td>
                            <td>@log.Action</td>
                            <td>@(log.FromStatus ?? "-")</td>
                            <td>@(log.ToStatus ?? "-")</td>
                            <td>@log.PerformedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="p-3 text-muted small">No audit log activity yet.</div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Status doughnut chart
        (function () {
            var labels = [@Html.Raw(string.Join(",", statusCounts.Keys.Select(k => $"'{k}'")))];
            var data   = [@Html.Raw(string.Join(",", statusCounts.Values))];
            var colors = ['#9E9E9E','#29B6F6','#1565C0','#FFA726','#1565C0','#1976D2','#43A047'];
            new Chart(document.getElementById('statusChart'), {
                type: 'doughnut',
                data: { labels: labels, datasets: [{ data: data, backgroundColor: colors, borderWidth: 1 }] },
                options: {
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } },
                    cutout: '60%'
                }
            });
        })();
    </script>
}
