@model OpenQMS.Models.Capa

@{
    ViewData["Title"] = "Delete CAPA";

    var delLinked = new List<string>();
    if (Model.LinkedProducts?.Any()   == true) delLinked.AddRange(Model.LinkedProducts.Select(x => x.Product?.Name ?? "").Where(n => n != ""));
    if (Model.LinkedProcesses?.Any()  == true) delLinked.AddRange(Model.LinkedProcesses.Select(x => x.Process?.Name ?? "").Where(n => n != ""));
    if (Model.LinkedAssets?.Any()     == true) delLinked.AddRange(Model.LinkedAssets.Select(x => x.Asset?.Name ?? "").Where(n => n != ""));
    if (Model.LinkedMaterials?.Any()  == true) delLinked.AddRange(Model.LinkedMaterials.Select(x => x.Material?.Name ?? "").Where(n => n != ""));
    if (Model.LinkedSuppliers?.Any()  == true) delLinked.AddRange(Model.LinkedSuppliers.Select(x => x.Supplier?.LegalName ?? "").Where(n => n != ""));
    if (Model.LinkedDeviations?.Any() == true) delLinked.AddRange(Model.LinkedDeviations.Select(x => x.Deviation?.Title ?? "").Where(n => n != ""));
    if (Model.LinkedComplaints?.Any() == true) delLinked.AddRange(Model.LinkedComplaints.Select(x => x.Complaint?.Title ?? "").Where(n => n != ""));
    if (Model.LinkedAudits?.Any()     == true) delLinked.AddRange(Model.LinkedAudits.Select(x => x.Audit?.Title ?? "").Where(n => n != ""));
    if (!delLinked.Any())
    {
        if (Model.Product   != null) delLinked.Add(Model.Product.Name);
        if (Model.Deviation != null) delLinked.Add(Model.Deviation.Title);
    }
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">Delete CAPA</h4>
    </div>
</div>
<hr />
<h5 class="text-danger">Are you sure you want to delete this?</h5>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CapaId)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.CapaId)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Title)</dd>
            <dt class="col-sm-4">Linked Records</dt>
            <dd class="col-sm-8">@(delLinked.Any() ? string.Join(", ", delLinked) : "-")</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DeterminedBy)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.DeterminedBy)</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Status)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Status)</dd>
        </dl>

        @if (Model.Changes.Any())
        {
            <h6 class="mt-3 text-uppercase small text-muted">Linked Changes</h6>
            <table class="table table-sm">
                <thead><tr><th>ID</th><th>Title</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.Changes)
                    {
                        <tr>
                            <td><a asp-controller="Changes" asp-action="Details" asp-route-id="@item.Id">@item.ChangeId</a></td>
                            <td>@item.Title</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-2">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
    </div>
</form>
