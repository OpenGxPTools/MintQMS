@model OpenQMS.Models.Capa
@using OpenQMS.Authorization

@{
    ViewData["Title"] = $"Edit — {Model.CapaId}";

    var products   = (List<SelectListItem>)ViewData["Products"];
    var processes  = (List<SelectListItem>)ViewData["Processes"];
    var assets     = (List<SelectListItem>)ViewData["Assets"];
    var materials  = (List<SelectListItem>)ViewData["Materials"];
    var suppliers  = (List<SelectListItem>)ViewData["Suppliers"];
    var deviations = (List<SelectListItem>)ViewData["Deviations"];
    var complaints = (List<SelectListItem>)ViewData["Complaints"];
    var audits     = (List<SelectListItem>)ViewData["Audits"];

    var selProductIds   = (List<int>)(ViewBag.SelectedProductIds   ?? new List<int>());
    var selProcessIds   = (List<int>)(ViewBag.SelectedProcessIds   ?? new List<int>());
    var selAssetIds     = (List<int>)(ViewBag.SelectedAssetIds     ?? new List<int>());
    var selMaterialIds  = (List<int>)(ViewBag.SelectedMaterialIds  ?? new List<int>());
    var selSupplierIds  = (List<int>)(ViewBag.SelectedSupplierIds  ?? new List<int>());
    var selDeviationIds = (List<int>)(ViewBag.SelectedDeviationIds ?? new List<int>());
    var selComplaintIds = (List<int>)(ViewBag.SelectedComplaintIds ?? new List<int>());
    var selAuditIds     = (List<int>)(ViewBag.SelectedAuditIds     ?? new List<int>());

    var s                = Model.Status;
    var isDetermination  = s == Capa.CapaStatus.Determination;
    var isAssessment     = s == Capa.CapaStatus.Assessment;
    var isImplementation = s == Capa.CapaStatus.Implementation;
    var planEditable     = isDetermination || isAssessment;
    var implEditable     = isImplementation;

    var statusLabel = s switch
    {
        Capa.CapaStatus.PendingAssessment => "Pending Assessment",
        Capa.CapaStatus.PendingApproval   => "Pending Approval",
        _ => s.ToString()
    };
    var badgeClass = s switch
    {
        Capa.CapaStatus.Determination     => "bg-secondary",
        Capa.CapaStatus.Assessment        => "bg-info text-dark",
        Capa.CapaStatus.PendingAssessment => "bg-primary text-white",
        Capa.CapaStatus.Implementation    => "bg-warning text-dark",
        Capa.CapaStatus.PendingApproval   => "bg-primary text-white",
        Capa.CapaStatus.Approved          => "bg-success",
        _                                 => "bg-secondary"
    };

    string LinkedName(ICollection<OpenQMS.Models.CapaProduct>? j, OpenQMS.Models.Product? legacy)
        => j?.Any() == true ? string.Join(", ", j.Select(x => x.Product?.Name).Where(n => n != null)) : (legacy?.Name ?? "-");
    string LinkedProcessName(ICollection<OpenQMS.Models.CapaProcess>? j, OpenQMS.Models.Process? legacy)
        => j?.Any() == true ? string.Join(", ", j.Select(x => x.Process?.Name).Where(n => n != null)) : (legacy?.Name ?? "-");
    string LinkedAssetName(ICollection<OpenQMS.Models.CapaAsset>? j, OpenQMS.Models.Asset? legacy)
        => j?.Any() == true ? string.Join(", ", j.Select(x => x.Asset?.Name).Where(n => n != null)) : (legacy?.Name ?? "-");
    string LinkedMaterialName(ICollection<OpenQMS.Models.CapaMaterial>? j, OpenQMS.Models.Material? legacy)
        => j?.Any() == true ? string.Join(", ", j.Select(x => x.Material?.Name).Where(n => n != null)) : (legacy?.Name ?? "-");
    string LinkedSupplierName(ICollection<OpenQMS.Models.CapaSupplier>? j, OpenQMS.Models.Supplier? legacy)
        => j?.Any() == true ? string.Join(", ", j.Select(x => x.Supplier?.LegalName).Where(n => n != null)) : (legacy?.LegalName ?? "-");
    string LinkedDeviationName(ICollection<OpenQMS.Models.CapaDeviation>? j, OpenQMS.Models.Deviation? legacy)
        => j?.Any() == true ? string.Join(", ", j.Select(x => x.Deviation?.Title).Where(n => n != null)) : (legacy?.Title ?? "-");
    string LinkedComplaintName(ICollection<OpenQMS.Models.CapaComplaint>? j, OpenQMS.Models.Complaint? legacy)
        => j?.Any() == true ? string.Join(", ", j.Select(x => x.Complaint?.Title).Where(n => n != null)) : (legacy?.Title ?? "-");
    string LinkedAuditName(ICollection<OpenQMS.Models.CapaAudit>? j, OpenQMS.Models.Audit? legacy)
        => j?.Any() == true ? string.Join(", ", j.Select(x => x.Audit?.Title).Where(n => n != null)) : (legacy?.Title ?? "-");
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">Edit CAPA &mdash; <span class="fw-bold">@Model.CapaId</span></h4>
        <small class="text-muted">@Model.Title</small>
    </div>
    <span class="badge @badgeClass fs-6">@statusLabel</span>
</div>
<hr />

<form asp-action="Edit">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="LinkedAdverseEventId" />

            <!-- ── Section 1: Determination ──────────────────────────────────── -->
            <div class="card mb-4 @(!planEditable ? "opacity-50" : "")">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    Determination
                    @if (!planEditable)
                    {
                        <span class="badge bg-secondary"><i class="bi bi-lock-fill"></i> Locked</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-dark">In Progress</span>
                    }
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Define the corrective and preventive actions required to address the root cause.</p>
                    @if (!planEditable)
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-3">CAPA Type</dt>
                            <dd class="col-sm-9">@Html.DisplayFor(m => m.Type)</dd>
                            <input type="hidden" asp-for="Type" />

                            <dt class="col-sm-3">Title</dt>
                            <dd class="col-sm-9">@Model.Title</dd>
                            <input type="hidden" asp-for="Title" />

                            <dt class="col-sm-3">Products</dt>
                            <dd class="col-sm-9">@LinkedName(Model.LinkedProducts, Model.Product)</dd>

                            <dt class="col-sm-3">Processes</dt>
                            <dd class="col-sm-9">@LinkedProcessName(Model.LinkedProcesses, Model.Process)</dd>

                            <dt class="col-sm-3">Assets</dt>
                            <dd class="col-sm-9">@LinkedAssetName(Model.LinkedAssets, Model.Asset)</dd>

                            <dt class="col-sm-3">Materials</dt>
                            <dd class="col-sm-9">@LinkedMaterialName(Model.LinkedMaterials, Model.Material)</dd>

                            <dt class="col-sm-3">Suppliers</dt>
                            <dd class="col-sm-9">@LinkedSupplierName(Model.LinkedSuppliers, Model.Supplier)</dd>

                            <dt class="col-sm-3">Deviations</dt>
                            <dd class="col-sm-9">@LinkedDeviationName(Model.LinkedDeviations, Model.Deviation)</dd>

                            <dt class="col-sm-3">Complaints</dt>
                            <dd class="col-sm-9">@LinkedComplaintName(Model.LinkedComplaints, Model.Complaint)</dd>

                            <dt class="col-sm-3">Audits</dt>
                            <dd class="col-sm-9">@LinkedAuditName(Model.LinkedAudits, Model.Audit)</dd>

                            <dt class="col-sm-3">Corrective Action</dt>
                            <dd class="col-sm-9">@(Model.CorrectiveAction ?? "-")</dd>
                            <input type="hidden" asp-for="CorrectiveAction" />

                            <dt class="col-sm-3">Preventive Action</dt>
                            <dd class="col-sm-9">@(Model.PreventiveAction ?? "-")</dd>
                            <input type="hidden" asp-for="PreventiveAction" />

                            <dt class="col-sm-3">Target Completion</dt>
                            <dd class="col-sm-9">@(Model.TargetCompletionDate.HasValue ? Model.TargetCompletionDate.Value.ToString("dd MMM yyyy") : "-")</dd>
                            <input type="hidden" asp-for="TargetCompletionDate" />
                        </dl>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Title" class="form-label"></label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Type" class="form-label">
                                    CAPA Type
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="capatype" aria-label="CAPA Type guidance">?</button>
                                </label>
                                <select asp-for="Type" asp-items="Html.GetEnumSelectList<OpenQMS.Models.Capa.CapaType>()" class="form-select"></select>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TargetCompletionDate" class="form-label"></label>
                                <input asp-for="TargetCompletionDate" class="form-control" type="date" />
                                <span asp-validation-for="TargetCompletionDate" class="text-danger small"></span>
                            </div>

                            <!-- Products -->
                            <div class="col-md-6">
                                <label class="form-label">Products</label>
                                <select id="productDropdown" class="form-select form-select-sm">
                                    <option value="">-- Add Product --</option>
                                    @foreach (var item in products)
                                    {
                                        <option value="@item.Value" data-text="@item.Text">@item.Text</option>
                                    }
                                </select>
                                <div id="productTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                <div id="productHidden" class="d-none"></div>
                            </div>

                            <!-- Processes -->
                            <div class="col-md-6">
                                <label class="form-label">Processes</label>
                                <select id="processDropdown" class="form-select form-select-sm">
                                    <option value="">-- Add Process --</option>
                                    @foreach (var item in processes)
                                    {
                                        <option value="@item.Value" data-text="@item.Text">@item.Text</option>
                                    }
                                </select>
                                <div id="processTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                <div id="processHidden" class="d-none"></div>
                            </div>

                            <!-- Assets -->
                            <div class="col-md-6">
                                <label class="form-label">Assets</label>
                                <select id="assetDropdown" class="form-select form-select-sm">
                                    <option value="">-- Add Asset --</option>
                                    @foreach (var item in assets)
                                    {
                                        <option value="@item.Value" data-text="@item.Text">@item.Text</option>
                                    }
                                </select>
                                <div id="assetTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                <div id="assetHidden" class="d-none"></div>
                            </div>

                            <!-- Materials -->
                            <div class="col-md-6">
                                <label class="form-label">Materials</label>
                                <select id="materialDropdown" class="form-select form-select-sm">
                                    <option value="">-- Add Material --</option>
                                    @foreach (var item in materials)
                                    {
                                        <option value="@item.Value" data-text="@item.Text">@item.Text</option>
                                    }
                                </select>
                                <div id="materialTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                <div id="materialHidden" class="d-none"></div>
                            </div>

                            <!-- Suppliers -->
                            <div class="col-md-6">
                                <label class="form-label">Suppliers</label>
                                <select id="supplierDropdown" class="form-select form-select-sm">
                                    <option value="">-- Add Supplier --</option>
                                    @foreach (var item in suppliers)
                                    {
                                        <option value="@item.Value" data-text="@item.Text">@item.Text</option>
                                    }
                                </select>
                                <div id="supplierTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                <div id="supplierHidden" class="d-none"></div>
                            </div>

                            <!-- Deviations -->
                            <div class="col-md-6">
                                <label class="form-label">Linked Deviations</label>
                                <select id="deviationDropdown" class="form-select form-select-sm">
                                    <option value="">-- Add Deviation --</option>
                                    @foreach (var item in deviations)
                                    {
                                        <option value="@item.Value" data-text="@item.Text">@item.Text</option>
                                    }
                                </select>
                                <div id="deviationTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                <div id="deviationHidden" class="d-none"></div>
                            </div>

                            <!-- Complaints -->
                            <div class="col-md-6">
                                <label class="form-label">Linked Complaints</label>
                                <select id="complaintDropdown" class="form-select form-select-sm">
                                    <option value="">-- Add Complaint --</option>
                                    @foreach (var item in complaints)
                                    {
                                        <option value="@item.Value" data-text="@item.Text">@item.Text</option>
                                    }
                                </select>
                                <div id="complaintTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                <div id="complaintHidden" class="d-none"></div>
                            </div>

                            <!-- Audits -->
                            <div class="col-md-6">
                                <label class="form-label">Linked Audits</label>
                                <select id="auditDropdown" class="form-select form-select-sm">
                                    <option value="">-- Add Audit --</option>
                                    @foreach (var item in audits)
                                    {
                                        <option value="@item.Value" data-text="@item.Text">@item.Text</option>
                                    }
                                </select>
                                <div id="auditTags" class="mt-1 d-flex flex-wrap gap-1"></div>
                                <div id="auditHidden" class="d-none"></div>
                            </div>

                            <div class="col-12">
                                <label asp-for="CorrectiveAction" class="form-label">
                                    Corrective Action <span class="text-danger">*</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="corrective" aria-label="Corrective action guidance">?</button>
                                </label>
                                <textarea asp-for="CorrectiveAction" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="CorrectiveAction" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="PreventiveAction" class="form-label">
                                    Preventive Action <span class="text-danger">*</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="preventive" aria-label="Preventive action guidance">?</button>
                                </label>
                                <textarea asp-for="PreventiveAction" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="PreventiveAction" class="text-danger small"></span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ── Section 2: Assessment ──────────────────────────────────────── -->
            <div class="card mb-4 @(!planEditable ? "opacity-50" : "")">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    Assessment
                    @if (!planEditable)
                    {
                        <span class="badge bg-secondary"><i class="bi bi-lock-fill"></i> Locked</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-dark">In Progress</span>
                    }
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Assess the impact, risk, and adequacy of the proposed corrective and preventive actions.</p>
                    @if (!planEditable)
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-3">Assessment</dt>
                            <dd class="col-sm-9">@(Model.Assessment ?? "-")</dd>
                        </dl>
                        <input type="hidden" asp-for="Assessment" />
                    }
                    else
                    {
                        <div class="col-12">
                            <label asp-for="Assessment" class="form-label">
                                Assessment <span class="text-danger">*</span>
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="assessment" aria-label="Assessment guidance">?</button>
                            </label>
                            <textarea asp-for="Assessment" class="form-control" rows="5"></textarea>
                        </div>
                    }
                </div>
            </div>

            <!-- ── Section 3: Implementation ─────────────────────────────────── -->
            @if (implEditable)
            {
                <div class="card mb-4">
                    <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                        Implementation
                        <span class="badge bg-warning text-dark">Action Required</span>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">Document all completed CAPA actions with evidence, confirm root cause elimination, and record the effectiveness check.</p>
                        <div class="col-12">
                            <label asp-for="Implementation" class="form-label">
                                Implementation <span class="text-danger">*</span>
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 help-btn" data-help="implementation" aria-label="Implementation guidance">?</button>
                            </label>
                            <textarea asp-for="Implementation" class="form-control" rows="5"></textarea>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex gap-2 mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">View Details</a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
            </div>
        </form>

<!-- Popover help content -->
<div class="d-none">
    <div id="help-capatype">
        <p class="mb-0">Recall / Market Action makes this CAPA the master record for a recall; Improvement Opportunity is a planned business improvement, not a response to a problem.</p>
    </div>
    <div id="help-corrective">
        <p class="mb-1"><strong>Corrective Action must include:</strong></p>
        <ul class="mb-0 ps-3">
            <li>A description of each action to eliminate the identified root cause</li>
            <li>The person responsible for each action</li>
            <li>Target completion date for each action</li>
            <li>How effectiveness will be verified</li>
        </ul>
    </div>
    <div id="help-preventive">
        <p class="mb-1"><strong>Preventive Action must include:</strong></p>
        <ul class="mb-0 ps-3">
            <li>Actions to prevent recurrence of this or similar issues</li>
            <li>Systemic or process improvements proposed</li>
            <li>Review of related processes, procedures, or controls</li>
            <li>Training or documentation updates required</li>
        </ul>
    </div>
    <div id="help-assessment">
        <p class="mb-1"><strong>Assessment must address:</strong></p>
        <ul class="mb-0 ps-3">
            <li>Impact on product quality and patient safety</li>
            <li>Risk level if actions are not completed on time</li>
            <li>Adequacy and feasibility of the proposed corrective and preventive actions</li>
            <li>Whether the target completion date is realistic</li>
        </ul>
    </div>
    <div id="help-implementation">
        <p class="mb-1"><strong>Implementation must document:</strong></p>
        <ul class="mb-0 ps-3">
            <li>All CAPA actions completed, with evidence (e.g. SOP revised on [date], training completed by [names] on [date])</li>
            <li>Confirmation that the root cause has been eliminated</li>
            <li>Effectiveness check result — confirm the issue has not recurred</li>
            <li>Date each action was completed and by whom</li>
        </ul>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    function setupPicker(dropdownId, tagsId, hiddenId, inputName, preselected) {
        var selected = {};
        preselected = preselected || [];

        function renderTags() {
            var tagsDiv   = document.getElementById(tagsId);
            var hiddenDiv = document.getElementById(hiddenId);
            tagsDiv.innerHTML   = '';
            hiddenDiv.innerHTML = '';
            Object.keys(selected).forEach(function(id) {
                var text = selected[id];
                var chip = document.createElement('span');
                chip.style.cssText = 'display:inline-block;background:#0d6efd;color:white;padding:2px 8px;border-radius:12px;margin:2px;font-size:12px;cursor:pointer;';
                chip.innerHTML = text + ' &times;';
                chip.title = 'Click to remove';
                chip.addEventListener('click', function() {
                    delete selected[id];
                    var opt = document.querySelector('#' + dropdownId + ' option[value="' + id + '"]');
                    if (opt) opt.disabled = false;
                    renderTags();
                });
                tagsDiv.appendChild(chip);
                var hidden = document.createElement('input');
                hidden.type  = 'hidden';
                hidden.name  = inputName;
                hidden.value = id;
                hiddenDiv.appendChild(hidden);
            });
        }

        preselected.forEach(function(item) {
            selected[item.id] = item.text;
            var opt = document.querySelector('#' + dropdownId + ' option[value="' + item.id + '"]');
            if (opt) opt.disabled = true;
        });
        renderTags();

        document.getElementById(dropdownId).addEventListener('change', function() {
            var dd   = document.getElementById(dropdownId);
            var id   = dd.value;
            var text = dd.options[dd.selectedIndex].dataset.text;
            if (id && !selected[id]) {
                selected[id] = text;
                dd.options[dd.selectedIndex].disabled = true;
                renderTags();
            }
            dd.value = '';
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.help-btn').forEach(function (btn) {
            var contentEl = document.getElementById('help-' + btn.dataset.help);
            new bootstrap.Popover(btn, {
                html: true, trigger: 'click', placement: 'right',
                content: contentEl ? contentEl.innerHTML : '',
                title: '', container: 'body'
            });
        });
        document.addEventListener('click', function (e) {
            if (!e.target.classList.contains('help-btn')) {
                document.querySelectorAll('.help-btn').forEach(function (btn) {
                    var pop = bootstrap.Popover.getInstance(btn);
                    if (pop) pop.hide();
                });
            }
        });
    });
    </script>
    @if (planEditable)
    {
        <script>
        document.addEventListener('DOMContentLoaded', function () {
            var selProducts   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(products.Where(x => selProductIds.Contains(int.Parse(x.Value))).Select(x => new { id = x.Value, text = x.Text }).ToList()));
            var selProcesses  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(processes.Where(x => selProcessIds.Contains(int.Parse(x.Value))).Select(x => new { id = x.Value, text = x.Text }).ToList()));
            var selAssets     = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(assets.Where(x => selAssetIds.Contains(int.Parse(x.Value))).Select(x => new { id = x.Value, text = x.Text }).ToList()));
            var selMaterials  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(materials.Where(x => selMaterialIds.Contains(int.Parse(x.Value))).Select(x => new { id = x.Value, text = x.Text }).ToList()));
            var selSuppliers  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(suppliers.Where(x => selSupplierIds.Contains(int.Parse(x.Value))).Select(x => new { id = x.Value, text = x.Text }).ToList()));
            var selDeviations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(deviations.Where(x => selDeviationIds.Contains(int.Parse(x.Value))).Select(x => new { id = x.Value, text = x.Text }).ToList()));
            var selComplaints = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(complaints.Where(x => selComplaintIds.Contains(int.Parse(x.Value))).Select(x => new { id = x.Value, text = x.Text }).ToList()));
            var selAudits     = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(audits.Where(x => selAuditIds.Contains(int.Parse(x.Value))).Select(x => new { id = x.Value, text = x.Text }).ToList()));
            setupPicker('productDropdown',   'productTags',   'productHidden',   'selectedProducts',   selProducts);
            setupPicker('processDropdown',   'processTags',   'processHidden',   'selectedProcesses',  selProcesses);
            setupPicker('assetDropdown',     'assetTags',     'assetHidden',     'selectedAssets',     selAssets);
            setupPicker('materialDropdown',  'materialTags',  'materialHidden',  'selectedMaterials',  selMaterials);
            setupPicker('supplierDropdown',  'supplierTags',  'supplierHidden',  'selectedSuppliers',  selSuppliers);
            setupPicker('deviationDropdown', 'deviationTags', 'deviationHidden', 'selectedDeviations', selDeviations);
            setupPicker('complaintDropdown', 'complaintTags', 'complaintHidden', 'selectedComplaints', selComplaints);
            setupPicker('auditDropdown',     'auditTags',     'auditHidden',     'selectedAudits',     selAudits);
        });
        </script>
    }
}
