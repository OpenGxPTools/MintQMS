@model OpenQMS.Models.Capa

@{
    ViewData["Title"] = L["Attachments"].Value;
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">@L["Attachments"]</h4>
        <small class="text-muted">@Model.CapaId — @Model.Title</small>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>@L["Back to CAPA"]</a>
</div>
<hr />

@if (Model.Status != OpenQMS.Models.Capa.CapaStatus.Approved)
{
    <div class="card mb-4">
        <div class="card-header fw-semibold">@L["Upload New Attachment"]</div>
        <div class="card-body">
            <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data">
                <input type="hidden" name="capaId" value="@Model.Id" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">@L["Select File"]</label>
                        <input type="file" class="form-control" name="file" required />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">@L["Description (optional)"]</label>
                        <input type="text" class="form-control" name="description" placeholder="@L["e.g., Root Cause Analysis Report"]" />
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">@L["Upload"]</button>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <strong>@L["Record Approved:"]</strong> @L["This CAPA is approved. No new attachments can be uploaded."]
    </div>
}

<h5>@L["Attached Files ({0})", Model.Attachments?.Count ?? 0]</h5>

@if (Model.Attachments != null && Model.Attachments.Any())
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>@L["File Name"]</th>
                <th>@L["Description"]</th>
                <th>@L["Size"]</th>
                <th>@L["Uploaded By"]</th>
                <th>@L["Uploaded Date"]</th>
                <th>@L["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attachment in Model.Attachments.OrderByDescending(a => a.UploadedDate))
            {
                <tr>
                    <td>@attachment.FileName</td>
                    <td>@(attachment.Description ?? "-")</td>
                    <td>@((attachment.FileSize / 1024.0).ToString("N2")) KB</td>
                    <td>@attachment.UploadedBy</td>
                    <td>@attachment.UploadedDate.ToSite().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a asp-action="ViewAttachment" asp-route-id="@attachment.Id" class="btn btn-sm btn-outline-secondary" target="_blank"><i class="bi bi-eye me-1"></i>@L["View"]</a>
                        <a asp-action="DownloadAttachment" asp-route-id="@attachment.Id" class="btn btn-sm btn-outline-primary">@L["Download"]</a>
                        @if (Model.Status != OpenQMS.Models.Capa.CapaStatus.Approved)
                        {
                            <form asp-action="DeleteAttachment" method="post" style="display:inline;" data-delete-reason="attachment">
                                <input type="hidden" name="id" value="@attachment.Id" />
                                <input type="hidden" name="capaId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">@L["No attachments yet."]</p>
}
