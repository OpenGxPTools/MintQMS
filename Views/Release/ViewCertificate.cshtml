@model OpenQMS.Services.IssuedCopyResult
@using OpenQMS.Models.Release

@{
    var cert = (OpenQMS.Models.Release.ReleaseCertificate)ViewBag.Certificate;
    ViewData["Title"] = cert?.CertificateNumber ?? L["Certificate"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@media print {
        .navbar, header, footer, .no-print, .btn, nav { display: none !important; }
        .card { border: 1px solid #dee2e6 !important; }
        body { font-size: 11pt; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <div>
        <a asp-action="Details" asp-route-id="@cert?.ReleaseRecordId" class="btn btn-outline-secondary btn-sm">&#8592; @L["Back to Record"]</a>
    </div>
    <button onclick="window.print()" class="btn btn-outline-primary btn-sm">&#128438; @L["Print / Save as PDF"]</button>
</div>

@* The certificate's CURRENT status is shown (and printed) outside the stored copy, which never changes. *@
@if (cert?.Status == CertificateStatus.Superseded)
{
    <div class="alert alert-secondary fw-semibold" id="certificate-status">@L["SUPERSEDED — this certificate has been replaced by a later one and is no longer valid."]</div>
}
else if (cert?.Status == CertificateStatus.Withdrawn)
{
    <div class="alert alert-danger fw-semibold" id="certificate-status">@L["WITHDRAWN — this certificate has been withdrawn and is no longer valid."]</div>
}

@if (Model.Copy == null)
{
    <div class="alert alert-warning">@L["Certificate content snapshot not available."]</div>
}
else if (!Model.IntegrityOk)
{
    <div class="alert alert-danger" id="integrity-failed">
        <strong>@L["Integrity check failed."]</strong>
        @L["The stored copy of this certificate does not match the checksum recorded when it was issued, so it is not shown. The event has been recorded in the audit trail. Contact your administrator."]
    </div>
}
else
{
    @Html.Raw(Model.Copy.Html)
    <partial name="~/Views/Shared/_IssuedCopyBanner.cshtml" model="Model.Copy" />
}
