@model OpenQMS.ViewModels.Release.CertificateSnapshot?
@using OpenQMS.ViewModels.Release
@using OpenQMS.Models.Release
@using OpenQMS.Models
@inject OpenQMS.Data.ApplicationDbContext _certDb

@{
    var cert = (OpenQMS.Models.Release.ReleaseCertificate)ViewBag.Certificate;
    var _certSettings = await _certDb.SystemSettings.FindAsync(1);
    ViewData["Title"] = cert?.CertificateNumber ?? "Certificate";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var certTitle = cert?.CertificateType switch
    {
        CertificateType.CoA      => "Certificate of Analysis",
        CertificateType.CoC      => "Certificate of Conformance",
        CertificateType.Combined => "Certificate of Analysis and Conformance",
        _                        => "Quality Oversight Review Report"
    };
}

<style>
    @@media print {
        .navbar, header, footer, .no-print, .btn, nav { display: none !important; }
        .card { border: 1px solid #dee2e6 !important; }
        body { font-size: 11pt; }
    }
    .cert-header { border-bottom: 3px solid #0d6efd; padding-bottom: 12px; }
    .cert-section { border-top: 1px solid #dee2e6; padding-top: 12px; margin-top: 12px; }
    .cert-signature { border: 1px solid #333; padding: 16px; margin-top: 24px; background: #f8f9fa; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <div>
        <a asp-action="Details" asp-route-id="@cert?.ReleaseRecordId" class="btn btn-outline-secondary btn-sm">&#8592; Back to Record</a>
    </div>
    <button onclick="window.print()" class="btn btn-outline-primary btn-sm">&#128438; Print / Save as PDF</button>
</div>

@if (Model == null)
{
    <div class="alert alert-warning">Certificate content snapshot not available.</div>
}
else
{
    <div class="card p-4" id="certificate-content">
        <!-- Organisation Header (visible on screen and in print) -->
        @if (!string.IsNullOrEmpty(_certSettings?.LogoPath) || !string.IsNullOrEmpty(_certSettings?.OrganisationName))
        {
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                <div>
                    @if (!string.IsNullOrEmpty(_certSettings?.LogoPath))
                    {
                        <img src="@_certSettings.LogoPath" alt="@(_certSettings.OrganisationName ?? "Organisation")"
                             style="max-height:60px; max-width:200px;" />
                    }
                </div>
                <div class="text-end">
                    @if (!string.IsNullOrEmpty(_certSettings?.OrganisationName))
                    {
                        <div class="fw-bold fs-6">@_certSettings.OrganisationName</div>
                    }
                    @if (!string.IsNullOrEmpty(_certSettings?.OrganisationAddress))
                    {
                        <div class="small text-muted" style="white-space: pre-line;">@_certSettings.OrganisationAddress</div>
                    }
                </div>
            </div>
        }

        <!-- Header -->
        <div class="cert-header d-flex justify-content-between align-items-start">
            <div>
                <h3 class="mb-1">@certTitle</h3>
                <div><strong>Certificate No.:</strong> @Model.CertificateNumber</div>
                <div><strong>Record No.:</strong> @Model.RecordNumber</div>
                <div><strong>Date of Issue:</strong> @Model.IssuedDate.ToSite().ToString("dd-MMM-yyyy")</div>
            </div>
            <div class="text-end">
                <span class="badge bg-primary fs-6">@Model.ReleaseType</span><br />
                @if (cert?.Status == CertificateStatus.Superseded)
                {
                    <span class="badge bg-secondary mt-1">SUPERSEDED</span>
                }
                else if (cert?.Status == CertificateStatus.Withdrawn)
                {
                    <span class="badge bg-danger mt-1">WITHDRAWN</span>
                }
            </div>
        </div>

        <!-- Product & Batch Identification -->
        <div class="cert-section">
            <h6 class="text-uppercase text-muted small mb-2">Product Identification</h6>
            @{
                var cpt = Model?.ProductType;
            }
            <div class="row">
                <div class="col-md-4"><strong>Product Name:</strong> @Model?.ProductName</div>
                <div class="col-md-4"><strong>Brand Name:</strong> @(Model?.BrandName ?? "-")</div>
                <div class="col-md-4"><strong>ARTG Ref.:</strong> @(Model?.ArtgReference ?? "-")</div>
            </div>
            @if (!cpt.HasValue || cpt == ProductType.Pharmaceutical || cpt == ProductType.Biological || cpt == ProductType.ConsumerHealth)
            {
                <div class="row mt-1">
                    <div class="col-md-4"><strong>INN / Generic:</strong> @(Model?.InnName ?? "-")</div>
                    <div class="col-md-4"><strong>Dosage Form:</strong> @(Model?.DosageForm ?? "-")</div>
                    <div class="col-md-4"><strong>Strength / Presentation:</strong> @(Model?.Strength ?? "-")</div>
                </div>
            }
            @if (cpt == ProductType.Cosmetic)
            {
                <div class="row mt-1">
                    <div class="col-md-6"><strong>INCI Name / Ingredient Ref.:</strong> @(Model?.InciName ?? "-")</div>
                    <div class="col-md-3"><strong>Presentation / Form:</strong> @(Model?.PresentationForm ?? "-")</div>
                    <div class="col-md-3"><strong>Strength / Presentation:</strong> @(Model?.Strength ?? "-")</div>
                </div>
            }
            @if (cpt == ProductType.MedicalDevice)
            {
                <div class="row mt-1">
                    <div class="col-md-6"><strong>Device Type / Category:</strong> @(Model?.DeviceTypeCategory ?? "-")</div>
                    <div class="col-md-6"><strong>Model / Version:</strong> @(Model?.ModelVersion ?? "-")</div>
                </div>
            }
            @if (cpt == ProductType.RawMaterial)
            {
                <div class="row mt-1">
                    <div class="col-md-4"><strong>Standard / Scientific Name:</strong> @(Model?.StandardScientificName ?? "-")</div>
                    <div class="col-md-4"><strong>Material Type / Category:</strong> @(Model?.RawMaterialTypeCategory ?? "-")</div>
                    <div class="col-md-4"><strong>Grade:</strong> @(Model?.Grade ?? "-")</div>
                </div>
                <div class="row mt-1">
                    <div class="col-md-4"><strong>Presentation / Form:</strong> @(Model?.PresentationForm ?? "-")</div>
                </div>
            }
        </div>

        <div class="cert-section">
            <h6 class="text-uppercase text-muted small mb-2">Batch Details</h6>
            <div class="row">
                <div class="col-md-3"><strong>Batch No.:</strong> @Model.BatchNumber</div>
                <div class="col-md-3"><strong>Batch Size:</strong> @(Model.BatchSize ?? "-")</div>
                <div class="col-md-3"><strong>Mfg Date:</strong> @(Model.ManufacturingDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
                <div class="col-md-3">
                    @if (Model.ExpiryDate.HasValue)
                    {
                        <strong>Expiry Date:</strong> @Model.ExpiryDate.Value.ToString("dd-MMM-yyyy")
                    }
                    else if (Model.RetestDate.HasValue)
                    {
                        <strong>Retest Date:</strong> @Model.RetestDate.Value.ToString("dd-MMM-yyyy")
                    }
                    else { <strong>Expiry / Retest Date:</strong> <span>-</span> }
                </div>
            </div>
            @if (cert?.CertificateType == CertificateType.CoC || cert?.CertificateType == CertificateType.Combined)
            {
                <div class="row mt-1">
                    <div class="col-md-3"><strong>Pack Size:</strong> @(Model.PackSize ?? "-")</div>
                </div>
            }
        </div>

        <div class="cert-section">
            <h6 class="text-uppercase text-muted small mb-2">Manufacturing &amp; Testing Sites</h6>
            <div class="row g-2">
                <div class="col-md-6">
                    <strong>Manufacturing Site:</strong> @(Model.ManufacturingSite ?? "-")<br />
                    <small class="text-muted">GMP Licence / Clearance: @(Model.ManufacturingSiteGmpRef ?? "-")</small>
                </div>
                @if (!string.IsNullOrEmpty(Model.PackagingSite))
                {
                    <div class="col-md-6">
                        <strong>Packaging Site:</strong> @Model.PackagingSite<br />
                        <small class="text-muted">GMP Licence / Clearance: @(Model.PackagingSiteGmpRef ?? "-")</small>
                    </div>
                }
                <div class="col-md-6">
                    <strong>Testing Laboratory / Laboratories:</strong><br />
                    @if (Model.TestingLabs != null && Model.TestingLabs.Any())
                    {
                        @foreach (var lab in Model.TestingLabs)
                        {
                            <div>@lab.LaboratoryName <small class="text-muted">@(string.IsNullOrEmpty(lab.GmpLicenceRef) ? "" : $"[{lab.GmpLicenceRef}]")</small></div>
                        }
                    }
                    else if (!string.IsNullOrEmpty(Model.TestingLaboratory))
                    {
                        <span>@Model.TestingLaboratory</span>
                    }
                    else { <span>-</span> }
                </div>
                <div class="col-md-6">
                    <strong>Releasing Company:</strong> @(Model.ReleasingCompany ?? "-")<br />
                    <small class="text-muted">TGA Licence / Clearance: @(Model.ReleasingCompanyLicenceRef ?? "-")</small>
                </div>
            </div>
        </div>

        @if (cert?.CertificateType == CertificateType.CoA || cert?.CertificateType == CertificateType.Combined)
        {
            <!-- Analytical Results -->
            <div class="cert-section">
                <h6 class="text-uppercase text-muted small mb-2">Analytical Results</h6>
                @if (Model.TestResults.Any())
                {
                    bool anyFail = Model.TestResults.Any(t => t.Status == TestResultStatus.Fail);
                    bool anyPend = Model.TestResults.Any(t => t.Status == TestResultStatus.Pending);
                    string conclusionLabel = anyFail ? "OUT OF SPECIFICATION"
                                          : anyPend  ? "RESULTS PENDING"
                                          : "CONFORMS TO SPECIFICATION";
                    string conclusionClass = anyFail ? "bg-danger"
                                          : anyPend  ? "bg-warning text-dark"
                                          : "bg-success";
                    <div class="d-flex align-items-center mb-2">
                        <span class="fw-semibold me-2 small">Overall Conclusion:</span>
                        <span class="badge @conclusionClass fs-6">@conclusionLabel</span>
                    </div>
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Test Parameter</th>
                                <th>Test Method</th>
                                <th>Acceptance Criterion</th>
                                <th>Result</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.TestResults)
                            {
                                var tbadge = t.Status == TestResultStatus.Pass ? "bg-success"
                                           : t.Status == TestResultStatus.Fail ? "bg-danger"
                                           : "bg-secondary";
                                <tr>
                                    <td>@t.TestParameter</td>
                                    <td><small>@t.TestMethod</small></td>
                                    <td>@t.AcceptanceCriterion</td>
                                    <td>@t.Result</td>
                                    <td><span class="badge @tbadge">@EnumHelper.Display(t.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No analytical results recorded.</p>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.OpenDeviationsNotes))
        {
            <div class="cert-section">
                <h6 class="text-uppercase text-muted small mb-2">Open Deviations / Exceptions</h6>
                <p>@Model.OpenDeviationsNotes</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.LimitationsNotes))
        {
            <div class="cert-section">
                <h6 class="text-uppercase text-muted small mb-2">Limitations / Conditions on Release</h6>
                <p>@Model.LimitationsNotes</p>
            </div>
        }

        <!-- Signature Block -->
        <div class="cert-signature mt-4">
            @{
                string sigTitle = cert?.CertificateType switch
                {
                    CertificateType.CoA      => "Certificate of Analysis — Signatory",
                    CertificateType.CoC      => "Certificate of Conformance — Signatory",
                    CertificateType.Combined => "Certificate of Analysis and Conformance — Signatory",
                    _                        => "Quality Oversight — Signatory"
                };
                string displayStatement = Model.CertificateIssuanceStatement
                    ?? Model.APCertificationStatement
                    ?? "I hereby certify that the information contained in this certificate is accurate.";
                string displayName = Model.IssuedByFullName ?? Model.APName ?? cert?.APFullNameQualification ?? "-";
                DateTime? displayDate = (Model.IssuedDate != default ? Model.IssuedDate : Model.CertificationDate).ToSite();
            }
            <h6 class="text-uppercase small mb-3">@sigTitle</h6>
            <p>@displayStatement</p>
            <div class="row mt-3">
                <div class="col-md-5">
                    <strong>Signed By:</strong><br />
                    @displayName
                </div>
                <div class="col-md-3">
                    <strong>Date of Issue:</strong><br />
                    @(displayDate?.ToString("dd-MMM-yyyy") ?? "-")
                </div>
                @if (!string.IsNullOrEmpty(Model.ReleaseRegisterRef))
                {
                    <div class="col-md-4">
                        <strong>Register Ref.:</strong> @Model.ReleaseRegisterRef
                    </div>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.APName) && Model.APName != displayName)
            {
                <div class="mt-2 pt-2 border-top small text-muted">
                    <strong>Batch Certified By (AP):</strong> @Model.APName
                    @if (Model.CertificationDate.HasValue)
                    {
                        <span> on @Model.CertificationDate.Value.ToSite().ToString("dd-MMM-yyyy")</span>
                    }
                </div>
            }
        </div>
    </div>
}
