@model OpenQMS.Models.Service

@{
    ViewData["Title"] = "Delete Service";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <h4 class="mb-0">Delete Service</h4>
    </div>
</div>
<hr />
<h5 class="text-danger">Are you sure you want to delete this?</h5>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.ServiceId)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.ServiceId)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Description)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Category)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Category)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Version)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Version)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.EditedBy)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.EditedBy)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.EditedOn)
            </dt>
            <dd class="col-sm-8">
                @(Model.EditedOn.ToSite())
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Status)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Status)
            </dd>
        </dl>
    </div>
</div>

<div>

    <h4>Documents</h4>
    <div class="row">
        <table class="table table-border">
            <thead>
                <tr>
                    <th>File Name</th>
                    <th>Description</th>
                    <th>Uploaded By</th>
                    <th>Uploaded Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Documents != null)
                {
                    @foreach (var item in Model.Documents)
                    {
                        <tr>
                            <td>@item.FileName</td>
                            <td>@(item.Description ?? "-")</td>
                            <td>@item.UploadedBy</td>
                            <td>@item.UploadedDate.ToSite().ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <br />

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if ((bool)ViewData["HasLinkedRecords"] == true)
    {
        <div class="alert alert-danger">This service has linked Documents or Suppliers. Remove those links before deleting.</div>
    }
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <input type="submit" value="Delete" class="btn btn-danger" disabled="@((bool)ViewData["HasLinkedRecords"] == true ? "disabled" : null)" />
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        </div>
    </form>
</div>
