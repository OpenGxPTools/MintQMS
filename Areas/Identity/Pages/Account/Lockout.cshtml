@page
@model LockoutModel
@{
    ViewData["Title"] = L["Locked out"].Value;
    ViewData["AuthTitleClass"] = "text-danger";
    Layout = "_AuthLayout";
}

<p class="text-danger">@L["This account has been locked out, please try again later."]</p>
    <div class="mint-auth-links">
        <a asp-page="./Login">@L["Back to log in"]</a>
    </div>
