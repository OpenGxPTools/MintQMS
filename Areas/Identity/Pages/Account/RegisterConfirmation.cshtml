@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = L["Register confirmation"].Value;
}

<h1>@ViewData["Title"]</h1>
@{
    if (Model.DisplayConfirmAccountLink)
    {
        <div class="alert alert-warning">
            @H["<strong>Email is not configured yet.</strong> Once SMTP is set up in System Settings, confirmation emails will be sent automatically."]
            <br />@L["For now, use this link to confirm the account:"] <a id="confirm-link" href="@Model.EmailConfirmationUrl">@L["Click here to confirm your account"]</a>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            @H["A confirmation email has been sent to <strong>{0}</strong>. The user must click the link in that email before they can log in.", Model.Email]
        </div>
    }
}

