@page
@model LoginWith2faModel
@{
    ViewData["Title"] = L["Two-factor authentication"].Value;
    Layout = "_AuthLayout";
}

<p class="text-muted">@L["Your login is protected with an authenticator app. Enter your authenticator code below."]</p>
<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <input asp-for="RememberMe" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-floating">
        <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="one-time-code" inputmode="numeric" autofocus />
        <label asp-for="Input.TwoFactorCode" class="form-label"></label>
        <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="Input.RememberMachine" />
        <label asp-for="Input.RememberMachine" class="form-check-label">@Html.DisplayNameFor(m => m.Input.RememberMachine)</label>
    </div>
    <button type="submit" class="w-100 btn btn-lg btn-primary">@L["Log in"]</button>
</form>
<p class="mint-auth-links">
    @H["Don't have access to your authenticator device? You can {0}.",
        HtmlPieces.Link(Url.Page("./LoginWithRecoveryCode", new { returnUrl = Model.ReturnUrl }), L["log in with a recovery code"].Value, "recovery-code-login")]
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
