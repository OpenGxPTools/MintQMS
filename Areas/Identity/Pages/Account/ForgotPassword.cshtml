@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = L["Forgot your password?"].Value;
    Layout = "_AuthLayout";
}

<p class="text-muted">@L["Enter your email."]</p>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-floating">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" autofocus />
        <label asp-for="Input.Email" class="form-label"></label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <button type="submit" class="w-100 btn btn-lg btn-primary">@L["Reset Password"]</button>
    <div class="mint-auth-links">
        <a asp-page="./Login">@L["Back to log in"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
