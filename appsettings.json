{
  "ConnectionStrings": {
    // SQLite is the supported database. Production: an absolute path on durable storage,
    // e.g. "Data Source=/var/lib/mintqms/OpenQMS.db" (see DEPLOYMENT.md).
    "DefaultConnection": "Data Source=OpenQMS.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BackupStatusFile": "/var/backups/mintqms/backup_status.json",
  // Where users can obtain this installation's source code (AGPLv3 section 13). If you modify
  // MintQMS, point this at your own modified source.
  "SourceCodeUrl": "https://github.com/OpenGxPTools/MintQMS",
  // Folder that keeps the sign-in/anti-forgery keys across restarts (production: e.g. /var/lib/mintqms/keys).
  // Empty = the .NET default (the service account's home folder).
  "DataProtectionKeysPath": ""
}
